{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinLaucher",
  "version": "1.0.5",
  "identifier": "design.winlaucher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinLaucher",
        "width": 1200,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#0f1118",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:; font-src 'self' data:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "WinLaucher",
    "copyright": "© 2026 WinLaucher",
    "category": "Game",
    "shortDescription": "WinLaucher — Minecraft Java Edition launcher",
    "longDescription": "WinLaucher is a modern Minecraft Java Edition launcher: installs any vanilla version, Fabric, Forge, NeoForge and Quilt, manages Java automatically, browses and installs Modrinth mods and modpacks, and launches the real game with Microsoft or offline accounts.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
