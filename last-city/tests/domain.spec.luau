--!nonstrict
-- Runs against the exact game domain modules, not a reimplementation.
local Config = require("../src/ReplicatedStorage/Shared/GameConfig")
local Items = require("../src/ReplicatedStorage/Shared/ItemDefinitions")
local Weapons = require("../src/ReplicatedStorage/Shared/WeaponDefinitions")
local Buildings = require("../src/ReplicatedStorage/Shared/BuildingDefinitions")
local QuestDefs = require("../src/ReplicatedStorage/Shared/QuestDefinitions")
local EconomyDefs = require("../src/ReplicatedStorage/Shared/EconomyConfig")
local Util = require("../src/ServerScriptService/Domain/Util")
local Inventory = require("../src/ServerScriptService/Domain/Inventory")(Items, Weapons, Config, Util)
local Profile = require("../src/ServerScriptService/Domain/Profile")(Config, Items, Weapons, Buildings, QuestDefs, EconomyDefs, Util, Inventory)
local Quests = require("../src/ServerScriptService/Domain/Quests")(QuestDefs, Inventory, Util)
local Building = require("../src/ServerScriptService/Domain/Building")(Buildings, Inventory, Config, Util)
local Economy = require("../src/ServerScriptService/Domain/Economy")(Buildings, EconomyDefs, Inventory, Util)
local Progression = require("../src/ServerScriptService/Domain/Progression")(Config, EconomyDefs, Inventory)
local Lease = require("../src/ServerScriptService/Domain/Lease")
local RateLimiter = require("../src/ServerScriptService/Domain/RateLimiter")
local passed, failed = 0, 0
local function eq(actual, expected, message)
    assert(actual == expected, (message or "Values differ") .. ": expected " .. tostring(expected) .. ", got " .. tostring(actual))
end
local function test(name, callback)
    local ok, err = pcall(callback)
    if ok then passed += 1; print("PASSED | " .. name)
    else failed += 1; print("FAILED | " .. name .. " | " .. tostring(err)) end
end
local function fresh() local p = Profile.new(); return p, p.Campaigns.coop end
local function rich(c)
    c.Cash = 100000
    for id, def in Items do if not def.weapon and not def.armor and not def.blueprint then c.Stockpile[id] = 1000 end end
end
local function completed(c, id, now)
    assert(Quests.accept(c, id, now))
    for _, goal in QuestDefs[id].objectives do Quests.record(c, goal.event, goal.target == "*" and "walker" or goal.target, goal.count, now) end
    eq(c.Quests[id].status, "Completed")
end
local function find(c, id) for _, e in c.Inventory do if e.id == id then return e end end; error("Missing " .. id) end

test("new profile contains real starter inventory", function()
    local p,c = fresh(); eq(p.SchemaVersion,1); eq(Inventory.count(c,"crowbar"),1); eq(Inventory.count(c,"food"),3); assert(Inventory.find(c,c.Equipped)); eq(c.Cash,200)
end)
test("solo and coop inventories are not aliased", function() local p,c=fresh(); Inventory.remove(c,"food",3); eq(Inventory.count(p.Campaigns.solo,"food"),3) end)
test("inventory grant merges stacks within capacity", function() local _,c=fresh(); assert(Inventory.grant(c,{food=17})); eq(find(c,"food").count,20); eq(#c.Inventory,4) end)
test("inventory overflow creates a second bounded stack", function() local _,c=fresh(); assert(Inventory.grant(c,{food=18})); eq(Inventory.count(c,"food"),21); eq(#c.Inventory,5) end)
test("weight limit rejects transaction with no partial grant", function() local _,c=fresh(); local uid=c.NextItemId; eq(Inventory.grant(c,{ammo=1,metal=9999}),false); eq(Inventory.count(c,"ammo"),0); eq(c.NextItemId,uid) end)
test("unknown item cannot be minted", function() local _,c=fresh(); eq(Inventory.grant(c,{administrator=1}),false); eq(#c.Inventory,4) end)
test("negative, fractional, NaN and infinite item counts rejected", function() local _,c=fresh(); for _,n in {-1,0,1.5,0/0,math.huge} do eq(Inventory.grant(c,{metal=n}),false) end end)
test("split preserves total and allocates a unique uid", function() local _,c=fresh(); local e=find(c,"food"); assert(Inventory.split(c,e.uid,1)); eq(e.count,2); eq(Inventory.count(c,"food"),3); assert(c.Inventory[#c.Inventory].uid~=e.uid) end)
test("split cannot duplicate an entire stack", function() local _,c=fresh(); local e=find(c,"food"); eq(Inventory.split(c,e.uid,e.count),false); eq(Inventory.count(c,"food"),3) end)
test("weapons cannot be split", function() local _,c=fresh(); eq(Inventory.split(c,c.Equipped,1),false); eq(Inventory.count(c,"crowbar"),1) end)
test("move changes order not count or uid", function() local _,c=fresh(); local uid=c.Equipped; assert(Inventory.move(c,uid,4)); eq(c.Inventory[4].uid,uid); eq(#c.Inventory,4) end)
test("invalid moves leave inventory intact", function() local _,c=fresh(); eq(Inventory.move(c,c.Equipped,0),false); eq(Inventory.move(c,"stolen",1),false); eq(Inventory.move(c,c.Equipped,1.5),false) end)
test("removal clears equipped uid", function() local _,c=fresh(); assert(Inventory.remove(c,"crowbar",1)); eq(c.Equipped,"") end)
test("over-removal cannot make negative stacks", function() local _,c=fresh(); eq(Inventory.remove(c,"food",4),false); eq(Inventory.count(c,"food"),3) end)
test("specific uid removal does not affect another stack", function() local _,c=fresh(); local old=find(c,"food").uid; Inventory.split(c,old,1); local uid=c.Inventory[#c.Inventory].uid; assert(Inventory.takeUid(c,uid,1)); eq(find(c,"food").uid,old); eq(Inventory.count(c,"food"),2) end)
test("equipping requires ownership", function() local _,c=fresh(); eq(Inventory.equip(c,"i99999"),false) end)
test("rifle level requirement is enforced", function() local _,c=fresh(); Inventory.grant(c,{rifle=1}); local e=find(c,"rifle"); eq(Inventory.equip(c,e.uid),false); c.XP=400; assert(Inventory.equip(c,e.uid)); eq(c.Equipped,e.uid) end)
test("armor equips independently of weapon", function() local _,c=fresh(); Inventory.grant(c,{vest=1}); local weapon=c.Equipped; assert(Inventory.equip(c,find(c,"vest").uid)); eq(c.Equipped,weapon); eq(c.Armor,find(c,"vest").uid) end)
test("stock deposit and withdrawal conserve resources", function() local _,c=fresh(); local sum=(c.Stockpile.food or 0)+Inventory.count(c,"food"); assert(Inventory.transfer(c,"food",2,true)); assert(Inventory.transfer(c,"food",2,false)); eq((c.Stockpile.food or 0)+Inventory.count(c,"food"),sum) end)
test("stock rejects negative quantities and unique weapons", function() local _,c=fresh(); eq(Inventory.transfer(c,"food",-5,false),false); eq(Inventory.transfer(c,"crowbar",1,true),false); eq(Inventory.count(c,"crowbar"),1) end)
test("full backpack withdrawal does not debit stock", function() local _,c=fresh(); Inventory.grant(c,{crowbar=20}); local n=c.Stockpile.metal; eq(Inventory.transfer(c,"metal",1,false),false); eq(c.Stockpile.metal,n) end)
test("stock cap prevents item destruction on failed deposit", function() local _,c=fresh(); c.Stockpile.food=9999; eq(Inventory.transfer(c,"food",1,true),false); eq(Inventory.count(c,"food"),3) end)
test("mixed stock and backpack payment is exact", function() local _,c=fresh(); c.Stockpile.metal=2; Inventory.grant(c,{metal=5}); assert(Inventory.pay(c,{metal=6})); eq(c.Stockpile.metal,0); eq(Inventory.count(c,"metal"),1) end)
test("multi-resource payment failure debits nothing", function() local _,c=fresh(); local wood=c.Stockpile.wood; eq(Inventory.pay(c,{wood=1,parts=999}),false); eq(c.Stockpile.wood,wood) end)

test("quest acceptance creates persisted objective state", function() local _,c=fresh(); assert(Quests.accept(c,"first_blood",100)); eq(c.Quests.first_blood.status,"Active"); eq(c.Quests.first_blood.progress[1],0) end)
test("quest cannot be accepted twice", function() local _,c=fresh(); Quests.accept(c,"first_blood",100); eq(Quests.accept(c,"first_blood",100),false) end)
test("kills before acceptance do not count", function() local _,c=fresh(); Quests.record(c,"kill","walker",5,100); Quests.accept(c,"first_blood",100); eq(c.Quests.first_blood.progress[1],0) end)
test("first blood counts only regular walkers", function() local _,c=fresh(); Quests.accept(c,"first_blood",100); Quests.record(c,"kill","runner",5,100); eq(c.Quests.first_blood.progress[1],0); Quests.record(c,"kill","walker",2,100); eq(c.Quests.first_blood.progress[1],2) end)
test("quest progress clamps to target", function() local _,c=fresh(); Quests.accept(c,"first_blood",100); Quests.record(c,"kill","walker",99,100); eq(c.Quests.first_blood.progress[1],5); eq(c.Quests.first_blood.status,"Completed") end)
test("incomplete quest cannot pay rewards", function() local p,c=fresh(); Quests.accept(c,"first_blood",100); eq(Quests.claim(p,c,"first_blood",100),false); eq(p.Coins,0); eq(Inventory.count(c,"pistol"),0) end)
test("first blood awards exact coins XP pistol and ammo", function() local p,c=fresh(); completed(c,"first_blood",100); assert(Quests.claim(p,c,"first_blood",100)); eq(p.Coins,200); eq(c.XP,150); eq(Inventory.count(c,"pistol"),1); eq(Inventory.count(c,"ammo"),24); eq(c.Cash,200) end)
test("quest reward replay is idempotently rejected", function() local p,c=fresh(); completed(c,"first_blood",100); Quests.claim(p,c,"first_blood",100); for _=1,20 do eq(Quests.claim(p,c,"first_blood",100),false) end; eq(p.Coins,200); eq(Inventory.count(c,"pistol"),1) end)
test("partial inventory reward cannot consume quest or grant coins", function() local p,c=fresh(); completed(c,"first_blood",100); Inventory.grant(c,{crowbar=19}); local nextId=c.NextItemId; eq(#c.Inventory,23); eq(Quests.claim(p,c,"first_blood",100),false); eq(c.Quests.first_blood.status,"Completed"); eq(p.Coins,0); eq(c.XP,0); eq(Inventory.count(c,"ammo"),0); eq(c.NextItemId,nextId) end)
test("quest claim revalidates objectives instead of trusting status", function() local p,c=fresh(); Quests.accept(c,"first_blood",100); c.Quests.first_blood.status="Completed"; eq(Quests.claim(p,c,"first_blood",100),false) end)
test("supply crates are distinct and cannot be farmed", function() local _,c=fresh(); Quests.accept(c,"lost_supplies",100); for _=1,5 do Quests.record(c,"supply","market",1,100,"Supply1") end; eq(c.Quests.lost_supplies.progress[1],1); Quests.record(c,"supply","market",1,100,"Supply2"); Quests.record(c,"supply","market",1,100,"Supply3"); eq(c.Quests.lost_supplies.status,"Completed") end)
test("electricity requires all resource and building objectives", function() local _,c=fresh(); Quests.accept(c,"city_power",100); Quests.record(c,"build","generator",1,100); eq(c.Quests.city_power.status,"Active"); for id,n in {metal=20,wire=10,electronics=5} do Quests.record(c,"collect",id,n,100) end; eq(c.Quests.city_power.status,"Completed") end)
test("daily quest prerequisite cannot be bypassed", function() local _,c=fresh(); eq(Quests.accept(c,"daily_hunt",100),false) end)
test("daily progress resets at UTC boundary", function() local p,c=fresh(); completed(c,"first_blood",1); Quests.claim(p,c,"first_blood",1); assert(Quests.accept(c,"daily_hunt",86399)); Quests.record(c,"kill","runner",19,86399); Quests.refresh(c,86400); eq(c.Quests.daily_hunt,nil); assert(Quests.accept(c,"daily_hunt",86400)); eq(c.Quests.daily_hunt.progress[1],0) end)
test("expired daily reward cannot be claimed", function() local p,c=fresh(); completed(c,"first_blood",1); Quests.claim(p,c,"first_blood",1); completed(c,"daily_hunt",86399); eq(Quests.claim(p,c,"daily_hunt",86400),false); eq(p.Coins,200) end)

