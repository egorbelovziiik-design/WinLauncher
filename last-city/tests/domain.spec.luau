test("shop inventory overflow leaves cash and stock unchanged", function() local _,c=fresh(); Inventory.grant(c,{crowbar=20}); local product=EconomyDefs.Shop[4]; eq(Economy.buy(c,product,200,1),false); eq(c.Cash,200); eq(Inventory.count(c,"ammo"),0) end)
test("cosmetic requires coins and gives no campaign advantage", function() local p,c=fresh(); eq(Economy.cosmetic(p,"amber"),false); p.Coins=300; assert(Economy.cosmetic(p,"amber")); eq(p.Coins,50); eq(c.Cash,200); eq(c.XP,0); eq(p.EquippedSkin,"amber") end)
test("owned cosmetic is not charged again", function() local p=fresh(); p.Coins=300; Economy.cosmetic(p,"amber"); Economy.cosmetic(p,"amber"); eq(p.Coins,50) end)
test("craft requires a completed workshop", function() local _,c=fresh(); rich(c); eq(Economy.craft(c,"ammo",100),false); Building.place(c,"workshop",0,0,0,100); eq(Economy.craft(c,"ammo",105),false); assert(Economy.craft(c,"ammo",110)) end)
test("craft consumes exact inputs and rejects parallel orders", function() local _,c=fresh(); rich(c); Building.place(c,"workshop",0,0,0,100); local metal=c.Stockpile.metal; assert(Economy.craft(c,"ammo",110)); eq(c.Stockpile.metal,metal-2); eq(Economy.craft(c,"ammo",110),false); eq(c.Stockpile.metal,metal-2) end)
