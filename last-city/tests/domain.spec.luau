test("farm does not produce without a worker", function() local _,c=fresh(); rich(c); Building.place(c,"farm",0,0,0,100); c.Stockpile.food=0; Economy.tick(c,110,12); Economy.tick(c,140,12); eq(c.Stockpile.food,0) end)
