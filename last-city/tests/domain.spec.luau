test("shop rejects negative fractional NaN and overstock purchase", function() local _,c=fresh(); for _,n in {-1,0,0/0,0.5,31} do eq(Economy.buy(c,EconomyDefs.Shop[1],30,n),false) end; eq(c.Cash,200) end)
