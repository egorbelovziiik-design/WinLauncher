test("normalization advances uid counters to prevent collisions", function() local p,c=fresh(); c.Inventory[1].uid="i300"; c.NextItemId=0; local loaded=Profile.normalize(p); local target=loaded.Campaigns.coop; assert(Inventory.grant(target,{pistol=1})); eq(find(target,"pistol").uid,"i301") end)
test("normalization clamps forged counts ammo durability and currency", function() local p,c=fresh(); p.Coins=math.huge; c.Inventory[1].count=999; c.Inventory[1].durability=-10; c.Inventory[1].ammo=999; local loaded=Profile.normalize(p); eq(loaded.Coins,0); eq(loaded.Campaigns.coop.Inventory[1].count,1); eq(loaded.Campaigns.coop.Inventory[1].durability,0); eq(loaded.Campaigns.coop.Inventory[1].ammo,0) end)
test("full profile roundtrip retains currencies quest inventory base workers settings", function() local p,c=fresh(); completed(c,"first_blood",100); Quests.claim(p,c,"first_blood",100); rich(c); Building.place(c,"generator",-24,0,0,100); local _,b=Building.place(c,"farm",0,0,0,100); c.Workers[1].job=b.uid; p.Settings.graphics="Low"; p.Coins=777; local loaded=assert(Profile.normalize(Util.copy(p))); local copy=loaded.Campaigns.coop; eq(loaded.Coins,777); eq(copy.XP,150); eq(Inventory.count(copy,"pistol"),1); eq(copy.Quests.first_blood.status,"RewardClaimed"); eq(#copy.Buildings,2); eq(copy.Workers[1].job,b.uid); eq(loaded.Settings.graphics,"Low"); eq(Quests.claim(loaded,copy,"first_blood",200),false) end)
test("normalized unique quest crates remain deduplicated", function() local p,c=fresh(); Quests.accept(c,"lost_supplies",100); Quests.record(c,"supply","market",1,100,"Supply1"); local loaded=Profile.normalize(p); local copy=loaded.Campaigns.coop; Quests.record(copy,"supply","market",1,100,"Supply1"); eq(copy.Quests.lost_supplies.progress[1],1) end)
test("pending craft survives profile roundtrip", function() local p,c=fresh(); rich(c); Building.place(c,"workshop",0,0,0,100); Economy.craft(c,"ammo",110); local loaded=Profile.normalize(p); assert(Economy.collectCraft(loaded.Campaigns.coop,200)); eq(Inventory.count(loaded.Campaigns.coop,"ammo"),16) end)

test("lease allows absent and expired sessions", function() assert(Lease.canAcquire(nil,"A",100)); assert(Lease.canAcquire({Lease={Token="B",Expires=99}},"A",100)) end)
test("lease denies another live server", function() eq(Lease.canAcquire({Lease={Token="B",Expires=180}},"A",100),false) end)
test("stale server cannot save after new lease", function() eq(Lease.owns({Lease={Token="B",Expires=250}},"A",200),false) end)
test("expired owner cannot save even with correct token", function() eq(Lease.owns({Lease={Token="A",Expires=100}},"A",100),false) end)
test("valid owner can save before expiration", function() assert(Lease.owns({Lease={Token="A",Expires=180}},"A",100)) end)
test("corrupt lease is fail-closed", function() eq(Lease.canAcquire("corrupt","A",100),false); eq(Lease.canAcquire({Lease="broken"},"A",100),false) end)
test("token bucket limits bursts and refills", function() local r=RateLimiter.new(3,2); for _=1,3 do assert(r:allow("A",0)) end; eq(r:allow("A",0),false); eq(r:allow("A",0.2),false); assert(r:allow("A",0.5)); eq(r:allow("A",0.5),false) end)
test("rate limiter isolates players and cleans departed entries", function() local r=RateLimiter.new(1,1); assert(r:allow("A",0)); assert(r:allow("B",0)); r:remove("A"); assert(r:allow("A",0)); eq(r:allow("B",0),false) end)
test("vertical slice transaction sequence: accept kill reward equip build power reload", function()
    local p,c=fresh(); assert(Quests.accept(c,"first_blood",100))
    for _=1,5 do Quests.record(c,"kill","walker",1,101) end
    assert(Quests.claim(p,c,"first_blood",102)); local pistol=find(c,"pistol"); assert(Inventory.equip(c,pistol.uid))
    local n=math.min(Weapons.pistol.magazine-pistol.ammo,Inventory.count(c,"ammo")); assert(Inventory.remove(c,"ammo",n)); pistol.ammo+=n
    eq(pistol.ammo,8); eq(Inventory.count(c,"ammo"),16)
    assert(Building.place(c,"wall",0,-20,0,103)); assert(Building.place(c,"generator",0,0,0,103))
    eq(Economy.tick(c,112,12).supply,12)
    local copy=assert(Profile.normalize(p)); eq(copy.Campaigns.coop.Equipped,pistol.uid); eq(find(copy.Campaigns.coop,"pistol").ammo,8); eq(copy.Coins,200)
end)
test("medical quest requires first blood and deduplicates three caches",function()
    local p,c=fresh(); eq(Quests.accept(c,"medical_run",100),false)
    completed(c,"first_blood",100); Quests.claim(p,c,"first_blood",100); assert(Quests.accept(c,"medical_run",100))
    for _=1,5 do Quests.record(c,"medical","pharmacy",1,100,"MedicalCache1") end
    eq(c.Quests.medical_run.progress[1],1)
    Quests.record(c,"medical","pharmacy",1,100,"MedicalCache2"); Quests.record(c,"medical","pharmacy",1,100,"MedicalCache3")
    assert(Quests.claim(p,c,"medical_run",100)); eq(p.Coins,500); eq(Inventory.count(c,"bandage"),4)
    eq(Quests.claim(p,c,"medical_run",100),false)
end)
test("radio quest needs both documents and survives save normalization",function()
    local p,c=fresh(); completed(c,"first_blood",100); Quests.claim(p,c,"first_blood",100); assert(Quests.accept(c,"radio_recovery",100))
    Quests.record(c,"intel","radio",1,100,"PoliceDispatch")
    local loaded=Profile.normalize(p); local copy=loaded.Campaigns.coop
    Quests.record(copy,"intel","radio",1,101,"PoliceDispatch"); eq(copy.Quests.radio_recovery.progress[1],1)
    Quests.record(copy,"intel","radio",1,102,"RadioMaintenance"); assert(Quests.claim(loaded,copy,"radio_recovery",102)); eq(Inventory.count(copy,"vest"),1)
end)
test("relief camp evidence is distinct persisted and rewarded once",function()
    local p,c=fresh(); completed(c,"first_blood",100); Quests.claim(p,c,"first_blood",100); assert(Quests.accept(c,"relief_recon",100))
    for _,uid in {"ReliefRoster","ReliefTransmitter","ReliefTags"} do
        Quests.record(c,"relief","camp",1,100,uid); Quests.record(c,"relief","camp",1,100,uid)
    end
    eq(c.Quests.relief_recon.progress[1],3); eq(c.Quests.relief_recon.status,"Completed")
    local before=p.Coins; assert(Quests.claim(p,c,"relief_recon",101)); eq(p.Coins,before+350); eq(Quests.claim(p,c,"relief_recon",101),false)
    local restored=assert(Profile.normalize(p)).Campaigns.coop; eq(restored.Quests.relief_recon.status,"RewardClaimed")
end)
test("bandage recipe consumes cloth and water and grants two usable bandages",function()
    local _,c=fresh(); rich(c); Building.place(c,"workshop",0,0,0,100); local cloth=c.Stockpile.cloth
    assert(Economy.craft(c,"bandage",110)); eq(c.Stockpile.cloth,cloth-2); eq(Economy.collectCraft(c,115),false)
    assert(Economy.collectCraft(c,116)); eq(Inventory.count(c,"bandage"),2); eq(Items.bandage.amount,25)
end)
