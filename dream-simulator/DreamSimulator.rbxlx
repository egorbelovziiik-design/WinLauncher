		lightRange = 56,
		lightColor = Color3.fromRGB(255, 150, 170),
		bonus = { sanityMul = 0.9 },
	},
	{
		id = "crown",
		name = "Корона кошмаров",
		description = "Корона из чёрного стекла. Кошмары признают своего.",
