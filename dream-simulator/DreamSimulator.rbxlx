    <Item class="ModuleScript" referent="298">
      <Properties>
        <string name="Name">MapService</string>
        <string name="Source"><![CDATA[--!nonstrict
-- MapService: клонирование карт снов, освещение, поиск маркеров.

local Lighting = game:GetService("Lighting")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))

local MapService = {}

-- Смещение мира снов относительно спальни меню.
MapService.DREAM_OFFSET = Vector3.new(0, 0, 4000)

local savedLighting = nil

local function ensure(className, name, parent)
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA(className) then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = parent
	return instance
end

function MapService.captureLighting()
	if savedLighting then
		return
	end
	savedLighting = {
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		FogColor = Lighting.FogColor,
		FogStart = Lighting.FogStart,
		FogEnd = Lighting.FogEnd,
		GlobalShadows = Lighting.GlobalShadows,
		ExposureCompensation = Lighting.ExposureCompensation,
		EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
	}
end

function MapService.applyLighting(dreamDef)
	MapService.captureLighting()
	Lighting.Ambient = dreamDef.ambient or Color3.fromRGB(40, 40, 55)
	Lighting.OutdoorAmbient = dreamDef.outdoorAmbient or Color3.fromRGB(20, 20, 34)
	Lighting.Brightness = dreamDef.brightness or 1
	Lighting.ClockTime = dreamDef.clockTime or 0.5
	Lighting.FogColor = dreamDef.fogColor or Color3.fromRGB(30, 34, 50)
	Lighting.FogStart = dreamDef.fogStart or 20
	Lighting.FogEnd = dreamDef.fogEnd or 300
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4

	local atmosphere = ensure("Atmosphere", "DreamAtmosphere", Lighting)
	local atmo = dreamDef.atmosphere or {}
	atmosphere.Density = atmo.density or 0.35
	atmosphere.Offset = atmo.offset or 0.1
	atmosphere.Color = atmo.color or Color3.fromRGB(120, 130, 160)
	atmosphere.Decay = atmo.decay or Color3.fromRGB(60, 70, 90)
	atmosphere.Glare = atmo.glare or 0.05
	atmosphere.Haze = atmo.haze or 1.5

	local bloom = ensure("BloomEffect", "DreamBloom", Lighting)
	local bloomDef = dreamDef.bloom or {}
	bloom.Enabled = true
	bloom.Intensity = bloomDef.intensity or 0.5
	bloom.Size = bloomDef.size or 24
	bloom.Threshold = bloomDef.threshold or 1.1

	local color = ensure("ColorCorrectionEffect", "DreamColor", Lighting)
	local cc = dreamDef.colorCorrection or {}
	color.Enabled = true
	color.TintColor = cc.tint or Color3.fromRGB(210, 215, 240)
	color.Saturation = cc.saturation or -0.1
	color.Contrast = cc.contrast or 0.15
	color.Brightness = cc.brightness or -0.03

	local dof = ensure("DepthOfFieldEffect", "DreamDOF", Lighting)
	local dofDef = dreamDef.depthOfField or {}
	dof.Enabled = true
	dof.FocusDistance = dofDef.focus or 40
	dof.NearIntensity = dofDef.near or 0.2
	dof.FarIntensity = dofDef.far or 0.4
	dof.InFocusRadius = 60
end

function MapService.resetLighting()
	if not savedLighting then
		return
	end
	for key, value in pairs(savedLighting) do
		pcall(function()
			Lighting[key] = value
		end)
	end
	for _, name in ipairs({ "DreamAtmosphere", "DreamBloom", "DreamColor", "DreamDOF" }) do
		local instance = Lighting:FindFirstChild(name)
		if instance then
			instance:Destroy()
		end
	end
end

-- Возвращает папку сессии с клоном карты.
function MapService.buildDream(dreamDef, parentFolder)
	local template = ServerStorage:FindFirstChild("DreamMaps")
	template = template and template:FindFirstChild(dreamDef.map)
	if not template then
		warn("[MapService] нет карты для сна: " .. tostring(dreamDef.map))
		return nil
	end
	local model = template:Clone()
	model.Name = "Dream_" .. dreamDef.map
	-- Сны строятся далеко от спальни меню, чтобы миры не пересекались.
	model:PivotTo(model:GetPivot() + MapService.DREAM_OFFSET)
	model.Parent = parentFolder

	-- Точка спавна
	local spawnPart = MapService.findMarker(model, "MK_Spawn")
	if spawnPart then
		model:SetAttribute("SpawnPosition", spawnPart.Position)
	end
	model:SetAttribute("DreamId", dreamDef.id)
	MapService.applyLighting(dreamDef)
	return model
end

function MapService.findMarker(model, name)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant.Name == name and descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

function MapService.collectMarkers(model, prefix)
	local out = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") and string.sub(descendant.Name, 1, #prefix) == prefix then
			table.insert(out, descendant)
		end
	end
	table.sort(out, function(a, b)
		return a.Name < b.Name
	end)
	return out
end

-- ------------------------------------------------------------------
-- Постановка объектов на реальную поверхность карты.
-- Это лечит «висящие в воздухе» маркеры и спавн монстров внутри стен.
-- ------------------------------------------------------------------

-- Возвращает точку на полу под позицией (или nil).
function MapService.groundAt(position)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = false
	local origin = position + Vector3.new(0, 90, 0)
	local result = workspace:Raycast(origin, Vector3.new(0, -260, 0), params)
	if result then
		return result.Position, result.Normal, result.Instance
	end
	return nil
end

-- Свободно ли место для существа ростом height и радиусом radius.
function MapService.isClear(position, radius, height, ignoreList)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList or {}
	params.MaxParts = 8
	-- Коробка начинается чуть выше пола, иначе «пол» считается препятствием.
	local parts = workspace:GetPartBoundsInBox(
		CFrame.new(position + Vector3.new(0, height * 0.5 + 0.6, 0)),
		Vector3.new(radius * 2, height, radius * 2),
		params
	)
	for _, part in ipairs(parts) do
		if part.CanCollide and part.Transparency < 0.95 then
			return false
		end
	end
	return true
end

-- Ищет безопасную точку рядом с желаемой: сначала сама точка, затем спираль.
function MapService.findFreeSpot(position, opts)
	opts = opts or {}
	local radius = opts.radius or 2.5
	local height = opts.height or 6
	local attempts = opts.attempts or 26
	local reach = opts.reach or 26
	local ignore = opts.ignore

	local ground = MapService.groundAt(position)
	local start = ground or position
	if MapService.isClear(start, radius, height, ignore) then
		return start + Vector3.new(0, 0.2, 0)
	end
	for step = 1, attempts do
		local angle = step * 2.399963 -- золотое сечение: равномерно по кругу
		local distance = reach * math.sqrt(step / attempts)
		local candidate = start + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local point = MapService.groundAt(candidate)
		if point and MapService.isClear(point, radius, height, ignore) then
			return point + Vector3.new(0, 0.2, 0)
		end
	end
	return nil
end

function MapService.spawnPosition(model, fallback)
	local marker = MapService.findMarker(model, "MK_Spawn")
	if marker then
		local spot = MapService.findFreeSpot(marker.Position, { radius = 3, height = 7, reach = 30 })
		if spot then
			return spot + Vector3.new(0, 3.6, 0)
		end
		return marker.Position + Vector3.new(0, 4, 0)
	end
	return fallback or Vector3.new(0, 8, 0)
end

-- Надёжная точка для NPC/предмета по маркеру.
function MapService.markerSpot(model, marker, opts)
	if not marker then
		return nil
	end
	local position = marker.Position
	if typeof(position) ~= "Vector3" then
		return nil
	end
	return MapService.findFreeSpot(position, opts)
end

function MapService.cleanup(folder)
	if folder and folder.Parent then
		folder:Destroy()
	end
	MapService.resetLighting()
end

function MapService.setFogIntensity(multiplier)
	Lighting.FogEnd = math.max(20, Lighting.FogEnd * multiplier)
end

return MapService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="299">
      <Properties>
        <string name="Name">DataManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- DataManager: профиль игрока, DataStore, автосохранение, валидация.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local ItemDefinitions = require(SharedModules:WaitForChild("ItemDefinitions"))
local AchievementDefinitions = require(SharedModules:WaitForChild("AchievementDefinitions"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))

local DataManager = {}

local store = nil
local profiles = {}
local saving = {}

local function defaultProfile()
	return {
		version = Config.ProfileVersion,
		coins = 0,
		owned = {},
		consumables = {},
		equipped = {},
		achievements = {},
		settings = Config.defaultSettings(),
		difficulty = "Normal",
		lastDream = nil,
		stats = {
			dreams = 0,
			wins = 0,
			losses = 0,
			quests = 0,
			coinsEarned = 0,
			playtime = 0,
			bestTime = 0,
			dreamsVisited = {},
		},
	}
end

local function clampNumber(value, fallback, minValue, maxValue)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	if value < minValue then
		return minValue
	end
	if value > maxValue then
		return maxValue
	end
	return value
end

local function validateSettings(raw)
	local settings = Config.defaultSettings()
	if type(raw) ~= "table" then
		return settings
	end
	settings.musicVolume = clampNumber(raw.musicVolume, settings.musicVolume, 0, 1)
	settings.sfxVolume = clampNumber(raw.sfxVolume, settings.sfxVolume, 0, 1)
	settings.sensitivity = clampNumber(raw.sensitivity, settings.sensitivity, 0, 1)
	settings.scareIntensity = clampNumber(raw.scareIntensity, settings.scareIntensity, 0, 2)
	if raw.hints ~= nil then
		settings.hints = raw.hints == true
	end
	if raw.cameraShake ~= nil then
		settings.cameraShake = raw.cameraShake == true
	end
	if raw.quality == "Низкое" or raw.quality == "Средний" or raw.quality == "Высокое" then
		settings.quality = raw.quality
	end
	return settings
end

-- Приводит любые данные (в том числе испорченные) к корректному профилю.
function DataManager.validate(raw)
	local profile = defaultProfile()
	if type(raw) ~= "table" then
		return profile
	end
	profile.coins = math.floor(clampNumber(raw.coins, 0, 0, 99999999))
	profile.difficulty = Config.Difficulties[raw.difficulty] and raw.difficulty or "Normal"
	profile.lastDream = type(raw.lastDream) == "string" and raw.lastDream or nil
	profile.settings = validateSettings(raw.settings)

	if type(raw.owned) == "table" then
		for itemId, value in pairs(raw.owned) do
			if value == true and ItemDefinitions.get(itemId) then
				profile.owned[itemId] = true
			end
		end
	end
	if type(raw.consumables) == "table" then
		for itemId, count in pairs(raw.consumables) do
			local item = ItemDefinitions.get(itemId)
			if item and item.stackable then
				profile.consumables[itemId] = math.floor(clampNumber(count, 0, 0, 999))
			end
		end
	end
	if type(raw.equipped) == "table" then
		for itemId, value in pairs(raw.equipped) do
			if value == true and profile.owned[itemId] then
				profile.equipped[itemId] = true
			end
		end
	end
	if type(raw.achievements) == "table" then
		for id, value in pairs(raw.achievements) do
			if value == true and AchievementDefinitions.get(id) then
				profile.achievements[id] = true
			end
		end
	end
	local stats = raw.stats
	if type(stats) == "table" then
		for _, key in ipairs({ "dreams", "wins", "losses", "quests", "coinsEarned" }) do
			profile.stats[key] = math.floor(clampNumber(stats[key], 0, 0, 99999999))
		end
		profile.stats.playtime = clampNumber(stats.playtime, 0, 0, 99999999)
		profile.stats.bestTime = clampNumber(stats.bestTime, 0, 0, 99999)
		if type(stats.dreamsVisited) == "table" then
			for dreamId, value in pairs(stats.dreamsVisited) do
				if value == true then
					profile.stats.dreamsVisited[dreamId] = true
				end
			end
		end
	end
	return profile
end

function DataManager.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		workspace:SetAttribute("DataStoreMode", "cloud")
	else
		workspace:SetAttribute("DataStoreMode", "memory")
		warn("[DataManager] DataStore недоступен, прогресс только в памяти: " .. tostring(result))
	end

	task.spawn(function()
		while true do
			task.wait(Config.SaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				DataManager.save(player)
			end
		end
	end)

	game:BindToClose(function()
		for _, player in ipairs(Players:GetPlayers()) do
			DataManager.save(player)
		end
		if not RunService:IsStudio() then
			task.wait(2)
		end
	end)
end

function DataManager.load(player)
	if profiles[player] then
		return profiles[player]
	end
	local raw = nil
	if store then
		local key = Config.DataStoreKey .. tostring(player.UserId)
		for attempt = 1, 4 do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				raw = result
				break
			end
			warn(("[DataManager] GetAsync fail (%d): %s"):format(attempt, tostring(result)))
			task.wait(attempt * 0.6)
		end
	end
	local profile = DataManager.validate(raw)
	profiles[player] = profile
	return profile
end

function DataManager.get(player)
	return profiles[player] or DataManager.load(player)
end

function DataManager.save(player)
	local profile = profiles[player]
	if not profile or saving[player] then
		return
	end
	saving[player] = true
	if store then
		local key = Config.DataStoreKey .. tostring(player.UserId)
		local ok, err = pcall(function()
			store:SetAsync(key, profile)
		end)
		if not ok then
			warn("[DataManager] сохранение не удалось: " .. tostring(err))
		end
	end
	saving[player] = false
end

function DataManager.remove(player)
	DataManager.save(player)
	profiles[player] = nil
	saving[player] = nil
end

function DataManager.pushProfile(player)
	local remote = Remotes.get("ProfileUpdated")
	if remote then
		remote:FireClient(player, DataManager.get(player))
	end
end

function DataManager.addCoins(player, amount)
	local profile = DataManager.get(player)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then
		return 0
	end
	profile.coins = math.min(profile.coins + amount, 99999999)
	profile.stats.coinsEarned = profile.stats.coinsEarned + amount
	DataManager.pushProfile(player)
	local AchievementManager = script.Parent:FindFirstChild("AchievementManager")
	if AchievementManager then
		local manager = require(AchievementManager)
		manager.check(player, "coins")
	end
	return amount
end

function DataManager.spendCoins(player, amount)
	local profile = DataManager.get(player)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 or profile.coins < amount then
		return false
	end
	profile.coins = profile.coins - amount
	DataManager.pushProfile(player)
	return true
end

function DataManager.updateStat(player, key, delta)
	local profile = DataManager.get(player)
	if type(profile.stats[key]) == "number" then
		profile.stats[key] = profile.stats[key] + (tonumber(delta) or 0)
	else
		profile.stats[key] = delta
	end
end

function DataManager.markDreamVisited(player, dreamId)
	local profile = DataManager.get(player)
	profile.stats.dreamsVisited[dreamId] = true
end

function DataManager.unlockAchievement(player, id)
	local profile = DataManager.get(player)
	local def = AchievementDefinitions.get(id)
	if not def or profile.achievements[id] then
		return false
	end
	profile.achievements[id] = true
	local remote = Remotes.get("AchievementUnlocked")
	if remote then
		remote:FireClient(player, {
			id = id,
			name = def.name,
			description = def.description,
			icon = def.icon,
			reward = def.reward,
		})
	end
	profile.coins = math.min(profile.coins + (def.reward or 0), 99999999)
	profile.stats.coinsEarned = profile.stats.coinsEarned + (def.reward or 0)
	DataManager.pushProfile(player)
	return true
end

return DataManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="300">
      <Properties>
        <string name="Name">EconomyManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- EconomyManager: магазин, инвентарь, настройки. Все проверки — на сервере.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local ItemDefinitions = require(SharedModules:WaitForChild("ItemDefinitions"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))

local DataManager = require(script.Parent:WaitForChild("DataManager"))

local EconomyManager = {}

local function sendResult(player, ok, message, itemId)
	local remote = Remotes.get("PurchaseResult")
	if remote then
		remote:FireClient(player, { ok = ok, message = message, itemId = itemId })
	end
end

local function sendEquipResult(player, ok, message, itemId)
	local remote = Remotes.get("EquipResult")
	if remote then
		remote:FireClient(player, { ok = ok, message = message, itemId = itemId })
	end
end

function EconomyManager.buyItem(player, itemId)
	if type(itemId) ~= "string" then
		return false
	end
	local item = ItemDefinitions.get(itemId)
	if not item then
		sendResult(player, false, "Такого предмета нет", itemId)
		return false
	end
	local profile = DataManager.get(player)

	if item.stackable then
		if (profile.consumables[itemId] or 0) >= 99 then
			sendResult(player, false, "Больше 99 штук не поместится", itemId)
			return false
		end
	elseif profile.owned[itemId] then
		sendResult(player, false, "Этот предмет уже куплен", itemId)
		return false
	end

	if profile.coins < item.price then
		sendResult(player, false, ("Не хватает монет: нужно %d"):format(item.price), itemId)
		return false
	end
	if not DataManager.spendCoins(player, item.price) then
		sendResult(player, false, "Покупка отклонена сервером", itemId)
		return false
	end

	if item.stackable then
		profile.consumables[itemId] = (profile.consumables[itemId] or 0) + 1
	else
		profile.owned[itemId] = true
		if item.slot == "flashlight" and not profile.owned.flashlight then
			profile.owned.flashlight = true
		end
	end

	DataManager.pushProfile(player)
	DataManager.save(player)
	sendResult(player, true, ("Куплено: %s"):format(item.name), itemId)

	local AchievementManager = script.Parent:FindFirstChild("AchievementManager")
	if AchievementManager then
		require(AchievementManager).check(player, "shop")
	end
	return true
end

function EconomyManager.equipItem(player, itemId)
	local item = ItemDefinitions.get(itemId)
	local profile = DataManager.get(player)
	if not item or item.stackable then
		sendEquipResult(player, false, "Этот предмет нельзя надеть", itemId)
		return false
	end
	if not (profile.owned[itemId] or (itemId == "flashlight" and profile.owned.flashlight)) then
		sendEquipResult(player, false, "Предмет не куплен", itemId)
		return false
	end
	if profile.equipped[itemId] then
		profile.equipped[itemId] = nil
		sendEquipResult(player, true, ("Снято: %s"):format(item.name), itemId)
	else
		-- один предмет на слот
		if item.slot then
			for otherId in pairs(profile.equipped) do
				local other = ItemDefinitions.get(otherId)
				if other and other.slot == item.slot then
					profile.equipped[otherId] = nil
				end
			end
		end
		profile.equipped[itemId] = true
		sendEquipResult(player, true, ("Надето: %s"):format(item.name), itemId)
	end
	DataManager.pushProfile(player)
	DataManager.save(player)
	EconomyManager.applyCosmetics(player)
	return true
end

function EconomyManager.unequipItem(player, slot)
	local profile = DataManager.get(player)
	for itemId in pairs(profile.equipped) do
		local item = ItemDefinitions.get(itemId)
		if item and item.slot == slot then
			profile.equipped[itemId] = nil
		end
	end
	DataManager.pushProfile(player)
	DataManager.save(player)
	EconomyManager.applyCosmetics(player)
	sendEquipResult(player, true, "Снято", nil)
	return true
end

-- Суммарные бонусы надетых предметов.
function EconomyManager.getBonuses(player)
	local profile = DataManager.get(player)
	local bonuses = {
		sanityMul = 1,
		timeBonus = 0,
		lightRange = 0,
		lightColor = nil,
		speedBonus = 0,
		scareMul = 1,
	}
	for itemId in pairs(profile.equipped) do
		local item = ItemDefinitions.get(itemId)
		if item then
			if item.lightRange then
				bonuses.lightRange = math.max(bonuses.lightRange, item.lightRange)
			end
			if item.lightColor then
				bonuses.lightColor = item.lightColor
			end
			local bonus = item.bonus or {}
			if bonus.sanityMul then
				bonuses.sanityMul = bonuses.sanityMul * bonus.sanityMul
			end
			if bonus.timeBonus then
				bonuses.timeBonus = bonuses.timeBonus + bonus.timeBonus
			end
			if bonus.speedBonus then
				bonuses.speedBonus = bonuses.speedBonus + bonus.speedBonus
			end
			if bonus.scareMul then
				bonuses.scareMul = math.min(bonuses.scareMul, bonus.scareMul)
			end
		end
	end
	if profile.owned.flashlight and bonuses.lightRange <= 0 then
		bonuses.lightRange = 30
	end
	return bonuses
end

function EconomyManager.applyCosmetics(player)
	local profile = DataManager.get(player)
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local oldTrail = root:FindFirstChild("DreamTrail")
	if oldTrail then
		oldTrail:Destroy()
	end
	if profile.equipped.trail then
		local attachment0 = Instance.new("Attachment")
		attachment0.Name = "TrailA0"
		attachment0.Position = Vector3.new(0, 1.4, 0)
		attachment0.Parent = root
		local attachment1 = Instance.new("Attachment")
		attachment1.Name = "TrailA1"
		attachment1.Position = Vector3.new(0, -1.4, 0)
		attachment1.Parent = root
		local trail = Instance.new("Trail")
		trail.Name = "DreamTrail"
		trail.Attachment0 = attachment0
		trail.Attachment1 = attachment1
		trail.Lifetime = 0.6
		trail.Color = ColorSequence.new(Color3.fromRGB(170, 180, 255))
		trail.Transparency = NumberSequence.new(0.2)
		trail.Parent = root
	end

	local oldWings = character:FindFirstChild("DreamWings")
	if oldWings then
		oldWings:Destroy()
	end
	if profile.equipped.wings then
		local wings = Instance.new("Model")
		wings.Name = "DreamWings"
		for side = -1, 1, 2 do
			for index = 1, 3 do
				local part = Instance.new("Part")
				part.Name = "Wing"
				part.Size = Vector3.new(0.2, 3 + index, 2.4)
				part.Color = Color3.fromRGB(70, 50, 110)
				part.Material = Enum.Material.Neon
				part.Transparency = 0.35
				part.CanCollide = false
				part.Massless = true
				part.Anchored = false
				part.CFrame = root.CFrame * CFrame.new(side * (1.2 + index * 0.5), 1.4, 0.4 - index * 0.3)
				part.Parent = wings
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
			end
		end
		wings.Parent = character
	end
end

function EconomyManager.useConsumable(player, itemId)
	local item = ItemDefinitions.get(itemId)
	local profile = DataManager.get(player)
	if not item or not item.stackable then
		sendEquipResult(player, false, "Это не расходник", itemId)
		return false
	end
	local count = profile.consumables[itemId] or 0
	if count <= 0 then
		sendEquipResult(player, false, "Расходник закончился", itemId)
		return false
	end
	local DreamManager = script.Parent:FindFirstChild("DreamManager")
	local applied = false
	if DreamManager then
		applied = require(DreamManager).applyConsumable(player, item)
	end
	if not applied then
		sendEquipResult(player, false, "Сейчас это нельзя использовать", itemId)
		return false
	end
	profile.consumables[itemId] = count - 1
	DataManager.pushProfile(player)
	DataManager.save(player)
	sendEquipResult(player, true, ("Использовано: %s"):format(item.name), itemId)
	return true
end

function EconomyManager.updateSettings(player, key, value)
	local profile = DataManager.get(player)
	if type(key) == "table" then
		for innerKey, innerValue in pairs(key) do
			EconomyManager.updateSettings(player, innerKey, innerValue)
		end
		return true
	end
	if type(key) ~= "string" then
		return false
	end
	local settings = profile.settings
	if key == "musicVolume" or key == "sfxVolume" or key == "sensitivity" or key == "scareIntensity" then
		value = tonumber(value)
		if value ~= value or value == math.huge then
			return false
		end
		local maxValue = (key == "scareIntensity") and 2 or 1
		settings[key] = math.clamp(value, 0, maxValue)
	elseif key == "hints" or key == "cameraShake" then
		settings[key] = value == true
	elseif key == "quality" then
		if value == "Низкое" or value == "Средний" or value == "Высокое" then
			settings.quality = value
		end
	else
		return false
	end
	DataManager.pushProfile(player)
	DataManager.save(player)
	return true
end

function EconomyManager.resetSettings(player)
	local profile = DataManager.get(player)
	profile.settings = Config.defaultSettings()
	DataManager.pushProfile(player)
	DataManager.save(player)
	return true
end

return EconomyManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="301">
      <Properties>
        <string name="Name">AchievementManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- AchievementManager: проверка условий достижений.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local DreamDefinitions = require(SharedModules:WaitForChild("DreamDefinitions"))

local DataManager = require(script.Parent:WaitForChild("DataManager"))

local AchievementManager = {}

local function unlock(player, id)
	DataManager.unlockAchievement(player, id)
end

-- cause: "coins" | "shop" | "dream" | "quest" | "end"
function AchievementManager.check(player, cause, context)
	local profile = DataManager.get(player)
	if not profile then
		return
	end
	local stats = profile.stats
	context = context or {}

	if stats.dreams >= 1 then
		unlock(player, "first_dream")
	end
	if stats.dreams >= 10 then
		unlock(player, "dreams_10")
	end
	if stats.dreams >= 25 then
		unlock(player, "dreams_25")
	end
	if stats.wins >= 5 then
		unlock(player, "wins_5")
	end
	if stats.wins >= 20 then
		unlock(player, "wins_20")
	end
	if stats.quests >= 10 then
		unlock(player, "quests_10")
	end
	if stats.quests >= 30 then
		unlock(player, "quests_30")
	end
	if stats.coinsEarned >= 1000 then
		unlock(player, "coins_1000")
	end
	if stats.coinsEarned >= 5000 then
		unlock(player, "coins_5000")
	end

	local ownedCount = 0
	for _ in pairs(profile.owned) do
		ownedCount += 1
	end
	if ownedCount >= 5 then
		unlock(player, "shop_5")
	end

	local allVisited = true
	for _, dream in ipairs(DreamDefinitions.List) do
		if not profile.stats.dreamsVisited[dream.id] then
			allVisited = false
			break
		end
	end
	if allVisited then
		unlock(player, "all_dreams")
	end

	if cause == "end" then
		if context.win then
			unlock(player, "first_win")
			if context.difficulty == "Extreme" then
				unlock(player, "extreme_win")
			end
			if context.survived and context.survived <= 300 then
				unlock(player, "speedrun")
			end
			if context.health and context.health <= 1 then
				unlock(player, "survivor")
			end
		else
			unlock(player, "death")
		end
	end
end

return AchievementManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="302">
      <Properties>
        <string name="Name">QuestManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- QuestManager: задания, объекты, прогресс, портал пробуждения.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local QuestDefinitions = require(SharedModules:WaitForChild("QuestDefinitions"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))
local Util = require(SharedModules:WaitForChild("Util"))

local MapService = require(script.Parent:WaitForChild("MapService"))
local DataManager = require(script.Parent:WaitForChild("DataManager"))

local QuestManager = {}

local function newPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.Neon
	for key, value in pairs(props) do
		part[key] = value
	end
	return part
end

local function makeBillboard(part, text, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(210, 44)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 70
	gui.Adornee = part
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(235, 235, 255)
	label.TextStrokeTransparency = 0.4
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	return gui
end

local function objectiveText(quest)
	if quest.kind == "collect" then
		return "Найти: " .. (quest.label or quest.title)
	elseif quest.kind == "interact" then
		return "Активировать: " .. (quest.label or quest.title)
	elseif quest.kind == "lights" then
		return "Включить: " .. (quest.label or "свет")
	elseif quest.kind == "talk" then
		return "Поговорить с NPC"
	elseif quest.kind == "reach" then
		return "Добраться до цели"
	elseif quest.kind == "survive" then
		return "Продержаться"
	end
	return quest.title
end

function QuestManager.startSession(session)
	session.quests = {}
	session.questStates = {}
	local dreamDef = session.dream
	local mandatoryDef, optionalDefs = QuestDefinitions.forDream(dreamDef.id, dreamDef)

	local function makeState(def, optional, state, giver)
		local questState = {
			def = def,
			optional = optional,
			state = state or "active",
			progress = {},
			done = false,
			spawned = false,
			target = nil,
			giver = giver,
		}
		table.insert(session.quests, questState)
		session.questStates[def.id] = questState
		return questState
	end

	if mandatoryDef then
		session.mandatoryQuest = makeState(mandatoryDef, false, "active", nil)
	else
		session.mandatoryQuest = nil
	end

	local rng = session.rng or Random.new()
	local pool = {}
	for _, def in ipairs(optionalDefs) do
		table.insert(pool, def)
	end
	Util.shuffle(pool, rng)
	local take = math.min(3, #pool)
	local npcNames = {}
	for _, npc in ipairs(dreamDef.npcs or {}) do
		table.insert(npcNames, npc.name)
	end
	for index = 1, take do
		local giver = npcNames[((index - 1) % math.max(1, #npcNames)) + 1] or "Странник"
		makeState(pool[index], true, "offered", giver)
	end

	session.portalOpen = false
	session.questsDone = 0
	session.coinsEarned = 0

	QuestManager.spawnPortal(session)
	QuestManager.spawnObjectsForActive(session)
	QuestManager.spawnBatteryPickups(session)
	QuestManager.sendUpdate(session)
end

function QuestManager.ensureObjectsFolder(session)
	if session.objects and session.objects.Parent then
		return session.objects
	end
	local objects = Instance.new("Folder")
	objects.Name = "QuestObjects"
	objects.Parent = session.container
	session.objects = objects
	return objects
end

function QuestManager.spawnObjectsForActive(session)
	local objects = QuestManager.ensureObjectsFolder(session)
	local model = session.mapModel
	local rng = session.rng or Random.new()
	local itemMarkers = MapService.collectMarkers(model, "MK_Item")
	local interactMarkers = MapService.collectMarkers(model, "MK_Interact")
	local lampMarkers = MapService.collectMarkers(model, "MK_Lamp")
	local reachMarkers = MapService.collectMarkers(model, "MK_Reach")

	session.markerCursor = session.markerCursor or { item = 1, interact = 1, lamp = 1, reach = 1 }

	local function nextMarker(markers, key)
		if #markers == 0 then
			return nil
		end
		local cursor = session.markerCursor[key]
		local marker = markers[((cursor - 1) % #markers) + 1]
		session.markerCursor[key] = cursor + 1
		return marker
	end

	for _, questState in ipairs(session.quests) do
		if questState.state == "active" and not questState.spawned then
			questState.spawned = true
			local def = questState.def

			if def.kind == "collect" then
				for i = 1, def.need do
					local marker = nextMarker(itemMarkers, "item")
					local basePosition = (marker and marker.Position or Vector3.new(i * 8, 3, 0))
						+ Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
					local position = MapService.findFreeSpot(basePosition, { radius = 2, height = 4, reach = 16 })
						or (basePosition + Vector3.new(0, 3, 0))
					local part = newPart({
						Name = "Collectible",
						Size = Vector3.new(1.7, 1.7, 1.7),
						Shape = Enum.PartType.Ball,
						Position = position,
						Color = Color3.fromRGB(150, 210, 255),
						Transparency = 0.1,
					})
					part:SetAttribute("InteractKind", "collect")
					part:SetAttribute("QuestId", def.id)
					part:SetAttribute("QuestLabel", def.label or def.title)
					part:SetAttribute("Prompt", "Подобрать: " .. (def.label or def.title))
					part.Parent = objects
					CollectionService:AddTag(part, "Interactable")
					makeBillboard(part, def.label or def.title, Color3.fromRGB(180, 230, 255))
					local light = Instance.new("PointLight")
					light.Color = Color3.fromRGB(150, 210, 255)
					light.Brightness = 1.6
					light.Range = 14
					light.Parent = part
					if not questState.target then
						questState.target = position
					end
				end
			elseif def.kind == "interact" or def.kind == "lights" then
				local markers = def.kind == "lights" and lampMarkers or interactMarkers
				local key = def.kind == "lights" and "lamp" or "interact"
				for i = 1, def.need do
					local marker = nextMarker(markers, key)
					local rawPosition = marker and marker.Position or Vector3.new(i * 12, 3, 0)
					local isLamp = def.kind == "lights"
					local position = MapService.findFreeSpot(rawPosition, { radius = 2.4, height = isLamp and 6 or 4, reach = 16 })
						or rawPosition
					local part = newPart({
						Name = isLamp and "Lamp" or "QuestObject",
						Size = isLamp and Vector3.new(1.6, 4.2, 1.6) or Vector3.new(3.2, 3.2, 3.2),
						Position = position + Vector3.new(0, isLamp and 3 or 2.2, 0),
						Color = isLamp and Color3.fromRGB(70, 72, 84) or Color3.fromRGB(120, 100, 200),
						Material = Enum.Material.Metal,
						Transparency = 0,
					})
					part:SetAttribute("InteractKind", isLamp and "lamp" or "object")
					part:SetAttribute("QuestId", def.id)
					part:SetAttribute("QuestLabel", def.label or def.title)
					part:SetAttribute("Prompt", (isLamp and "Включить: " or "Активировать: ") .. (def.label or def.title))
					part.Parent = objects
					CollectionService:AddTag(part, "Interactable")
					makeBillboard(part, def.label or def.title, isLamp and Color3.fromRGB(255, 240, 170) or Color3.fromRGB(200, 190, 255))

					if isLamp then
						local bulb = Instance.new("PointLight")
						bulb.Name = "Bulb"
						bulb.Color = Color3.fromRGB(255, 235, 180)
						bulb.Brightness = 0
						bulb.Range = 46
						bulb.Shadows = true
						bulb.Enabled = false
						bulb.Parent = part
					else
						local strip = newPart({
							Name = "Strip",
							Size = Vector3.new(3.4, 0.3, 3.4),
							Position = part.Position + Vector3.new(0, 1.7, 0),
							Color = Color3.fromRGB(200, 120, 255),
							Transparency = 0.1,
						})
						strip.Parent = part
					end
					if not questState.target then
						questState.target = part.Position
					end
				end
			elseif def.kind == "reach" then
				local marker = nextMarker(reachMarkers, "reach")
				local rawPosition = marker and marker.Position or Vector3.new(60, 3, 60)
				local position = MapService.findFreeSpot(rawPosition, { radius = 4, height = 6, reach = 22 }) or rawPosition
				local zone = newPart({
					Name = "ReachZone",
					Size = Vector3.new(16, 12, 16),
					Position = position + Vector3.new(0, 4, 0),
					Color = Color3.fromRGB(120, 220, 255),
					Transparency = 0.82,
					Material = Enum.Material.ForceField,
				})
				zone:SetAttribute("InteractKind", "zone")
				zone:SetAttribute("QuestId", def.id)
				zone:SetAttribute("QuestLabel", def.title)
				zone:SetAttribute("Prompt", "Зона: " .. def.title)
				zone.Parent = objects
				CollectionService:AddTag(zone, "Interactable")
				makeBillboard(zone, def.title, Color3.fromRGB(160, 225, 255))
				questState.zonePart = zone
				questState.target = position
			elseif def.kind == "talk" then
				-- цель — ближайший NPC, прогресс идёт через диалог
				local npcs = MapService.collectMarkers(model, "MK_NPC")
				if #npcs > 0 then
					questState.target = npcs[1].Position
				end
			end
		end
	end
end

-- Батарейки, разбросанные по сну: без них фонарик «умирает» за пару минут.
function QuestManager.spawnBatteryPickups(session)
	if session.batteriesSpawned then
		return
	end
	session.batteriesSpawned = true
	local objects = QuestManager.ensureObjectsFolder(session)
	local markers = MapService.collectMarkers(session.mapModel, "MK_Item")
	if #markers == 0 then
		return
	end
	local rng = session.rng or Random.new()
	local count = math.min(5, #markers)
	local step = math.max(1, math.floor(#markers / count))
	for index = 1, count do
		local marker = markers[((index - 1) * step) + 1] or markers[index] or markers[1]
		local rawPosition = marker.Position + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		local position = MapService.findFreeSpot(rawPosition, { radius = 2, height = 4, reach = 14 })
			or (rawPosition + Vector3.new(0, 2.2, 0))
		-- Ставим на пол, а не наполовину в нём.
		position = position + Vector3.new(0, 1.1, 0)
		local pack = newPart({
			Name = "BatteryPack",
			Size = Vector3.new(1.1, 2, 0.7),
			Position = position,
			Color = Color3.fromRGB(120, 255, 190),
			Material = Enum.Material.Neon,
			Transparency = 0.05,
		})
		local cap = newPart({
			Name = "Cap",
			Size = Vector3.new(0.5, 0.35, 0.5),
			Position = position + Vector3.new(0, 1.15, 0),
			Color = Color3.fromRGB(230, 230, 240),
			Material = Enum.Material.Metal,
		})
		cap.Parent = pack
		pack:SetAttribute("InteractKind", "battery")
		pack:SetAttribute("Prompt", "🔋 Подобрать батарейку")
		pack:SetAttribute("BatteryAmount", math.floor(rng:NextNumber(35, 55)))
		pack.Parent = objects
		CollectionService:AddTag(pack, "Interactable")
		makeBillboard(pack, "🔋 Батарейка", Color3.fromRGB(150, 255, 200))
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(140, 255, 200)
		light.Brightness = 1.4
		light.Range = 12
		light.Parent = pack
	end
end

function QuestManager.spawnPortal(session)
	if session.portal and session.portal.Parent then
		return
	end
	local model = session.mapModel
	local marker = MapService.findMarker(model, "MK_Portal")
	local rawPosition = marker and marker.Position or Vector3.new(0, 6, 0)
	local position = MapService.findFreeSpot(rawPosition, { radius = 5, height = 6, reach = 26 }) or rawPosition

	local portal = Instance.new("Model")
	portal.Name = "ExitPortal"
	portal.Parent = session.container

	local ring = newPart({
		Name = "PortalRing",
		Size = Vector3.new(14, 14, 1),
		Position = position + Vector3.new(0, 7, 0),
		Color = Color3.fromRGB(150, 110, 255),
		Material = Enum.Material.Neon,
		Transparency = 1,
	})
	ring.Parent = portal

	local center = newPart({
		Name = "PortalCore",
		Size = Vector3.new(12, 12, 0.4),
		Position = ring.Position,
		Color = Color3.fromRGB(60, 40, 120),
		Transparency = 1,
	})
	center.Parent = portal

	local trigger = newPart({
		Name = "PortalTrigger",
		Size = Vector3.new(10, 12, 4),
		Position = ring.Position,
		Transparency = 1,
	})
	trigger:SetAttribute("InteractKind", "portal")
	trigger:SetAttribute("Prompt", "Войти в портал пробуждения")
	trigger.Parent = portal
	CollectionService:AddTag(trigger, "Interactable")

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(150, 110, 255)
	light.Brightness = 0
	light.Range = 40
	light.Parent = ring

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.Size = NumberSequence.new(0.45)
	emitter.Color = ColorSequence.new(Color3.fromRGB(170, 140, 255))
	emitter.Parent = ring

	portal.PrimaryPart = ring
	session.portal = portal
	session.portalPosition = ring.Position
	session.portalRing = ring
	session.portalLight = light
	session.portalEmitter = emitter
	session.portalTrigger = trigger
end

function QuestManager.sendUpdate(session)
	local payload = { quests = {}, mandatoryLeft = 0 }
	for _, questState in ipairs(session.quests) do
		local def = questState.def
		local current = 0
		if def.kind == "talk" then
			current = questState.progress.talk or 0
		elseif def.kind == "reach" then
			current = questState.reached and 1 or 0
		else
			current = math.floor(questState.progress.total or 0)
		end
		if questState.state == "active" and current > def.need then
			current = def.need
		end
		local objectives = {
			{
				text = objectiveText(def),
				current = current,
				goal = def.need,
				done = questState.state == "done" or current >= def.need,
			},
		}
		table.insert(payload.quests, {
			id = def.id,
			title = def.title,
			desc = def.desc,
			state = questState.state == "done" and "done" or questState.state,
			mandatory = not questState.optional,
			optional = questState.optional,
			giver = questState.giver,
			reward = def.reward,
			target = questState.target,
			objectives = objectives,
		})
		if not questState.optional and questState.state ~= "done" then
			payload.mandatoryLeft += 1
		end
	end
	local remote = Remotes.get("QuestUpdate")
	if remote then
		remote:FireClient(session.player, payload)
	end
end

function QuestManager.acceptQuest(session, questId)
	local questState = session.questStates and session.questStates[questId]
	if not questState or questState.state ~= "offered" then
		return false
	end
	questState.state = "active"
	QuestManager.spawnObjectsForActive(session)
	QuestManager.sendUpdate(session)
	local remote = Remotes.get("Toast")
	if remote then
		remote:FireClient(session.player, {
			text = ("Взято задание: %s"):format(questState.def.title),
			color = Config.Colors.accent,
			icon = "📜",
		})
	end
	return true
end

local function completeQuest(session, questState)
	questState.state = "done"
	questState.done = true
	session.coinsEarned = (session.coinsEarned or 0) + questState.def.reward
	session.questsDone = (session.questsDone or 0) + 1
	local player = session.player
	DataManager.updateStat(player, "quests", 1)
	local remote = Remotes.get("QuestCompleted")
	if remote then
		remote:FireClient(player, {
			title = questState.def.title,
			reward = questState.def.reward,
			mandatory = not questState.optional,
		})
	end
	local AchievementManager = script.Parent:FindFirstChild("AchievementManager")
	if AchievementManager then
		require(AchievementManager).check(player, "quest")
	end
	DataManager.save(player)
	if not questState.optional then
		QuestManager.openPortal(session)
	end
end

function QuestManager.addProgress(session, questState, amount)
	local def = questState.def
	if def.kind == "survive" then
		questState.progress.total = (questState.progress.total or 0) + amount
	else
		questState.progress.total = (questState.progress.total or 0) + amount
	end
	if (questState.progress.total or 0) >= def.need and questState.state == "active" then
		completeQuest(session, questState)
	end
	QuestManager.sendUpdate(session)
end

-- label: имя NPC / метка объекта (nil = любой)
function QuestManager.progress(session, kind, label, amount)
	if not session or session.ended then
		return
	end
	for _, questState in ipairs(session.quests) do
		local def = questState.def
		if questState.state == "active" and def.kind == kind then
			local matches = true
			if label and def.label then
				matches = (def.label == label)
			end
			if matches then
				if kind == "talk" then
					if label and questState.progress[label] then
						-- уже поговорили
					else
						if label then
							questState.progress[label] = true
						end
						QuestManager.addProgress(session, questState, amount or 1)
					end
				else
					QuestManager.addProgress(session, questState, amount or 1)
				end
			end
		end
	end
end

function QuestManager.tick(session, dt)
	if not session or session.ended then
		return
	end
	local character = session.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local changed = false
	for _, questState in ipairs(session.quests) do
		local def = questState.def
		if questState.state == "active" then
			if def.kind == "survive" then
				questState.progress.total = (questState.progress.total or 0) + dt
				if (questState.progress.total or 0) >= def.need then
					completeQuest(session, questState)
					changed = true
				end
			elseif def.kind == "reach" and questState.zonePart and root and not questState.reached then
				local distance = (root.Position - questState.zonePart.Position).Magnitude
				if distance <= 11 then
					questState.reached = true
					completeQuest(session, questState)
					changed = true
				end
			end
		end
	end
	if changed then
		QuestManager.sendUpdate(session)
	end
end

function QuestManager.openPortal(session)
	if session.portalOpen or not session.portal then
		return
	end
	session.portalOpen = true
	local ring = session.portalRing
	local center = session.portalRing and session.portalRing.Parent:FindFirstChild("PortalCore")
	if ring then
		TweenService:Create(ring, TweenInfo.new(1.2), { Transparency = 0.1 }):Play()
	end
	if center then
		TweenService:Create(center, TweenInfo.new(1.2), { Transparency = 0.3 }):Play()
	end
	if session.portalLight then
		session.portalLight.Brightness = 4
	end
	if session.portalEmitter then
		session.portalEmitter.Rate = 30
	end
	local remote = Remotes.get("PortalOpened")
	if remote then
		remote:FireClient(session.player, { position = session.portalPosition })
	end
	local hint = Remotes.get("Hint")
	if hint then
		hint:FireClient(session.player, "🌀 Портал пробуждения открыт — иди на фиолетовый свет!")
	end
end

function QuestManager.cleanup(session)
	if session.objects then
		for _, child in ipairs(session.objects:GetDescendants()) do
			if child:IsA("BasePart") then
				CollectionService:RemoveTag(child, "Interactable")
			end
		end
	end
	if session.portal then
		for _, child in ipairs(session.portal:GetDescendants()) do
			if child:IsA("BasePart") then
				CollectionService:RemoveTag(child, "Interactable")
			end
		end
	end
	session.quests = {}
	session.questStates = {}
end

return QuestManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="303">
      <Properties>
        <string name="Name">NPCManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- NPCManager: NPC во сне, диалоги и выдача заданий.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Remotes = require(SharedModules:WaitForChild("Remotes"))
local QuestDefinitions = require(SharedModules:WaitForChild("QuestDefinitions"))

local Config = require(SharedModules:WaitForChild("Config"))
local MapService = require(script.Parent:WaitForChild("MapService"))
local QuestManager = require(script.Parent:WaitForChild("QuestManager"))
local DataManager = require(script.Parent:WaitForChild("DataManager"))

local NPCManager = {}

local NpcToast

local function labelPart(part, text)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(230, 50)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 80
	gui.Adornee = part
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(235, 230, 255)
	label.TextStrokeTransparency = 0.35
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
end

function NPCManager.spawnNPCs(session)
	session.npcs = {}
	local templates = ServerStorage:FindFirstChild("NPCTemplates")
	local template = templates and templates:FindFirstChild("NPC")
	if not template then
		warn("[NPCManager] нет шаблона NPC")
		return
	end
	local markers = MapService.collectMarkers(session.mapModel, "MK_NPC")
	local definitions = session.dream.npcs or {}
	for index, marker in ipairs(markers) do
		local definition = definitions[((index - 1) % math.max(1, #definitions)) + 1]
		if not definition then
			break
		end
		local model = template:Clone()
		model.Name = "NPC_" .. index
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and string.sub(part.Name, 1, 3) ~= "Eye" and part.Name ~= "Root" and part.Name ~= "Head" then
				part.Color = definition.color or Color3.fromRGB(180, 180, 200)
			end
		end
		local root = model.PrimaryPart or model:FindFirstChild("Root")
		if not root then
			model:Destroy()
			continue
		end
		local spot = MapService.findFreeSpot(marker.Position, { radius = 2.4, height = 7, reach = 18 })
		if not spot then
			spot = marker.Position
		end
		model:PivotTo(CFrame.new(spot + Vector3.new(0, 3.2, 0)))
		model.Parent = session.container
		labelPart(root, "❗ " .. definition.name)

		local talkPart = model:FindFirstChild("TalkPoint", true)
		if not talkPart then
			talkPart = Instance.new("Part")
			talkPart.Name = "TalkPoint"
			talkPart.Size = Vector3.new(4.5, 6, 4.5)
			talkPart.Transparency = 1
			talkPart.Anchored = true
			talkPart.CanCollide = false
			talkPart.CanQuery = false
			talkPart.CanTouch = false
			talkPart.CFrame = CFrame.new(root.Position)
			talkPart.Parent = model
		end
		talkPart:SetAttribute("InteractKind", "npc")
		talkPart:SetAttribute("NPCIndex", index)
		talkPart:SetAttribute("Prompt", "Поговорить: " .. definition.name)
		CollectionService:AddTag(talkPart, "Interactable")

		session.npcs[index] = { model = model, definition = definition, talkPart = talkPart }
	end
end

local function questForNPC(session, npcName)
	local fallback = nil
	for _, questState in ipairs(session.quests or {}) do
		if questState.state == "offered" and (questState.giver == npcName or not questState.giver) then
			return questState
		end
		if questState.state == "active" and not fallback then
			fallback = questState
		end
	end
	return fallback
end

local function vitals(session)
	local character = session.player and session.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local remote = Remotes.get("VitalsUpdate")
	if remote then
		remote:FireClient(session.player, {
			health = humanoid and humanoid.Health or 0,
			maxHealth = humanoid and humanoid.MaxHealth or Config.MaxHealth,
			sanity = session.sanity,
			maxSanity = Config.MaxSanity,
			stamina = session.stamina,
			maxStamina = Config.MaxStamina,
			sprinting = session.sprinting,
			flashlight = session.flashlight,
		})
	end
end

local HEAL_PRICE = 120
local BATTERY_PRICE = 55
local CALM_PRICE = 0
local ITEM_PRICE = 80

function NPCManager.openDialog(session, part)
	if session.ended then
		return
	end
	local index = part:GetAttribute("NPCIndex")
	local npc = session.npcs and session.npcs[index]
	local definition = npc and npc.definition
	if not definition then
		return
	end
	if npc then
		npc.talks = (npc.talks or 0) + 1
		npc.lastTalk = os.clock()
	end

	local questState = questForNPC(session, definition.name)
	local options = {}
	local lines = { definition.line or "..." }

	-- Приветствие зависит от числа разговоров
	if npc and npc.talks and npc.talks > 1 then
		table.insert(lines, "«Ты снова здесь? Сон не любит, когда его замечают.»")
	end

	if questState and questState.state == "offered" then
		table.insert(lines, "«Мне нужна помощь: " .. questState.def.title .. ". " .. questState.def.desc .. "»")
		table.insert(options, { text = "📜 Взять задание", action = "accept_quest:" .. questState.def.id })
	elseif questState and questState.state == "active" then
		table.insert(lines, "«" .. questState.def.desc .. "»")
		table.insert(options, { text = "💡 Подсказка", action = "hint:" .. questState.def.id })
	elseif questState and questState.state == "done" then
		table.insert(lines, "«Ты справился. Сон запомнит это.»")
		if not questState.thanked then
			table.insert(options, { text = "🎁 Поблагодарить", action = "thank:" .. questState.def.id })
		end
	end

	-- Услуги: лечение и успокоение
	local coins = DataManager.get(session.player).coins
	local character = session.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hurt = humanoid and humanoid.Health < humanoid.MaxHealth - 1
	if hurt or (session.sanity or 100) < Config.MaxSanity - 1 then
		table.insert(options, {
			text = ("🩹 Перевязать раны (%d 🪙)"):format(HEAL_PRICE),
			action = "heal",
		})
		table.insert(options, { text = "🧘 Успокоиться (бесплатно)", action = "calm" })
	end

	-- Обмен: NPC отдаёт зелье рассудка
	local stock = npc and npc.stock
	if stock == nil then
		stock = 1
		if npc then
			npc.stock = stock
		end
	end
	if stock > 0 then
		table.insert(options, { text = ("🧪 Купить зелье рассудка (%d 🪙)"):format(ITEM_PRICE), action = "trade" })
	end
	local batteryStock = npc and npc.batteryStock
	if batteryStock == nil then
		batteryStock = 2
		if npc then
			npc.batteryStock = batteryStock
		end
	end
	local battery = (session.battery or 0)
	if batteryStock > 0 and battery < 99 then
		table.insert(options, { text = ("🔋 Попросить батарейку (%d 🪙)"):format(BATTERY_PRICE), action = "battery" })
	end

	table.insert(options, { text = "🕯 Что здесь случилось?", action = "lore" })
	table.insert(options, { text = "🚪 Уйти", action = "close" })

	session.dialog = { npcIndex = index, questId = questState and questState.def.id, coins = coins }

	local remote = Remotes.get("DialogOpen")
	if remote then
		remote:FireClient(session.player, {
			npcName = definition.name,
			text = table.concat(lines, "\n\n"),
			kind = "npc",
			options = options,
		})
	end

	-- Разговор засчитывается заданию «поговорить с NPC»
	QuestManager.progress(session, "talk", definition.name, 1)
end

function NPCManager.handleChoice(session, action)
	if not session then
		return
	end
	local close = Remotes.get("DialogClosed")
	if close then
		close:FireClient(session.player)
	end
	if type(action) ~= "string" then
		return
	end

	if string.sub(action, 1, 12) == "accept_quest" then
		local questId = string.match(action, "accept_quest:(.+)")
		if questId and QuestManager.acceptQuest(session, questId) then
			NpcToast(session, "Задание взято: " .. questId)
		end
	elseif string.sub(action, 1, 4) == "hint" then
		local questId = string.match(action, "hint:(.+)")
		local quest = questId and QuestDefinitions.get(questId)
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(session.player, quest and ("«" .. quest.title .. "»: " .. quest.desc) or (session.dream.hint or "Слушай тишину — она подскажет."))
		end
	elseif action == "lore" then
		local messages = session.dream.messages or {}
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(session.player, #messages > 0 and messages[math.random(1, #messages)] or (session.dream.hint or "Слушай тишину — она подскажет."))
		end
	elseif action == "heal" then
		local character = session.player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		if session.sanity >= Config.MaxSanity - 1 and humanoid.Health >= humanoid.MaxHealth - 1 then
			NpcToast(session, "Тебе не нужна помощь")
			return
		end
		if not DataManager.spendCoins(session.player, HEAL_PRICE) then
			NpcToast(session, "Не хватает монет: нужно " .. HEAL_PRICE)
			return
		end
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 45)
		session.sanity = math.min(Config.MaxSanity, (session.sanity or 100) + 35)
		vitals(session)
		NpcToast(session, "NPC перевязал раны: +45 ❤ и +35 🧠")
	elseif action == "calm" then
		session.sanity = math.min(Config.MaxSanity, (session.sanity or 100) + 18)
		session.stamina = math.min(Config.MaxStamina, (session.stamina or 100) + 20)
		vitals(session)
		NpcToast(session, "Ты дышишь ровнее: +18 🧠 и +20 ⚡")
	elseif action == "trade" then
		local index = session.dialog and session.dialog.npcIndex
		local npc = index and session.npcs and session.npcs[index]
		if npc and (npc.stock or 0) <= 0 then
			NpcToast(session, "У NPC больше нет зелий")
			return
		end
		if not DataManager.spendCoins(session.player, ITEM_PRICE) then
			NpcToast(session, "Не хватает монет: нужно " .. ITEM_PRICE)
			return
		end
		if npc then
			npc.stock = math.max(0, (npc.stock or 1) - 1)
		end
		local profile = DataManager.get(session.player)
		profile.consumables.sanity_potion = (profile.consumables.sanity_potion or 0) + 1
		DataManager.pushProfile(session.player)
		NpcToast(session, "Получено зелье рассудка (используй в инвентаре или кнопкой)")
	elseif action == "battery" then
		local index = session.dialog and session.dialog.npcIndex
		local npc = index and session.npcs and session.npcs[index]
		if npc and (npc.batteryStock or 0) <= 0 then
			NpcToast(session, "У NPC закончились батарейки")
			return
		end
		if not DataManager.spendCoins(session.player, BATTERY_PRICE) then
			NpcToast(session, "Не хватает монет: нужно " .. BATTERY_PRICE)
			return
		end
		if npc then
			npc.batteryStock = math.max(0, (npc.batteryStock or 2) - 1)
		end
		session.battery = math.min(100, (session.battery or 0) + 80)
		vitals(session)
		NpcToast(session, "Батарейка вставлена: заряд фонарика " .. tostring(math.floor(session.battery)) .. "%")
	elseif string.sub(action, 1, 5) == "thank" then
		local questId = string.match(action, "thank:(.+)")
		local questState = questId and session.questStates and session.questStates[questId]
		if questState and not questState.thanked then
			questState.thanked = true
			DataManager.addCoins(session.player, 25)
			session.coinsEarned = (session.coinsEarned or 0) + 25
			NpcToast(session, "NPC отблагодарил тебя: +25 🪙")
		end
	end
end

NpcToast = function(session, text)
	local remote = Remotes.get("Toast")
	if remote and session.player then
		remote:FireClient(session.player, { text = text, color = Color3.fromRGB(160, 200, 255), icon = "📜" })
	end
end

function NPCManager.cleanup(session)
	for _, npc in pairs(session.npcs or {}) do
		if npc.model and npc.model.Parent then
			npc.model:Destroy()
		end
	end
	session.npcs = {}
end

return NPCManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="304">
      <Properties>
        <string name="Name">MonsterManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- MonsterManager: спавн и ИИ монстров. Полностью переписан:
-- монстры всегда ставятся на пол, не спавнятся рядом с игроком,
-- не застревают в геометрии и не «залипают» друг в друге.

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local MonsterDefinitions = require(SharedModules:WaitForChild("MonsterDefinitions"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))

local MapService = require(script.Parent:WaitForChild("MapService"))

local MonsterManager = {}

local TEMPLATE_BY_BEHAVIOR = {
	stalker = "Stalker",
	chaser = "Chaser",
	watcher = "Watcher",
	mimic = "Mimic",
	hunter = "Hunter",
}

local ATTACK_COOLDOWN = 2.4

local function getTemplate(behavior)
	local templates = ServerStorage:FindFirstChild("MonsterTemplates")
	local name = TEMPLATE_BY_BEHAVIOR[behavior] or "Stalker"
	return templates and templates:FindFirstChild(name)
end

local function playerRoot(session)
	local character = session.player and session.player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return root, humanoid
end

local function tintModel(model, color, eyeColor, transparency)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			if part:GetAttribute("Eye") or string.sub(part.Name, 1, 3) == "Eye" then
				part:SetAttribute("Eye", true)
				part.Color = eyeColor
				part.Material = Enum.Material.Neon
				part.Transparency = 0
			else
				part.Color = color
				if transparency and transparency > 0 then
					part.Transparency = transparency
				end
			end
		elseif part:IsA("PointLight") then
			part.Color = eyeColor
		elseif part:IsA("ParticleEmitter") then
			part.Color = ColorSequence.new(eyeColor)
		end
	end
end

-- Ставит модель на землю: нижняя грань ровно на поверхности.
local function snapModelToGround(model, groundPosition)
	local extents = model:GetExtentsSize()
	local pivot = model:GetPivot()
	model:PivotTo(CFrame.new(Vector3.new(groundPosition.X, groundPosition.Y + extents.Y * 0.5 + 0.1, groundPosition.Z)))
	local box = model:GetBoundingBox()
	local bottom = box.Position.Y - box.Size.Y * 0.5
	local root = model.PrimaryPart or model:FindFirstChild("Root", true)
	local rootOffset = root and (root.Position.Y - bottom) or extents.Y * 0.5
	return rootOffset
end

-- Монстр ставится на реальный пол карты.
local function placeMonster(model, position, ignoreList)
	local spot = MapService.findFreeSpot(position, {
		radius = 2.6,
		height = 7,
		reach = 30,
		ignore = ignoreList,
	})
	if not spot then
		return nil
	end
	return snapModelToGround(model, spot)
end

function MonsterManager.spawnMonster(session, monsterId, position)
	if session.ended then
		return nil
	end
	local def = MonsterDefinitions.get(monsterId)
	if not def then
		return nil
	end
	local template = getTemplate(def.behavior)
	if not template then
		warn("[MonsterManager] нет шаблона для поведения " .. tostring(def.behavior))
		return nil
	end

	local model = template:Clone()
	model.Name = "Monster_" .. tostring(def.id) .. "_" .. tostring(#session.monsters + 1)
	tintModel(model, def.color or Color3.fromRGB(20, 20, 30), def.eyeColor or Color3.fromRGB(255, 50, 60), def.transparency)
	if (def.scale or 1) ~= 1 then
		pcall(function()
			model:ScaleTo(def.scale)
		end)
	end

	local root = model.PrimaryPart or model:FindFirstChild("Root", true)
	if not root then
		model:Destroy()
		return nil
	end

	-- Модель ещё не в Workspace: проверяем настоящую геометрию карты.
	local rootOffset = placeMonster(model, position, nil)
	if not rootOffset then
		model:Destroy()
		return nil
	end
	model.Parent = session.container

	local monster = {
		id = def.id,
		def = def,
		model = model,
		root = root,
		home = root.Position,
		state = "patrol",
		waypoints = {},
		waypointIndex = 1,
		lastRepath = 0,
		lastSeen = 0,
		attackCooldown = 1 + math.random(),
		announced = false,
		patrolIndex = math.random(1, 4),
		lastPosition = root.Position,
		rootOffset = rootOffset,
		stuckTime = 0,
		teleports = 0,
		chasing = false,
		visible = false,
	}

	table.insert(session.monsters, monster)
	CollectionService:AddTag(model, "Monster")
	return monster
end

local function patrolPoints(session)
	if session.patrolGround and #session.patrolGround > 0 then
		return session.patrolGround
	end
	local out = {}
	for _, marker in ipairs(MapService.collectMarkers(session.mapModel, "MK_Patrol")) do
		local spot = MapService.findFreeSpot(marker.Position, { radius = 2.5, height = 6, reach = 14 })
		if spot then
			table.insert(out, spot)
		end
	end
	session.patrolGround = out
	return out
end

local function spawnPoints(session)
	local out = {}
	for _, marker in ipairs(MapService.collectMarkers(session.mapModel, "MK_Monster")) do
		local spot = MapService.findFreeSpot(marker.Position, { radius = 3, height = 7, reach = 20 })
		if spot then
			table.insert(out, spot)
		end
	end
	for _, point in ipairs(patrolPoints(session)) do
		table.insert(out, point)
	end
	if #out == 0 then
		local origin = session.mapModel:GetAttribute("SpawnPosition") or Vector3.new(0, 6, 0)
		for _, offset in ipairs({ Vector3.new(40, 0, 40), Vector3.new(-40, 0, 40), Vector3.new(0, 0, 55) }) do
			local spot = MapService.findFreeSpot(origin + offset, { radius = 3, height = 7, reach = 30 })
			if spot then
				table.insert(out, spot)
			end
		end
	end
	return out
end

-- Точка спавна не ближе minDistance и не дальше maxDistance от игрока.
local function pickSpawnPoint(session, points, minDistance, maxDistance)
	local root = playerRoot(session)
	local playerPosition = root and root.Position or nil
	local candidates = {}
	for _, point in ipairs(points) do
		local distance = playerPosition and (point - playerPosition).Magnitude or math.huge
		if distance >= minDistance and distance <= maxDistance then
			table.insert(candidates, point)
		end
	end
	if #candidates == 0 then
		for _, point in ipairs(points) do
			local distance = playerPosition and (point - playerPosition).Magnitude or math.huge
			if distance >= minDistance then
				table.insert(candidates, point)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[math.random(1, #candidates)]
end

function MonsterManager.start(session)
	session.monsters = {}
	session.started = true
	local types = session.dream.monsters or { "shadow" }
	local count = session.difficulty.monsterCount or 3
	local points = spawnPoints(session)
	if #points == 0 then
		warn("[MonsterManager] на карте нет точек спавна монстров: " .. tostring(session.dream.id))
	end

	-- Монстры выходят постепенно: первый — через 12 секунд сна.
	for index = 1, count do
		task.delay(12 + (index - 1) * 6, function()
			if session.ended or not session.monsters then
				return
			end
			if #session.monsters >= count then
				return
			end
			local point = pickSpawnPoint(session, points, 55, 160) or pickSpawnPoint(session, points, 35, 400)
			if not point then
				return
			end
			local monsterId = types[math.random(1, #types)]
			local monster = MonsterManager.spawnMonster(session, monsterId, point)
			if monster then
				local alert = Remotes.get("MonsterAlert")
				if alert then
					alert:FireClient(session.player, { name = monster.def.name })
				end
				local scare = Remotes.get("Scare")
				if scare then
					scare:FireClient(session.player, { kind = "growl", monsterName = monster.def.name, intensity = 0.7 })
				end
			end
		end)
	end

	MonsterManager.runLoop(session)
end

-- ---------------------------------------------------------------
-- Движение
-- ---------------------------------------------------------------

local function raycastDown(position, ignoreModel)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ignoreModel }
	params.IgnoreWater = true
	local hit = workspace:Raycast(position + Vector3.new(0, 16, 0), Vector3.new(0, -60, 0), params)
	if hit then
		return hit.Position
	end
	return nil
end

local function repath(session, monster, goal)
	local root = monster.root
	if not root or not root.Parent then
		return
	end
	local path = PathfindingService:CreatePath({
		AgentRadius = 2.4,
		AgentHeight = 6.5,
		AgentCanJump = true,
		AgentJumpHeight = 8,
		AgentMaxSlope = 45,
		WaypointSpacing = 7,
	})
	local ok = pcall(function()
		path:ComputeAsync(root.Position, goal)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		monster.waypoints = path:GetWaypoints()
		monster.waypointIndex = 2
	else
		monster.waypoints = { { Position = goal, Action = Enum.PathWaypointAction.Walk } }
		monster.waypointIndex = 1
	end
	monster.lastRepath = os.clock()
end

local function moveToward(monster, dt, targetPosition, speed)
	local root = monster.root
	local position = root.Position
	local delta = targetPosition - position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	local distance = flat.Magnitude
	if distance < 0.4 then
		return true
	end
	local step = math.min(speed * dt, distance)
	local nextPosition = position + flat.Unit * step

	local ground = raycastDown(nextPosition, monster.model)
	if ground then
		nextPosition = Vector3.new(nextPosition.X, ground.Y + (monster.rootOffset or 3.2), nextPosition.Z)
	elseif delta.Y > 2 then
		nextPosition = Vector3.new(nextPosition.X, position.Y + math.min(step, delta.Y), nextPosition.Z)
	end

	local lookTarget = nextPosition + flat.Unit * 4
	pcall(function()
		monster.model:PivotTo(CFrame.lookAt(nextPosition, lookTarget))
	end)
	return distance <= step + 0.5
end

-- Аварийное спасение застрявшего монстра: ставим рядом с игроком, но вне поля зрения.
local function rescue(session, monster, root)
	if monster.teleports >= 4 then
		return
	end
	local target = root and root.Position or monster.home
	local angle = math.random() * math.pi * 2
	local distance = 45 + math.random() * 25
	local candidate = target + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
	local spot = MapService.findFreeSpot(candidate, {
		radius = 2.6,
		height = 7,
		reach = 40,
		ignore = { monster.model },
	})
	if spot then
		monster.teleports += 1
		monster.rootOffset = snapModelToGround(monster.model, spot)
		monster.waypoints = {}
		monster.lastRepath = 0
		monster.stuckTime = 0
		monster.lastPosition = spot
	end
end

-- ---------------------------------------------------------------
-- Атака
-- ---------------------------------------------------------------

function MonsterManager.damagePlayer(session, monster)
	local root, humanoid = playerRoot(session)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local difficulty = session.difficulty
	local bonuses = session.bonuses or {}
	local damage = (monster.def.damage or 15) * (difficulty.monsterDamage or 1)
	humanoid:TakeDamage(damage)
	session.sanity = math.max(0, (session.sanity or 100) - (monster.def.sanityDrain or 5) * 0.8)
	session.lastAttacker = monster.def.name

	local scare = Remotes.get("Scare")
	if scare then
		scare:FireClient(session.player, {
			kind = monster.def.boss and "boss" or "jumpscare",
			monsterName = monster.def.name,
			intensity = (monster.def.boss and 1.4 or 1) * math.clamp(difficulty.monsterDamage or 1, 0.5, 1.6) * (bonuses.scareMul or 1),
		})
	end
end

-- ---------------------------------------------------------------
-- Основной цикл
-- ---------------------------------------------------------------

local function updateMonster(session, monster, dt)
	local root = monster.root
	if not monster.model.Parent or not root then
		return
	end
	local now = os.clock()
	monster.attackCooldown = math.max(0, monster.attackCooldown - dt)
	local def = monster.def

	local targetRoot = playerRoot(session)
	if not targetRoot then
		return
	end
	local targetPosition = targetRoot.Position
	local monsterPosition = root.Position

	-- Упал за пределы карты / слишком далеко — возвращаем
	if monsterPosition.Y < -60 or (monsterPosition - session.mapModel:GetPivot().Position).Magnitude > 1200 then
		rescue(session, monster, targetRoot)
		return
	end

	local flat = Vector3.new(targetPosition.X - monsterPosition.X, 0, targetPosition.Z - monsterPosition.Z)
	local distance = flat.Magnitude

	-- Свет фонарика выдаёт игрока: монстры замечают дальше
	local lightBonus = session.flashlight and 1.45 or 1
	local detectRange = (def.detectRange or 70) * lightBonus

	-- Линия видимости
	local visible = false
	if distance <= detectRange then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { monster.model, session.container:FindFirstChild("QuestObjects") }
		params.IgnoreWater = true
		local eye = monsterPosition + Vector3.new(0, 4.5, 0)
		local target = targetPosition + Vector3.new(0, 1.5, 0)
		local hit = workspace:Raycast(eye, target - eye, params)
		visible = hit == nil
	end
	monster.visible = visible
	if visible then
		monster.lastSeen = now
		if session.flashlight and distance < detectRange * 0.75 then
			monster.lastSeen = now
		end
	end

	local noise = (session.sprinting and 1.4 or 1) * (session.flashlight and 1.2 or 1)
	local heard = distance <= 26 * noise
	local chasing = visible or (now - monster.lastSeen < 4) or (heard and distance < 34)

	-- Наблюдатель: замирает, пока на него смотрят
	if def.behavior == "watcher" then
		local look = session.lookVector
		local watched = false
		if look and distance > 0.5 then
			local direction = Vector3.new(flat.X, 0, flat.Z).Unit
			local lookFlat = Vector3.new(look.X, 0, look.Z)
			if lookFlat.Magnitude > 0.1 then
				watched = lookFlat.Unit:Dot(direction) > 0.6
			end
		end
		if visible and watched then
			chasing = false
			session.sanity = math.max(0, session.sanity - 1.4 * dt)
		end
	end

	monster.chasing = chasing

	if chasing then
		if now - monster.lastRepath > 1.6 then
			repath(session, monster, targetPosition)
		end
		local waypoint = monster.waypoints[monster.waypointIndex]
		local goal = waypoint and waypoint.Position or targetPosition
		if moveToward(monster, dt, goal, (def.speed or 14) * (session.difficulty.monsterSpeed or 1) * 1.08) then
			monster.waypointIndex += 1
			if monster.waypointIndex > #monster.waypoints then
				monster.waypoints = {}
			end
		end
	else
		local points = patrolPoints(session)
		local goal = monster.home
		if #points > 0 then
			local point = points[((monster.patrolIndex - 1) % #points) + 1]
			if (monsterPosition - point).Magnitude < 10 then
				monster.patrolIndex += 1
				point = points[((monster.patrolIndex - 1) % #points) + 1]
			end
			goal = point
		end
		if now - monster.lastRepath > 4 then
			repath(session, monster, goal)
		end
		local waypoint = monster.waypoints[monster.waypointIndex]
		if waypoint then
			if moveToward(monster, dt, waypoint.Position, (def.speed or 12) * 0.45) then
				monster.waypointIndex += 1
			end
		else
			moveToward(monster, dt, goal, (def.speed or 12) * 0.45)
		end
	end

	-- Атака: только если монстр видит игрока (или вплотную) и прошёл общий кулдаун.
	local nowClock = os.clock()
	local canAttack = distance <= (def.attackRange or 6) + 1
		and monster.attackCooldown <= 0
		and (visible or distance < 4)
		and (session.lastHitAt == nil or nowClock - session.lastHitAt > 1.1)
	if canAttack then
		monster.attackCooldown = ATTACK_COOLDOWN
		session.lastHitAt = nowClock
		MonsterManager.damagePlayer(session, monster)
	end

	-- Первая встреча: предупреждение
	if not monster.announced and visible and distance < 45 then
		monster.announced = true
		local alert = Remotes.get("MonsterAlert")
		if alert then
			alert:FireClient(session.player, { name = def.name })
		end
	end

	-- Обнаружение застревания
	if chasing then
		local moved = (root.Position - monster.lastPosition).Magnitude
		if moved < 0.35 then
			monster.stuckTime += dt
		else
			monster.stuckTime = math.max(0, monster.stuckTime - dt)
			monster.lastPosition = root.Position
		end
		if monster.stuckTime > 1.6 then
			monster.stuckTime = 0
			-- Точку берём ДО очистки маршрута, иначе ветка «поправить на полу»
			-- не выполнялась никогда и монстр всегда телепортировался.
			local waypoint = monster.waypoints[monster.waypointIndex]
			monster.waypoints = {}
			monster.lastRepath = 0
			if waypoint and math.random() < 0.5 then
				local ground = raycastDown(waypoint.Position, monster.model) or waypoint.Position
				monster.rootOffset = snapModelToGround(monster.model, ground)
			else
				rescue(session, monster, targetRoot)
			end
		end
	end
end

function MonsterManager.runLoop(session)
	task.spawn(function()
		local heartbeat = 0
		while session.started and not session.ended and session.player.Parent do
			local dt = task.wait(0.1) or 0.1
			local monsters = session.monsters or {}
			for index = #monsters, 1, -1 do
				local monster = monsters[index]
				if not monster or not monster.model or not monster.model.Parent then
					table.remove(monsters, index)
				else
					local ok, err = pcall(updateMonster, session, monster, dt)
					if not ok then
						warn("[MonsterManager] ошибка ИИ: " .. tostring(err))
					end
				end
			end
			heartbeat += dt
			if heartbeat > 8 then
				heartbeat = 0
				local root = playerRoot(session)
				if root and #monsters > 0 then
					local nearest = math.huge
					for _, monster in ipairs(monsters) do
						nearest = math.min(nearest, (monster.root.Position - root.Position).Magnitude)
					end
					if nearest > 260 then
						-- Игрок ушёл далеко: подтягиваем одного монстра поближе.
						local monster = monsters[math.random(1, #monsters)]
						rescue(session, monster, root)
					end
				end
			end
		end
	end)
end

function MonsterManager.spawnBoss(session)
	if session.bossSpawned or session.ended then
		return
	end
	session.bossSpawned = true
	local bossId = session.dream.boss or "nightmare"
	local root = playerRoot(session)
	local basePosition = root and root.Position or (session.mapModel:GetAttribute("SpawnPosition") or Vector3.new(0, 6, 0))
	local angle = math.random() * math.pi * 2
	local monster = MonsterManager.spawnMonster(session, bossId, basePosition + Vector3.new(math.cos(angle) * 70, 0, math.sin(angle) * 70))
	if monster then
		monster.home = monster.root.Position
		local alert = Remotes.get("MonsterAlert")
		if alert then
			alert:FireClient(session.player, { name = monster.def.name })
		end
		local scare = Remotes.get("Scare")
		if scare then
			scare:FireClient(session.player, { kind = "boss", monsterName = monster.def.name, intensity = 1.3 })
		end
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(session.player, "🩸 Кошмар проснулся. Не смотри ему в глаза — беги.")
		end
	end
end

function MonsterManager.stop(session)
	session.started = false
	for _, monster in ipairs(session.monsters or {}) do
		if monster.model and monster.model.Parent then
			monster.model:Destroy()
		end
	end
	session.monsters = {}
end

function MonsterManager.getNearest(session, position)
	local nearest = nil
	local best = math.huge
	for _, monster in ipairs(session.monsters or {}) do
		if monster.model and monster.model.Parent and monster.root then
			local distance = (monster.root.Position - position).Magnitude
			if distance < best then
				best = distance
				nearest = monster
			end
		end
	end
	return nearest, best
end

function MonsterManager.update() end

return MonsterManager
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="305">
      <Properties>
        <string name="Name">DreamManager</string>
        <string name="Source"><![CDATA[--!nonstrict
-- DreamManager: полный цикл сна (меню → сон → кошмар → пробуждение).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local DreamDefinitions = require(SharedModules:WaitForChild("DreamDefinitions"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))
local Util = require(SharedModules:WaitForChild("Util"))

local DataManager = require(script.Parent:WaitForChild("DataManager"))
local MapService = require(script.Parent:WaitForChild("MapService"))
local QuestManager = require(script.Parent:WaitForChild("QuestManager"))
local MonsterManager = require(script.Parent:WaitForChild("MonsterManager"))
local NPCManager = require(script.Parent:WaitForChild("NPCManager"))

local DreamManager = {}

local sessions = {}
local states = {}
local stateSince = {}

local EVENTS = {
	{ id = "rain", title = "ДОЖДЬ", description = "Вода стекает по стенам сна.", icon = "🌧", duration = 12 },
	{ id = "fog_boost", title = "ТУМАН", description = "Мир теряет очертания.", icon = "🌫", duration = 14, sanity = 2 },
	{ id = "red_moon", title = "КРОВАВАЯ ЛУНА", description = "Свет стал красным.", icon = "🌕", duration = 12 },
	{ id = "whispers", title = "ШЁПОТ", description = "Голоса повторяют твоё имя.", icon = "🗣", duration = 8, sanity = 6 },
	{ id = "scary_sound", title = "КРИК", description = "Крик раздался внутри головы.", icon = "📢", duration = 5, sanity = 5 },
	{ id = "footsteps", title = "ШАГИ", description = "Кто-то идёт за тобой.", icon = "👣", duration = 8, sanity = 3 },
	{ id = "flicker", title = "МЕРЦАНИЕ", description = "Свет боится тебя.", icon = "💡", duration = 10, sanity = 2 },
	{ id = "lights_out", title = "ТЕМНОТА", description = "Свет погас.", icon = "🕶", duration = 12, sanity = 4 },
	{ id = "sanity_aura", title = "ДАВЛЕНИЕ", description = "Сон сжимает виски.", icon = "🌀", duration = 10, sanity = 5 },
	{ id = "monster_rush", title = "РЫВОК", description = "Что-то пронеслось рядом.", icon = "💨", duration = 6, spawn = true },
	{ id = "monster_wave", title = "ВОЛНА", description = "Их стало больше.", icon = "🌊", duration = 6, spawn = true },
	{ id = "cold", title = "ХОЛОД", description = "Пальцы не слушаются.", icon = "❄️", duration = 8, stamina = 30 },
	{ id = "clock", title = "УКРАДЕННОЕ ВРЕМЯ", description = "Часы сделали шаг назад.", icon = "⏰", duration = 6, time = 12 },
	{ id = "darkness_pulse", title = "ПУЛЬС", description = "Тьма дышит в такт с тобой.", icon = "🖤", duration = 10, sanity = 4 },
	{ id = "scream_wave", title = "ХОР", description = "Сотни голосов смеются.", icon = "😱", duration = 7, sanity = 7 },
	{ id = "calm", title = "ЗАТИШЬЕ", description = "На миг стало спокойно.", icon = "🕯", duration = 12, sanity = -6 },
}

local function setState(player, state)
	states[player] = state
	stateSince[player] = os.clock()
	local remote = Remotes.get("DreamStateChanged")
	if remote then
		remote:FireClient(player, { state = state })
	end
end

function DreamManager.getState(player)
	return states[player] or "menu"
end

function DreamManager.getSession(player)
	return sessions[player]
end

function DreamManager.isBusy(player)
	local state = states[player]
	return state == "sleeping" or state == "dream"
end

local function getHumanoid(player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function DreamManager.menuSpawn()
	local bedroom = Workspace:FindFirstChild("MenuBedroom")
	if bedroom then
		local marker = MapService.findMarker(bedroom, "MenuSpawn")
		if marker then
			return marker.Position + Vector3.new(0, 4, 0)
		end
	end
	return Vector3.new(0, 6, 0)
end

function DreamManager.teleportToMenu(player)
	local character = player.Character
	if not character then
		return
	end
	character:PivotTo(CFrame.new(DreamManager.menuSpawn()))
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = Config.BaseWalkSpeed
		humanoid.JumpPower = Config.JumpPower
		humanoid.UseJumpPower = true
		humanoid.Health = humanoid.MaxHealth
	end
	character:SetAttribute("InDream", false)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		backpack:ClearAllChildren()
	end
end

function DreamManager.preparePlayer(player)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.MaxHealth = Config.MaxHealth
		humanoid.Health = Config.MaxHealth
		humanoid.WalkSpeed = Config.BaseWalkSpeed
		humanoid.JumpPower = Config.JumpPower
		humanoid.UseJumpPower = true
	end
	-- Во время сна персонажа нельзя выбрасывать в лобби: игрок может
	-- возродиться по кнопке Reset, и сон должен продолжиться на месте.
	if DreamManager.getState(player) ~= "dream" then
		DreamManager.teleportToMenu(player)
	end

	local EconomyManager = script.Parent:FindFirstChild("EconomyManager")
	if EconomyManager then
		require(EconomyManager).applyCosmetics(player)
	end
end

local function newSession(player, dreamDef, difficulty, bonuses)
	local container = Instance.new("Folder")
	container.Name = ("Dream_%s_%d"):format(player.Name, os.time())
	container.Parent = Workspace:FindFirstChild("ActiveDreams") or Workspace

	local session = {
		player = player,
		dream = dreamDef,
		difficulty = difficulty,
		bonuses = bonuses or {},
		container = container,
		rng = Random.new(),
		monsters = {},
		npcs = {},
		quests = {},
		questStates = {},
		sanity = Config.MaxSanity,
		stamina = Config.MaxStamina,
		timeLeft = difficulty.time + (bonuses and bonuses.timeBonus or 0),
		totalTime = difficulty.time + (bonuses and bonuses.timeBonus or 0),
		elapsed = 0,
		ended = false,
		sprinting = false,
		flashlight = false,
		battery = 100,
		flashlightTier = "basic",
		flashlightNotifiedEmpty = false,
		promptIds = {},
		promptParts = {},
		promptSerial = 0,
		lookVector = nil,
		coinsEarned = 0,
		questsDone = 0,
		bonusXp = 0,
	}

	-- Освещение зависит от экипированного предмета (фонарик/лампа).
	local profile = DataManager.get(player)
	local equipped = profile and profile.equipped or {}
	if equipped.lantern then
		session.flashlightTier = "lantern"
	elseif equipped.flashlight then
		session.flashlightTier = "flashlight"
	else
		session.flashlightTier = "basic"
	end

	session.mapModel = MapService.buildDream(dreamDef, container)
	if not session.mapModel then
		container:Destroy()
		return nil
	end
	session.patrolPoints = MapService.collectMarkers(session.mapModel, "MK_Patrol")
	return session
end

function DreamManager.startDream(player, difficultyKey, dreamId)
	if DreamManager.isBusy(player) then
		return false, "Сон уже идёт"
	end
	-- Повторный сон с экрана результата: убираем прошлую сессию.
	local previous = sessions[player]
	if previous then
		sessions[player] = nil
		MonsterManager.stop(previous)
		NPCManager.cleanup(previous)
		QuestManager.cleanup(previous)
		if previous.container and previous.container.Parent then
			previous.container:Destroy()
		end
	end
	if type(difficultyKey) ~= "string" or not Config.Difficulties[difficultyKey] then
		difficultyKey = "Normal"
	end
	local difficulty = Config.getDifficulty(difficultyKey)
	local profile = DataManager.get(player)
	profile.difficulty = difficultyKey

	local chosenId = dreamId
	if type(chosenId) ~= "string" or not DreamDefinitions.ById[chosenId] then
		chosenId = DreamDefinitions.random(profile.lastDream)
	end
	local dreamDef = DreamDefinitions.get(chosenId)

	local EconomyManager = script.Parent:FindFirstChild("EconomyManager")
	local bonuses = EconomyManager and require(EconomyManager).getBonuses(player) or {}

	setState(player, "sleeping")
	local humanoid = getHumanoid(player)
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.Health = humanoid.MaxHealth
	end

	local sleepRemote = Remotes.get("SleepSequence")
	if sleepRemote then
		sleepRemote:FireClient(player, {
			dreamName = dreamDef.name or dreamDef.title,
			dreamId = dreamDef.id,
			subtitle = dreamDef.subtitle,
			icon = dreamDef.icon,
			desc = dreamDef.desc,
			difficultyName = difficulty.name,
			difficulty = difficultyKey,
			duration = Config.SleepDuration,
		})
	end

	task.wait(Config.SleepDuration)

	if not player.Parent then
		setState(player, "menu")
		return false, "Игрок вышел"
	end

	local session = newSession(player, dreamDef, difficulty, bonuses)
	if not session then
		setState(player, "menu")
		return false, "Не удалось построить сон"
	end
	sessions[player] = session

	profile.lastDream = dreamDef.id
	DataManager.markDreamVisited(player, dreamDef.id)
	DataManager.updateStat(player, "dreams", 1)

	local spawnPosition = MapService.spawnPosition(session.mapModel, Vector3.new(0, 8, 0))
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(spawnPosition))
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = hum.MaxHealth
			hum.WalkSpeed = Config.BaseWalkSpeed + (bonuses.speedBonus or 0)
			hum.JumpPower = Config.JumpPower
		end
		character:SetAttribute("InDream", true)
	end

	QuestManager.startSession(session)
	NPCManager.spawnNPCs(session)
	MonsterManager.start(session)
	setState(player, "dream")

	local AchievementManager = script.Parent:FindFirstChild("AchievementManager")
	if AchievementManager then
		require(AchievementManager).check(player, "dream")
	end

	local startedRemote = Remotes.get("DreamStarted")
	if startedRemote then
		startedRemote:FireClient(player, {
			dreamId = dreamDef.id,
			dreamName = dreamDef.name or dreamDef.title,
			subtitle = dreamDef.subtitle,
			icon = dreamDef.icon,
			difficulty = difficultyKey,
			difficultyName = difficulty.name,
			duration = session.totalTime,
			bonuses = bonuses,
			settings = profile.settings,
			flashlightTier = session.flashlightTier,
			battery = session.battery,
		})
	end

	-- Первые подсказки сна
	task.delay(4, function()
		if session.ended then
			return
		end
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(player, "🔦 F — фонарик. Он освещает путь, но батарея садится и монстры видят свет.")
		end
	end)
	task.delay(13, function()
		if session.ended then
			return
		end
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(player, "💬 NPC (E) даёт задания, лечение и батарейки. Батарейки также лежат по сну — ищи зелёное свечение.")
		end
	end)

	local timerRemote = Remotes.get("TimerUpdate")
	if timerRemote then
		timerRemote:FireClient(player, { remaining = session.timeLeft, total = session.totalTime })
	end
	DreamManager.sendVitals(session)
	DreamManager.startLoop(session)
	return true
end

function DreamManager.sendVitals(session)
	local character = session.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local remote = Remotes.get("VitalsUpdate")
	if remote then
		remote:FireClient(session.player, {
			health = humanoid and humanoid.Health or 0,
			maxHealth = humanoid and humanoid.MaxHealth or Config.MaxHealth,
			sanity = session.sanity,
			maxSanity = Config.MaxSanity,
			stamina = session.stamina,
			maxStamina = Config.MaxStamina,
			sprinting = session.sprinting,
			flashlight = session.flashlight,
			battery = session.battery,
			batteryMax = 100,
			flashlightTier = session.flashlightTier,
		})
	end
end

function DreamManager.startLoop(session)
	local player = session.player
	local difficulty = session.difficulty
	local lastSecond = math.floor(session.timeLeft)
	local lastEvent = 0
	local eventInterval = difficulty.eventInterval or 30
	local vitalsTimer = 0
	local promptTimer = 0
	local lastPromptPart = nil

	task.spawn(function()
		while not session.ended and player.Parent do
			local dt = task.wait(0.1) or 0.1
			if session.ended then
				break
			end
			session.elapsed += dt

			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")

			-- Таймер
			session.timeLeft = math.max(0, session.timeLeft - dt)
			local currentSecond = math.floor(session.timeLeft)
			if currentSecond ~= lastSecond then
				lastSecond = currentSecond
				-- Первые подсказки сна
	task.delay(4, function()
		if session.ended then
			return
		end
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(player, "🔦 F — фонарик. Он освещает путь, но батарея садится и монстры видят свет.")
		end
	end)
	task.delay(13, function()
		if session.ended then
			return
		end
		local hint = Remotes.get("Hint")
		if hint then
			hint:FireClient(player, "💬 NPC (E) даёт задания, лечение и батарейки. Батарейки также лежат по сну — ищи зелёное свечение.")
		end
	end)

	local timerRemote = Remotes.get("TimerUpdate")
				if timerRemote then
					timerRemote:FireClient(player, { remaining = session.timeLeft, total = session.totalTime })
				end
			end

			-- Выносливость и скорость
			if session.sprinting and session.stamina > 0 then
				session.stamina = math.max(0, session.stamina - Config.SprintDrain * dt)
				if humanoid then
					humanoid.WalkSpeed = Config.SprintSpeed + (session.bonuses.speedBonus or 0)
				end
				if session.stamina <= 0 then
					session.sprinting = false
				end
			else
				session.stamina = math.min(Config.MaxStamina, session.stamina + Config.StaminaRegen * dt)
				if humanoid then
					humanoid.WalkSpeed = Config.BaseWalkSpeed + (session.bonuses.speedBonus or 0)
				end
			end

			-- Фонарик: батарея садится, когда он включён (яркий фонарь ест больше)
			if session.flashlight then
				local drain = session.flashlightTier == "lantern" and 0.78
					or (session.flashlightTier == "flashlight" and 0.55 or 0.38)
				session.battery = math.max(0, session.battery - drain * dt)
				if session.battery <= 0 then
					session.flashlight = false
					local toast = Remotes.get("Toast")
					if toast then
						toast:FireClient(player, { text = "Батарея фонарика села — нужна новая (магазин / NPC)", color = Config.Colors.warn, icon = "🔋" })
					end
				end
			else
				-- Медленная самоподзарядка, пока фонарик выключен
				session.battery = math.min(100, session.battery + 0.12 * dt)
			end

			-- Рассудок
			local drain = 0
			if root then
				local nearest, distance = MonsterManager.getNearest(session, root.Position)
				if nearest and distance < 45 then
					drain += Config.Sanity.DrainMonster * (1 - distance / 45)
				end
				if session.flashlight then
					session.sanity = math.min(Config.MaxSanity, session.sanity + Config.Sanity.RegenLight * dt)
				else
					drain += Config.Sanity.DrainDark
				end
				if session.sprinting then
					drain += 0.3
				end
			end
			local sanityMul = (session.bonuses.sanityMul or 1)
			session.sanity = math.max(0, session.sanity - drain * difficulty.sanityDrain * sanityMul * dt)

			if session.sanity <= 0 and humanoid and humanoid.Health > 0 then
				humanoid:TakeDamage(4.5 * dt)
			elseif session.sanity < Config.Sanity.Critical and session.elapsed > 45 and not session.bossSpawned then
				MonsterManager.spawnBoss(session)
			end

			-- Задания и цель компаса
			QuestManager.tick(session, dt)

			-- События
			if session.elapsed - lastEvent > eventInterval then
				lastEvent = session.elapsed
				DreamManager.triggerEvent(session)
			end

			-- Подсказки взаимодействия и подбор предметов
			promptTimer += dt
			if promptTimer >= 0.25 and root then
				promptTimer = 0
				local part = DreamManager.findPromptPart(session, root.Position)
				if part ~= lastPromptPart then
					lastPromptPart = part
					local promptRemote = Remotes.get("PromptUpdate")
					if promptRemote then
						if part then
							promptRemote:FireClient(player, { id = DreamManager.promptId(session, part), text = part:GetAttribute("Prompt") or "Взаимодействовать" })
						else
							promptRemote:FireClient(player, nil)
						end
					end
				end
			end

			-- Синхронизация витальных показателей
			vitalsTimer += dt
			if vitalsTimer >= 0.5 then
				vitalsTimer = 0
				DreamManager.sendVitals(session)
			end

			-- Проверка завершения
			if session.timeLeft <= 0 then
				local done = session.mandatoryQuest and session.mandatoryQuest.state == "done"
				if done then
					DreamManager.endDream(player, true, "Ты успел выбраться до пробуждения")
				else
					DreamManager.endDream(player, false, "Время вышло — сон поглотил тебя")
				end
				break
			end
			if humanoid and humanoid.Health <= 0 then
				DreamManager.endDream(player, false, "Кошмар настиг тебя")
				break
			end
		end
	end)
end

function DreamManager.promptId(session, part)
	local existing = session.promptIds[part]
	if existing then
		return existing
	end
	session.promptSerial += 1
	local id = "obj_" .. session.promptSerial
	session.promptIds[part] = id
	session.promptParts[id] = part
	return id
end

function DreamManager.findPromptPart(session, position)
	local best = nil
	local bestDistance = Config.InteractRange
	for _, part in ipairs(CollectionService:GetTagged("Interactable")) do
		if part:IsA("BasePart") and part:IsDescendantOf(session.container) and part.Parent then
			local distance = (part.Position - position).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				best = part
			end
		end
	end
	return best
end

function DreamManager.triggerEvent(session)
	if session.ended then
		return
	end
	local event = EVENTS[math.random(1, #EVENTS)]
	local remote = Remotes.get("EventStarted")
	if remote then
		remote:FireClient(session.player, {
			id = event.id,
			title = event.title,
			description = event.description,
			icon = event.icon,
			duration = event.duration or 8,
		})
	end
	if event.sanity then
		if event.sanity > 0 then
			session.sanity = math.max(0, session.sanity - event.sanity)
		else
			session.sanity = math.min(Config.MaxSanity, session.sanity - event.sanity)
		end
	end
	if event.stamina then
		session.stamina = math.max(0, session.stamina - event.stamina)
	end
	if event.time then
		session.timeLeft = math.max(1, session.timeLeft - event.time)
	end
	if event.spawn then
		local root = session.player.Character and session.player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local types = session.dream.monsters or { "shadow" }
			MonsterManager.spawnMonster(
				session,
				types[math.random(1, #types)],
				root.Position + Vector3.new(math.random(-32, 32), 3, math.random(-32, 32))
			)
		end
	end
end

function DreamManager.handleInteract(player, promptId)
	local session = sessions[player]
	if not session or session.ended then
		return
	end
	local part = session.promptParts[promptId]
	if not part or not part.Parent then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if (root.Position - part.Position).Magnitude > Config.InteractRange * 1.8 then
		local result = Remotes.get("InteractionResult")
		if result then
			result:FireClient(player, { ok = false, reason = "too_far", text = "Слишком далеко" })
		end
		return
	end

	local kind = part:GetAttribute("InteractKind")
	local label = part:GetAttribute("QuestLabel")

	if kind == "collect" then
		CollectionService:RemoveTag(part, "Interactable")
		session.promptIds[part] = nil
		session.promptParts[promptId] = nil
		part:Destroy()
		QuestManager.progress(session, "collect", label, 1)
	elseif kind == "object" or kind == "lamp" then
		if part:GetAttribute("Used") then
			return
		end
		part:SetAttribute("Used", true)
		if kind == "lamp" then
			part.Material = Enum.Material.Neon
			part.Color = Color3.fromRGB(255, 240, 190)
			local bulb = part:FindFirstChild("Bulb")
			if bulb then
				bulb.Enabled = true
				bulb.Brightness = 3
			end
			QuestManager.progress(session, "lights", label, 1)
		else
			part.Color = Color3.fromRGB(120, 240, 160)
			local light = part:FindFirstChildOfClass("PointLight")
			if not light then
				light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(140, 255, 180)
				light.Brightness = 2
				light.Range = 18
				light.Parent = part
			end
			QuestManager.progress(session, "interact", label, 1)
		end
	elseif kind == "battery" then
		local amount = part:GetAttribute("BatteryAmount") or 40
		CollectionService:RemoveTag(part, "Interactable")
		session.promptIds[part] = nil
		session.promptParts[promptId] = nil
		session.battery = math.min(100, (session.battery or 0) + amount)
		if session.battery > 1 and not session.flashlight then
			session.flashlight = true
		end
		local toast = Remotes.get("Toast")
		if toast then
			toast:FireClient(player, {
				text = "Батарейка вставлена: " .. tostring(math.floor(session.battery)) .. "%",
				color = Color3.fromRGB(150, 255, 200),
				icon = "🔋",
			})
		end
		local flash = Instance.new("PointLight")
		flash.Color = Color3.fromRGB(150, 255, 210)
		flash.Brightness = 6
		flash.Range = 22
		flash.Parent = part
		task.delay(0.25, function()
			if part and part.Parent then
				part:Destroy()
			end
		end)
		DreamManager.sendVitals(session)
		local ok = Remotes.get("InteractionResult")
		if ok then
			ok:FireClient(player, { ok = true, reason = "battery", text = "Батарейка" })
		end
	elseif kind == "npc" then
		NPCManager.openDialog(session, part)
	elseif kind == "portal" then
		if not session.portalOpen then
			local hint = Remotes.get("Hint")
			if hint then
				hint:FireClient(player, "Портал ещё не открыт. Выполни основное задание.")
			end
			local result = Remotes.get("InteractionResult")
			if result then
				result:FireClient(player, { ok = false, reason = "portal_locked", text = "Портал закрыт" })
			end
			return
		end
		DreamManager.endDream(player, true, "Ты вошёл в портал пробуждения")
	end
end

function DreamManager.handleDialogChoice(player, action)
	local session = sessions[player]
	if not session then
		return
	end
	NPCManager.handleChoice(session, action)
end

function DreamManager.setSprinting(player, value)
	local session = sessions[player]
	if not session or session.ended then
		return
	end
	session.sprinting = value == true and session.stamina > 1
end

function DreamManager.setFlashlight(player, value)
	local session = sessions[player]
	if not session or session.ended then
		return
	end
	local wanted = value == true
	if wanted and (session.battery or 0) <= 0.5 then
		session.flashlight = false
		local toast = Remotes.get("Toast")
		if toast then
			toast:FireClient(player, { text = "Фонарик не работает: батарея пуста", color = Config.Colors.warn, icon = "🔋" })
		end
		DreamManager.sendVitals(session)
		return
	end
	session.flashlight = wanted
	if wanted then
		session.flashlightNotifiedEmpty = false
		-- Включённый фонарик видно издалека: ближайший монстр теряет осторожность
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and math.random() < 0.4 then
			local nearest = MonsterManager.getNearest(session, root.Position)
			if nearest then
				nearest.lastSeen = os.clock()
			end
		end
	end
	DreamManager.sendVitals(session)
end

function DreamManager.setLook(player, lookVector)
	local session = sessions[player]
	if not session or session.ended then
		return
	end
	if typeof(lookVector) == "Vector3" then
		session.lookVector = lookVector
	end
end

function DreamManager.applyConsumable(player, item)
	local session = sessions[player]
	if not session or session.ended then
		return false
	end
	local effect = item.consumable or {}
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if effect.sanity then
		session.sanity = math.min(Config.MaxSanity, session.sanity + effect.sanity)
	end
	if effect.health and humanoid then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + effect.health)
	end
	if effect.stamina then
		session.stamina = math.min(Config.MaxStamina, session.stamina + effect.stamina)
	end
	if effect.flashlight then
		session.battery = math.min(100, (session.battery or 0) + 75)
		if (session.battery or 0) > 1 then
			session.flashlight = true
		end
	end
	if effect.speed and humanoid then
		local base = Config.BaseWalkSpeed + (session.bonuses.speedBonus or 0)
		humanoid.WalkSpeed = base * 1.4
		task.delay(effect.speed, function()
			if humanoid and humanoid.Parent and not session.ended then
				humanoid.WalkSpeed = base
			end
		end)
	end
	DreamManager.sendVitals(session)
	return true
end

function DreamManager.endDream(player, won, reasonText)
	local session = sessions[player]
	if not session or session.ended then
		return
	end
	session.ended = true
	local difficultyKey = session.difficulty.key
	local survived = math.floor(session.elapsed)

	setState(player, "waking")
	MonsterManager.stop(session)
	NPCManager.cleanup(session)

	local questCoins = session.coinsEarned or 0
	local base = session.difficulty.reward or 100
	local coins = math.floor(questCoins + (won and base or base * 0.25))

	DataManager.addCoins(player, coins)
	DataManager.updateStat(player, "wins", won and 1 or 0)
	DataManager.updateStat(player, "losses", won and 0 or 1)
	DataManager.updateStat(player, "playtime", survived)
	local profile = DataManager.get(player)
	if won and (profile.stats.bestTime <= 0 or survived < profile.stats.bestTime) then
		profile.stats.bestTime = survived
	end

	local humanoid = getHumanoid(player)
	local AchievementManager = script.Parent:FindFirstChild("AchievementManager")
	if AchievementManager then
		require(AchievementManager).check(player, "end", {
			win = won,
			difficulty = difficultyKey,
			survived = survived,
			health = humanoid and humanoid.Health or 0,
		})
	end
	DataManager.save(player)

	local payload = {
		won = won,
		reasonText = reasonText or "",
		dreamName = session.dream.name or session.dream.title,
		dreamId = session.dream.id,
		difficulty = difficultyKey,
		difficultyName = session.difficulty.name,
		survived = survived,
		questsDone = session.questsDone or 0,
		questsTotal = #session.quests,
		coins = coins,
	}
	local endRemote = Remotes.get("DreamEnded")
	if endRemote then
		endRemote:FireClient(player, payload)
	end

	-- Экран результата остаётся у игрока; мир сна убираем, персонажа возвращаем в спальню.
	-- Состояние остаётся "waking": клиент показывает итоги, игрок сам выбирает
	-- «В меню» или «Ещё сон».
	task.delay(Config.WakeDuration, function()
		-- Игрок мог нажать «Ещё сон» с экрана итогов: тогда новый сон уже идёт
		-- и трогать его (свет, телепорт, контейнер) нельзя.
		if states[player] ~= "waking" then
			return
		end
		if sessions[player] == session then
			sessions[player] = nil
		end
		MonsterManager.stop(session)
		NPCManager.cleanup(session)
		QuestManager.cleanup(session)
		if session.container and session.container.Parent then
			session.container:Destroy()
		end
		MapService.resetLighting()
		if player.Parent and states[player] ~= "menu" then
			DreamManager.teleportToMenu(player)
		end
	end)
end

function DreamManager.returnToMenu(player)
	local session = sessions[player]
	if session and not session.ended then
		DreamManager.endDream(player, false, "Ты сдался и проснулся")
		return
	end
	-- С экрана результата (state == "waking") тоже возвращаемся в лобби.
	sessions[player] = nil
	setState(player, "menu")
	DreamManager.teleportToMenu(player)
	DataManager.pushProfile(player)
end

function DreamManager.cleanupPlayer(player)
	local session = sessions[player]
	if session then
		session.ended = true
		MonsterManager.stop(session)
		NPCManager.cleanup(session)
		QuestManager.cleanup(session)
		if session.container and session.container.Parent then
			session.container:Destroy()
		end
	end
	sessions[player] = nil
	states[player] = nil
	stateSince[player] = nil
	MapService.resetLighting()
end

-- Сторож: не даёт игроку застрять в «спящем» сне или без мира.
-- Такие состояния — худший вид бага: экран есть, а играть нельзя.
local function watchdog()
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player, state in pairs(states) do
				if player.Parent then
					local since = stateSince[player] or now
					if state == "sleeping" and now - since > Config.SleepDuration + 30 then
						warn("[DreamManager] сторож: игрок застрял в засыпании, возвращаю в меню")
						sessions[player] = nil
						setState(player, "menu")
						DreamManager.teleportToMenu(player)
					elseif state == "dream" then
						local session = sessions[player]
						local alive = session and not session.ended and session.container and session.container.Parent
						if not alive then
							warn("[DreamManager] сторож: сессия сна потеряна, возвращаю в меню")
							sessions[player] = nil
							MapService.resetLighting()
							setState(player, "menu")
							DreamManager.teleportToMenu(player)
						end
					end
				end
			end
		end
	end)
end

function DreamManager.init()
	MapService.captureLighting()
	Players.PlayerRemoving:Connect(function(player)
		DreamManager.cleanupPlayer(player)
	end)
	watchdog()
end

return DreamManager
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="306">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[--!nonstrict
-- Main: запуск сервера, подключение сетевых событий, жизненный цикл игрока.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))

local DataManager = require(script.Parent:WaitForChild("DataManager"))
local EconomyManager = require(script.Parent:WaitForChild("EconomyManager"))
local AchievementManager = require(script.Parent:WaitForChild("AchievementManager"))
local DreamManager = require(script.Parent:WaitForChild("DreamManager"))

print(("[DREAM SIMULATOR] сервер запущен, версия %s"):format(Config.VERSION))

DataManager.init()
DreamManager.init()

-- Маркеры состояния мира: их читает панель диагностики на клиенте (F8).
workspace:SetAttribute("BuildVersion", Config.VERSION)
workspace:SetAttribute("GameReady", true)

local function setupLeaderstats(player)
	local existing = player:FindFirstChild("leaderstats")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	folder.Parent = player

	local coins = Instance.new("IntValue")
	coins.Name = "Монеты"
	coins.Value = DataManager.get(player).coins
	coins.Parent = folder

	local dreams = Instance.new("IntValue")
	dreams.Name = "Сны"
	dreams.Value = DataManager.get(player).stats.dreams
	dreams.Parent = folder

	task.spawn(function()
		while player.Parent do
			local profile = DataManager.get(player)
			coins.Value = profile.coins
			dreams.Value = profile.stats.dreams
			task.wait(2)
		end
	end)
end

local function onCharacterAdded(player, character)
	task.wait(0.3)
	if not player.Parent then
		return
	end
	DreamManager.preparePlayer(player)
	local state = DreamManager.getState(player)
	if state == "dream" then
		local session = DreamManager.getSession(player)
		if session and session.mapModel then
			local spawnPos = session.mapModel:GetAttribute("SpawnPosition") or Vector3.new(0, 8, 0)
			character:PivotTo(CFrame.new(spawnPos))
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			local session = DreamManager.getSession(player)
			if session and not session.ended then
				DreamManager.endDream(player, false, "Кошмар настиг тебя")
			end
		end)
	end
end

local function onPlayerAdded(player)
	DataManager.load(player)
	setupLeaderstats(player)

	if player.Character then
		task.spawn(function()
			DreamManager.preparePlayer(player)
			DreamManager.returnToMenu(player)
			DataManager.pushProfile(player)
		end)
	end

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	task.delay(2.5, function()
		if player.Parent then
			DataManager.pushProfile(player)
			local state = Remotes.get("DreamStateChanged")
			if state then
				state:FireClient(player, { state = DreamManager.getState(player) })
			end
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	DreamManager.cleanupPlayer(player)
	DataManager.remove(player)
end)

-- ------------------------------------------------------------------
-- Сетевые события
-- ------------------------------------------------------------------

Remotes.get("PlayerReady").OnServerEvent:Connect(function(player)
	DataManager.pushProfile(player)
	local state = Remotes.get("DreamStateChanged")
	if state then
		state:FireClient(player, { state = DreamManager.getState(player) })
	end
	local toast = Remotes.get("Toast")
	if toast then
		toast:FireClient(player, { text = "Добро пожаловать в мир снов", color = Config.Colors.accent, icon = "🌙" })
	end
end)

Remotes.get("RequestDream").OnServerEvent:Connect(function(player, difficultyKey, dreamId)
	if type(difficultyKey) ~= "string" or not Config.validDifficulty(difficultyKey) then
		difficultyKey = "Normal"
	end
	if type(dreamId) ~= "string" then
		dreamId = nil
	end
	local ok, err = DreamManager.startDream(player, difficultyKey, dreamId)
	if not ok and err then
		local toast = Remotes.get("Toast")
		if toast then
			toast:FireClient(player, { text = err, color = Config.Colors.bad, icon = "⚠️" })
		end
	end
end)

Remotes.get("ReturnToMenu").OnServerEvent:Connect(function(player)
	DreamManager.returnToMenu(player)
end)

Remotes.get("BuyItem").OnServerEvent:Connect(function(player, itemId)
	if type(itemId) ~= "string" then
		return
	end
	EconomyManager.buyItem(player, itemId)
end)

Remotes.get("EquipItem").OnServerEvent:Connect(function(player, itemId)
	if type(itemId) ~= "string" then
		return
	end
	EconomyManager.equipItem(player, itemId)
end)

Remotes.get("UnequipItem").OnServerEvent:Connect(function(player, slot)
	if type(slot) ~= "string" then
		return
	end
	EconomyManager.unequipItem(player, slot)
end)

Remotes.get("UseItem").OnServerEvent:Connect(function(player, itemId)
	if type(itemId) ~= "string" then
		return
	end
	EconomyManager.useConsumable(player, itemId)
end)

Remotes.get("UpdateSettings").OnServerEvent:Connect(function(player, key, value)
	EconomyManager.updateSettings(player, key, value)
end)

Remotes.get("ResetSettings").OnServerEvent:Connect(function(player)
	EconomyManager.resetSettings(player)
end)

Remotes.get("Interact").OnServerEvent:Connect(function(player, promptId)
	if type(promptId) ~= "string" then
		return
	end
	DreamManager.handleInteract(player, promptId)
end)

Remotes.get("DialogChoice").OnServerEvent:Connect(function(player, action)
	if type(action) ~= "string" then
		return
	end
	DreamManager.handleDialogChoice(player, action)
end)

Remotes.get("CloseDialog").OnServerEvent:Connect(function(player)
	local closed = Remotes.get("DialogClosed")
	if closed then
		closed:FireClient(player)
	end
end)

Remotes.get("SetSprinting").OnServerEvent:Connect(function(player, value)
	DreamManager.setSprinting(player, value == true)
end)

Remotes.get("SetFlashlight").OnServerEvent:Connect(function(player, value)
	DreamManager.setFlashlight(player, value == true)
end)

Remotes.get("LookUpdate").OnServerEvent:Connect(function(player, lookVector)
	DreamManager.setLook(player, lookVector)
end)

Remotes.get("ReportDeath").OnServerEvent:Connect(function(player)
	local session = DreamManager.getSession(player)
	if session and not session.ended then
		DreamManager.endDream(player, false, "Кошмар настиг тебя")
	end
end)

Remotes.get("RequestProfile").OnServerInvoke = function(player)
	return DataManager.get(player), DreamManager.getState(player)
end

-- Страховка: раз в минуту сохраняем прогресс игроков в меню.
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			local state = DreamManager.getState(player)
			if state ~= "dream" and state ~= "sleeping" then
				DataManager.save(player)
			end
		end
	end
end)

print("[DREAM SIMULATOR] все системы готовы")
