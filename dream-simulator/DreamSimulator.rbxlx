              </UDim2>
              <bool name="RichText">true</bool>
              <UDim2 name="Size">
                <XS>1</XS>
                <XO>0</XO>
                <YS>-72</YS>
                <YO>0</YO>
              </UDim2>
              <string name="Text">Один сон длится 10 минут. Найди портал пробуждения и не потеряй рассудок.</string>
              <Color3 name="TextColor3">
                <R>0.61960787</R>
                <G>0.6313726</G>
                <B>0.7764706</B>
              </Color3>
              <bool name="TextScaled">true</bool>
              <float name="TextSize">18</float>
              <bool name="TextWrapped">false</bool>
              <token name="TextXAlignment">0</token>
              <token name="TextYAlignment">1</token>
            </Properties>
            <Item class="UITextSizeConstraint" referent="7608">
              <Properties>
                <string name="Name">SizeConstraint</string>
