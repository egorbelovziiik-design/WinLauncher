      </Properties>
      <Item class="LocalScript" referent="8281">
        <Properties>
          <string name="Name">BootMenu</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	BootMenu.client.luau
	Страховочный интерфейс лобби: кнопка «МЕНЮ» сверху экрана.
	Не зависит ни от одного модуля игры — работает, даже если
	основной клиентский интерфейс по какой-то причине не загрузился.
	Когда полноценное меню готово (TopBar.MenuReady == true), эта панель
	сама прячется, чтобы не дублировать кнопки.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

------------------------------------------------------------------
-- Скрываем стандартный интерфейс Roblox (с повторами: CoreGui грузится не сразу)
------------------------------------------------------------------
local function hideCoreGui()
	for _, guiType in ipairs({
		Enum.CoreGuiType.Backpack,
		Enum.CoreGuiType.PlayerList,
		Enum.CoreGuiType.EmotesMenu,
		Enum.CoreGuiType.Health,
		Enum.CoreGuiType.Chat,
	}) do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(guiType, false)
		end)
	end
	pcall(function()
		StarterGui:SetCore("TopbarEnabled", false)
	end)
end
hideCoreGui()
task.spawn(function()
	for _ = 1, 20 do
		task.wait(0.5)
		hideCoreGui()
	end
end)

------------------------------------------------------------------
-- Резервная панель
------------------------------------------------------------------
local DARK = Color3.fromRGB(10, 11, 22)
local PANEL = Color3.fromRGB(22, 24, 44)
local ACCENT = Color3.fromRGB(166, 140, 255)
local TEXT = Color3.fromRGB(238, 238, 255)
local DIM = Color3.fromRGB(190, 190, 220)

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function stroke(parent, color, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or ACCENT
	s.Transparency = transparency or 0.4
	s.Thickness = 1.5
	s.Parent = parent
	return s
end

local function makeButton(parent, name, text, position, size, callback)
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = text
	button.Position = position
	button.Size = size
	button.BackgroundColor3 = Color3.fromRGB(52, 40, 118)
	button.TextColor3 = TEXT
	button.Font = Enum.Font.GothamBold
	button.TextScaled = true
	button.AutoButtonColor = true
	button.ZIndex = 62
	button.Parent = parent
	corner(button, 12)
	stroke(button, ACCENT, 0.35)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 20
	constraint.Parent = button
	if callback then
		button.MouseButton1Click:Connect(callback)
	end
	return button
end

local boot = playerGui:FindFirstChild("BootUI")
if not boot then
	boot = Instance.new("ScreenGui")
	boot.Name = "BootUI"
	boot.ResetOnSpawn = false
	boot.IgnoreGuiInset = false
	boot.DisplayOrder = 95
	boot.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	boot.Parent = playerGui
end

local menuButton = boot:FindFirstChild("MenuButton")
if not menuButton then
	menuButton = makeButton(boot, "MenuButton", "☰  МЕНЮ", UDim2.fromOffset(12, 48), UDim2.fromOffset(150, 40), nil)
	menuButton.BackgroundColor3 = Color3.fromRGB(44, 34, 104)
end

local back = boot:FindFirstChild("BootBackdrop")
if not back then
	back = Instance.new("Frame")
	back.Name = "BootBackdrop"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = DARK
	back.BackgroundTransparency = 0.45
	back.Visible = false
	back.ZIndex = 60
	back.Parent = boot

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(520, 560)
	card.BackgroundColor3 = PANEL
	card.BackgroundTransparency = 0.02
	card.ZIndex = 61
	card.Parent = back
	corner(card, 22)
	stroke(card, ACCENT, 0.3)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 56)
	title.Position = UDim2.fromOffset(0, 22)
	title.BackgroundTransparency = 1
	title.Text = "🌙 DREAM SIMULATOR"
	title.TextColor3 = TEXT
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.ZIndex = 62
	title.Parent = card
	local c1 = Instance.new("UITextSizeConstraint")
	c1.MaxTextSize = 30
	c1.Parent = title

	local subtitle = Instance.new("TextLabel")
	subtitle.Size = UDim2.new(1, -40, 0, 26)
	subtitle.Position = UDim2.fromOffset(20, 78)
	subtitle.BackgroundTransparency = 1
	subtitle.Text = "Каждый сон — новая история..."
	subtitle.TextColor3 = DIM
	subtitle.Font = Enum.Font.Gotham
	subtitle.TextScaled = true
	subtitle.ZIndex = 62
	subtitle.Parent = card
	local c2 = Instance.new("UITextSizeConstraint")
	c2.MaxTextSize = 17
	c2.Parent = subtitle

	local difficultyTitle = Instance.new("TextLabel")
	difficultyTitle.Size = UDim2.new(1, -40, 0, 24)
	difficultyTitle.Position = UDim2.fromOffset(20, 118)
	difficultyTitle.BackgroundTransparency = 1
	difficultyTitle.TextXAlignment = Enum.TextXAlignment.Left
	difficultyTitle.Text = "ВЫБЕРИ СЛОЖНОСТЬ И НАЧНИ СОН"
	difficultyTitle.TextColor3 = ACCENT
	difficultyTitle.Font = Enum.Font.GothamBold
	difficultyTitle.TextScaled = true
	difficultyTitle.ZIndex = 62
	difficultyTitle.Parent = card
	local c3 = Instance.new("UITextSizeConstraint")
	c3.MaxTextSize = 15
	c3.Parent = difficultyTitle

	local entries = {
		{ text = "🟢  ЛЁГКИЙ  ·  100 монет", key = "Easy" },
		{ text = "🟡  ОБЫЧНЫЙ  ·  250 монет", key = "Normal" },
		{ text = "🔴  СЛОЖНЫЙ  ·  500 монет", key = "Hard" },
		{ text = "💀  ЭКСТРИМ  ·  1000 монет", key = "Extreme" },
	}

	local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 20)

	local function startDream(key)
		back.Visible = false
		if remotesFolder then
			local remote = remotesFolder:FindFirstChild("RequestDream")
			if remote then
				remote:FireServer(key)
			end
		end
	end

	for index, entry in ipairs(entries) do
		makeButton(card, "Difficulty_" .. entry.key, entry.text,
			UDim2.fromOffset(30, 150 + (index - 1) * 64), UDim2.new(1, -60, 0, 54),
			function()
				startDream(entry.key)
			end)
	end

	makeButton(card, "CloseBoot", "✕  ЗАКРЫТЬ", UDim2.fromOffset(30, 420), UDim2.new(1, -60, 0, 50), function()
		back.Visible = false
	end)

	local hint = Instance.new("TextLabel")
	hint.Size = UDim2.new(1, -60, 0, 50)
	hint.Position = UDim2.fromOffset(30, 480)
	hint.BackgroundTransparency = 1
	hint.TextWrapped = true
	hint.Text = "Можно ходить по спальне: WASD — движение, SHIFT — бег. Меню открывается кнопкой сверху или клавишей M."
	hint.TextColor3 = DIM
	hint.Font = Enum.Font.Gotham
	hint.TextScaled = true
	hint.ZIndex = 62
	hint.Parent = card
	local c4 = Instance.new("UITextSizeConstraint")
	c4.MaxTextSize = 14
	c4.Parent = hint
end

menuButton.MouseButton1Click:Connect(function()
	-- Если полноценное меню работает, кнопку не перехватываем
	local topBar = playerGui:FindFirstChild("TopBar")
	if topBar and topBar:GetAttribute("MenuReady") == true then
		return
	end
	back.Visible = not back.Visible
end)

------------------------------------------------------------------
-- Прячемся, когда основное меню готово
------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(1)
		local topBar = playerGui:FindFirstChild("TopBar")
		local ready = topBar and topBar:GetAttribute("MenuReady") == true
		if ready then
			boot.Enabled = false
			break
		end
	end
end)

print("[DreamSimulator] BootMenu готов")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="8282">
        <Properties>
          <string name="Name">Splash</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	Splash.client.luau
	Заставка запуска: закрывает «сырые» первые секунды (загрузка карты,
	клонирование интерфейса) и красиво уводит в лобби.

	Скрипт полностью автономный — не требует ни одного модуля игры,
	поэтому работает даже если остальной клиент упал.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "SplashGUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 200
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local backdrop = Instance.new("Frame")
backdrop.Name = "Backdrop"
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.BackgroundColor3 = Color3.fromRGB(5, 6, 14)
backdrop.BorderSizePixel = 0
backdrop.Parent = gui

local glow = Instance.new("Frame")
glow.Name = "Glow"
glow.AnchorPoint = Vector2.new(0.5, 0.5)
glow.Position = UDim2.fromScale(0.5, 0.45)
glow.Size = UDim2.fromOffset(900, 900)
glow.BackgroundColor3 = Color3.fromRGB(54, 38, 120)
glow.BackgroundTransparency = 0.72
glow.BorderSizePixel = 0
glow.Parent = backdrop

local glowCorner = Instance.new("UICorner")
glowCorner.CornerRadius = UDim.new(1, 0)
glowCorner.Parent = glow

local glowGradient = Instance.new("UIGradient")
glowGradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.15),
	NumberSequenceKeypoint.new(1, 1),
})
glowGradient.Parent = glow

local moon = Instance.new("TextLabel")
moon.Name = "Moon"
moon.AnchorPoint = Vector2.new(0.5, 0.5)
moon.Position = UDim2.fromScale(0.5, 0.32)
moon.Size = UDim2.fromOffset(160, 160)
moon.BackgroundTransparency = 1
moon.Font = Enum.Font.GothamBold
moon.Text = "🌙"
moon.TextSize = 120
moon.TextTransparency = 1
moon.Parent = backdrop

local title = Instance.new("TextLabel")
title.Name = "Title"
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.5)
title.Size = UDim2.new(0.9, 0, 0, 64)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.Text = "DREAM SIMULATOR"
title.TextColor3 = Color3.fromRGB(240, 238, 255)
title.TextScaled = true
title.TextTransparency = 1
title.Parent = backdrop

local titleConstraint = Instance.new("UITextSizeConstraint")
titleConstraint.MaxTextSize = 46
titleConstraint.Parent = title

local subtitle = Instance.new("TextLabel")
subtitle.Name = "Subtitle"
subtitle.AnchorPoint = Vector2.new(0.5, 0.5)
subtitle.Position = UDim2.fromScale(0.5, 0.58)
subtitle.Size = UDim2.new(0.9, 0, 0, 26)
subtitle.BackgroundTransparency = 1
subtitle.Font = Enum.Font.Gotham
subtitle.Text = "Каждый сон — новая история..."
subtitle.TextColor3 = Color3.fromRGB(170, 168, 210)
subtitle.TextScaled = true
subtitle.TextTransparency = 1
subtitle.Parent = backdrop

local subtitleConstraint = Instance.new("UITextSizeConstraint")
subtitleConstraint.MaxTextSize = 18
subtitleConstraint.Parent = subtitle

local track = Instance.new("Frame")
track.Name = "Track"
track.AnchorPoint = Vector2.new(0.5, 0.5)
track.Position = UDim2.fromScale(0.5, 0.68)
track.Size = UDim2.fromOffset(320, 6)
track.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
track.BorderSizePixel = 0
track.BackgroundTransparency = 0.3
track.Parent = backdrop

local trackCorner = Instance.new("UICorner")
trackCorner.CornerRadius = UDim.new(1, 0)
trackCorner.Parent = track

local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = Color3.fromRGB(166, 140, 255)
fill.BorderSizePixel = 0
fill.Parent = track

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(1, 0)
fillCorner.Parent = fill

local status = Instance.new("TextLabel")
status.Name = "Status"
status.AnchorPoint = Vector2.new(0.5, 0.5)
status.Position = UDim2.fromScale(0.5, 0.74)
status.Size = UDim2.new(0.9, 0, 0, 20)
status.BackgroundTransparency = 1
status.Font = Enum.Font.Gotham
status.Text = "собираем мир снов..."
status.TextColor3 = Color3.fromRGB(130, 128, 170)
status.TextSize = 14
status.TextTransparency = 1
status.Parent = backdrop

-- Появление
TweenService:Create(moon, TweenInfo.new(0.9), { TextTransparency = 0 }):Play()
TweenService:Create(title, TweenInfo.new(1.0, Enum.EasingStyle.Quint), { TextTransparency = 0 }):Play()
TweenService:Create(subtitle, TweenInfo.new(1.2), { TextTransparency = 0.15 }):Play()
TweenService:Create(status, TweenInfo.new(1.4), { TextTransparency = 0.2 }):Play()
TweenService:Create(fill, TweenInfo.new(2.0, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(1, 1) }):Play()

local phrases = {
	"собираем мир снов...",
	"зажигаем фонарик...",
	"будим монстров...",
	"готово",
}
task.spawn(function()
	for index, text in ipairs(phrases) do
		task.wait(0.55)
		status.Text = text
	end
end)

-- Уход в лобби (ровно один раз)
local faded = false
local function fadeOut()
	if faded or not gui.Parent then
		return
	end
	faded = true
	local info = TweenInfo.new(0.75, Enum.EasingStyle.Quad)
	TweenService:Create(backdrop, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(title, info, { TextTransparency = 1 }):Play()
	TweenService:Create(subtitle, info, { TextTransparency = 1 }):Play()
	TweenService:Create(moon, info, { TextTransparency = 1 }):Play()
	TweenService:Create(status, info, { TextTransparency = 1 }):Play()
	TweenService:Create(track, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(fill, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(glow, info, { BackgroundTransparency = 1 }):Play()
	task.wait(0.8)
	gui:Destroy()
end

-- Не держим игрока дольше 2.6 секунды, даже если сервер тормозит.
task.delay(2.2, fadeOut)

-- Если сервер сообщил, что мир готов раньше — уходим сразу после минимума.
task.spawn(function()
	local startedAt = os.clock()
	while os.clock() - startedAt < 1.4 do
		task.wait(0.15)
	end
	while os.clock() - startedAt < 4 do
		if workspace:GetAttribute("GameReady") == true then
			fadeOut()
			return
		end
		task.wait(0.2)
	end
end)

-- Страховка от «вечной заставки»
task.delay(6, function()
	if gui.Parent then
		gui:Destroy()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="8283">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	ClientMain.client.luau
	Запуск клиентских контроллеров DREAM SIMULATOR: NIGHTMARE WORLDS.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local ClientState = require(script.Parent.Modules.ClientState)
local SoundController = require(script.Parent.Modules.SoundController)
local CameraController = require(script.Parent.Modules.CameraController)
local MenuController = require(script.Parent.Modules.MenuController)
local HUDController = require(script.Parent.Modules.HUDController)
local EffectsController = require(script.Parent.Modules.EffectsController)
local CutsceneController = require(script.Parent.Modules.CutsceneController)
local InputController = require(script.Parent.Modules.InputController)
local DiagnosticsController = require(script.Parent.Modules.DiagnosticsController)

local player = Players.LocalPlayer

-- Прячем стандартные элементы интерфейса, которые не нужны в хорроре.
-- CoreGui грузится не сразу, поэтому повторяем несколько секунд.
local function hideCoreGui()
	for _, guiType in ipairs({
		Enum.CoreGuiType.Backpack,
		Enum.CoreGuiType.PlayerList,
		Enum.CoreGuiType.EmotesMenu,
		Enum.CoreGuiType.Health,
		Enum.CoreGuiType.Chat,
	}) do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(guiType, false)
		end)
	end
	pcall(function()
		StarterGui:SetCore("TopbarEnabled", false)
	end)
end
hideCoreGui()
task.spawn(function()
	for _ = 1, 12 do
		task.wait(0.5)
		hideCoreGui()
	end
end)

-- Ждём, пока сервер создаст Remotes
Remotes.getFolder()
task.wait(0.3)

local function safeStart(name, startFn)
	local ok, err = pcall(startFn)
	if not ok then
		warn("[DreamSimulator] " .. name .. " не запустился: " .. tostring(err))
	end
	return ok
end

safeStart("SoundController", SoundController.start)
safeStart("CameraController", CameraController.start)
safeStart("HUDController", HUDController.start)
safeStart("MenuController", MenuController.start)
safeStart("EffectsController", EffectsController.start)
safeStart("CutsceneController", CutsceneController.start)
safeStart("InputController", InputController.start)
safeStart("DiagnosticsController", DiagnosticsController.start)

ClientState.setPhase("loading")

------------------------------------------------------------------
-- Профиль
------------------------------------------------------------------
local profileFunction = Remotes.get("RequestProfile")
task.spawn(function()
	local ok, profile = pcall(function()
		return profileFunction:InvokeServer()
	end)
	if ok and profile then
		ClientState.setProfile(profile)
	end
end)

Remotes.get("ProfileUpdated").OnClientEvent:Connect(function(profile)
	if profile then
		ClientState.setProfile(profile)
	end
end)

------------------------------------------------------------------
-- Переходы между фазами
------------------------------------------------------------------
Remotes.get("DreamStateChanged").OnClientEvent:Connect(function(data)
	if data.state == "menu" then
		-- CutsceneController уже переключил фазу, но подстрахуемся
		if ClientState.phase ~= "menu" then
			ClientState.setPhase("menu")
		end
	end
end)

ClientState.on("Phase", function(phase)
	if phase == "menu" then
		CameraController.setMode("menu")
		MenuController.show()
	elseif phase == "dream" then
		MenuController.hide()
	end
end)

-- Стартуем в меню: показываем спальню и кнопки
task.delay(0.6, function()
	ClientState.setPhase("menu")
	CameraController.setMode("menu")
	MenuController.show()
	local ready = Remotes.get("PlayerReady")
	if ready then
		ready:FireServer()
	end
end)

-- Кнопка МЕНЮ всегда доступна, даже если что-то выше упало
task.delay(1.6, function()
	local topBar = player:WaitForChild("PlayerGui"):FindFirstChild("TopBar")
	if topBar then
		topBar.Enabled = true
	end
	if ClientState.phase ~= "dream" then
		MenuController.show()
	end
end)

------------------------------------------------------------------
-- Персонаж: первое лицо включаем только во сне
------------------------------------------------------------------
player.CameraMode = Enum.CameraMode.Classic
-- Не переводим камеру в Scriptable на старте: до первой фазы она должна
-- показывать лобби, иначе игрок видит чёрный экран до срабатывания меню.
if Workspace.CurrentCamera and Workspace.CurrentCamera.CameraType ~= Enum.CameraType.Custom then
	CameraController.setMode("menu")
end

player.CharacterAdded:Connect(function()
	if ClientState.phase == "menu" then
		CameraController.setMode("menu")
	end
end)

------------------------------------------------------------------
-- Резервная кнопка МЕНЮ живёт в отдельном скрипте BootMenu.client.luau
------------------------------------------------------------------

print("[DreamSimulator] Клиент готов")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="8284">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="8285">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	ClientState.luau
	Общее состояние клиента: профиль, настройки, фаза игры, кэш элементов интерфейса.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.SharedModules.Config)
local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local ItemDefinitions = require(ReplicatedStorage.SharedModules.ItemDefinitions)

local ClientState = {}

ClientState.player = Players.LocalPlayer
ClientState.playerGui = ClientState.player:WaitForChild("PlayerGui")
ClientState.phase = "loading" -- loading | menu | sleeping | dream | waking | result
ClientState.profile = nil
ClientState.settings = {
	musicVolume = 0.5,
	sfxVolume = 0.75,
	quality = "Средний",
	sensitivity = 0.5,
	scareIntensity = 1,
	hints = true,
	cameraShake = true,
}
ClientState.dream = nil
ClientState.quests = {}
ClientState.mandatoryLeft = 0
ClientState.timer = { remaining = Config.DreamDuration, total = Config.DreamDuration }
ClientState.vitals = { sanity = 100, stamina = 100, health = 100, maxHealth = 100, maxSanity = 100, maxStamina = 100, sprinting = false, flashlight = false, battery = 100, batteryMax = 100 }
ClientState.prompt = nil
ClientState.result = nil
ClientState.bonuses = {}
ClientState.isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
ClientState.toastHandlers = {}
ClientState.stateHandlers = {}
ClientState.elementCache = {}

function ClientState.on(event, handler)
	ClientState[event .. "Handlers"] = ClientState[event .. "Handlers"] or {}
	table.insert(ClientState[event .. "Handlers"], handler)
	return function()
		local list = ClientState[event .. "Handlers"]
		for index, item in ipairs(list) do
			if item == handler then
				table.remove(list, index)
				break
			end
		end
	end
end

function ClientState.emit(event, ...)
	local list = ClientState[event .. "Handlers"]
	if not list then
		return
	end
	for _, handler in ipairs(list) do
		task.spawn(handler, ...)
	end
end

function ClientState.setPhase(phase)
	if ClientState.phase == phase then
		return
	end
	ClientState.phase = phase
	ClientState.emit("Phase", phase)
end

------------------------------------------------------------------
-- Профиль
------------------------------------------------------------------
function ClientState.setProfile(profile)
	if not profile then
		return
	end
	ClientState.profile = profile
	if profile.settings then
		for key, value in pairs(profile.settings) do
			ClientState.settings[key] = value
		end
	end
	ClientState.emit("Profile", profile)
end

function ClientState.getCoins()
	return ClientState.profile and ClientState.profile.coins or 0
end

function ClientState.ownsItem(itemId)
	return ClientState.profile ~= nil and ClientState.profile.owned[itemId] == true
end

function ClientState.isEquipped(itemId)
	return ClientState.profile ~= nil and ClientState.profile.equipped[itemId] == true
end

function ClientState.consumableCount(itemId)
	return ClientState.profile and ClientState.profile.consumables[itemId] or 0
end

------------------------------------------------------------------
-- Интерфейс
------------------------------------------------------------------
-- Кэш экранов: WaitForChild здесь смертельно опасен — при опечатке в имени
-- поток висит 12 секунд и интерфейс «умирает». Ищем без блокировки.
ClientState.guiCache = {}
ClientState.playerGui.ChildAdded:Connect(function(child)
	if child:IsA("ScreenGui") then
		ClientState.guiCache[child.Name] = child
	end
end)
ClientState.playerGui.ChildRemoved:Connect(function(child)
	if ClientState.guiCache[child.Name] == child then
		ClientState.guiCache[child.Name] = nil
	end
end)

function ClientState.getGui(name)
	local cached = ClientState.guiCache[name]
	if cached and cached.Parent then
		return cached
	end
	local gui = ClientState.playerGui:FindFirstChild(name)
	if not gui then
		-- Короткое ожидание: GUI могли ещё не склонировать в PlayerGui.
		for _ = 1, 20 do
			task.wait(0.05)
			gui = ClientState.playerGui:FindFirstChild(name)
			if gui then
				break
			end
		end
	end
	if gui then
		ClientState.guiCache[name] = gui
	end
	return gui
end

function ClientState.el(guiName, elementName)
	local key = guiName .. "::" .. elementName
	local cached = ClientState.elementCache[key]
	if cached and cached.Parent then
		return cached
	end
	local gui = ClientState.getGui(guiName)
	local found = gui and gui:FindFirstChild(elementName, true)
	if found then
		ClientState.elementCache[key] = found
	end
	return found
end

function ClientState.setGuiEnabled(guiName, enabled)
	local gui = ClientState.getGui(guiName)
	if gui then
		gui.Enabled = enabled
	end
end

function ClientState.tween(instance, duration, goal, style, direction)
	if not instance then
		return nil
	end
	local info = TweenInfo.new(
		duration,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

function ClientState.toast(text, color, icon)
	if not text then
		return
	end
	ClientState.emit("Toast", { text = text, color = color, icon = icon })
end

function ClientState.playSound(name)
	ClientState.emit("Sound", name)
end

function ClientState.isDream()
	return ClientState.phase == "dream"
end

-- Курсор: во сне он заблокирован по центру (первое лицо),
-- но для диалогов, инвентаря и меню его нужно освобождать.
function ClientState.setCursorFree(free)
	local ok = pcall(function()
		if free then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		elseif ClientState.phase == "dream" then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
	end)
	return ok
end

function ClientState.fmtTime(seconds)
	local s = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(s / 60), s % 60)
end

function ClientState.quality()
	return ClientState.settings.quality or "Средний"
end

function ClientState.scareLevel()
	return math.clamp(ClientState.settings.scareIntensity or 1, 0, 1)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8286">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	SoundController.luau
	Музыка меню, эмбиент сна, сердцебиение, шёпот, скримеры, звуки покупок и побед.
	Громкость управляется настройками игрока.
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")

local Config = require(ReplicatedStorage.SharedModules.Config)
local ClientState = require(script.Parent.ClientState)

local SoundController = {}

local groups = {}
local sounds = {}

local function createGroup(name, volume)
	local group = Instance.new("SoundGroup")
	group.Name = name
	group.Volume = volume
	group.Parent = SoundService
	groups[name] = group
	return group
end

local function newSound(name, soundId, groupName, looped, volume)
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Looped = looped == true
	sound.Volume = volume or 0.6
	sound.SoundGroup = groups[groupName] or groups.SFX
	-- Запасной встроенный звук: срабатывает, если основной ассет недоступен
	-- (чужие аудио в Roblox часто закрыты правами).
	sound:SetAttribute("FallbackId", Config.SoundFallbacks[name])
	sound:SetAttribute("FallbackPitch", Config.SoundPitch[name] or 1)
	sound:SetAttribute("PrimaryId", soundId)
	sound.Parent = SoundService
	sounds[name] = sound
	return sound
end

local function playWithFallback(sound)
	pcall(function()
		sound:Play()
	end)
	local fallback = sound:GetAttribute("FallbackId")
	if not fallback or sound:GetAttribute("UsingFallback") then
		return
	end
	task.delay(0.3, function()
		if not sound.Parent then
			return
		end
		-- Основной ассет не загрузился — переключаемся на встроенный.
		local loaded = true
		pcall(function()
			loaded = sound.IsLoaded
		end)
		if sound.IsPlaying and (loaded or sound.TimeLength > 0) then
			return
		end
		if loaded and sound.TimeLength > 0 then
			return
		end
		sound:SetAttribute("UsingFallback", true)
		sound.SoundId = fallback
		sound.PlaybackSpeed = sound:GetAttribute("FallbackPitch") or 1
		pcall(function()
			sound:Play()
		end)
	end)
end

function SoundController.play(name, volumeMultiplier)
	local sound = sounds[name]
	if not sound then
		return
	end
	if sound.IsPlaying and not sound.Looped then
		sound:Stop()
	end
	sound.Volume = (sound:GetAttribute("BaseVolume") or 0.6) * (volumeMultiplier or 1)
	playWithFallback(sound)
end

function SoundController.stop(name, fadeOut)
	local sound = sounds[name]
	if not sound then
		return
	end
	if fadeOut then
		ClientState.tween(sound, fadeOut, { Volume = 0 })
		task.delay(fadeOut, function()
			sound:Stop()
		end)
	else
		sound:Stop()
	end
end

function SoundController.applyVolumes()
	local music = ClientState.settings.musicVolume or 0.5
	local sfx = ClientState.settings.sfxVolume or 0.75
	if groups.Music then
		groups.Music.Volume = music
	end
	if groups.Ambient then
		groups.Ambient.Volume = sfx * 0.8
	end
	if groups.SFX then
		groups.SFX.Volume = sfx
	end
	if groups.Scares then
		groups.Scares.Volume = sfx
	end
end

function SoundController.playMusic(track)
	SoundController.stop("MenuMusic", 0.6)
	SoundController.stop("DreamMusic", 0.6)
	local sound = sounds[track]
	if not sound then
		return
	end
	sound.Volume = 0
	playWithFallback(sound)
	ClientState.tween(sound, 1.6, { Volume = 0.5 })
end

function SoundController.setAmbient(dreamId)
	local ambient = sounds.DreamAmbient
	if not ambient then
		return
	end
	if ambient.IsPlaying then
		ambient:Stop()
	end
	if dreamId then
		playWithFallback(ambient)
	end
end

function SoundController.heartbeat(enabled)
	local sound = sounds.Heartbeat
	if not sound then
		return
	end
	if enabled and not sound.IsPlaying then
		sound.Volume = 0
		playWithFallback(sound)
		ClientState.tween(sound, 0.8, { Volume = 0.5 })
	elseif not enabled and sound.IsPlaying then
		ClientState.tween(sound, 0.8, { Volume = 0 })
		task.delay(0.85, function()
			sound:Stop()
		end)
	end
end

function SoundController.start()
	createGroup("Music", 0.5)
	createGroup("Ambient", 0.5)
	createGroup("SFX", 0.75)
	createGroup("Scares", 0.9)

	local music = newSound("MenuMusic", Config.Sounds.MenuMusic, "Music", true, 0.5)
	music:SetAttribute("BaseVolume", 0.5)
	local dreamMusic = newSound("DreamMusic", Config.Sounds.DreamAmbient, "Music", true, 0.35)
	dreamMusic:SetAttribute("BaseVolume", 0.35)
	local heartbeat = newSound("Heartbeat", Config.Sounds.Heartbeat, "Scares", true, 0.5)
	heartbeat:SetAttribute("BaseVolume", 0.5)
	local whisper = newSound("Whisper", Config.Sounds.Whisper, "Scares", false, 0.55)
	whisper:SetAttribute("BaseVolume", 0.55)
	local scare = newSound("Scare", Config.Sounds.Scare, "Scares", false, 0.9)
	scare:SetAttribute("BaseVolume", 0.9)
	local growl = newSound("MonsterGrowl", Config.Sounds.MonsterGrowl, "Scares", false, 0.7)
	growl:SetAttribute("BaseVolume", 0.7)
	local click = newSound("Click", Config.Sounds.Click, "SFX", false, 0.5)
	click:SetAttribute("BaseVolume", 0.5)
	local purchase = newSound("Purchase", Config.Sounds.Purchase, "SFX", false, 0.7)
	purchase:SetAttribute("BaseVolume", 0.7)
	local win = newSound("Win", Config.Sounds.Win, "Music", false, 0.8)
	win:SetAttribute("BaseVolume", 0.8)
	local lose = newSound("Lose", Config.Sounds.Lose, "Scares", false, 0.8)
	lose:SetAttribute("BaseVolume", 0.8)
	local door = newSound("DoorCreak", Config.Sounds.DoorCreak, "SFX", false, 0.6)
	door:SetAttribute("BaseVolume", 0.6)
	local pickup = newSound("Pickup", Config.Sounds.Pickup, "SFX", false, 0.55)
	pickup:SetAttribute("BaseVolume", 0.55)
	local portal = newSound("Portal", Config.Sounds.Portal, "Scares", false, 0.7)
	portal:SetAttribute("BaseVolume", 0.7)
	local growlBig = newSound("BigScare", Config.Sounds.BigScare, "Scares", false, 1)
	growlBig:SetAttribute("BaseVolume", 1)
	local whisperLoop = newSound("WhisperLoop", Config.Sounds.Whisper, "Ambient", true, 0)
	whisperLoop:SetAttribute("BaseVolume", 0.35)

	SoundController.applyVolumes()
	ClientState.on("Sound", function(name)
		SoundController.play(name)
	end)
	ClientState.on("Profile", function()
		SoundController.applyVolumes()
	end)
end

function SoundController.setMenu()
	SoundController.applyVolumes()
	SoundController.heartbeat(false)
	SoundController.setAmbient(nil)
	SoundController.playMusic("MenuMusic")
end

function SoundController.setDream()
	SoundController.applyVolumes()
	SoundController.playMusic("DreamMusic")
	SoundController.setAmbient(true)
end

-- Шёпот на фоне при низком рассудке (плавно, без щелчков)
function SoundController.whispers(enabled, intensity)
	local sound = sounds.WhisperLoop
	if not sound then
		return
	end
	local level = math.clamp(intensity or 0.5, 0, 1) * 0.45
	if enabled then
		if not sound.IsPlaying then
			sound.Volume = 0
			playWithFallback(sound)
		end
		ClientState.tween(sound, 1.2, { Volume = level })
	elseif sound.IsPlaying then
		ClientState.tween(sound, 1.2, { Volume = 0 })
		task.delay(1.3, function()
			if sound and sound.IsPlaying and sound.Volume <= 0.02 then
				sound:Stop()
			end
		end)
	end
end

function SoundController.setWaking(won)
	SoundController.heartbeat(false)
	SoundController.setAmbient(nil)
	SoundController.stop("DreamMusic", 1)
	SoundController.play(won and "Win" or "Lose")
end

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8287">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	CameraController.luau
	Кинематографичная камера меню, строгое первое лицо во сне,
	камера для катсцен и тряска (её можно отключить в настройках).
]]

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)

local CameraController = {}

local camera = Workspace.CurrentCamera
local mode = "menu"
local menuTime = 0
local shakeAmount = 0
local shakeDecay = 0
local connection

local function getBedroom()
	return Workspace:FindFirstChild("MenuBedroom")
end

local function getCameraNodes()
	local bedroom = getBedroom()
	local result = {}
	if not bedroom then
		return result
	end
	local folder = bedroom:FindFirstChild("CameraPath")
	if not folder then
		return result
	end
	local nodes = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			local index = tonumber(child.Name:match("%d+")) or 1
			nodes[index] = child
		end
	end
	for index = 1, #nodes do
		if nodes[index] then
			table.insert(result, nodes[index])
		end
	end
	return result
end

local function getLookTarget()
	local bedroom = getBedroom()
	local target = bedroom and bedroom:FindFirstChild("CameraTarget", true)
	if target and target:IsA("BasePart") then
		return target.Position
	end
	return Vector3.new(0, 6, -2)
end

function CameraController.setMode(newMode)
	mode = newMode
	camera = Workspace.CurrentCamera
	if mode == "menu" then
		camera.CameraType = Enum.CameraType.Custom
		CameraController.releaseToPlayer()
		ClientState.player.CameraMode = Enum.CameraMode.Classic
	elseif mode == "dream" then
		camera.CameraType = Enum.CameraType.Custom
		ClientState.player.CameraMode = Enum.CameraMode.LockFirstPerson
		camera.FieldOfView = 78
	elseif mode == "script" then
		camera.CameraType = Enum.CameraType.Scriptable
		ClientState.player.CameraMode = Enum.CameraMode.Classic
	end
end

-- Возвращает управление камерой персонажу (лобби).
function CameraController.releaseToPlayer()
	local character = ClientState.player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Custom
	if humanoid then
		camera.CameraSubject = humanoid
	end
	ClientState.player.CameraMode = Enum.CameraMode.Classic
end

function CameraController.getMode()
	return mode
end

function CameraController.setFieldOfView(fov, duration)
	ClientState.tween(camera, duration or 1, { FieldOfView = fov })
end

function CameraController.shake(intensity, duration)
	if not ClientState.settings.cameraShake then
		return
	end
	local scare = math.clamp(ClientState.settings.scareIntensity or 1, 0.35, 1.6)
	shakeAmount = math.max(shakeAmount, (intensity or 0.5) * scare)
	shakeDecay = math.max(shakeDecay, (intensity or 0.5) * scare / math.max(0.2, duration or 1))
end

function CameraController.setScriptableCFrame(cframe)
	mode = "script"
	camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = cframe
end

function CameraController.applySensitivity()
	local sensitivity = ClientState.settings.sensitivity or 0.5
	UserInputService.MouseDeltaSensitivity = 0.4 + sensitivity * 1.6
	if sensitivity < 0.2 then
		ClientState.tween(camera, 1, { FieldOfView = mode == "dream" and 60 or 70 })
	end
end

function CameraController.lookAt(target, cframePosition)
	if not cframePosition then
		return
	end
	local direction = (target - cframePosition).Unit
	CameraController.setScriptableCFrame(CFrame.lookAt(cframePosition, cframePosition + direction))
end

function CameraController.start()
	applySensitivity()
	local nodes = getCameraNodes()
	if #nodes == 0 then
		-- Запасная траектория, если карта меню не загрузилась
		nodes = {
			{ CFrame = CFrame.new(6, 7, 10) },
			{ CFrame = CFrame.new(-6, 6, 8) },
			{ CFrame = CFrame.new(-2, 8, -4) },
		}
	end
	local target = getLookTarget()
	local segmentTime = 9

	connection = RunService.RenderStepped:Connect(function(dt)
		camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		menuTime += dt

		if mode == "menu" then
			-- В лобби камера обычная (от третьего лица), игрок свободно ходит.
			if camera.CameraType ~= Enum.CameraType.Custom then
				CameraController.releaseToPlayer()
			end
		end

		if shakeAmount > 0.001 then
			shakeAmount = math.max(0, shakeAmount - shakeDecay * dt)
			local offset = Vector3.new(
				(math.random() - 0.5) * shakeAmount,
				(math.random() - 0.5) * shakeAmount,
				0
			) * 0.35
			if camera.CameraType == Enum.CameraType.Scriptable then
				camera.CFrame = camera.CFrame * CFrame.new(offset) * CFrame.Angles(0, 0, math.rad((math.random() - 0.5) * shakeAmount))
			else
				local character = ClientState.player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.CameraOffset = Vector3.new(offset.X, offset.Y, 0)
				end
			end
		else
			local character = ClientState.player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.CameraOffset.Magnitude > 0.001 then
				humanoid.CameraOffset = Vector3.zero
			end
		end
	end)
end

function CameraController.stop()
	if connection then
		connection:Disconnect()
		connection = nil
	end
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8288">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	InputController.luau
	Управление:
		WASD — движение, SHIFT — бег, E — взаимодействие, F — фонарик,
		TAB — задания, Q — эликсир рассудка, ESC — закрыть окно.
	Мобильные кнопки приходят из DreamHUD (SprintButton / InteractButton / FlashlightButton / UseItemButton).
]]

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local ClientState = require(script.Parent.ClientState)

local InputController = {}

local sprinting = false
local flashlightOn = false
local lookAccumulator = 0
local actionsBound = false

local function interactRemote()
	return Remotes.get("Interact")
end

local function sendSprint(want)
	if sprinting == want then
		return
	end
	sprinting = want
	local remote = Remotes.get("SetSprinting")
	if remote then
		remote:FireServer(want)
	end
end

function InputController.toggleFlashlight(force)
	if not ClientState.isDream() then
		return
	end
	local battery = (ClientState.vitals and ClientState.vitals.battery) or 100
	if force == nil and not flashlightOn and battery <= 1 then
		ClientState.toast("Батарея пуста — используй батарейку (Q или магазин)", Color3.fromRGB(255, 176, 120), "🔋")
		return
	end
	if force ~= nil then
		flashlightOn = force == true
	else
		flashlightOn = not flashlightOn
	end
	local remote = Remotes.get("SetFlashlight")
	if remote then
		remote:FireServer(flashlightOn)
	end
	-- Включаем локальный луч сразу, сервер подтвердит или выключит при пустой батарее.
	ClientState.emit("Flashlight", flashlightOn)
	if flashlightOn and ClientState.ownsItem("lantern") then
		ClientState.toast("Лампа сновидца: широкий тёплый свет", Color3.fromRGB(255, 214, 156), "🏮")
	end
end

function InputController.setSprintEnabled(enabled)
	if not ClientState.isDream() then
		sendSprint(false)
		return
	end
	sendSprint(enabled == true)
end

function InputController.interact()
	if not ClientState.prompt or not ClientState.prompt.id then
		return
	end
	local remote = interactRemote()
	if remote then
		remote:FireServer(ClientState.prompt.id)
	end
	ClientState.emit("Interacted")
end

function InputController.useSanityPotion()
	if not ClientState.isDream() then
		return
	end
	local count = ClientState.consumableCount("sanity_potion")
	if count <= 0 then
		ClientState.toast("Нет эликсира рассудка", Color3.fromRGB(255, 150, 150), "🧪")
		return
	end
	Remotes.get("UseItem"):FireServer("sanity_potion")
end

function InputController.resetSprint()
	sprinting = false
end

function InputController.start()
	if actionsBound then
		return
	end
	actionsBound = true

	ContextActionService:BindAction("DreamSprint", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController.setSprintEnabled(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			InputController.setSprintEnabled(false)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)

	ContextActionService:BindAction("DreamInteract", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController.interact()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.E)

	ContextActionService:BindAction("DreamFlashlight", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController.toggleFlashlight()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.F)

	ContextActionService:BindAction("DreamQuestLog", function(_, state)
		if state == Enum.UserInputState.Begin then
			ClientState.emit("ToggleQuestLog")
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Tab)

	ContextActionService:BindAction("DreamUseItem", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController.useSanityPotion()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Q)

	ContextActionService:BindAction("DreamClosePanel", function(_, state)
		if state == Enum.UserInputState.Begin then
			ClientState.emit("ClosePanel")
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape)

	-- Мобильные действия из HUD
	-- Держим локальное состояние в согласии с сервером (он гасит свет при пустой батарее).
	ClientState.on("Vitals", function(data)
		if data and data.flashlight ~= nil then
			local serverOn = data.flashlight == true
			if serverOn ~= flashlightOn then
				flashlightOn = serverOn
				ClientState.emit("Flashlight", serverOn)
			end
		end
	end)

	-- Обратная связь по взаимодействию: сервер объясняет, почему не вышло.
	Remotes.get("InteractionResult").OnClientEvent:Connect(function(data)
		if not data or data.ok then
			return
		end
		if data.reason == "too_far" then
			ClientState.toast("Слишком далеко — подойди ближе", Color3.fromRGB(255, 190, 150), "🚶")
		elseif data.reason == "portal_locked" then
			ClientState.toast("Портал закрыт: сначала основное задание", Color3.fromRGB(190, 170, 255), "🌀")
		end
	end)

	ClientState.on("MobileAction", function(action)
		if action == "sprint" then
			if sprinting then
				InputController.setSprintEnabled(false)
				ClientState.toast("Бег выключен", Color3.fromRGB(160, 200, 255), "🏃")
			elseif (ClientState.vitals and ClientState.vitals.stamina or 0) > 8 then
				InputController.setSprintEnabled(true)
				ClientState.toast("Бег включён — монстры слышат тебя", Color3.fromRGB(255, 200, 150), "🏃")
			else
				ClientState.toast("Не хватает выносливости", Color3.fromRGB(255, 150, 150), "⚡")
			end
		elseif action == "interact" then
			InputController.interact()
		elseif action == "flashlight" then
			InputController.toggleFlashlight()
		elseif action == "item" then
			InputController.useSanityPotion()
		end
	end)

	-- Отправка направления взгляда (нужно НАБЛЮДАТЕЛЮ)
	RunService.RenderStepped:Connect(function(dt)
		if not ClientState.isDream() then
			return
		end
		lookAccumulator += dt
		if lookAccumulator > 0.25 then
			lookAccumulator = 0
			local camera = workspace.CurrentCamera
			local remote = Remotes.get("LookUpdate")
			if camera and remote then
				remote:FireServer(camera.CFrame.LookVector)
			end
		end
		if sprinting then
			local vitals = ClientState.vitals
			if vitals and vitals.stamina and vitals.stamina <= 1 then
				sendSprint(false)
			end
		end
	end)

	ClientState.on("Phase", function(phase)
		if phase == "menu" or phase == "result" then
			InputController.resetSprint()
			flashlightOn = false
			ClientState.emit("Flashlight", false)
		elseif phase == "dream" then
			flashlightOn = false
			ClientState.emit("Flashlight", false)
		end
	end)
end

function InputController.isFlashlightOn()
	return flashlightOn
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8289">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	HUDController.luau
	Игровой интерфейс сна: таймер, рассудок/выносливость/здоровье, задания,
	подсказки, уведомления, диалоги, события, компас и мобильные кнопки.
]]

local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.SharedModules.Config)
local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local ClientState = require(script.Parent.ClientState)

local HUDController = {}

local hud
local dialogGui
local resultGui
local toastQueue = {}
local toastActive = false
local questLogOpen = false
local dialogOpen = false
local eventHideAt = 0
local monsterAlertUntil = 0

local function getGui()
	hud = hud or ClientState.getGui("DreamHUD")
	return hud
end

local function setVisible(element, visible)
	if element then
		element.Visible = visible
	end
end

------------------------------------------------------------------
-- Уведомления
------------------------------------------------------------------
local function showNextToast()
	if toastActive or #toastQueue == 0 then
		return
	end
	local gui = getGui()
	local area = gui and gui:FindFirstChild("ToastArea", true)
	local template = area and area:FindFirstChild("ToastTemplate")
	if not area or not template then
		return
	end
	toastActive = true
	local payload = table.remove(toastQueue, 1)

	local frame = template:Clone()
	frame.Name = "Toast"
	-- HUD может быть ещё выключен в момент прихода события — включаем явно.
	local gui = getGui()
	if gui then
		gui.Enabled = true
	end
	frame.Visible = true
	frame.Parent = area
	if payload.color then
		local accent = frame:FindFirstChild("Accent") or frame:FindFirstChildWhichIsA("Frame")
		if accent and accent ~= frame then
			accent.BackgroundColor3 = payload.color
		end
		local stroke = frame:FindFirstChildWhichIsA("UIStroke")
		if stroke then
			stroke.Color = payload.color
		end
		local text = frame:FindFirstChild("Text")
		if text then
			text.TextColor3 = payload.color
		end
	end
	local icon = frame:FindFirstChild("Icon")
	if icon then
		icon.Text = payload.icon or "✨"
	end
	local text = frame:FindFirstChild("Text")
	if text then
		text.Text = payload.text
	end
	frame.BackgroundTransparency = 1
	frame.Position = UDim2.new(frame.Position.X.Scale + 0.05, 0, frame.Position.Y.Scale, 0)
	ClientState.tween(frame, 0.22, {
		BackgroundTransparency = 0.12,
		Position = UDim2.new(1 - frame.Size.X.Scale - 0.02, 0, frame.Position.Y.Scale, 0),
	})
	task.delay(3.4, function()
		ClientState.tween(frame, 0.35, { BackgroundTransparency = 1, Position = UDim2.new(frame.Position.X.Scale + 0.05, 0, frame.Position.Y.Scale, 0) })
		task.wait(0.4)
		if frame then
			frame:Destroy()
		end
		toastActive = false
		showNextToast()
	end)
end

function HUDController.toast(payload)
	table.insert(toastQueue, payload)
	showNextToast()
end

------------------------------------------------------------------
-- Задания
------------------------------------------------------------------

local function clearChildren(parent, keepNames)
	for _, child in ipairs(parent:GetChildren()) do
		if not keepNames or not keepNames[child.Name] then
			if child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" and child.Name ~= "ObjectiveTemplate" and child.Name ~= "QuestEntryTemplate" then
				child:Destroy()
			end
		end
	end
end

local function buildObjectiveText(quest)
	local parts = {}
	for _, objective in ipairs(quest.objectives) do
		local prefix = objective.done and "✔" or "•"
		local progress = objective.goal > 1 and (" " .. objective.current .. "/" .. objective.goal) or ""
		table.insert(parts, prefix .. " " .. objective.text .. progress)
	end
	return table.concat(parts, "\n")
end

-- Плашка «ФОНАРИК: ВКЛ/ВЫКЛ» + цвет по заряду
-- Заголовок сна на первые секунды: «Тёмный лес · Обычный»
function HUDController.showDreamIntro(payload)
	local frame = ClientState.el("DreamHUD", "DreamIntro")
	if not frame then
		return
	end
	local title = ClientState.el("DreamHUD", "IntroTitle")
	local subtitle = ClientState.el("DreamHUD", "IntroSubtitle")
	local hint = ClientState.el("DreamHUD", "IntroHint")
	if title then
		title.Text = (payload.icon or "🌙") .. " " .. tostring(payload.dreamName or "Сон")
		title.TextTransparency = 1
	end
	if subtitle then
		subtitle.Text = tostring(payload.subtitle or "Каждый сон — новая история...")
		subtitle.TextTransparency = 1
	end
	if hint then
		hint.Text = "Сложность: " .. tostring(payload.difficultyName or "Обычный") .. "  ·  F — фонарик, E — взаимодействие, TAB — задания"
		hint.TextTransparency = 1
	end
	-- HUD может быть ещё выключен в момент прихода события — включаем явно.
	local gui = getGui()
	if gui then
		gui.Enabled = true
	end
	frame.Visible = true
	for _, label in ipairs({ title, subtitle, hint }) do
		if label then
			ClientState.tween(label, 0.7, { TextTransparency = 0 })
		end
	end
	task.delay(3.4, function()
		for _, label in ipairs({ title, subtitle, hint }) do
			if label and label.Parent then
				ClientState.tween(label, 0.8, { TextTransparency = 1 })
			end
		end
		task.wait(0.9)
		if frame and frame.Parent then
			frame.Visible = false
		end
	end)
end

function HUDController.renderFlashlight(data)
	local label = ClientState.el("DreamHUD", "FlashlightLabel")
	local chip = ClientState.el("DreamHUD", "FlashlightChip")
	local on = data and data.flashlight == true
	local battery = math.floor((data and data.battery) or 0)
	if label then
		if on then
			label.Text = "🔦 ФОНАРИК: ВКЛ · " .. tostring(battery) .. "%"
			label.TextColor3 = Color3.fromRGB(255, 226, 150)
		else
			label.Text = "🔦 ФОНАРИК: ВЫКЛ · " .. tostring(battery) .. "%"
			label.TextColor3 = Color3.fromRGB(158, 161, 198)
		end
	end
	if chip then
		local stroke = chip:FindFirstChildWhichIsA("UIStroke")
		if stroke then
			stroke.Transparency = on and 0.15 or 0.6
			stroke.Color = on and Color3.fromRGB(255, 209, 102) or Color3.fromRGB(120, 122, 160)
		end
		chip.BackgroundTransparency = on and 0.1 or 0.3
	end
	-- Процент заряда прямо в подписи шкалы батареи
	local batteryBar = ClientState.el("DreamHUD", "BatteryBar")
	if batteryBar then
		for _, child in ipairs(batteryBar:GetChildren()) do
			if child:IsA("TextLabel") then
				child.Text = "🔦 БАТАРЕЯ: " .. tostring(battery) .. "%"
				child.TextColor3 = battery < 20 and Color3.fromRGB(255, 150, 150) or Color3.fromRGB(158, 161, 198)
			end
		end
	end
	-- Мобильная кнопка фонарика
	local mobileButton = ClientState.el("DreamHUD", "FlashlightButton")
	if mobileButton then
		mobileButton.BackgroundTransparency = on and 0.05 or 0.25
	end
	-- Предупреждение о низком заряде (один раз за сон)
	if not on and battery > 0 and battery <= 18 and not HUDController.batteryWarned then
		HUDController.batteryWarned = true
		ClientState.toast("Батарея фонарика почти пуста", Color3.fromRGB(255, 190, 120), "🔋")
	end
end

function HUDController.renderQuests()
	local gui = getGui()
	if not gui then
		return
	end
	-- Трекер
	local tracker = gui:FindFirstChild("QuestTracker", true)
	if tracker then
		local list = tracker:FindFirstChild("ObjectiveList")
		local title = tracker:FindFirstChild("QuestTitle")
		local template = list and list:FindFirstChild("ObjectiveTemplate")
		if list and template then
			for _, child in ipairs(list:GetChildren()) do
				if child ~= template and child:IsA("TextLabel") then
					child:Destroy()
				end
			end
			local shown = 0
			local mainTitle = nil
			for _, quest in ipairs(ClientState.quests) do
				if quest.state == "active" and shown < 2 then
					shown += 1
					if not mainTitle then
						mainTitle = (quest.mandatory and "❗ " or "⭐ ") .. quest.title
					end
					for _, objective in ipairs(quest.objectives) do
						local label = template:Clone()
						label.Name = "Objective"
						label.Visible = true
						label.Text = (objective.done and "✔ " or "• ") .. objective.text ..
							(objective.goal > 1 and ("  " .. objective.current .. "/" .. objective.goal) or "")
						label.TextColor3 = objective.done and Color3.fromRGB(140, 240, 180) or Color3.fromRGB(220, 225, 255)
						label.Parent = list
					end
				end
			end
			if shown == 0 then
				local offerered = nil
				for _, quest in ipairs(ClientState.quests) do
					if quest.state == "offered" then
						offerered = quest
						break
					end
				end
				if offerered then
					mainTitle = "📜 Новое задание у " .. (offerered.giver or "NPC")
				else
					mainTitle = "Все задания выполнены"
				end
			end
			if title then
				title.Text = mainTitle or "ЗАДАНИЯ"
			end
			tracker.Visible = true
		end
	end

	-- Полный лог
	local logFrame = gui:FindFirstChild("QuestLog", true)
	if logFrame then
		local list = logFrame:FindFirstChild("QuestLogList")
		local template = list and list:FindFirstChild("QuestEntryTemplate")
		if list and template then
			for _, child in ipairs(list:GetChildren()) do
				if child ~= template and child:IsA("Frame") then
					child:Destroy()
				end
			end
			local count = 0
			for _, quest in ipairs(ClientState.quests) do
				count += 1
				local entry = template:Clone()
				entry.Name = "Quest_" .. quest.id
				entry.Visible = true
				entry.Parent = list
				local title = entry:FindFirstChild("Title")
				if title then
					local stateText = "В РАБОТЕ"
					if quest.state == "done" then
						stateText = "ВЫПОЛНЕНО"
					elseif quest.state == "offered" then
						stateText = "ПОГОВОРИТЕ С NPC"
					end
					title.Text = (quest.mandatory and "❗ " or "⭐ ") .. quest.title .. "  <font color='#9d92c9'>[" .. stateText .. "]</font>"
					title.TextColor3 = quest.state == "done" and Color3.fromRGB(140, 240, 180) or Color3.fromRGB(245, 240, 255)
				end
				local body = entry:FindFirstChild("Body")
				if body then
					if quest.state == "offered" then
						body.Text = "Выдаёт: " .. (quest.giver or "NPC") .. "\nНаграда: " .. quest.reward .. " 🪙\nПоговорите с ним, чтобы начать."
					else
						body.Text = buildObjectiveText(quest) .. "\n\nНаграда: " .. quest.reward .. " 🪙"
					end
				end
				local accent = entry:FindFirstChild("Accent")
				if accent then
					accent.BackgroundColor3 = quest.mandatory and Color3.fromRGB(255, 140, 160) or Color3.fromRGB(255, 214, 120)
				end
			end
			local empty = logFrame:FindFirstChild("EmptyLabel")
			if empty then
				empty.Visible = count == 0
			end
		end
	end
end

function HUDController.toggleQuestLog(force)
	local gui = getGui()
	if not gui then
		return
	end
	local logFrame = gui:FindFirstChild("QuestLog", true)
	if not logFrame then
		return
	end
	questLogOpen = force ~= nil and force or not questLogOpen
	HUDController.renderQuests()
	logFrame.Visible = questLogOpen
	if questLogOpen then
		logFrame.BackgroundTransparency = 1
		ClientState.tween(logFrame, 0.25, { BackgroundTransparency = 0.08 })
	end
	ClientState.setCursorFree(questLogOpen)
	ClientState.emit("QuestLogToggled", questLogOpen)
end

------------------------------------------------------------------
-- Диалоги
------------------------------------------------------------------

local function closeDialog()
	dialogOpen = false
	local gui = getGui()
	if gui then
		local dialog = gui:FindFirstChild("Dialog", true)
		setVisible(dialog, false)
	end
	ClientState.setCursorFree(false)
end

function HUDController.openDialog(payload)
	local gui = getGui()
	if not gui then
		return
	end
	-- В первом лице курсор заблокирован: освобождаем, иначе варианты не нажать
	ClientState.setCursorFree(true)
	local dialog = gui:FindFirstChild("Dialog", true)
	if not dialog then
		return
	end
	dialogOpen = true
	dialog.Visible = true
	local panel = dialog:FindFirstChild("Panel") or dialog
	local nameLabel = panel:FindFirstChild("NpcName", true)
	local textLabel = panel:FindFirstChild("DialogText", true)
	local portrait = panel:FindFirstChild("Portrait", true)
	local optionsFrame = panel:FindFirstChild("Options", true)
	if nameLabel then
		nameLabel.Text = payload.npcName or "??? "
	end
	if textLabel then
		textLabel.Text = payload.text or ""
		textLabel.TextTransparency = 1
		ClientState.tween(textLabel, 0.35, { TextTransparency = 0 })
	end
	if portrait then
		local icon = portrait:FindFirstChild("Icon")
		if icon then
			icon.Text = payload.kind == "code" and "🔐" or (payload.kind == "note" and "📜" or "👤")
		end
	end
	if optionsFrame then
		local template = optionsFrame:FindFirstChild("OptionTemplate")
		for _, child in ipairs(optionsFrame:GetChildren()) do
			if child ~= template and child:IsA("TextButton") then
				child:Destroy()
			end
		end
		if template then
			local options = payload.options or {}
			for index, option in ipairs(options) do
				local button = template:Clone()
				button.Name = "Option_" .. index
				button.Visible = true
				button.Parent = optionsFrame
				local label = button:FindFirstChild("Label") or button
				if label and label ~= button then
					label.Text = tostring(index) .. ". " .. option.text
				else
					button.Text = option.text
				end
				button.BackgroundTransparency = 1
				local stroke = button:FindFirstChildWhichIsA("UIStroke")
				button.MouseEnter:Connect(function()
					ClientState.tween(button, 0.15, { BackgroundTransparency = 0.55 })
					if stroke then
						ClientState.tween(stroke, 0.15, { Transparency = 0 })
					end
				end)
				button.MouseLeave:Connect(function()
					ClientState.tween(button, 0.2, { BackgroundTransparency = 0.85 })
					if stroke then
						ClientState.tween(stroke, 0.2, { Transparency = 0.5 })
					end
				end)
				button.MouseButton1Click:Connect(function()
					ClientState.playSound("Click")
					Remotes.get("DialogChoice"):FireServer(option.action)
					if option.action == "close" then
						closeDialog()
					end
				end)
			end
		end
	end
end

function HUDController.closeDialog()
	closeDialog()
end

------------------------------------------------------------------
-- Инициализация
------------------------------------------------------------------
HUDController.batteryWarned = false

function HUDController.start()
	local gui = getGui()
	if not gui then
		return
	end
	hud = gui
	gui.Enabled = false

	local function bind(name, handler)
		local element = ClientState.el("DreamHUD", name)
		if element then
			element.MouseButton1Click:Connect(function()
				ClientState.playSound("Click")
				handler()
			end)
		end
	end
	bind("SprintButton", function()
		ClientState.emit("MobileAction", "sprint")
	end)
	bind("InteractButton", function()
		ClientState.emit("MobileAction", "interact")
	end)
	bind("FlashlightButton", function()
		ClientState.emit("MobileAction", "flashlight")
	end)
	bind("UseItemButton", function()
		ClientState.emit("MobileAction", "item")
	end)
	bind("QuestLogClose", function()
		HUDController.toggleQuestLog(false)
	end)

	local mobile = ClientState.el("DreamHUD", "MobileControls")
	if mobile then
		mobile.Visible = ClientState.isMobile
	end
	local crosshair = ClientState.el("DreamHUD", "Crosshair")
	if crosshair then
		crosshair.Visible = false
	end

	ClientState.on("Toast", HUDController.toast)

	ClientState.on("Phase", function(phase)
		local visible = phase == "dream" or phase == "waking"
		gui.Enabled = visible
		if phase == "dream" then
			HUDController.batteryWarned = false
		elseif phase == "menu" then
			closeDialog()
			HUDController.toggleQuestLog(false)
			local intro = ClientState.el("DreamHUD", "DreamIntro")
			if intro then
				intro.Visible = false
			end
		end
	end)

	-- Выбор варианта диалога цифрами 1..9 (удобно и без мыши)
	ContextActionService:BindAction("DreamDialogChoose", function(_, state, input)
		if state ~= Enum.UserInputState.Begin or not dialogOpen then
			return Enum.ContextActionResult.Pass
		end
		local numbers = {
			[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
			[Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
			[Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9,
		}
		local number = numbers[input.KeyCode]
		if not number then
			return Enum.ContextActionResult.Pass
		end
		local gui = getGui()
		local dialog = gui and gui:FindFirstChild("Dialog", true)
		local options = dialog and dialog:FindFirstChild("Options", true)
		if not options then
			return Enum.ContextActionResult.Pass
		end
		local buttons = {}
		for _, child in ipairs(options:GetChildren()) do
			if child:IsA("TextButton") and child.Name:match("^Option_") then
				table.insert(buttons, child)
			end
		end
		table.sort(buttons, function(a, b)
			return (tonumber(a.Name:match("%d+")) or 0) < (tonumber(b.Name:match("%d+")) or 0)
		end)
		local target = buttons[number]
		if target then
			target:Activate()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four,
		Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine)

	Remotes.get("QuestCompleted").OnClientEvent:Connect(function(data)
		ClientState.playSound("Pickup")
		-- Обязательное задание открывает портал — отдельный «магический» звук.
		if data and data.mandatory then
			task.delay(0.35, function()
				ClientState.playSound("Portal")
			end)
		end
	end)

	Remotes.get("DreamStarted").OnClientEvent:Connect(function(data)
		HUDController.batteryWarned = false
		HUDController.showDreamIntro(data or {})
	end)

	Remotes.get("TimerUpdate").OnClientEvent:Connect(function(data)
		ClientState.timer.remaining = data.remaining
		ClientState.timer.total = data.total or Config.DreamDuration
		local label = ClientState.el("DreamHUD", "TimerLabel")
		if label then
			label.Text = "🌙 ДО ПРОБУЖДЕНИЯ: " .. ClientState.fmtTime(data.remaining)
			label.TextColor3 = data.remaining <= 60 and Color3.fromRGB(255, 120, 130) or Color3.fromRGB(240, 238, 255)
		end
		local bar = ClientState.el("DreamHUD", "TimerBar")
		local fill = bar and bar:FindFirstChild("Fill")
		if fill then
			ClientState.tween(fill, 0.25, { Size = UDim2.new(math.clamp(data.remaining / (data.total or 600), 0, 1), 0, 1, 0) })
		end
	end)

	Remotes.get("VitalsUpdate").OnClientEvent:Connect(function(data)
		ClientState.vitals = data
		local function setBar(name, value, max)
			local bar = ClientState.el("DreamHUD", name)
			local fill = bar and bar:FindFirstChild("Fill")
			if fill then
				ClientState.tween(fill, 0.2, { Size = UDim2.new(math.clamp(value / math.max(1, max), 0, 1), 0, 1, 0) })
			end
		end
		setBar("SanityBar", data.sanity, data.maxSanity or 100)
		setBar("StaminaBar", data.stamina, data.maxStamina or 100)
		setBar("HealthBar", data.health, data.maxHealth or 100)
		setBar("BatteryBar", data.battery or 100, data.batteryMax or 100)
		HUDController.renderFlashlight(data)
		ClientState.emit("Vitals", data)
	end)

	Remotes.get("PromptUpdate").OnClientEvent:Connect(function(data)
		ClientState.prompt = data and data.id and data or nil
		local promptFrame = ClientState.el("DreamHUD", "InteractPrompt")
		if not promptFrame then
			return
		end
		if data and data.id and not dialogOpen then
			promptFrame.Visible = true
			local label = promptFrame:FindFirstChild("PromptText")
			if label then
				label.Text = data.text or "Взаимодействовать"
			end
			local key = promptFrame:FindFirstChild("KeyLabel")
			if key then
				key.Text = ClientState.isMobile and "👆" or "E"
			end
		else
			promptFrame.Visible = false
		end
	end)

	Remotes.get("QuestUpdate").OnClientEvent:Connect(function(data)
		ClientState.quests = data.quests or {}
		ClientState.mandatoryLeft = data.mandatoryLeft or 0
		HUDController.renderQuests()
		local hint = ClientState.el("DreamHUD", "HintLabel")
		if hint then
			if ClientState.quests and #ClientState.quests > 0 then
				local anyActive = false
				for _, quest in ipairs(ClientState.quests) do
					if quest.state == "active" then
						anyActive = true
					end
				end
				if not anyActive then
					hint.Text = "Найдите NPC с меткой ❗ и возьмите задание"
					hint.Visible = true
					task.delay(7, function()
						if hint then
							hint.Visible = false
						end
					end)
				end
			end
		end
	end)

	Remotes.get("QuestCompleted").OnClientEvent:Connect(function(data)
		ClientState.playSound("Purchase")
		HUDController.toast({
			text = (data.mandatory and "Обязательное задание выполнено: " or "Задание выполнено: ") .. (data.title or ""),
			color = data.mandatory and Color3.fromRGB(140, 240, 200) or Color3.fromRGB(255, 220, 140),
			icon = data.mandatory and "✅" or "⭐",
		})
		HUDController.toast({
			text = "+" .. tostring(data.reward or 0) .. " Dream Coins",
			color = Color3.fromRGB(255, 220, 140),
			icon = "🪙",
		})
	end)

	Remotes.get("DialogOpen").OnClientEvent:Connect(function(payload)
		if ClientState.phase ~= "dream" then
			return
		end
		HUDController.openDialog(payload)
	end)

	Remotes.get("DialogClosed").OnClientEvent:Connect(function()
		closeDialog()
	end)

	Remotes.get("EventStarted").OnClientEvent:Connect(function(data)
		local banner = ClientState.el("DreamHUD", "EventBanner")
		if not banner then
			return
		end
		banner.Visible = true
		local icon = banner:FindFirstChild("EventIcon")
		local title = banner:FindFirstChild("EventTitle")
		local desc = banner:FindFirstChild("EventDesc")
		if icon then
			icon.Text = data.icon or "⚡"
		end
		if title then
			title.Text = data.title or "СОБЫТИЕ"
		end
		if desc then
			desc.Text = data.description or ""
		end
		banner.BackgroundTransparency = 1
		ClientState.tween(banner, 0.4, { BackgroundTransparency = 0.15 })
		eventHideAt = os.clock() + math.min(6, data.duration or 4) + 1.5
		task.delay(1.2, function()
			ClientState.tween(banner, 0.3, { Size = UDim2.new(0, 560, 0, 110) })
		end)
		task.delay(math.min(7, (data.duration or 4) + 1.5), function()
			ClientState.tween(banner, 0.5, { BackgroundTransparency = 1 })
			task.wait(0.6)
			if banner then
				banner.Visible = false
			end
		end)
	end)

	Remotes.get("MonsterAlert").OnClientEvent:Connect(function(data)
		local alert = ClientState.el("DreamHUD", "MonsterAlert")
		if not alert then
			return
		end
		local nameLabel = alert:FindFirstChild("MonsterName")
		if nameLabel then
			nameLabel.Text = "ОНО РЯДОМ: " .. tostring(data.name or "МОНСТР")
		end
		alert.Visible = true
		alert.BackgroundTransparency = 0
		monsterAlertUntil = os.clock() + 4
		ClientState.tween(alert, 0.4, { BackgroundTransparency = 1 })
		task.delay(4, function()
			if alert and os.clock() >= monsterAlertUntil then
				alert.Visible = false
			end
		end)
	end)

	Remotes.get("PortalOpened").OnClientEvent:Connect(function(data)
		local hint = ClientState.el("DreamHUD", "PortalHint")
		if hint then
			hint.Visible = true
			local label = hint:FindFirstChild("Label") or hint
			if label and label ~= hint then
				label.Text = "🌀 ПОРТАЛ ПРОБУЖДЕНИЯ ОТКРЫТ — иди к фиолетовому свету"
			else
				hint.Text = "🌀 ПОРТАЛ ПРОБУЖДЕНИЯ ОТКРЫТ"
			end
		end
		ClientState.portalPosition = data and data.position or nil
	end)

	Remotes.get("Hint").OnClientEvent:Connect(function(text)
		local hint = ClientState.el("DreamHUD", "HintLabel")
		if hint then
			hint.Text = text
			hint.Visible = true
			task.delay(8, function()
				if hint then
					hint.Visible = false
				end
			end)
		end
	end)

	ClientState.on("ToggleQuestLog", function()
		HUDController.toggleQuestLog()
	end)

	-- Компас: стрелка к ближайшей цели
	RunService.RenderStepped:Connect(function()
		if ClientState.phase ~= "dream" then
			return
		end
		local compass = ClientState.el("DreamHUD", "Compass")
		local arrow = compass and compass:FindFirstChild("CompassArrow")
		local distanceLabel = compass and compass:FindFirstChild("DistanceLabel")
		if not compass or not arrow then
			return
		end
		local camera = workspace.CurrentCamera
		local target = nil
		if ClientState.portalPosition then
			local p = ClientState.portalPosition
			target = Vector3.new(p.x, p.y, p.z)
		else
			for _, quest in ipairs(ClientState.quests) do
				if quest.target and quest.state == "active" then
					target = Vector3.new(quest.target.x, quest.target.y, quest.target.z)
					break
				end
			end
		end
		if target and camera then
			local root = ClientState.player.Character and ClientState.player.Character:FindFirstChild("HumanoidRootPart")
			local origin = root and root.Position or camera.CFrame.Position
			local delta = target - origin
			local flat = Vector3.new(delta.X, 0, delta.Z)
			local look = camera.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 1 and flatLook.Magnitude > 0.01 then
				local angle = math.deg(math.atan2(flat.X, flat.Z) - math.atan2(flatLook.X, flatLook.Z))
				arrow.Rotation = -angle
				if distanceLabel then
					distanceLabel.Text = math.floor(flat.Magnitude) .. " м"
				end
				compass.Visible = true
			end
		else
			compass.Visible = false
		end
		if compass.Visible and not ClientState.bonuses.compass and not ClientState.portalPosition then
			compass.Visible = false
		end
	end)

	-- Результаты
	resultGui = ClientState.getGui("ResultGUI")
	ClientState.on("ShowResult", function(result)
		HUDController.showResult(result)
	end)
end

function HUDController.showResult(result)
	local gui = ClientState.getGui("ResultGUI")
	if not gui then
		return
	end
	gui.Enabled = true
	local frame = gui
	local function setText(name, text, color)
		local element = frame:FindFirstChild(name, true)
		if element and element:IsA("TextLabel") then
			element.Text = text
			if color then
				element.TextColor3 = color
			end
		end
	end
	setText("OutcomeTitle", result.won and "🌟 ТЫ ПРОСНУЛСЯ!" or "💀 СОН ПРОВАЛЕН",
		result.won and Color3.fromRGB(160, 255, 200) or Color3.fromRGB(255, 110, 120))
	setText("OutcomeSubtitle", result.won and "Кошмар остался позади. Пока что." or (result.reasonText or "Кошмар оказался сильнее тебя..."))
	setText("DreamValue", result.dreamName or "—")
	setText("DifficultyValue", result.difficultyName or "—")
	setText("TimeValue", ClientState.fmtTime(result.survived or 0) .. " из " .. ClientState.fmtTime(Config.DreamDuration))
	setText("QuestsValue", tostring(result.questsDone or 0) .. " / " .. tostring(result.questsTotal or 0))
	setText("CoinsValue", "+" .. tostring(result.coins or 0) .. " 🪙")
	setText("ReasonValue", result.won and "Портал пробуждения" or (result.reasonText or "—"))

	local card = gui:FindFirstChild("Card", true)
	if card then
		card.Position = UDim2.new(0.5, 0, 0.62, 0)
		card.BackgroundTransparency = 1
		ClientState.tween(card, 0.6, { Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 0.05 }, Enum.EasingStyle.Back)
	end

	-- Кнопки подключаем ОДИН раз: showResult вызывается после каждого сна,
	-- иначе одно нажатие отправляло бы несколько запросов сразу.
	local menuButton = gui:FindFirstChild("MenuButton", true)
	if menuButton and not menuButton:GetAttribute("Bound") then
		menuButton:SetAttribute("Bound", true)
		menuButton.MouseButton1Click:Connect(function()
			ClientState.playSound("Click")
			gui.Enabled = false
			ClientState.emit("ResultAction", "menu")
		end)
	end
	local retryButton = gui:FindFirstChild("RetryButton", true)
	if retryButton and not retryButton:GetAttribute("Bound") then
		retryButton:SetAttribute("Bound", true)
		retryButton.MouseButton1Click:Connect(function()
			ClientState.playSound("Click")
			gui.Enabled = false
			ClientState.emit("ResultAction", "retry")
		end)
	end
end

function HUDController.hideResult()
	local gui = ClientState.getGui("ResultGUI")
	if gui then
		gui.Enabled = false
	end
end

return HUDController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8290">
          <Properties>
            <string name="Name">MenuController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	MenuController.luau
	Главное меню, выбор сложности, магазин, инвентарь, достижения,
	статистика и настройки. Все кнопки действительно работают.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.SharedModules.Config)
local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local ItemDefinitions = require(ReplicatedStorage.SharedModules.ItemDefinitions)
local AchievementDefinitions = require(ReplicatedStorage.SharedModules.AchievementDefinitions)
local DreamDefinitions = require(ReplicatedStorage.SharedModules.DreamDefinitions)
local ClientState = require(script.Parent.ClientState)
local SoundController = require(script.Parent.SoundController)
local CameraController = require(script.Parent.CameraController)

local MenuController = {}

local PANELS = { "ShopGUI", "InventoryGUI", "AchievementsGUI", "StatsGUI", "SettingsGUI", "DifficultyGUI" }
local openPanel = nil
local buttonsReady = false
local selectedDifficulty = "Normal"
local difficultyReady = {}

------------------------------------------------------------------
-- Утилиты
------------------------------------------------------------------
local function setVisible(guiName, visible)
	local gui = ClientState.getGui(guiName)
	if gui then
		gui.Enabled = visible
	end
end

local function hover(button, hoverTransparency)
	if not button or not button:IsA("GuiButton") then
		return
	end
	local base = button.BackgroundTransparency
	button.MouseEnter:Connect(function()
		ClientState.tween(button, 0.15, { BackgroundTransparency = hoverTransparency or math.max(0, base - 0.15) })
		ClientState.tween(button, 0.15, { Size = UDim2.new(button.Size.X.Scale * 1.02, button.Size.X.Offset, button.Size.Y.Scale, button.Size.Y.Offset) })
	end)
	button.MouseLeave:Connect(function()
		ClientState.tween(button, 0.2, { BackgroundTransparency = base })
	end)
end

local function clickSound()
	SoundController.play("Click", 0.6)
end

local function makeButton(name)
	local button = ClientState.el("MainMenu", name)
	if not button then
		return nil
	end
	hover(button)
	return button
end

------------------------------------------------------------------
-- Главное меню
------------------------------------------------------------------
function MenuController.show()
	setVisible("MainMenu", true)
	CameraController.setMode("menu")
	local menu = ClientState.getGui("MainMenu")
	if menu then
		local content = menu:FindFirstChild("Content", true)
		if content then
			content.Position = UDim2.new(0, -420, 0, content.Position.Y.Offset)
			ClientState.tween(content, 0.9, { Position = UDim2.new(0, 64, 0, content.Position.Y.Offset) }, Enum.EasingStyle.Quint)
		end
		local fade = menu:FindFirstChild("Fade", true)
		if fade then
			fade.Visible = true
			fade.BackgroundTransparency = 0
			ClientState.tween(fade, 1.2, { BackgroundTransparency = 1 })
		end
	end
	local profileDifficulty = ClientState.profile and ClientState.profile.difficulty
	if type(profileDifficulty) == "string" and Config.Difficulties[profileDifficulty] and not ClientState.selectedDifficulty then
		selectedDifficulty = profileDifficulty
	end
	MenuController.refreshProfile()
	SoundController.setMenu()
end

-- Лобби без интерфейса: игрок может ходить по спальне
function MenuController.openLobbyFree()
	CameraController.setMode("menu")
	CameraController.releaseToPlayer()
	SoundController.setMenu()
end

function MenuController.hide()
	setVisible("MainMenu", false)
	for _, panel in ipairs(PANELS) do
		setVisible(panel, false)
	end
	openPanel = nil
	ClientState.setCursorFree(false)
end

function MenuController.closePanels()
	for _, panel in ipairs(PANELS) do
		setVisible(panel, false)
	end
	openPanel = nil
	local pausePanel = ClientState.el("TopBar", "PausePanel")
	if not (pausePanel and pausePanel.Visible) then
		ClientState.setCursorFree(false)
	end
	MenuController.refreshProfile()
end

function MenuController.openPanelByName(name)
	clickSound()
	ClientState.setCursorFree(true)
	for _, panel in ipairs(PANELS) do
		setVisible(panel, panel == name)
	end
	openPanel = name
	if name == "ShopGUI" then
		MenuController.renderShop()
	elseif name == "InventoryGUI" then
		MenuController.renderInventory()
	elseif name == "AchievementsGUI" then
		MenuController.renderAchievements()
	elseif name == "StatsGUI" then
		MenuController.renderStats()
	elseif name == "SettingsGUI" then
		MenuController.renderSettings()
	elseif name == "DifficultyGUI" then
		MenuController.renderDifficulty()
	end
end

local function difficultyName(key)
	local difficulty = Config.Difficulties[key]
	return difficulty and (difficulty.icon .. " " .. difficulty.name) or "Обычный"
end

function MenuController.setDifficulty(key, silent)
	if not Config.Difficulties[key] then
		key = "Normal"
	end
	selectedDifficulty = key
	ClientState.selectedDifficulty = key
	local label = ClientState.el("MainMenu", "SelectedDifficulty")
	if label then
		local difficulty = Config.Difficulties[key]
		label.Text = "ВЫБРАНО: " .. string.upper(difficulty.name) .. " · 🏆 " .. tostring(difficulty.reward) .. " монет"
		label.TextColor3 = difficulty.color
	end
	for chipKey in pairs(Config.Difficulties) do
		local chip = ClientState.el("MainMenu", "Diff" .. chipKey)
		if chip then
			local difficulty = Config.Difficulties[chipKey]
			local active = chipKey == key
			chip.BackgroundTransparency = active and 0 or 0.25
			local stroke = chip:FindFirstChildWhichIsA("UIStroke")
			if stroke then
				stroke.Transparency = active and 0 or 0.6
				stroke.Thickness = active and 2 or 1.2
			end
			chip.TextTransparency = active and 0 or 0.3
			chip.TextColor3 = difficulty.color
		end
	end
	if not silent then
		SoundController.play("Click", 0.55)
	end
end

function MenuController.refreshProfile()
	local profile = ClientState.profile
	local coins = profile and profile.coins or 0
	for _, name in ipairs({ "CoinsLabel", "CoinValue", "CoinsLabelShop" }) do
		for _, guiName in ipairs({ "MainMenu", "ShopGUI", "InventoryGUI", "AchievementsGUI", "StatsGUI" }) do
			local label = ClientState.el(guiName, name)
			if label then
				if name == "CoinValue" then
					label.Text = tostring(coins)
				else
					label.Text = "🪙 " .. tostring(coins) .. " DREAM COINS"
				end
			end
		end
	end
	-- Карточка профиля
	local stats = profile and profile.stats or {}
	local playerName = Players.LocalPlayer and Players.LocalPlayer.DisplayName or "Сновидец"
	local nameLabel = ClientState.el("MainMenu", "ProfileName")
	if nameLabel then
		nameLabel.Text = playerName
	end
	local levelLabel = ClientState.el("MainMenu", "ProfileLevel")
	if levelLabel then
		local level = 1 + math.floor((stats.dreams or 0) / 5)
		levelLabel.Text = "Уровень сна: " .. tostring(level) .. "   ·   " .. difficultyName(selectedDifficulty)
	end
	local function setProfileValue(name, value)
		local label = ClientState.el("MainMenu", name)
		if label then
			label.Text = tostring(value)
		end
	end
	setProfileValue("ProfileDreams", stats.dreams or 0)
	setProfileValue("ProfileWins", stats.wins or 0)
	setProfileValue("ProfileQuests", stats.quests or 0)
	local achievements = 0
	for _ in pairs(profile and profile.achievements or {}) do
		achievements += 1
	end
	setProfileValue("ProfileAchievements", tostring(achievements) .. " / 16")

	local lastDream = profile and profile.lastDream
	local lastDreamDef = lastDream and DreamDefinitions.get(lastDream)
	local lastLabel = ClientState.el("MainMenu", "LastDreamLabel")
	if lastLabel then
		lastLabel.Text = lastDreamDef and (lastDreamDef.icon .. " " .. lastDreamDef.name) or "—"
	end
	local bestLabel = ClientState.el("MainMenu", "BestTimeLabel")
	if bestLabel then
		local best = stats.bestTime or 0
		bestLabel.Text = best > 0 and ("Лучшее время: " .. ClientState.fmtTime(best)) or "Лучшее время: —"
	end
	MenuController.setDifficulty(selectedDifficulty, true)

	if openPanel == "ShopGUI" then
		MenuController.renderShop()
	elseif openPanel == "InventoryGUI" then
		MenuController.renderInventory()
	end
end

------------------------------------------------------------------
-- Выбор сложности
------------------------------------------------------------------
function MenuController.renderDifficulty()
	local gui = ClientState.getGui("DifficultyGUI")
	if not gui then
		return
	end
	local dreamInfo = gui:FindFirstChild("DreamPreview", true)
	if dreamInfo then
		local dream = DreamDefinitions.get(DreamDefinitions.Order[math.random(1, #DreamDefinitions.Order)])
		dreamInfo.Text = "Следующий сон: " .. dream.name .. "\n" .. dream.subtitle
	end
	for _, key in ipairs(Config.DifficultyOrder) do
		local difficulty = Config.Difficulties[key]
		local cardName = key .. "Card"
		local card = gui:FindFirstChild(cardName, true)
		if card then
			card.BackgroundColor3 = Color3.fromRGB(14, 16, 30)
			local stroke = card:FindFirstChildWhichIsA("UIStroke")
			if stroke then
				stroke.Color = difficulty.color
			end
			local nameLabel = card:FindFirstChild("Name") or card:FindFirstChild("CardName")
			if nameLabel then
				nameLabel.Text = difficulty.icon .. " " .. difficulty.name
				nameLabel.TextColor3 = difficulty.color
			end
			local desc = card:FindFirstChild("Desc") or card:FindFirstChild("CardDesc")
			if desc then
				desc.Text = difficulty.description
			end
			local reward = card:FindFirstChild("Reward") or card:FindFirstChild("CardReward")
			if reward then
				reward.Text = "🏆 " .. difficulty.reward .. " монет"
			end
			local time = card:FindFirstChild("Time") or card:FindFirstChild("CardTime")
			if time then
				time.Text = "⏱ 10 минут"
			end
			if not difficultyReady[key] then
				difficultyReady[key] = true
				card.MouseButton1Click:Connect(function()
					MenuController.setDifficulty(key, true)
					MenuController.startDream(key)
				end)
				hover(card, 0.35)
			end
		end
	end
end

function MenuController.startDream(difficultyKey)
	clickSound()
	MenuController.hide()
	ClientState.emit("RequestDream", difficultyKey)
	local remote = Remotes.get("RequestDream")
	if remote then
		remote:FireServer(difficultyKey)
	end
	-- Если сервер отказал (сон уже идёт), возвращаем меню, чтобы не остаться без UI
	task.delay(2.5, function()
		if ClientState.phase == "menu" and not (ClientState.getGui("MainMenu") and ClientState.getGui("MainMenu").Enabled) then
			MenuController.show()
			ClientState.toast("Сон не начался — попробуй ещё раз", Color3.fromRGB(255, 180, 150), "🌙")
		end
	end)
end

------------------------------------------------------------------
-- Магазин
------------------------------------------------------------------
local function clearList(list, templateName)
	for _, child in ipairs(list:GetChildren()) do
		if child.Name ~= templateName and not child:IsA("UIGridLayout") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

function MenuController.renderShop()
	local gui = ClientState.getGui("ShopGUI")
	local list = gui and gui:FindFirstChild("ItemList", true)
	local template = list and list:FindFirstChild("CardTemplate")
	if not list or not template then
		return
	end
	clearList(list, "CardTemplate")
	for index, itemId in ipairs(ItemDefinitions.Order) do
		local item = ItemDefinitions.get(itemId)
		if item then
			local card = template:Clone()
			card.Name = "Card_" .. itemId
			card.Visible = true
			card.LayoutOrder = index
			card.Parent = list
			local icon = card:FindFirstChild("Icon")
			if icon then
				icon.Text = item.icon
				icon.TextColor3 = item.color
			end
			local name = card:FindFirstChild("Name")
			if name then
				name.Text = item.name
				name.TextColor3 = item.color
			end
			local desc = card:FindFirstChild("Desc")
			if desc then
				desc.Text = item.description
			end
			local price = card:FindFirstChild("Price")
			if price then
				price.Text = "🪙 " .. item.price
			end
			local rarity = card:FindFirstChild("Rarity")
			if rarity then
				rarity.Text = item.rarity
				rarity.TextColor3 = item.color
			end
			local buy = card:FindFirstChild("BuyButton")
			local ownedBadge = card:FindFirstChild("OwnedBadge")
			local owned = ClientState.ownsItem(itemId)
			local consumableCount = ClientState.consumableCount(itemId)
			if ownedBadge then
				ownedBadge.Visible = owned and not item.stackable
				if item.stackable and consumableCount > 0 then
					ownedBadge.Text = "У тебя: " .. consumableCount
					ownedBadge.Visible = true
				end
			end
			if buy then
				buy.Text = (owned and not item.stackable) and "КУПЛЕНО" or (item.stackable and "КУПИТЬ ЕЩЁ" or "КУПИТЬ")
				buy.BackgroundColor3 = owned and not item.stackable and Color3.fromRGB(40, 60, 50) or Color3.fromRGB(60, 46, 120)
				buy.AutoButtonColor = false
				hover(buy, 0.3)
				buy.MouseButton1Click:Connect(function()
					if owned and not item.stackable then
						return
					end
					clickSound()
					Remotes.get("BuyItem"):FireServer(itemId)
				end)
			end
			card.MouseEnter:Connect(function()
				local stroke = card:FindFirstChildWhichIsA("UIStroke")
				if stroke then
					ClientState.tween(stroke, 0.2, { Transparency = 0 })
				end
			end)
			card.MouseLeave:Connect(function()
				local stroke = card:FindFirstChildWhichIsA("UIStroke")
				if stroke then
					ClientState.tween(stroke, 0.2, { Transparency = 0.45 })
				end
			end)
		end
	end
end

------------------------------------------------------------------
-- Инвентарь
------------------------------------------------------------------
function MenuController.renderInventory()
	local gui = ClientState.getGui("InventoryGUI")
	local list = gui and gui:FindFirstChild("ItemList", true)
	local template = list and list:FindFirstChild("CardTemplate")
	if not list or not template then
		return
	end
	clearList(list, "CardTemplate")
	local profile = ClientState.profile
	if not profile then
		return
	end
	local index = 0
	for _, itemId in ipairs(ItemDefinitions.Order) do
		local item = ItemDefinitions.get(itemId)
		local owned = profile.owned[itemId]
		local count = profile.consumables[itemId]
		if item and (owned or (count and count > 0)) then
			index += 1
			local equipped = profile.equipped[itemId] == true
			local card = template:Clone()
			card.Name = "Card_" .. itemId
			card.Visible = true
			card.LayoutOrder = index
			card.Parent = list
			local icon = card:FindFirstChild("Icon")
			if icon then
				icon.Text = item.icon
				icon.TextColor3 = item.color
			end
			local name = card:FindFirstChild("Name")
			if name then
				name.Text = item.name .. (count and (" ×" .. count) or "")
				name.TextColor3 = item.color
			end
			local desc = card:FindFirstChild("Desc")
			if desc then
				desc.Text = item.description
			end
			local countLabel = card:FindFirstChild("Count")
			if countLabel then
				countLabel.Text = count and ("Количество: " .. count) or item.rarity
			end
			local toggle = card:FindFirstChild("ToggleButton")
			if toggle then
				if item.stackable then
					toggle.Text = "ИСПОЛЬЗОВАТЬ"
					toggle.BackgroundColor3 = Color3.fromRGB(40, 70, 90)
					toggle.MouseButton1Click:Connect(function()
						clickSound()
						Remotes.get("UseItem"):FireServer(itemId)
					end)
				else
					toggle.Text = equipped and "СНЯТЬ" or "НАДЕТЬ"
					toggle.BackgroundColor3 = equipped and Color3.fromRGB(60, 90, 70) or Color3.fromRGB(60, 46, 120)
					toggle.MouseButton1Click:Connect(function()
						clickSound()
						Remotes.get("EquipItem"):FireServer(itemId)
					end)
				end
				hover(toggle, 0.3)
			end
			local state = card:FindFirstChild("StateLabel")
			if state then
				state.Text = equipped and "✔ НАДЕТО" or (item.stackable and "" or "НЕ НАДЕТО")
				state.TextColor3 = equipped and Color3.fromRGB(140, 240, 180) or Color3.fromRGB(150, 150, 180)
			end
		end
	end
	local equippedLabel = gui and gui:FindFirstChild("EquippedLabel", true)
	if equippedLabel then
		local names = {}
		for itemId in pairs(profile.equipped) do
			local item = ItemDefinitions.get(itemId)
			if item then
				table.insert(names, item.name)
			end
		end
		equippedLabel.Text = #names > 0 and ("Экипировано: " .. table.concat(names, ", ")) or "Экипировано: ничего"
	end
	if index == 0 then
		local empty = gui and gui:FindFirstChild("EmptyLabel", true)
		if empty then
			empty.Visible = true
		end
	end
end

------------------------------------------------------------------
-- Достижения
------------------------------------------------------------------
function MenuController.renderAchievements()
	local gui = ClientState.getGui("AchievementsGUI")
	local list = gui and gui:FindFirstChild("List", true)
	local template = list and list:FindFirstChild("RowTemplate")
	if not list or not template then
		return
	end
	clearList(list, "RowTemplate")
	local profile = ClientState.profile
	local unlockedCount = 0
	for index, achievement in ipairs(AchievementDefinitions.List) do
		local unlocked = profile and profile.achievements[achievement.id] == true
		if unlocked then
			unlockedCount += 1
		end
		local row = template:Clone()
		row.Name = "Row_" .. achievement.id
		row.Visible = true
		row.LayoutOrder = index
		row.Parent = list
		local icon = row:FindFirstChild("Icon")
		if icon then
			icon.Text = achievement.icon
			icon.TextTransparency = unlocked and 0 or 0.6
		end
		local name = row:FindFirstChild("Name")
		if name then
			name.Text = achievement.name
			name.TextColor3 = unlocked and Color3.fromRGB(200, 255, 220) or Color3.fromRGB(170, 170, 200)
		end
		local desc = row:FindFirstChild("Desc")
		if desc then
			desc.Text = achievement.description
			desc.TextTransparency = unlocked and 0.15 or 0.55
		end
		local state = row:FindFirstChild("State")
		if state then
			state.Text = unlocked and "✔ ПОЛУЧЕНО" or "🔒 ЗАКРЫТО"
			state.TextColor3 = unlocked and Color3.fromRGB(140, 240, 180) or Color3.fromRGB(140, 140, 170)
		end
		row.BackgroundTransparency = unlocked and 0.15 or 0.55
	end
	local progress = gui and gui:FindFirstChild("ProgressLabel", true)
	if progress then
		progress.Text = "Открыто: " .. unlockedCount .. " / " .. #AchievementDefinitions.List
	end
end

------------------------------------------------------------------
-- Статистика
------------------------------------------------------------------
function MenuController.renderStats()
	local profile = ClientState.profile
	if not profile then
		return
	end
	local stats = profile.stats
	local function setText(name, value)
		local label = ClientState.el("StatsGUI", name)
		if label then
			label.Text = tostring(value)
		end
	end
	local timeMinutes = math.floor((stats.playtime or 0) / 60)
	setText("DreamsValue", stats.dreams or 0)
	setText("WinsValue", stats.wins or 0)
	setText("LossesValue", stats.losses or 0)
	setText("QuestsValue", stats.quests or 0)
	setText("CoinsValue", "🪙 " .. (stats.coinsEarned or 0))
	setText("TimeValue", timeMinutes .. " мин")
	setText("AchievementsValue", (function()
		local n = 0
		for _ in pairs(profile.achievements) do
			n += 1
		end
		return n
	end)())
	setText("BestTimeValue", ClientState.fmtTime(stats.bestTime or 0))
	local visited = 0
	for _ in pairs(stats.dreamsVisited or {}) do
		visited += 1
	end
	setText("DreamsVisitedValue", visited .. " / 10")
	local winrate = 0
	if (stats.dreams or 0) > 0 then
		winrate = math.floor((stats.wins or 0) / stats.dreams * 100)
	end
	setText("WinrateValue", winrate .. "%")
end

------------------------------------------------------------------
-- Настройки
------------------------------------------------------------------
local function bindSlider(frame, value, onChange)
	if not frame then
		return
	end
	local fill = frame:FindFirstChild("Fill")
	local knob = frame:FindFirstChild("Knob", true) or fill
	local valueLabel = frame:FindFirstChild("Value")

	-- Панель настроек перерисовывается при каждом открытии: обновляем только вид,
	-- а обработчики подключаем один раз.
	if frame:GetAttribute("SliderBound") then
		local currentValue = math.clamp(value or 0.5, 0, 1)
		if fill then
			fill.Size = UDim2.new(currentValue, 0, 1, 0)
		end
		if knob and knob ~= fill then
			knob.Position = UDim2.new(currentValue, 0, 0.5, 0)
		end
		if valueLabel then
			valueLabel.Text = tostring(math.floor(currentValue * 100)) .. "%"
		end
		return
	end
	frame:SetAttribute("SliderBound", true)

	local current = math.clamp(value or 0.5, 0, 1)
	local dragging = false

	local function apply(alpha, final)
		current = math.clamp(alpha, 0, 1)
		if fill then
			fill.Size = UDim2.new(current, 0, 1, 0)
		end
		if knob and knob ~= fill then
			knob.Position = UDim2.new(current, 0, 0.5, 0)
		end
		if valueLabel then
			valueLabel.Text = tostring(math.floor(current * 100)) .. "%"
		end
		if final then
			onChange(current)
		end
	end

	apply(current, false)

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local alpha = (input.Position.X - frame.AbsolutePosition.X) / math.max(1, frame.AbsoluteSize.X)
			apply(alpha, true)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local alpha = (input.Position.X - frame.AbsolutePosition.X) / math.max(1, frame.AbsoluteSize.X)
			apply(alpha, false)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			onChange(current)
		end
	end)
end

local function settingBaseText(button)
	local base = button:GetAttribute("BaseText")
	if not base then
		base = (button.Text:gsub(":%s*ВКЛ.*$", ""):gsub(":%s*ВЫКЛ.*$", ""))
		button:SetAttribute("BaseText", base)
	end
	return base
end

local function bindToggle(button, initial, key)
	if not button then
		return
	end
	local state = ClientState.settings[key]
	if state == nil then
		state = initial == true
	end
	local function render()
		button.Text = settingBaseText(button) .. ": " .. (state and "ВКЛ" or "ВЫКЛ")
		button.TextColor3 = state and Color3.fromRGB(150, 250, 190) or Color3.fromRGB(200, 160, 170)
	end
	render()
	if button:GetAttribute("ToggleBound") then
		return
	end
	button:SetAttribute("ToggleBound", true)
	button.MouseButton1Click:Connect(function()
		state = not state
		render()
		clickSound()
		ClientState.settings[key] = state
		Remotes.get("UpdateSettings"):FireServer(key, state)
	end)
end

function MenuController.renderSettings()
	local settings = ClientState.settings
	local gui = ClientState.getGui("SettingsGUI")
	if not gui then
		return
	end
	bindSlider(gui:FindFirstChild("MusicSlider", true), settings.musicVolume, function(value)
		Remotes.get("UpdateSettings"):FireServer("musicVolume", value)
		ClientState.settings.musicVolume = value
		SoundController.applyVolumes()
	end)
	bindSlider(gui:FindFirstChild("SfxSlider", true), settings.sfxVolume, function(value)
		Remotes.get("UpdateSettings"):FireServer("sfxVolume", value)
		ClientState.settings.sfxVolume = value
		SoundController.applyVolumes()
	end)
	bindSlider(gui:FindFirstChild("SensitivitySlider", true), settings.sensitivity, function(value)
		Remotes.get("UpdateSettings"):FireServer("sensitivity", value)
		ClientState.settings.sensitivity = value
		CameraController.applySensitivity()
	end)
	bindSlider(gui:FindFirstChild("ScareSlider", true), settings.scareIntensity, function(value)
		Remotes.get("UpdateSettings"):FireServer("scareIntensity", value)
		ClientState.settings.scareIntensity = value
	end)
	bindToggle(gui:FindFirstChild("HintsToggle", true), settings.hints, "hints")
	bindToggle(gui:FindFirstChild("CameraShakeToggle", true), settings.cameraShake, "cameraShake")
	local scareToggle = gui:FindFirstChild("ScareToggle", true)
	if scareToggle then
		local enabled = (settings.scareIntensity or 1) > 0.25
		local baseText = scareToggle:GetAttribute("ScareBase") or scareToggle.Text:gsub(":%s*(ВКЛ|ВЫКЛ).*$", "")
		scareToggle:SetAttribute("ScareBase", baseText)
		local function renderScare()
			scareToggle.Text = baseText .. ": " .. (enabled and "ВКЛ" or "ВЫКЛ")
			scareToggle.TextColor3 = enabled and Color3.fromRGB(255, 170, 190) or Color3.fromRGB(150, 150, 180)
		end
		renderScare()
		if not scareToggle:GetAttribute("ScareBound") then
			scareToggle:SetAttribute("ScareBound", true)
			scareToggle.MouseButton1Click:Connect(function()
				enabled = not enabled
				renderScare()
				clickSound()
				ClientState.settings.scareIntensity = enabled and 1 or 0.15
				Remotes.get("UpdateSettings"):FireServer("scareIntensity", ClientState.settings.scareIntensity)
			end)
		end
	end
	for _, pair in ipairs({ { "QualityLow", "Низкое" }, { "QualityMedium", "Средний" }, { "QualityHigh", "Высокое" } }) do
		local button = gui:FindFirstChild(pair[1], true)
		if button then
			button.TextColor3 = settings.quality == pair[2] and Color3.fromRGB(180, 255, 210) or Color3.fromRGB(190, 190, 220)
			if not button:GetAttribute("QualityBound") then
				button:SetAttribute("QualityBound", true)
				button.MouseButton1Click:Connect(function()
					clickSound()
					Remotes.get("UpdateSettings"):FireServer("quality", pair[2])
					ClientState.settings.quality = pair[2]
					MenuController.renderSettings()
					ClientState.emit("QualityChanged", pair[2])
				end)
			end
		end
	end
	local reset = gui:FindFirstChild("ResetButton", true)
	if reset and not reset:GetAttribute("ResetBound") then
		reset:SetAttribute("ResetBound", true)
		reset.MouseButton1Click:Connect(function()
			clickSound()
			Remotes.get("ResetSettings"):FireServer()
			task.delay(0.4, function()
				MenuController.renderSettings()
				SoundController.applyVolumes()
				CameraController.applySensitivity()
			end)
		end)
	end
end

------------------------------------------------------------------
-- Инициализация
------------------------------------------------------------------
function MenuController.start()
	if buttonsReady then
		return
	end
	buttonsReady = true

	local menu = ClientState.getGui("MainMenu")
	if menu then
		menu.Enabled = true
		-- Масштаб интерфейса под размер экрана (телефоны, ноутбуки, 4K)
		local uiScale = menu:FindFirstChildOfClass("UIScale")
		if not uiScale then
			uiScale = Instance.new("UIScale")
			uiScale.Parent = menu
		end
		local function updateScale()
			local camera = workspace.CurrentCamera
			if camera then
				uiScale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.58, 1.05)
			end
		end
		updateScale()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
	end

	-- Быстрый старт с выбранной сложностью
	local startButton = makeButton("StartButton")
	if startButton then
		startButton.MouseButton1Click:Connect(function()
			MenuController.startDream(selectedDifficulty)
		end)
	end

	for _, key in ipairs(Config.DifficultyOrder) do
		local chip = makeButton("Diff" .. key)
		if chip then
			chip.MouseButton1Click:Connect(function()
				MenuController.setDifficulty(key)
			end)
		end
	end

	-- Кровать в лобби: лечь спать можно без меню
	local bedroom = workspace:FindFirstChild("MenuBedroom")
	local bed = bedroom and bedroom:FindFirstChild("BedPoint", true)
	local prompt = bed and bed:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Triggered:Connect(function(player)
			if player ~= ClientState.player then
				return
			end
			if ClientState.phase ~= "menu" then
				return
			end
			clickSound()
			MenuController.startDream(selectedDifficulty)
		end)
		ClientState.on("Phase", function(phase)
			prompt.Enabled = phase == "menu"
		end)
	end

	-- Панель «как играть»
	local howToButton = makeButton("HowToButton")
	if howToButton then
		howToButton.MouseButton1Click:Connect(function()
			clickSound()
			local tutorial = ClientState.el("MainMenu", "TutorialPanel")
			if tutorial then
				tutorial.Visible = true
				tutorial.BackgroundTransparency = 1
				ClientState.tween(tutorial, 0.3, { BackgroundTransparency = 0.25 })
			end
		end)
	end
	local tutorialClose = makeButton("TutorialClose")
	if tutorialClose then
		tutorialClose.MouseButton1Click:Connect(function()
			clickSound()
			local tutorial = ClientState.el("MainMenu", "TutorialPanel")
			if tutorial then
				tutorial.Visible = false
			end
		end)
	end

	local playButton = makeButton("PlayButton")
	if playButton then
		playButton.MouseButton1Click:Connect(function()
			MenuController.openPanelByName("DifficultyGUI")
		end)
	end
	local shopButton = makeButton("ShopButton")
	if shopButton then
		shopButton.MouseButton1Click:Connect(function()
			MenuController.openPanelByName("ShopGUI")
		end)
	end
	local inventoryButton = makeButton("InventoryButton")
	if inventoryButton then
		inventoryButton.MouseButton1Click:Connect(function()
			MenuController.openPanelByName("InventoryGUI")
		end)
	end
	local achievementsButton = makeButton("AchievementsButton")
	if achievementsButton then
		achievementsButton.MouseButton1Click:Connect(function()
			MenuController.openPanelByName("AchievementsGUI")
		end)
	end
	local statsButton = makeButton("StatsButton")
	if statsButton then
		statsButton.MouseButton1Click:Connect(function()
			MenuController.openPanelByName("StatsGUI")
		end)
	end
	local settingsButton = makeButton("SettingsButton")
	if settingsButton then
		settingsButton.MouseButton1Click:Connect(function()
			MenuController.openPanelByName("SettingsGUI")
		end)
	end

	for _, guiName in ipairs(PANELS) do
		local gui = ClientState.getGui(guiName)
		if gui then
			gui.Enabled = false
			local close = gui:FindFirstChild("CloseButton", true) or gui:FindFirstChild("BackButton", true)
			if close then
				hover(close)
				close.MouseButton1Click:Connect(function()
					clickSound()
					MenuController.closePanels()
				end)
			end
		end
	end

	-- Верхняя кнопка МЕНЮ: в лобби открывает/закрывает меню, во сне — паузу
	local topButton = ClientState.el("TopBar", "MenuButton")
	if topButton then
		hover(topButton)
		topButton.MouseButton1Click:Connect(function()
			clickSound()
			local phase = ClientState.phase
			local pausePanel = ClientState.el("TopBar", "PausePanel")
			if phase == "menu" then
				local menuGui = ClientState.getGui("MainMenu")
				local menuOpen = menuGui and menuGui.Enabled
				if menuOpen then
					MenuController.hide()
					MenuController.openLobbyFree()
				else
					MenuController.show()
				end
			elseif phase == "dream" or phase == "sleeping" or phase == "waking" then
				if pausePanel then
					pausePanel.Visible = not pausePanel.Visible
					ClientState.setCursorFree(pausePanel.Visible)
				end
			else
				MenuController.show()
			end
		end)
	end

	-- Кнопки панели паузы
	local pauseActions = {
		PauseContinue = function()
			local panel = ClientState.el("TopBar", "PausePanel")
			if panel then
				panel.Visible = false
			end
			ClientState.setCursorFree(false)
		end,
		PauseQuests = function()
			local panel = ClientState.el("TopBar", "PausePanel")
			if panel then
				panel.Visible = false
			end
			ClientState.emit("ToggleQuestLog")
		end,
		PauseInventory = function()
			local panel = ClientState.el("TopBar", "PausePanel")
			if panel then
				panel.Visible = false
			end
			MenuController.openPanelByName("InventoryGUI")
		end,
		PauseSettings = function()
			local panel = ClientState.el("TopBar", "PausePanel")
			if panel then
				panel.Visible = false
			end
			MenuController.openPanelByName("SettingsGUI")
		end,
		PauseLeave = function()
			local panel = ClientState.el("TopBar", "PausePanel")
			if panel then
				panel.Visible = false
			end
			local remote = Remotes.get("ReturnToMenu")
			if remote then
				remote:FireServer()
			end
		end,
	}
	for buttonName, handler in pairs(pauseActions) do
		local pauseButton = ClientState.el("TopBar", buttonName)
		if pauseButton then
			hover(pauseButton)
			pauseButton.MouseButton1Click:Connect(function()
				clickSound()
				handler()
			end)
		end
	end

	-- Крестик в меню лобби: закрыть интерфейс и гулять по спальне
	local closeMenu = ClientState.el("MainMenu", "CloseMenuButton")
	if closeMenu then
		hover(closeMenu)
		closeMenu.MouseButton1Click:Connect(function()
			clickSound()
			MenuController.hide()
			MenuController.openLobbyFree()
		end)
	end

	ClientState.on("ClosePanel", function()
		local tutorial = ClientState.el("MainMenu", "TutorialPanel")
		if tutorial and tutorial.Visible then
			tutorial.Visible = false
			return
		end
		if openPanel then
			MenuController.closePanels()
		end
	end)

	ClientState.on("Profile", function()
		MenuController.refreshProfile()
	end)

	ClientState.on("Phase", function(phase)
		-- Верхняя панель нужна в лобби и во сне, но не в катсценах и на экране результата.
		local topBar = ClientState.getGui("TopBar")
		if topBar then
			topBar.Enabled = (phase == "menu" or phase == "dream")
		end
		if phase == "menu" then
			MenuController.show()
		elseif phase == "sleeping" or phase == "dream" or phase == "waking" or phase == "result" then
			local pausePanel = ClientState.el("TopBar", "PausePanel")
			if pausePanel then
				pausePanel.Visible = false
			end
			MenuController.hide()
		end
	end)

	ClientState.on("Toast", function(payload)
		-- HUD уже показывает уведомления; в меню тоже полезно видеть покупки
		if ClientState.phase == "menu" then
			local label = ClientState.el("MainMenu", "MenuToast")
			if label then
				label.Text = payload.text
				label.TextTransparency = 0
				label.Visible = true
				ClientState.tween(label, 0.3, { TextTransparency = 0 })
				task.delay(3, function()
					ClientState.tween(label, 0.6, { TextTransparency = 1 })
				end)
			end
		end
	end)

	Remotes.get("PurchaseResult").OnClientEvent:Connect(function(result)
		if result.ok then
			SoundController.play("Purchase")
			ClientState.toast(result.message or "Куплено", Color3.fromRGB(150, 255, 190), "🛍️")
		else
			ClientState.toast(result.message or "Покупка не удалась", Color3.fromRGB(255, 140, 140), "❌")
		end
		MenuController.refreshProfile()
	end)

	Remotes.get("EquipResult").OnClientEvent:Connect(function(result)
		ClientState.toast(result.message or "", result.ok and Color3.fromRGB(150, 255, 190) or Color3.fromRGB(255, 140, 140), "🎒")
		MenuController.refreshProfile()
	end)

	Remotes.get("AchievementUnlocked").OnClientEvent:Connect(function(data)
		SoundController.play("Win", 0.6)
		ClientState.toast("Достижение: " .. data.name .. " (+150 🪙)", Color3.fromRGB(255, 230, 160), data.icon or "🏆")
	end)

	-- Признак, что меню реально работает (используется страховкой в ClientMain)
	local topGui = ClientState.getGui("TopBar")
	if topGui then
		topGui:SetAttribute("MenuReady", true)
	end

	-- Клавиша M открывает/закрывает меню в лобби
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.M then
			local phase = ClientState.phase
			if phase == "menu" then
				local menuGui = ClientState.getGui("MainMenu")
				if menuGui and menuGui.Enabled then
					MenuController.hide()
					MenuController.openLobbyFree()
				else
					MenuController.show()
				end
			elseif phase == "dream" then
				local pausePanel = ClientState.el("TopBar", "PausePanel")
				if pausePanel then
					pausePanel.Visible = not pausePanel.Visible
					ClientState.setCursorFree(pausePanel.Visible)
				end
			end
		end
	end)

	-- Анимация заголовка
	task.spawn(function()
		local title = ClientState.el("MainMenu", "Title")
		while true do
			task.wait(3)
			if title and title.Parent then
				title.Rotation = 1
				ClientState.tween(title, 0.4, { Rotation = 0 })
			end
		end
	end)
end

return MenuController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8291">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	EffectsController.luau
	Атмосфера и страх: искажение картинки от низкого рассудка, скримеры,
	фонарик, погодные эффекты, галлюцинации, тряска камеры, качество графики.
]]

local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local ClientState = require(script.Parent.ClientState)
local SoundController = require(script.Parent.SoundController)
local CameraController = require(script.Parent.CameraController)

local EffectsController = {}

local flashlightPart
local flashlightLight
local flashlightGlow
local flashlightBody
local flashlightLens
local weatherEmitter
local weatherAttachment
local baseFogEnd = Lighting.FogEnd
local baseColor = nil
local activeTimers = {}
local scareCooldown = 0

local function getEffect(name)
	return Lighting:FindFirstChild(name)
end

------------------------------------------------------------------
-- Фонарик
------------------------------------------------------------------
local flashlightOn = false
local flashlightTarget = false
local flashlightFlicker = 0
local flashlightSway = 0

-- Параметры луча зависят от экипированного предмета.
local BEAMS = {
	basic = { range = 44, angle = 52, brightness = 1.9, color = Color3.fromRGB(255, 244, 214) },
	flashlight = { range = 62, angle = 58, brightness = 2.6, color = Color3.fromRGB(255, 248, 224) },
	lantern = { range = 76, angle = 84, brightness = 3.0, color = Color3.fromRGB(255, 214, 156) },
}

local function flashlightSettings()
	local tier = (ClientState.dream and ClientState.dream.flashlightTier)
		or (ClientState.vitals and ClientState.vitals.flashlightTier)
		or "basic"
	return BEAMS[tier] or BEAMS.basic
end

local function ensureFlashlight()
	if flashlightPart and flashlightPart.Parent then
		return
	end
	flashlightPart = Instance.new("Part")
	flashlightPart.Name = "ClientFlashlight"
	flashlightPart.Size = Vector3.new(0.2, 0.2, 0.2)
	flashlightPart.Transparency = 1
	flashlightPart.Anchored = true
	flashlightPart.CanCollide = false
	flashlightPart.CanQuery = false
	flashlightPart.CanTouch = false
	flashlightPart.CastShadow = false
	flashlightPart.Parent = Workspace

	flashlightLight = Instance.new("SpotLight")
	flashlightLight.Name = "Beam"
	flashlightLight.Face = Enum.NormalId.Front
	flashlightLight.Shadows = true
	flashlightLight.Enabled = false
	flashlightLight.Parent = flashlightPart

	-- Мягкая подсветка вокруг игрока, чтобы фонарик не выглядел «плоским».
	flashlightGlow = Instance.new("PointLight")
	flashlightGlow.Name = "Glow"
	flashlightGlow.Range = 16
	flashlightGlow.Brightness = 0.55
	flashlightGlow.Shadows = false
	flashlightGlow.Enabled = false
	flashlightGlow.Parent = flashlightPart

	-- Видимая «тушка» фонарика в руке: без неё свет выглядит беспричинным.
	flashlightBody = Instance.new("Part")
	flashlightBody.Name = "ClientFlashlightBody"
	flashlightBody.Size = Vector3.new(0.26, 0.26, 1.5)
	flashlightBody.Color = Color3.fromRGB(46, 48, 56)
	flashlightBody.Material = Enum.Material.Metal
	flashlightBody.Anchored = true
	flashlightBody.CanCollide = false
	flashlightBody.CanQuery = false
	flashlightBody.CanTouch = false
	flashlightBody.CastShadow = false
	flashlightBody.Transparency = 1
	flashlightBody.Parent = Workspace

	flashlightLens = Instance.new("Part")
	flashlightLens.Name = "ClientFlashlightLens"
	flashlightLens.Size = Vector3.new(0.3, 0.3, 0.12)
	flashlightLens.Color = Color3.fromRGB(255, 246, 214)
	flashlightLens.Material = Enum.Material.Neon
	flashlightLens.Anchored = true
	flashlightLens.CanCollide = false
	flashlightLens.CanQuery = false
	flashlightLens.CanTouch = false
	flashlightLens.CastShadow = false
	flashlightLens.Transparency = 1
	flashlightLens.Parent = Workspace
end

local function applyBeam()
	local beam = flashlightSettings()
	if flashlightLight then
		flashlightLight.Range = beam.range
		flashlightLight.Angle = beam.angle
		flashlightLight.Brightness = beam.brightness
		flashlightLight.Color = beam.color
		flashlightLight.Shadows = ClientState.quality() ~= "Низкое"
	end
	if flashlightGlow then
		flashlightGlow.Color = beam.color
		flashlightGlow.Range = beam.range * 0.3
		flashlightGlow.Brightness = beam.brightness * 0.22
	end
end

local function setFlashlight(enabled)
	ensureFlashlight()
	applyBeam()
	flashlightTarget = enabled == true
	flashlightOn = enabled == true
	-- Ставим источник света сразу в камеру, иначе первый кадр луч летит из нуля.
	local camera = Workspace.CurrentCamera
	if flashlightOn and camera then
		flashlightPart.CFrame = camera.CFrame * CFrame.new(0.35, -0.25, -0.4)
	end
	if flashlightLight then
		flashlightLight.Enabled = flashlightOn
	end
	if flashlightGlow then
		flashlightGlow.Enabled = flashlightOn
	end
	if flashlightBody then
		flashlightBody.Transparency = flashlightOn and 0 or 1
	end
	if flashlightLens then
		flashlightLens.Transparency = flashlightOn and 0 or 1
	end
	if flashlightOn then
		SoundController.play("Click", 0.5)
	end
end

-- Плавное мерцание при низкой батарее/рассудке + лёгкое покачивание луча.
local function updateFlashlight(dt)
	if not flashlightPart or not flashlightPart.Parent then
		return
	end
	if not ClientState.isDream() then
		if flashlightLight and flashlightLight.Enabled then
			flashlightLight.Enabled = false
			if flashlightGlow then
				flashlightGlow.Enabled = false
			end
			if flashlightBody then
				flashlightBody.Transparency = 1
			end
			if flashlightLens then
				flashlightLens.Transparency = 1
			end
		end
		return
	end
	local battery = (ClientState.vitals and ClientState.vitals.battery) or 100
	local sanity = (ClientState.vitals and ClientState.vitals.sanity) or 100
	flashlightSway += dt

	local camera = Workspace.CurrentCamera
	if camera and flashlightOn then
		-- Небольшое отставание луча от резких поворотов — «живой» фонарик.
		local target = camera.CFrame * CFrame.new(0.35, -0.25, -0.4)
		flashlightPart.CFrame = flashlightPart.CFrame:Lerp(target, math.min(1, dt * 12))
		-- Тушка и линза идут за камерой чуть иначе — с покачиванием при ходьбе.
		local bob = math.sin(flashlightSway * 6) * 0.02
		local handCframe = camera.CFrame * CFrame.new(0.62 + bob, -0.62 + bob * 0.6, -0.95)
			* CFrame.Angles(math.rad(-2), math.rad(-4), 0)
		if flashlightBody then
			flashlightBody.CFrame = handCframe
		end
		if flashlightLens then
			flashlightLens.CFrame = handCframe * CFrame.new(0, 0, -0.78)
		end
	end

	if not flashlightOn then
		return
	end

	-- Мерцание: слабая батарея или низкий рассудок
	local flickerChance = 0
	if battery < 20 then
		flickerChance += (20 - battery) / 20 * 0.5
	end
	if sanity < 40 then
		flickerChance += (40 - sanity) / 40 * 0.45
	end
	flashlightFlicker = math.max(0, flashlightFlicker - dt)
	if flickerChance > 0 and math.random() < flickerChance * dt * 3 then
		flashlightFlicker = 0.06 + math.random() * 0.16
	end
	local lit = flashlightFlicker <= 0
	if flashlightLight then
		flashlightLight.Enabled = lit
		local beam = flashlightSettings()
		local fade = 0.55 + 0.45 * math.clamp(battery / 100, 0, 1)
		flashlightLight.Brightness = beam.brightness * fade
		flashlightLight.Range = beam.range * (0.75 + 0.25 * math.clamp(battery / 100, 0, 1))
	end
	if flashlightGlow then
		flashlightGlow.Enabled = lit
	end
end

------------------------------------------------------------------
-- Рассудок
------------------------------------------------------------------
function EffectsController.applySanity(sanity)
	local color = getEffect("DreamColor")
	local bloom = getEffect("DreamBloom")
	local dof = getEffect("DreamDOF")
	local hud = ClientState.getGui("DreamHUD")
	local vignette = hud and hud:FindFirstChild("Vignette", true)
	local whisper = hud and hud:FindFirstChild("WhisperLabel", true)

	local factor = math.clamp(1 - sanity / 100, 0, 1) -- 0 = ясен, 1 = безумие
	if color then
		color.Contrast = 0.1 + factor * 0.6
		color.Saturation = -0.1 - factor * 0.55
		color.Brightness = factor * -0.06
	end
	if dof then
		local quality = ClientState.quality()
		local base = quality == "Низкое" and 0 or 0.45
		dof.FarIntensity = base + factor * 0.5
		dof.NearIntensity = quality == "Низкое" and 0 or factor * 0.35
		dof.InFocusRadius = 45 - factor * 25
	end
	if bloom then
		bloom.Intensity = 0.6 + factor * 0.6
	end
	if vignette then
		vignette.BackgroundTransparency = 1 - factor * 0.62
		vignette.Visible = factor > 0.05
	end
	if whisper then
		if factor > 0.55 then
			whisper.Visible = true
			whisper.TextTransparency = math.clamp(1 - (factor - 0.55) * 2.2, 0, 1)
			local texts = { "не оборачивайся", "ты уже здесь был", "мы ждём тебя", "проснись", "это не твой сон" }
			whisper.Text = texts[math.random(1, #texts)]
		else
			whisper.Visible = false
		end
	end
	if factor > 0.4 then
		CameraController.shake(0.25 * factor, 0.4)
	end
	-- Шёпот в наушниках тем громче, чем ниже рассудок.
	SoundController.whispers(factor > 0.5, factor)
	if factor > 0.86 and not EffectsController.lowSanityWarned then
		EffectsController.lowSanityWarned = true
		ClientState.toast("Рассудок на нуле — монстры совсем рядом", Color3.fromRGB(255, 140, 160), "🌀")
	elseif factor < 0.6 then
		EffectsController.lowSanityWarned = false
	end
end

------------------------------------------------------------------
-- Скримеры
------------------------------------------------------------------
function EffectsController.jumpscare(name, intensity)
	local level = math.clamp(ClientState.settings.scareIntensity or 1, 0, 1.6)
	if level < 0.15 then
		return
	end
	local hud = ClientState.getGui("DreamHUD")
	local frame = hud and hud:FindFirstChild("Jumpscare", true)
	local icon = frame and frame:FindFirstChild("JumpscareIcon")
	local label = frame and frame:FindFirstChild("JumpscareName")
	if frame then
		frame.Visible = true
		frame.BackgroundTransparency = 0.15
		if icon then
			icon.Text = "👁️"
		end
		if label then
			label.Text = name or "БЕГИ"
		end
		ClientState.tween(frame, 0.5, { BackgroundTransparency = 1 })
		task.delay(0.6, function()
			if frame then
				frame.Visible = false
			end
		end)
	end
	CameraController.shake(2.4 * (intensity or 1) * level, 0.9)
	SoundController.play("Scare")
	-- Красная вспышка
	local color = getEffect("DreamColor")
	if color then
		local tint = color.TintColor
		color.TintColor = Color3.fromRGB(255, 120, 120)
		task.delay(0.35, function()
			if color then
				color.TintColor = tint
			end
		end)
	end
end

function EffectsController.hallucination()
	if math.clamp(ClientState.settings.scareIntensity or 1, 0, 2) < 0.3 then
		return
	end
	local character = ClientState.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local camera = Workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	local offset = Vector3.new(look.X, 0, look.Z).Unit * 18 + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
	local position = root.Position + offset
	local part = Instance.new("Part")
	part.Name = "Hallucination"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Size = Vector3.new(2, 6, 2)
	part.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	part.Color = Color3.fromRGB(18, 12, 26)
	part.Material = Enum.Material.Neon
	part.Transparency = 0.35
	part.Parent = Workspace
	local eyes = Instance.new("PointLight")
	eyes.Color = Color3.fromRGB(255, 60, 80)
	eyes.Brightness = 2
	eyes.Range = 12
	eyes.Parent = part
	Debris:AddItem(part, 1.8)
	SoundController.play("Whisper", 0.8)
end

------------------------------------------------------------------
-- Погода
------------------------------------------------------------------
local function clearWeather()
	if weatherEmitter then
		weatherEmitter:Destroy()
		weatherEmitter = nil
	end
	if weatherAttachment then
		weatherAttachment:Destroy()
		weatherAttachment = nil
	end
end

local function setWeather(kind, duration)
	clearWeather()
	local camera = Workspace.CurrentCamera
	weatherAttachment = Instance.new("Attachment")
	weatherAttachment.Parent = camera

	weatherEmitter = Instance.new("ParticleEmitter")
	weatherEmitter.Parent = weatherAttachment
	weatherEmitter.LightInfluence = 0.2
	weatherEmitter.Rate = kind == "snow" and 90 or 160
	weatherEmitter.Speed = NumberRange.new(kind == "snow" and 6 or 40)
	weatherEmitter.Lifetime = NumberRange.new(1.2, 2)
	weatherEmitter.SpreadAngle = Vector2.new(20, 20)
	weatherEmitter.Acceleration = Vector3.new(0, kind == "snow" and -8 or -60, 0)
	if kind == "snow" then
		weatherEmitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 0.2),
		})
		weatherEmitter.Color = ColorSequence.new(Color3.fromRGB(240, 250, 255))
		weatherEmitter.Transparency = NumberSequence.new(0.2)
	else
		weatherEmitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.08),
			NumberSequenceKeypoint.new(1, 0.05),
		})
		weatherEmitter.Color = ColorSequence.new(Color3.fromRGB(170, 200, 230))
		weatherEmitter.Transparency = NumberSequence.new(0.35)
	end
	weatherEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	if kind == "snow" then
		weatherEmitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	end
	if duration then
		task.delay(duration, clearWeather)
	end
end

------------------------------------------------------------------
-- События сна
------------------------------------------------------------------
function EffectsController.handleEvent(data)
	local id = data.id
	local duration = data.duration or 10
	if id == "rain" then
		setWeather("rain", duration)
	elseif id == "fog_boost" then
		Lighting.FogEnd = math.max(45, baseFogEnd * 0.45)
		task.delay(duration, function()
			Lighting.FogEnd = baseFogEnd
		end)
	elseif id == "red_moon" then
		local color = getEffect("DreamColor")
		if color then
			local tint = color.TintColor
			color.TintColor = Color3.fromRGB(255, 160, 150)
			task.delay(duration, function()
				if color then
					color.TintColor = tint
				end
			end)
		end
	elseif id == "whispers" then
		SoundController.play("Whisper")
		local hud = ClientState.getGui("DreamHUD")
		local whisper = hud and hud:FindFirstChild("WhisperLabel", true)
		if whisper then
			whisper.Visible = true
			whisper.Text = "ты не должен быть здесь"
			whisper.TextTransparency = 0
			task.delay(duration, function()
				if whisper then
					whisper.Visible = false
				end
			end)
		end
	elseif id == "scary_sound" then
		SoundController.play("Scare", 0.6)
		CameraController.shake(1.2, 0.8)
	elseif id == "footsteps" then
		SoundController.play("MonsterGrowl", 0.5)
		CameraController.shake(0.35, 1.2)
	elseif id == "flicker" then
		task.spawn(function()
			local finish = os.clock() + duration
			while os.clock() < finish do
				Lighting.Brightness = math.random() * 0.2
				task.wait(math.random(3, 12) / 100)
				Lighting.Brightness = 1
				task.wait(math.random(20, 80) / 100)
			end
			Lighting.Brightness = 1
		end)
	elseif id == "lights_out" then
		local color = getEffect("DreamColor")
		if color then
			baseColor = color.Brightness
			color.Brightness = -0.35
			task.delay(duration, function()
				if color then
					color.Brightness = baseColor or 0
				end
			end)
		end
	elseif id == "sanity_aura" then
		CameraController.shake(0.5, duration)
	end
end

------------------------------------------------------------------
-- Качество графики
------------------------------------------------------------------
function EffectsController.applyQuality()
	local quality = ClientState.quality()
	local bloom = getEffect("DreamBloom")
	local dof = getEffect("DreamDOF")
	local atmosphere = getEffect("DreamAtmosphere")
	if quality == "Низкое" then
		if bloom then bloom.Enabled = false end
		if dof then dof.Enabled = false end
		if atmosphere then atmosphere.Enabled = false end
		Lighting.GlobalShadows = false
	elseif quality == "Средний" then
		if bloom then bloom.Enabled = true end
		if dof then dof.Enabled = true end
		if atmosphere then atmosphere.Enabled = true end
		Lighting.GlobalShadows = true
	else
		if bloom then bloom.Enabled = true end
		if dof then dof.Enabled = true end
		if atmosphere then atmosphere.Enabled = true end
		Lighting.GlobalShadows = true
	end
end

------------------------------------------------------------------
-- Инициализация
------------------------------------------------------------------
function EffectsController.start()
	ensureFlashlight()
	baseFogEnd = Lighting.FogEnd

	ClientState.on("Flashlight", function(enabled)
		setFlashlight(enabled == true)
	end)

	-- Сервер — источник истины: если батарея села, свет гаснет у всех.
	-- Слушаем канал напрямую, чтобы фонарик работал даже если HUD не загрузился.
	local lastServerState = nil
	local vitalsRemote = Remotes.get("VitalsUpdate")
	if vitalsRemote then
		vitalsRemote.OnClientEvent:Connect(function(data)
			if not data then
				return
			end
			ClientState.vitals = data
			local serverOn = data.flashlight == true
			if lastServerState ~= serverOn then
				lastServerState = serverOn
				if serverOn ~= flashlightOn then
					setFlashlight(serverOn)
				end
			end
		end)
	end

	RunService.RenderStepped:Connect(updateFlashlight)

	ClientState.on("Phase", function(phase)
		if phase == "dream" then
			baseFogEnd = Lighting.FogEnd
			EffectsController.applyQuality()
		elseif phase == "menu" then
			setFlashlight(false)
			clearWeather()
			local hud = ClientState.getGui("DreamHUD")
			local vignette = hud and hud:FindFirstChild("Vignette", true)
			if vignette then
				vignette.Visible = false
			end
			EffectsController.applyQuality()
		end
	end)

	ClientState.on("QualityChanged", function()
		EffectsController.applyQuality()
	end)

	Remotes.get("Scare").OnClientEvent:Connect(function(data)
		local kind = data.kind
		local now = os.clock()
		if kind == "jumpscare" then
			if now - scareCooldown < 1.5 then
				return
			end
			scareCooldown = now
			EffectsController.jumpscare(data.monsterName, data.intensity or 1)
		elseif kind == "whisper" then
			SoundController.play("Whisper", 0.7)
			local hud = ClientState.getGui("DreamHUD")
			local whisper = hud and hud:FindFirstChild("WhisperLabel", true)
			if whisper then
				whisper.Visible = true
				whisper.Text = "проснись... проснись... проснись..."
				whisper.TextTransparency = 0.1
				task.delay(2.5, function()
					if whisper then
						whisper.Visible = false
					end
				end)
			end
			CameraController.shake(0.5, 1)
		elseif kind == "hallucination" then
			EffectsController.hallucination()
		elseif kind == "growl" then
			SoundController.play("MonsterGrowl", 0.7)
			CameraController.shake(0.45, 0.6)
		elseif kind == "reveal" then
			EffectsController.jumpscare(data.monsterName or "ОБМАНЩИК", 1)
		elseif kind == "boss" then
			EffectsController.jumpscare(data.monsterName or "КОШМАР", 1.2)
		end
	end)

	Remotes.get("EventStarted").OnClientEvent:Connect(function(data)
		EffectsController.handleEvent(data)
	end)

	Remotes.get("VitalsUpdate").OnClientEvent:Connect(function(data)
		EffectsController.applySanity(data.sanity or 100)
		if (data.sanity or 100) < 35 then
			SoundController.heartbeat(true)
		else
			SoundController.heartbeat(false)
		end
	end)

	-- Фонарик следует за камерой
	-- Поворот и мерцание фонарика выполняет updateFlashlight (см. выше)

	EffectsController.applyQuality()
end

EffectsController.setWeather = setWeather

return EffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8292">
          <Properties>
            <string name="Name">CutsceneController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	CutsceneController.luau
	Анимация засыпания (кровать → полёт через пространство снов → белая вспышка)
	и анимация пробуждения (потолок → персонаж садится → кадр становится чётким).
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.SharedModules.Config)
local Remotes = require(ReplicatedStorage.SharedModules.Remotes)
local DreamDefinitions = require(ReplicatedStorage.SharedModules.DreamDefinitions)

local ClientState = require(script.Parent.ClientState)
local CameraController = require(script.Parent.CameraController)
local SoundController = require(script.Parent.SoundController)
local HUDController = require(script.Parent.HUDController)
local EffectsController = require(script.Parent.EffectsController)

local CutsceneController = {}

local flightFolder = nil

------------------------------------------------------------------
-- Вспомогательные элементы
------------------------------------------------------------------
local function gui()
	return ClientState.getGui("CutsceneGUI")
end

local function cutsceneEl(name)
	local g = gui()
	if not g then
		return nil
	end
	return g:FindFirstChild(name, true)
end

local function setText(name, text)
	local label = cutsceneEl(name)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

local function showFade(alpha, duration)
	local fade = cutsceneEl("Fade")
	if not fade then
		return
	end
	fade.Visible = true
	fade.BackgroundTransparency = fade.BackgroundTransparency
	ClientState.tween(fade, duration or 0.6, { BackgroundTransparency = alpha })
end

local function showFlash(duration)
	local flash = cutsceneEl("WhiteFlash")
	if not flash then
		return
	end
	flash.Visible = true
	flash.BackgroundTransparency = 0
	ClientState.tween(flash, duration or 2, { BackgroundTransparency = 1 })
	task.delay((duration or 2) + 0.2, function()
		if flash then
			flash.Visible = false
		end
	end)
end

local function letterbox(enabled)
	for _, name in ipairs({ "LetterboxTop", "LetterboxBottom" }) do
		local frame = cutsceneEl(name)
		if frame then
			frame.Visible = true
			local closed = name == "LetterboxTop" and UDim2.new(1, 0, 0.12, 0) or UDim2.new(1, 0, 0.12, 0)
			if enabled then
				frame.Size = UDim2.new(1, 0, 0, 0)
				ClientState.tween(frame, 0.8, { Size = closed }, Enum.EasingStyle.Quint)
			else
				ClientState.tween(frame, 0.6, { Size = UDim2.new(1, 0, 0, 0) })
			end
		end
	end
end

local function bedroomPart(name)
	local bedroom = Workspace:FindFirstChild("MenuBedroom")
	if not bedroom then
		return nil
	end
	local found = bedroom:FindFirstChild(name, true)
	if found and found:IsA("BasePart") then
		return found
	end
	return nil
end

local function playerCharacter()
	local character = ClientState.player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	return character
end

local function lockCharacter(locked)
	local character = playerCharacter()
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = locked and 0 or Config.BaseWalkSpeed
		humanoid.JumpPower = locked and 0 or Config.JumpPower
		humanoid.UseJumpPower = true
	end
end

------------------------------------------------------------------
-- Полёт через пространство снов
------------------------------------------------------------------
local function buildFlightSpace()
	if flightFolder then
		flightFolder:Destroy()
	end
	flightFolder = Instance.new("Folder")
	flightFolder.Name = "DreamFlight"
	flightFolder.Parent = Workspace

	local baseY = 4000
	local function part(size, cframe, color, material, transparency)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = size
		p.CFrame = cframe
		p.Color = color
		p.Material = material or Enum.Material.Neon
		p.Transparency = transparency or 0
		p.Parent = flightFolder
		return p
	end

	-- Звёзды
	for i = 1, 160 do
		local x = math.random(-260, 260)
		local y = baseY + math.random(-160, 160)
		local z = -math.random(0, 900)
		local size = math.random(3, 9) / 10
		local star = part(Vector3.new(size, size, size), CFrame.new(x, y, z), Color3.fromRGB(255, 250, 230), Enum.Material.Neon)
		star.Shape = Enum.PartType.Ball
	end

	-- Облака
	for i = 1, 42 do
		local x = math.random(-140, 140)
		local y = baseY + math.random(-50, 50)
		local z = -math.random(0, 800)
		local scale = math.random(20, 55)
		local cloud = part(Vector3.new(scale * 1.8, scale * 0.7, scale), CFrame.new(x, y, z), Color3.fromRGB(190, 180, 255), Enum.Material.SmoothPlastic, 0.72)
		cloud.Shape = Enum.PartType.Ball
	end

	-- Портал
	for i = 1, 8 do
		local x = math.random(-90, 90)
		local y = baseY + math.random(-40, 40)
		local z = -math.random(60, 760)
		local size = math.random(14, 26)
		local ring = part(Vector3.new(1.2, size, size), CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(math.random(0, 180)), math.rad(90)), Color3.fromRGB(190, 150, 255), Enum.Material.Neon, 0.1)
		ring.Shape = Enum.PartType.Cylinder
		local core = part(Vector3.new(size * 0.72, size * 0.72, 1), CFrame.new(x, y, z) * CFrame.Angles(0, 0, 0), Color3.fromRGB(120, 90, 220), Enum.Material.ForceField, 0.45)
		core.Shape = Enum.PartType.Ball
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(170, 140, 255)
		light.Brightness = 3
		light.Range = 60
		light.Parent = ring
	end

	-- Летающие часы
	for i = 1, 10 do
		local x = math.random(-70, 70)
		local y = baseY + math.random(-45, 45)
		local z = -math.random(40, 820)
		local size = math.random(10, 18)
		local face = part(Vector3.new(0.8, size, size), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 240, 200), Enum.Material.Neon, 0.2)
		face.Shape = Enum.PartType.Cylinder
		local hand = part(Vector3.new(size * 0.7, 0.6, 0.6), CFrame.new(x, y, z + 1), Color3.fromRGB(90, 70, 40), Enum.Material.Neon)
		hand.CFrame = CFrame.new(face.Position + face.CFrame.LookVector * 0.6) * CFrame.Angles(0, 0, math.rad(math.random(0, 360))) * CFrame.new(size * 0.35, 0, 0)
	end

	-- Острова
	for i = 1, 12 do
		local x = math.random(-120, 120)
		local y = baseY + math.random(-70, 20)
		local z = -math.random(80, 860)
		local island = part(Vector3.new(math.random(16, 40), 4, math.random(16, 40)), CFrame.new(x, y, z), Color3.fromRGB(90, 80, 140), Enum.Material.Slate, 0)
		island.CFrame = island.CFrame * CFrame.Angles(math.rad(math.random(-20, 20)), math.rad(math.random(0, 360)), math.rad(math.random(-20, 20)))
		local glow = part(Vector3.new(2, 8, 2), CFrame.new(x, y + 6, z), Color3.fromRGB(120, 255, 220), Enum.Material.Neon, 0.2)
	end

	-- Странные предметы
	for i = 1, 24 do
		local x = math.random(-80, 80)
		local y = baseY + math.random(-40, 40)
		local z = -math.random(20, 840)
		local item = part(Vector3.new(2, 2, 2), CFrame.new(x, y, z) * CFrame.Angles(math.random(), math.random(), math.random()),
			Color3.fromRGB(math.random(120, 255), math.random(100, 255), math.random(150, 255)), Enum.Material.Neon, 0.1)
		item.Shape = (i % 3 == 0) and Enum.PartType.Ball or Enum.PartType.Block
	end

	-- Частицы вокруг камеры
	local holder = part(Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, baseY, 10), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, 1)
	holder.CanCollide = false
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxassetid://241876428"
	emitter.Rate = 160
	emitter.Lifetime = NumberRange.new(1.5, 3)
	emitter.Speed = NumberRange.new(1, 6)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 200, 255), Color3.fromRGB(120, 220, 255))
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Parent = holder

	return baseY
end

local runToken = 0

-- Отложенные шаги катсцены не должны «срабатывать» в следующем сне:
-- каждая катсцена увеличивает токен, устаревшие колбэки молча выходят.
local function later(delay, fn)
	local token = runToken
	task.delay(delay, function()
		if token == runToken then
			fn()
		end
	end)
end

local function playFlight(duration)
	local baseY = buildFlightSpace()
	local camera = Workspace.CurrentCamera
	local startAt = os.clock()
	local start = CFrame.new(0, baseY, 40)
	local finish = CFrame.new(0, baseY + 10, -620)

	CameraController.setMode("script")
	local done = false
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if done then
			return
		end
		local alpha = math.clamp((os.clock() - startAt) / duration, 0, 1)
		local eased = 1 - (1 - alpha) ^ 2
		local position = start.Position:Lerp(finish.Position, eased) + Vector3.new(math.sin(alpha * 9) * 6, math.cos(alpha * 7) * 4, 0)
		local look = position + Vector3.new(math.sin(alpha * 4) * 12, math.cos(alpha * 3) * 8, -60)
		camera.CFrame = CFrame.lookAt(position, look)
		camera.FieldOfView = 70 + math.sin(alpha * 8) * 10
	end)

	task.delay(duration, function()
		done = true
		if connection then
			connection:Disconnect()
		end
		camera.FieldOfView = 78
		if flightFolder then
			flightFolder:Destroy()
			flightFolder = nil
		end
	end)
end

------------------------------------------------------------------
-- Засыпание
------------------------------------------------------------------
function CutsceneController.playSleep(payload)
	runToken += 1
	ClientState.setPhase("sleeping")
	ClientState.dream = payload
	local guiRef = gui()
	if guiRef then
		guiRef.Enabled = true
	end
	for _, name in ipairs({ "DreamText", "Subtitle", "Heartbeat" }) do
		local element = cutsceneEl(name)
		if element then
			element.Visible = false
		end
	end
	local fade = cutsceneEl("Fade")
	if fade then
		fade.Visible = true
		fade.BackgroundTransparency = 1
	end

	setText("Subtitle", payload.dreamName .. " — " .. payload.difficultyName)
	letterbox(true)
	lockCharacter(true)
	SoundController.setMenu()
	SoundController.playMusic("DreamMusic")

	-- Камера у кровати
	local bedPoint = bedroomPart("BedPoint")
	local cameraPoint = bedroomPart("SleepCameraPoint")
	local camera = Workspace.CurrentCamera
	CameraController.setMode("script")
	if cameraPoint then
		camera.CFrame = cameraPoint.CFrame
	else
		camera.CFrame = CFrame.new(6, 6, 6)
	end
	local lookTarget = bedPoint and bedPoint.Position or Vector3.new(0, 3, 0)

	-- Персонаж идёт к кровати, садится, ложится
	task.spawn(function()
		local character = playerCharacter()
		if character and bedPoint then
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local target = CFrame.new(bedPoint.Position + Vector3.new(0, 2.2, 0), bedPoint.Position + Vector3.new(0, 2.2, 4))
			local start = root.CFrame
			local time = 2.2
			local startAt = os.clock()
			while os.clock() - startAt < time do
				local alpha = math.clamp((os.clock() - startAt) / time, 0, 1)
				local eased = alpha * alpha * (3 - 2 * alpha)
				pcall(function()
					character:PivotTo(start:Lerp(target, eased))
				end)
				task.wait()
			end
			-- Ложится
			local lying = CFrame.new(bedPoint.Position + Vector3.new(0, 1.4, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
			pcall(function()
				character:PivotTo(lying)
			end)
			if humanoid then
				humanoid.WalkSpeed = 0
			end
		end
	end)

	-- Камера медленно приближается и темнеет
	task.spawn(function()
		local startAt = os.clock()
		local duration = 3.2
		while os.clock() - startAt < duration do
			local alpha = math.clamp((os.clock() - startAt) / duration, 0, 1)
			local position = (cameraPoint and cameraPoint.Position or Vector3.new(7, 6, 7)):Lerp(lookTarget + Vector3.new(2.5, 2.5, 3.5), alpha * 0.75)
			camera.CFrame = CFrame.lookAt(position, lookTarget)
			task.wait()
		end
		CameraController.setMode("script")
	end)

	later(1.2, function()
		setText("DreamText", "ЗАСЫПАНИЕ...")
		local text = cutsceneEl("DreamText")
		if text then
			text.Visible = true
			text.TextTransparency = 1
			ClientState.tween(text, 1.2, { TextTransparency = 0 })
		end
		SoundController.heartbeat(true)
	end)

	later(3.4, function()
		showFade(0, 1.4)
		local text = cutsceneEl("DreamText")
		if text then
			ClientState.tween(text, 0.8, { TextTransparency = 1 })
			later(0.9, function()
				text.Visible = false
			end)
		end
	end)

	-- Полёт
	later(4.6, function()
		playFlight(4.2)
		SoundController.heartbeat(false)
		setText("DreamText", "ТЫ ПОГРУЖАЕШЬСЯ В СОН...")
		local text = cutsceneEl("DreamText")
		if text then
			text.Visible = true
			text.TextTransparency = 1
			ClientState.tween(text, 0.8, { TextTransparency = 0 })
		end
	end)

	later(8.4, function()
		showFlash(1.6)
		local text = cutsceneEl("DreamText")
		if text then
			ClientState.tween(text, 0.4, { TextTransparency = 1 })
		end
	end)
end

------------------------------------------------------------------
-- Пробуждение
------------------------------------------------------------------
function CutsceneController.playWake(won)
	runToken += 1
	ClientState.setPhase("waking")
	local guiRef = gui()
	if guiRef then
		guiRef.Enabled = true
	end
	SoundController.setWaking(won)
	letterbox(true)

	local fade = cutsceneEl("Fade")
	if fade then
		fade.Visible = true
		fade.BackgroundTransparency = 0
	end

	local camera = Workspace.CurrentCamera
	local bedPoint = bedroomPart("BedPoint")
	CameraController.setMode("script")
	local eye = bedPoint and (bedPoint.Position + Vector3.new(0, 2.6, 0)) or Vector3.new(0, 3, 0)
	camera.CFrame = CFrame.lookAt(eye, eye + Vector3.new(0, 12, 2))

	-- Размытый потолок
	showFade(0.82, 2.2)
	later(0.8, function()
		local dof = Lighting:FindFirstChild("DreamDOF")
		if dof then
			dof.FarIntensity = 1
			dof.InFocusRadius = 8
		end
		SoundController.heartbeat(true)
	end)

	-- Садится и картинка становится чёткой
	later(2.6, function()
		local character = playerCharacter()
		if character and bedPoint then
			local sit = CFrame.new(bedPoint.Position + Vector3.new(0, 2.4, 0), bedPoint.Position + Vector3.new(0, 2.4, 4))
			pcall(function()
				character:PivotTo(sit)
			end)
		end
		local dof = Lighting:FindFirstChild("DreamDOF")
		if dof then
			dof.FarIntensity = 0.25
			dof.InFocusRadius = 40
		end
	end)

	later(4.2, function()
		lockCharacter(false)
		SoundController.heartbeat(false)
		letterbox(false)
		showFade(0, 1.6)
		later(1.8, function()
			if guiRef then
				guiRef.Enabled = false
			end
			local fadeElement = cutsceneEl("Fade")
			if fadeElement then
				fadeElement.Visible = false
			end
			ClientState.setCursorFree(true)
			ClientState.setPhase("result")
			if ClientState.result then
				HUDController.showResult(ClientState.result)
			end
		end)
	end)
end

------------------------------------------------------------------
-- События сервера
------------------------------------------------------------------
function CutsceneController.start()
	Remotes.get("SleepSequence").OnClientEvent:Connect(function(payload)
		CutsceneController.playSleep(payload)
	end)

	Remotes.get("DreamStarted").OnClientEvent:Connect(function(payload)
		ClientState.dream = payload
		ClientState.bonuses = payload.bonuses or {}
		ClientState.timer.remaining = payload.duration or Config.DreamDuration
		ClientState.timer.total = payload.duration or Config.DreamDuration
		if payload.settings then
			for key, value in pairs(payload.settings) do
				ClientState.settings[key] = value
			end
		end
		local guiRef = gui()
		if guiRef then
			guiRef.Enabled = false
		end
		showFlash(0.9)
		ClientState.setPhase("dream")
		CameraController.setMode("dream")
		CameraController.setFieldOfView(80, 0.1)
		SoundController.setDream()
		local dream = DreamDefinitions.get(payload.dreamId)
		if dream then
			if dream.weather == "Rain" then
				EffectsController.setWeather("rain")
			elseif dream.weather == "Snow" then
				EffectsController.setWeather("snow")
			elseif dream.weather == "Storm" then
				EffectsController.setWeather("rain")
			end
		end
	end)

	Remotes.get("DreamEnded").OnClientEvent:Connect(function(result)
		ClientState.result = result
		CutsceneController.playWake(result.won == true)
	end)

	Remotes.get("DreamStateChanged").OnClientEvent:Connect(function(data)
		if data.state == "menu" then
			ClientState.result = nil
			ClientState.portalPosition = nil
			ClientState.quests = {}
			HUDController.hideResult()
			ClientState.setPhase("menu")
			ClientState.emit("EnteredMenu")
		elseif data.state == "waking" then
			local guiRef = gui()
			if guiRef then
				guiRef.Enabled = true
			end
		end
	end)

	ClientState.on("ResultAction", function(action)
		if action == "retry" then
			local difficulty = ClientState.result and ClientState.result.difficulty or "Normal"
			local previousPhase = ClientState.phase
			ClientState.result = nil
			HUDController.hideResult()
			local remote = Remotes.get("RequestDream")
			if remote then
				remote:FireServer(difficulty)
			end
			-- Если сервер не принял (сон ещё убирается), возвращаем меню,
			-- а не оставляем игрока на пустом экране.
			later(3, function()
				if ClientState.phase == previousPhase and previousPhase ~= "sleeping" then
					ClientState.setPhase("menu")
					ClientState.toast("Сон не начался — попробуй снова", Color3.fromRGB(255, 190, 150), "🌙")
				end
			end)
		else
			ClientState.setPhase("menu")
			ClientState.result = nil
			local remote = Remotes.get("ReturnToMenu")
			if remote then
				remote:FireServer()
			end
		end
	end)
end

return CutsceneController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8293">
          <Properties>
            <string name="Name">DiagnosticsController</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	DiagnosticsController.luau
	Диагностика и защита от «тихих» ошибок:
	  • F8 — панель состояния (сборка, режим данных, фаза, сон, FPS, пинг);
	  • ошибки клиентских скриптов превращаются в понятные тосты,
		а не молча ломают игру.

	Панель создаётся кодом, поэтому не зависит от верстки ScreenGui.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SharedModules = ReplicatedStorage:WaitForChild("SharedModules")
local Config = require(SharedModules:WaitForChild("Config"))
local DreamDefinitions = require(SharedModules:WaitForChild("DreamDefinitions"))
local Remotes = require(SharedModules:WaitForChild("Remotes"))
local ClientState = require(script.Parent.ClientState)

local DiagnosticsController = {}
local panel
local lines = {}
local visible = false
local errorCount = 0
local lastError = ""

local COLORS = {
	bg = Color3.fromRGB(11, 12, 24),
	stroke = Color3.fromRGB(140, 130, 255),
	text = Color3.fromRGB(226, 228, 246),
	dim = Color3.fromRGB(150, 154, 190),
	good = Color3.fromRGB(130, 235, 170),
	warn = Color3.fromRGB(255, 200, 120),
	bad = Color3.fromRGB(255, 130, 140),
}

local function newLine(parentFrame, index, text, color)
	local label = Instance.new("TextLabel")
	label.Name = "Line" .. index
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 18, 0, 46 + (index - 1) * 22)
	label.Size = UDim2.new(1, -36, 0, 20)
	label.Font = Enum.Font.Gotham
	label.TextSize = 15
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = color or COLORS.text
	label.Text = text
	label.Parent = parentFrame
	lines[index] = label
	return label
end

local function buildPanel()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "DiagnosticsGUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 60
	gui.Enabled = false
	gui.Parent = playerGui

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0, 0)
	card.Position = UDim2.new(0, 24, 0, 96)
	card.Size = UDim2.new(0, 400, 0, 300)
	card.BackgroundColor3 = COLORS.bg
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.stroke
	stroke.Thickness = 1.4
	stroke.Transparency = 0.35
	stroke.Parent = card

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0, 18, 0, 12)
	title.Size = UDim2.new(1, -36, 0, 24)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 17
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = COLORS.stroke
	title.Text = "🛠 ДИАГНОСТИКА  ·  F8 — закрыть"
	title.Parent = card

	for index = 1, 10 do
		newLine(card, index, "", COLORS.dim)
	end

	panel = gui
	return gui
end

local currentFps = 0
local fpsAccum, fpsFrames = 0, 0
RunService.RenderStepped:Connect(function(dt)
	fpsAccum += dt
	fpsFrames += 1
	if fpsAccum >= 0.5 then
		currentFps = math.floor(fpsFrames / fpsAccum)
		fpsAccum, fpsFrames = 0, 0
	end
end)

local function describeSettings()
	local settings = ClientState.settings or {}
	local quality = settings.quality or "Средний"
	return ("качество %s · скрымеры %.1f · тряска %s"):format(
		quality,
		settings.scareIntensity or 1,
		settings.cameraShake and "вкл" or "выкл"
	)
end

function DiagnosticsController.refresh()
	if not panel then
		return
	end
	local dataMode = (workspace:GetAttribute("DataStoreMode")) or "неизвестно"
	local version = (workspace:GetAttribute("BuildVersion")) or "dev"
	local ready = workspace:GetAttribute("GameReady") == true
	local dream = ClientState.dream
	local quests = 0
	for _, quest in ipairs(ClientState.quests or {}) do
		if quest.state == "done" then
			quests += 1
		end
	end
	local ping = 0
	pcall(function()
		ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	end)

	local clockText = os.date("%H:%M:%S")
	local rows = {
		{ "Сборка: " .. tostring(version) .. (ready and "  ·  мир готов" or "  ·  мир грузится"), ready and COLORS.good or COLORS.warn },
		{ "Данные: " .. tostring(dataMode), dataMode == "cloud" and COLORS.good or COLORS.warn },
		{ "Фаза: " .. tostring(ClientState.phase) .. "  ·  FPS " .. tostring(currentFps) .. tostring(ping > 0 and ("  ·  " .. ping .. " мс") or ""), COLORS.text },
		{ dream and ("Сон: " .. tostring(dream.dreamName) .. " (" .. tostring(dream.dreamId) .. ")") or "Сон: нет", COLORS.dim },
		{ ("Заданий выполнено: %d  ·  батарея %d%%"):format(quests, math.floor((ClientState.vitals and ClientState.vitals.battery) or 0)), COLORS.text },
		{ "Снов в базе: " .. tostring(#DreamDefinitions.List) .. "  ·  каналов: " .. tostring(#Remotes.EVENTS + #Remotes.FUNCTIONS), COLORS.dim },
		{ describeSettings(), COLORS.dim },
		{ ("Ошибок клиента: %d"):format(errorCount), errorCount > 0 and COLORS.bad or COLORS.good },
		{ errorCount > 0 and ("Последняя: " .. string.sub(lastError, 1, 54)) or "Ошибок нет", errorCount > 0 and COLORS.bad or COLORS.good },
		{ "Время: " .. clockText, COLORS.dim },
	}

	for index, row in ipairs(rows) do
		local label = lines[index]
		if label then
			label.Text = row[1]
			label.TextColor3 = row[2]
		end
	end
end

function DiagnosticsController.toggle(force)
	if not panel then
		buildPanel()
	end
	visible = force ~= nil and force or not visible
	panel.Enabled = visible
	if visible then
		DiagnosticsController.refresh()
	end
end

function DiagnosticsController.report(message)
	errorCount += 1
	lastError = tostring(message or "неизвестная ошибка"):gsub("\n.*", "")
	ClientState.toast("Ошибка: " .. string.sub(lastError, 1, 90), COLORS.bad, "⚠️")
	if visible then
		DiagnosticsController.refresh()
	end
end

function DiagnosticsController.start()
	buildPanel()

	-- Чтобы F8 не занимала игра, биндим напрямую
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F8 then
			DiagnosticsController.toggle()
		end
	end)

	-- Ошибки клиента: показываем тост и считаем
	local okContext, scriptContext = pcall(function()
		return game:GetService("ScriptContext")
	end)
	if okContext and scriptContext then
		scriptContext.Error:Connect(function(message, stack, _script)
			local first = tostring(message)
			errorCount += 1
			lastError = first
			warn("[DreamSimulator][client] " .. first .. "\n" .. tostring(stack))
			ClientState.toast("Ошибка: " .. string.sub(first, 1, 90), COLORS.bad, "⚠️")
			if visible then
				DiagnosticsController.refresh()
			end
		end)
	end

	-- Раз в секунду обновляем панель, если она открыта
	task.spawn(function()
		while true do
			task.wait(1)
			if visible then
				DiagnosticsController.refresh()
			end
		end
	end)
end

return DiagnosticsController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
