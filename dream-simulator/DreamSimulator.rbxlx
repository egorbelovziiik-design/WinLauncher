		ambience = "rbxassetid://9125402735",
		npcs = {
			{ name = "Смотритель маяка", color = Color3.fromRGB(180, 200, 210), line = "Маяк давно погас. Зажжёшь — и вода отступит. Хотя бы на время." },
			{ name = "Рыбак", color = Color3.fromRGB(90, 110, 100), line = "В воде не рыба. В воде те, кто не успел. Не смотри им в глаза." },
			{ name = "Девочка с плотом", color = Color3.fromRGB(200, 180, 190), line = "Мы плыли-плыли-плыли. Потом вода кончилась, а мы всё плыли." },
		},
		messages = {
			"Вода плещется там, где её нет.",
			"Из глубины поднимается пузырь.",
			"Дождь идёт снизу вверх.",
			"Маяк мигнул, хотя он не горит.",
		},
	}),
	dream({
		id = "ice",
		title = "Ледяной мир",
		subtitle = "Холод проникает в мысли",
		icon = "❄️",
		map = "IceWorld",
		desc = "Бесконечные сугробы, синие скалы и тишина, которая звенит.",
		hint = "Разожгите костёр — огонь укажет, куда идти.",
		mandatory = "ice_m",
		optional = { "ice_o1", "ice_o2", "ice_o3" },
		monsters = { "frost", "watcher", "shadow" },
		boss = "nightmare",
		monsterCount = 3,
		ambient = Color3.fromRGB(120, 150, 180),
		outdoorAmbient = Color3.fromRGB(80, 110, 145),
		fogColor = Color3.fromRGB(160, 190, 215),
		fogStart = 40,
		fogEnd = 300,
		brightness = 1.4,
		clockTime = 6,
		atmosphere = { density = 0.4, haze = 4, glare = 0.15, color = Color3.fromRGB(200, 225, 245), decay = Color3.fromRGB(150, 180, 210) },
		colorCorrection = { tint = Color3.fromRGB(215, 240, 255), saturation = -0.1, contrast = 0.12, brightness = 0.04 },
		bloom = { intensity = 0.55, size = 32, threshold = 1.3 },
		depthOfField = { focus = 70, near = 0.1, far = 0.5 },
		ambience = "rbxassetid://9125402735",
		npcs = {
			{ name = "Замерзший путник", color = Color3.fromRGB(200, 215, 230), line = "Костёр не гаснет триста лет. Разожги его — и лёд отпустит тебя." },
			{ name = "Снежная дева", color = Color3.fromRGB(220, 235, 255), line = "Холод честнее людей. Он не врёт, он просто забирает." },
			{ name = "Эхо", color = Color3.fromRGB(170, 190, 210), line = "…не возвращайся… не возвращайся…" },
		},
		messages = {
			"Снег пошёл вверх.",
			"Твоё дыхание стало чужим.",
			"Лёд треснул под ногами.",
			"Кто-то идёт по снегу. Следов нет.",
		},
	}),
	dream({
		id = "factory",
		title = "Заброшенная фабрика",
		subtitle = "Станки работают без людей",
		icon = "🏭",
		map = "Factory",
		desc = "Лязг конвейера, пар и запах мазута. Здесь делали кое-что запретное.",
		hint = "Остановите конвейер, чтобы попасть в цех.",
		mandatory = "factory_m",
		optional = { "factory_o1", "factory_o2", "factory_o3" },
		monsters = { "machine", "runner", "shadow" },
		boss = "nightmare",
		monsterCount = 4,
		ambient = Color3.fromRGB(55, 50, 45),
		outdoorAmbient = Color3.fromRGB(30, 28, 26),
		fogColor = Color3.fromRGB(40, 38, 34),
		fogStart = 20,
		fogEnd = 220,
		brightness = 0.75,
		clockTime = 1,
		atmosphere = { density = 0.42, haze = 2, glare = 0.06, color = Color3.fromRGB(150, 140, 120), decay = Color3.fromRGB(80, 70, 60) },
		colorCorrection = { tint = Color3.fromRGB(230, 215, 190), saturation = -0.22, contrast = 0.2, brightness = -0.05 },
		bloom = { intensity = 0.6, size = 24, threshold = 1.1 },
		depthOfField = { focus = 40, near = 0.22, far = 0.4 },
		ambience = "rbxassetid://9046893493",
		npcs = {
			{ name = "Мастер", color = Color3.fromRGB(150, 130, 90), line = "Три станка — три выключателя. Останови их все, иначе смена твоя никогда не кончится." },
			{ name = "Механик", color = Color3.fromRGB(110, 110, 110), line = "Шестерни валяются по всему цеху. Без них кран не заработает." },
			{ name = "Сменщик", color = Color3.fromRGB(130, 120, 100), line = "Я работаю здесь двадцать лет. Смены не было ни разу. Ты — мой первый гость." },
		},
		messages = {
			"Конвейер запустился сам.",
			"Из вентиляции идёт пар. Он шепчет.",
			"Искры складываются в цифры.",
			"На пульте горит: «СМЕНА НЕ ЗАКОНЧЕНА».",
		},
	}),
	dream({
		id = "space",
		title = "Космическая станция",
		subtitle = "В вакууме нет звука, но ты слышишь дыхание",
		icon = "🛰",
		map = "SpaceStation",
		desc = "Огни аварийного освещения, невесомость и что-то в шлюзе.",
		hint = "Восстановите подачу кислорода, иначе портал не откроется.",
		mandatory = "space_m",
		optional = { "space_o1", "space_o2", "space_o3" },
		monsters = { "alien", "machine", "watcher", "nightmare" },
		boss = "nightmare",
		monsterCount = 4,
		ambient = Color3.fromRGB(30, 34, 44),
		outdoorAmbient = Color3.fromRGB(10, 12, 20),
		fogColor = Color3.fromRGB(12, 14, 24),
		fogStart = 60,
		fogEnd = 400,
		brightness = 0.9,
		clockTime = 0,
		atmosphere = { density = 0.15, haze = 0.5, glare = 0.3, color = Color3.fromRGB(90, 110, 160), decay = Color3.fromRGB(30, 40, 70) },
		colorCorrection = { tint = Color3.fromRGB(190, 210, 255), saturation = -0.05, contrast = 0.28, brightness = -0.03 },
		bloom = { intensity = 1.1, size = 28, threshold = 0.95 },
		depthOfField = { focus = 80, near = 0.1, far = 0.55 },
		ambience = "rbxassetid://9046893493",
		npcs = {
			{ name = "ИИ «Орфей»", color = Color3.fromRGB(120, 200, 230), line = "Кислород: 3%. Восстановление требует трёх модулей. Рекомендую поторопиться, гость." },
			{ name = "Капитан", color = Color3.fromRGB(160, 170, 190), line = "Мы нашли это в туманности. Оно нашло нас быстрее." },
			{ name = "Инженер", color = Color3.fromRGB(140, 150, 130), line = "Не заходи в шлюз 4. И не слушай, если оттуда позовут твоим голосом." },
		},
		messages = {
			"Свет мигнул. Гравитация на миг исчезла.",
			"По обшивке что-то ползёт.",
			"Кислород: 2%. Дыши глубже.",
			"Твоё имя произнесли из шлюза.",
		},
	}),
	dream({
		id = "castle",
		title = "Проклятый замок",
		subtitle = "Король спит уже тысячу лет",
		icon = "🏰",
		map = "CursedCastle",
		desc = "Каменные стены, факелы и гобелены, на которых кто-то движется.",
		hint = "Снимите проклятие с замка, чтобы уйти.",
		mandatory = "castle_m",
		optional = { "castle_o1", "castle_o2", "castle_o3" },
		monsters = { "knight", "watcher", "shadow", "nightmare" },
		boss = "nightmare",
		monsterCount = 4,
		ambient = Color3.fromRGB(50, 40, 55),
		outdoorAmbient = Color3.fromRGB(26, 22, 34),
		fogColor = Color3.fromRGB(34, 28, 44),
		fogStart = 20,
		fogEnd = 200,
		brightness = 0.65,
		clockTime = 0.6,
		atmosphere = { density = 0.45, haze = 2.6, glare = 0.05, color = Color3.fromRGB(140, 110, 160), decay = Color3.fromRGB(60, 40, 80) },
		colorCorrection = { tint = Color3.fromRGB(220, 200, 255), saturation = -0.18, contrast = 0.24, brightness = -0.06 },
		bloom = { intensity = 0.75, size = 26, threshold = 1.05 },
		depthOfField = { focus = 32, near = 0.24, far = 0.42 },
		ambience = "rbxassetid://9125402735",
		npcs = {
			{ name = "Призрак короля", color = Color3.fromRGB(180, 160, 220), line = "Корона, меч и печать. Сними с меня бремя — и я отпущу твой сон." },
			{ name = "Слуга", color = Color3.fromRGB(140, 130, 120), line = "Господин не спит. Он ждёт. Уже тысячу лет." },
			{ name = "Ведьма", color = Color3.fromRGB(120, 90, 150), line = "Факелы — это глаза. Погаснет факел — ослепнет замок." },
		},
		messages = {
			"Факел погас сам.",
			"Доспехи на стене повернули шлем.",
			"Из подземелья слышен стон.",
			"Часы пробили тринадцать.",
		},
	}),
}

-- Погода каждого сна (для клиентских эффектов).
local WEATHER = {
	forest = "Rain",
	school = "Storm",
	city = "Rain",
	hospital = "Rain",
	circus = "None",
	flood = "Rain",
	ice = "Snow",
	factory = "None",
	space = "None",
	castle = "None",
}

for _, entry in ipairs(DreamDefinitions.List) do
	entry.name = entry.title
	entry.weather = entry.weather or WEATHER[entry.id] or "None"
end

DreamDefinitions.ById = {}
for _, entry in ipairs(DreamDefinitions.List) do
	DreamDefinitions.ById[entry.id] = entry
end

DreamDefinitions.Order = {}
for _, entry in ipairs(DreamDefinitions.List) do
	table.insert(DreamDefinitions.Order, entry.id)
end

function DreamDefinitions.get(id)
	return DreamDefinitions.ById[id] or DreamDefinitions.List[1]
end

function DreamDefinitions.random(exclude, rng)
	local pool = {}
	for _, entry in ipairs(DreamDefinitions.List) do
		if not exclude or entry.id ~= exclude then
			table.insert(pool, entry.id)
		end
	end
	if #pool == 0 then
		return DreamDefinitions.List[1].id
	end
	if rng then
		return pool[rng:NextInteger(1, #pool)]
	end
	return pool[math.random(1, #pool)]
end

return DreamDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="254">
        <Properties>
          <string name="Name">MonsterDefinitions</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MonsterDefinitions: 14 типов монстров (5 базовых архетипов + тематические).

local MonsterDefinitions = {}

MonsterDefinitions.Archetypes = {
	shadow = {
		name = "Тень",
		behavior = "stalker",
		speed = 12,
		detectRange = 70,
		attackRange = 6,
		damage = 22,
		sanityDrain = 8,
		height = 7.4,
		bodyColor = Color3.fromRGB(14, 12, 22),
		eyeColor = Color3.fromRGB(255, 60, 70),
		transparency = 0.25,
		scareSound = "scare",
		desc = "Скользит по стенам и не отбрасывает тени.",
	},
	runner = {
		name = "Бегун",
		behavior = "chaser",
		speed = 19,
		detectRange = 95,
		attackRange = 5,
		damage = 16,
		sanityDrain = 6,
		height = 6.2,
		bodyColor = Color3.fromRGB(120, 26, 30),
		eyeColor = Color3.fromRGB(255, 210, 120),
		transparency = 0,
		scareSound = "scare",
		desc = "Слышит каждый шаг. Никогда не устаёт.",
	},
	watcher = {
		name = "Наблюдатель",
		behavior = "watcher",
		speed = 6,
		detectRange = 120,
		attackRange = 40,
		damage = 9,
		sanityDrain = 12,
		height = 8.6,
		bodyColor = Color3.fromRGB(200, 200, 210),
		eyeColor = Color3.fromRGB(255, 30, 30),
		transparency = 0.45,
		scareSound = "scare_big",
		desc = "Стоит неподвижно и смотрит. Смотреть в ответ нельзя.",
	},
	trickster = {
		name = "Обманщик",
		behavior = "mimic",
		speed = 14,
		detectRange = 80,
		attackRange = 6,
		damage = 20,
		sanityDrain = 10,
		height = 6.8,
		bodyColor = Color3.fromRGB(70, 120, 110),
		eyeColor = Color3.fromRGB(160, 255, 220),
		transparency = 0,
		scareSound = "scare",
		desc = "Притворяется другом. Голос звучит знакомо.",
	},
	nightmare = {
		name = "Кошмар",
		behavior = "hunter",
		speed = 16,
		detectRange = 110,
		attackRange = 8,
		damage = 34,
		sanityDrain = 16,
		height = 11,
		bodyColor = Color3.fromRGB(30, 8, 40),
		eyeColor = Color3.fromRGB(255, 120, 0),
		transparency = 0.1,
		scareSound = "scare_big",
		desc = "Хозяин сна. Появляется, когда разум на исходе.",
		boss = true,
	},
}

-- Алиасы архетипов: поведение "chaser"/"hunter" описывается отдельными наборами.
MonsterDefinitions.Archetypes.chaser = {
	name = "Преследователь",
	behavior = "chaser",
	speed = 15,
	detectRange = 90,
	attackRange = 6,
	damage = 20,
	sanityDrain = 7,
	height = 7.2,
	bodyColor = Color3.fromRGB(90, 40, 40),
	eyeColor = Color3.fromRGB(255, 180, 80),
	transparency = 0,
	scareSound = "scare",
	desc = "Идёт по следу, пока не найдёт.",
}

MonsterDefinitions.Archetypes.hunter = {
	name = "Охотник",
	behavior = "hunter",
	speed = 15,
	detectRange = 105,
	attackRange = 7,
	damage = 28,
	sanityDrain = 12,
	height = 9.2,
	bodyColor = Color3.fromRGB(40, 20, 40),
	eyeColor = Color3.fromRGB(255, 110, 30),
	transparency = 0.05,
	scareSound = "scare_big",
	desc = "Не отступает. Умеет ждать.",
}

MonsterDefinitions.Types = {
	{
		id = "shadow",
		archetype = "shadow",
		name = "Тень",
		dreams = { "forest", "school", "hospital", "factory" },
	},
	{
		id = "runner",
		archetype = "runner",
		name = "Бегун",
		dreams = { "city", "flood", "school", "factory" },
	},
	{
		id = "watcher",
		archetype = "watcher",
		name = "Наблюдатель",
		dreams = { "forest", "ice", "castle", "space" },
	},
	{
		id = "trickster",
		archetype = "trickster",
		name = "Обманщик",
		dreams = { "circus", "city" },
	},
	{
		id = "nightmare",
		archetype = "nightmare",
		name = "Кошмар",
		dreams = { "castle", "circus", "space" },
	},
	{
		id = "pierrot",
		archetype = "trickster",
		name = "Пьеро",
		dreams = { "circus" },
		color = Color3.fromRGB(235, 235, 245),
		eyeColor = Color3.fromRGB(255, 40, 80),
		speed = 15,
	},
	{
		id = "nurse",
		archetype = "stalker",
		name = "Медсестра",
		dreams = { "hospital" },
		color = Color3.fromRGB(225, 230, 230),
		eyeColor = Color3.fromRGB(210, 30, 40),
		speed = 13,
	},
	{
		id = "doll",
		archetype = "watcher",
		name = "Кукла",
		dreams = { "circus", "school" },
		color = Color3.fromRGB(220, 200, 190),
		eyeColor = Color3.fromRGB(30, 30, 30),
		speed = 5,
		scale = 0.75,
	},
	{
		id = "drowned",
		archetype = "chaser",
		name = "Утопленник",
		dreams = { "flood" },
		color = Color3.fromRGB(60, 100, 100),
		eyeColor = Color3.fromRGB(200, 255, 240),
		speed = 13,
	},
	{
		id = "frost",
		archetype = "watcher",
		name = "Мороз",
		dreams = { "ice" },
		color = Color3.fromRGB(190, 225, 245),
		eyeColor = Color3.fromRGB(90, 200, 255),
		speed = 8,
	},
	{
		id = "machine",
		archetype = "chaser",
		name = "Механизм",
		dreams = { "factory", "space" },
		color = Color3.fromRGB(120, 110, 90),
		eyeColor = Color3.fromRGB(255, 170, 40),
		speed = 11,
		scale = 1.15,
	},
	{
		id = "alien",
		archetype = "hunter",
		name = "Чужой",
		dreams = { "space" },
		color = Color3.fromRGB(60, 80, 70),
		eyeColor = Color3.fromRGB(120, 255, 180),
		speed = 15,
	},
	{
		id = "knight",
		archetype = "hunter",
		name = "Тёмный рыцарь",
		dreams = { "castle" },
		color = Color3.fromRGB(70, 68, 80),
		eyeColor = Color3.fromRGB(255, 90, 40),
		speed = 12,
		scale = 1.1,
	},
	{
		id = "librarian",
		archetype = "stalker",
		name = "Библиотекарь",
		dreams = { "school", "castle" },
		color = Color3.fromRGB(80, 70, 110),
		eyeColor = Color3.fromRGB(230, 220, 160),
		speed = 9,
	},
}

MonsterDefinitions.ByArchetype = {}
for _, monster in ipairs(MonsterDefinitions.Types) do
	local base = MonsterDefinitions.Archetypes[monster.archetype] or MonsterDefinitions.Archetypes.shadow
	local merged = {}
	for key, value in pairs(base) do
		merged[key] = value
	end
	for key, value in pairs(monster) do
		merged[key] = value
	end
	merged.speed = monster.speed or base.speed
	merged.color = monster.color or base.bodyColor
	merged.eyeColor = monster.eyeColor or base.eyeColor
	merged.scale = monster.scale or 1
	MonsterDefinitions.ByArchetype[monster.id] = merged
end

function MonsterDefinitions.get(id)
	return MonsterDefinitions.ByArchetype[id] or MonsterDefinitions.ByArchetype.shadow
end

function MonsterDefinitions.forDream(dreamId)
	local out = {}
	for _, monster in ipairs(MonsterDefinitions.Types) do
		for _, dream in ipairs(monster.dreams) do
			if dream == dreamId then
				table.insert(out, monster.id)
				break
			end
		end
	end
	if #out == 0 then
		out = { "shadow", "runner" }
	end
	return out
end

return MonsterDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="255">
        <Properties>
          <string name="Name">QuestDefinitions</string>
          <string name="Source"><![CDATA[--!nonstrict
-- QuestDefinitions: 38 заданий (10 обязательных + 28 необязательных).
-- kind: collect | interact | talk | reach | survive | lights

local QuestDefinitions = {}

local raw = {
	-- Тёмный лес
	{ id = "forest_m", dream = "forest", kind = "collect", need = 4, title = "Осколки сна", desc = "Соберите 4 светящихся осколка на тропе.", reward = 60, label = "Осколок сна" },
	{ id = "forest_o1", dream = "forest", kind = "interact", need = 1, title = "Разжечь костёр", desc = "Найдите костёр у тропы и разожгите его.", reward = 40, label = "Костёр" },
	{ id = "forest_o2", dream = "forest", kind = "talk", need = 1, title = "Голос леса", desc = "Поговорите со Старым лесником.", reward = 35 },
	{ id = "forest_o3", dream = "forest", kind = "reach", need = 1, title = "Тайная поляна", desc = "Дойдите до поляны на севере леса.", reward = 45 },

	-- Школа
	{ id = "school_m", dream = "school", kind = "lights", need = 3, title = "Аварийный свет", desc = "Включите три аварийные лампы в школе.", reward = 60, label = "Аварийная лампа" },
	{ id = "school_o1", dream = "school", kind = "collect", need = 3, title = "Дневники учеников", desc = "Найдите 3 дневника в классах.", reward = 45, label = "Дневник" },
	{ id = "school_o2", dream = "school", kind = "interact", need = 2, title = "Чужие шкафчики", desc = "Проверьте два шкафчика в коридоре.", reward = 40, label = "Шкафчик" },
	{ id = "school_o3", dream = "school", kind = "lights", need = 3, title = "Дежурный свет", desc = "Включите три лампы в спортзале и коридоре.", reward = 50, label = "Лампа" },

	-- Город
	{ id = "city_m", dream = "city", kind = "interact", need = 3, title = "Питание города", desc = "Запустите три городских щитка.", reward = 70, label = "Щиток" },
	{ id = "city_o1", dream = "city", kind = "collect", need = 5, title = "Батареи", desc = "Соберите 5 батарей на улицах.", reward = 45, label = "Батарея" },
	{ id = "city_o2", dream = "city", kind = "reach", need = 1, title = "Седьмой этаж", desc = "Поднимитесь на крышу дальнего здания.", reward = 50 },
	{ id = "city_o3", dream = "city", kind = "survive", need = 90, title = "Патруль", desc = "Продержитесь 90 секунд, не попадаясь на глаза.", reward = 55 },

	-- Больница
	{ id = "hospital_m", dream = "hospital", kind = "collect", need = 4, title = "Медицинские записи", desc = "Найдите 4 истории болезни.", reward = 65, label = "Запись" },
	{ id = "hospital_o1", dream = "hospital", kind = "interact", need = 1, title = "Резервный генератор", desc = "Запустите генератор в подвале.", reward = 40, label = "Генератор" },
	{ id = "hospital_o2", dream = "hospital", kind = "talk", need = 1, title = "Разговор с медсестрой", desc = "Узнайте у медсестры, где выход.", reward = 35 },
	{ id = "hospital_o3", dream = "hospital", kind = "reach", need = 1, title = "Палата 13", desc = "Найдите палату 13 в западном крыле.", reward = 50 },

	-- Цирк
	{ id = "circus_m", dream = "circus", kind = "interact", need = 1, title = "Клетка", desc = "Откройте клетку с зверем.", reward = 65, label = "Клетка" },
	{ id = "circus_o1", dream = "circus", kind = "collect", need = 3, title = "Билеты", desc = "Соберите 3 билета на представление.", reward = 45, label = "Билет" },
	{ id = "circus_o2", dream = "circus", kind = "reach", need = 1, title = "Колесо обозрения", desc = "Заберитесь на колесо обозрения.", reward = 50 },
	{ id = "circus_o3", dream = "circus", kind = "lights", need = 3, title = "Гирлянды", desc = "Зажгите три гирлянды вокруг арены.", reward = 50, label = "Гирлянда" },

	-- Затопленный город
	{ id = "flood_m", dream = "flood", kind = "interact", need = 1, title = "Маяк", desc = "Зажгите маяк на краю города.", reward = 70, label = "Маяк" },
	{ id = "flood_o1", dream = "flood", kind = "collect", need = 3, title = "Сигнальные ракеты", desc = "Найдите 3 сигнальные ракеты.", reward = 45, label = "Ракета" },
	{ id = "flood_o2", dream = "flood", kind = "interact", need = 1, title = "Затопленный автобус", desc = "Осмотрите автобус в центре воды.", reward = 40, label = "Автобус" },
	{ id = "flood_o3", dream = "flood", kind = "reach", need = 1, title = "Плотина", desc = "Дойдите до старой плотины.", reward = 50 },

	-- Ледяной мир
	{ id = "ice_m", dream = "ice", kind = "interact", need = 1, title = "Огонь среди льда", desc = "Разожгите лагерный костёр.", reward = 65, label = "Костёр" },
	{ id = "ice_o1", dream = "ice", kind = "collect", need = 4, title = "Ледяные кристаллы", desc = "Соберите 4 кристалла.", reward = 45, label = "Кристалл" },
	{ id = "ice_o2", dream = "ice", kind = "talk", need = 1, title = "Замерзший путник", desc = "Поговорите с путником у костра.", reward = 35 },
	{ id = "ice_o3", dream = "ice", kind = "reach", need = 1, title = "Ледяной дворец", desc = "Дойдите до ворот дворца.", reward = 50 },

	-- Фабрика
	{ id = "factory_m", dream = "factory", kind = "interact", need = 3, title = "Остановить конвейер", desc = "Отключите три станка.", reward = 70, label = "Станок" },
	{ id = "factory_o1", dream = "factory", kind = "collect", need = 4, title = "Шестерни", desc = "Соберите 4 шестерни в цеху.", reward = 45, label = "Шестерня" },
	{ id = "factory_o2", dream = "factory", kind = "interact", need = 1, title = "Пульт управления", desc = "Включите главный пульт.", reward = 40, label = "Пульт" },
	{ id = "factory_o3", dream = "factory", kind = "survive", need = 60, title = "Обход", desc = "Переждите обход мастера — 60 секунд.", reward = 45 },

	-- Космическая станция
	{ id = "space_m", dream = "space", kind = "interact", need = 3, title = "Кислород", desc = "Восстановите три модуля подачи кислорода.", reward = 75, label = "Модуль кислорода" },
	{ id = "space_o1", dream = "space", kind = "collect", need = 4, title = "Модули данных", desc = "Соберите 4 модуля данных.", reward = 50, label = "Модуль данных" },
	{ id = "space_o2", dream = "space", kind = "talk", need = 1, title = "ИИ «Орфей»", desc = "Поговорите с ИИ станции.", reward = 40 },
	{ id = "space_o3", dream = "space", kind = "reach", need = 1, title = "Шлюз 4", desc = "Дойдите до четвёртого шлюза.", reward = 55 },

	-- Замок
	{ id = "castle_m", dream = "castle", kind = "interact", need = 2, title = "Снять проклятие", desc = "Активируйте печать и трон.", reward = 75, label = "Печать" },
	{ id = "castle_o1", dream = "castle", kind = "collect", need = 3, title = "Страницы гримуара", desc = "Соберите 3 страницы гримуара.", reward = 50, label = "Страница" },
	{ id = "castle_o2", dream = "castle", kind = "lights", need = 3, title = "Факелы", desc = "Зажгите три факела во дворе.", reward = 45, label = "Факел" },
	{ id = "castle_o3", dream = "castle", kind = "reach", need = 1, title = "Склеп", desc = "Найдите вход в склеп.", reward = 55 },
}

QuestDefinitions.List = {}
QuestDefinitions.ById = {}
QuestDefinitions.ByDream = {}

for _, entry in ipairs(raw) do
	local quest = {
		id = entry.id,
		dream = entry.dream,
		kind = entry.kind,
		need = entry.need or 1,
		title = entry.title,
		desc = entry.desc,
		reward = entry.reward or 40,
		label = entry.label,
	}
	table.insert(QuestDefinitions.List, quest)
	QuestDefinitions.ById[quest.id] = quest
	QuestDefinitions.ByDream[quest.dream] = QuestDefinitions.ByDream[quest.dream] or {}
	table.insert(QuestDefinitions.ByDream[quest.dream], quest)
end

function QuestDefinitions.get(id)
	return QuestDefinitions.ById[id]
end

-- Возвращает обязательный и необязательные квесты сна.
function QuestDefinitions.forDream(dreamId, dreamDef)
	local mandatory = nil
	local optional = {}
	for _, quest in ipairs(QuestDefinitions.ByDream[dreamId] or {}) do
		if dreamDef and quest.id == dreamDef.mandatory then
			mandatory = quest
		elseif quest.id ~= (dreamDef and dreamDef.mandatory) then
			table.insert(optional, quest)
		end
	end
	return mandatory, optional
end

function QuestDefinitions.kindLabel(kind)
	local labels = {
		collect = "Собрать",
		interact = "Активировать",
		talk = "Поговорить",
		reach = "Добраться",
		survive = "Продержаться",
		lights = "Включить",
	}
	return labels[kind] or "Задание"
end

return QuestDefinitions
]]></string>
