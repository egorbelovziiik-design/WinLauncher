	dream({
		id = "circus",
		title = "Проклятый цирк",
		subtitle = "Представление никогда не заканчивалось",
		icon = "🎪",
		map = "CursedCircus",
		desc = "Погасшие огни, красный бархат и запах жжёного сахара. Билеты всё ещё продают.",
		hint = "Освободите клетку — зверь укажет путь.",
		mandatory = "circus_m",
		optional = { "circus_o1", "circus_o2" },
		monsters = { "pierrot", "doll", "nightmare" },
		boss = "nightmare",
		monsterCount = 3,
		ambient = Color3.fromRGB(60, 30, 40),
		outdoorAmbient = Color3.fromRGB(34, 18, 26),
		fogColor = Color3.fromRGB(40, 22, 32),
		fogStart = 18,
		fogEnd = 180,
		brightness = 0.7,
		clockTime = 0.4,
		atmosphere = { density = 0.44, haze = 2.2, glare = 0.08, color = Color3.fromRGB(180, 110, 130), decay = Color3.fromRGB(90, 50, 60) },
		colorCorrection = { tint = Color3.fromRGB(255, 190, 200), saturation = 0.15, contrast = 0.25, brightness = -0.08 },
		bloom = { intensity = 0.9, size = 26, threshold = 1.0 },
