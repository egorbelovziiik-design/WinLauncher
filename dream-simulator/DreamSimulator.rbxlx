		description = "Крылья из тьмы за спиной. Немного ускоряют бег.",
		price = 1200,
		icon = "🦇",
		color = Color3.fromRGB(95, 70, 150),
		rarity = "Легендарный",
		stackable = false,
		category = "Эффект",
		slot = "wings",
		bonus = { speedBonus = 2 },
	},

	-- Расходники
	{
		id = "sanity_potion",
		name = "Эликсир разума",
		description = "Восстанавливает 45 рассудка. Q — использовать во сне.",
		price = 80,
