        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Config: единые настройки игры (сервер и клиент).

local Config = {}

Config.GAME_NAME = "🌙 DREAM SIMULATOR: NIGHTMARE WORLDS"
Config.VERSION = "2.0.0"

-- Основные тайминги (клиент тоже использует эти имена)
Config.DreamDuration = 600
Config.SleepDuration = 9.5
Config.WakeDuration = 6.0
Config.SaveInterval = 120
Config.ProfileVersion = 3

-- Персонаж
Config.BaseWalkSpeed = 16
Config.SprintSpeed = 26
Config.JumpPower = 50
Config.MaxHealth = 100
Config.MaxSanity = 100
Config.MaxStamina = 100
Config.InteractRange = 13
Config.SprintDrain = 16
Config.StaminaRegen = 11

-- Экономика / сохранение
Config.DataStoreName = "DreamSimulator_v1"
Config.DataStoreKey = "player_"
Config.SavedCoins = 0

-- Сложности (ключи используются в именах карточек: EasyCard, NormalCard, ...)
Config.Difficulties = {
	Easy = {
		key = "Easy",
		icon = "🌿",
		name = "Лёгкий",
		description = "Спокойный сон: монстры медлительны, разум крепок.",
		reward = 100,
		time = 600,
		monsterCount = 2,
		monsterSpeed = 0.78,
		monsterDamage = 0.6,
		sanityDrain = 0.6,
		eventInterval = 46,
		color = Color3.fromRGB(130, 225, 165),
	},
	Normal = {
		key = "Normal",
		icon = "🌙",
		name = "Обычный",
		description = "Стандартный кошмар. Держись подальше от тени.",
		reward = 250,
		time = 600,
		monsterCount = 3,
		monsterSpeed = 1.0,
		monsterDamage = 1.0,
		sanityDrain = 1.0,
		eventInterval = 32,
		color = Color3.fromRGB(150, 165, 255),
	},
	Hard = {
		key = "Hard",
		icon = "🔥",
		name = "Сложный",
		description = "Сон не отпускает: монстры быстрее, разум слабеет.",
		reward = 500,
		time = 600,
		monsterCount = 4,
		monsterSpeed = 1.18,
		monsterDamage = 1.35,
		sanityDrain = 1.35,
		eventInterval = 24,
		color = Color3.fromRGB(255, 175, 95),
	},
	Extreme = {
		key = "Extreme",
		icon = "💀",
		name = "Экстрим",
		description = "Кошмар без пощады. Один удар — и ты не проснёшься.",
		reward = 1000,
		time = 600,
		monsterCount = 5,
		monsterSpeed = 1.34,
		monsterDamage = 1.9,
		sanityDrain = 1.7,
		eventInterval = 17,
		color = Color3.fromRGB(255, 85, 105),
	},
}

Config.DifficultyOrder = { "Easy", "Normal", "Hard", "Extreme" }

Config.Settings = {
	musicVolume = 0.55,
	sfxVolume = 0.8,
	quality = "Высокое",
	sensitivity = 0.5,
	scareIntensity = 1,
	hints = true,
	cameraShake = true,
}

Config.QualityLevels = { "Низкое", "Средний", "Высокое" }

Config.Sanity = {
	DrainDark = 0.9,
	DrainMonster = 4.2,
	RegenLight = 0.55,
	Low = 55,
	Critical = 25,
}

Config.Sounds = {
	MenuMusic = "rbxassetid://1847861148",
	DreamAmbient = "rbxassetid://9046893493",
	Heartbeat = "rbxassetid://1837761438",
	Whisper = "rbxassetid://5665737137",
	Scare = "rbxassetid://5153734608",
	BigScare = "rbxassetid://5801257793",
	MonsterGrowl = "rbxassetid://5801257793",
	Click = "rbxassetid://6073536806",
	Purchase = "rbxassetid://6023527123",
	Win = "rbxassetid://5654042073",
	Lose = "rbxassetid://5153642694",
	DoorCreak = "rbxassetid://5674194248",
	Pickup = "rbxassetid://5674227256",
	Portal = "rbxassetid://1837736541",
}

-- Запасные звуки из встроенной библиотеки Roblox (rbxasset://).
-- Многие rbxassetid из чужих мест недоступны из-за прав на аудио —
-- без этого запаса музыка и часть эффектов молчали бы.
Config.SoundFallbacks = {
	MenuMusic = "rbxasset://sounds/bass.wav",
	DreamAmbient = "rbxasset://sounds/uuhhh.mp3",
	Heartbeat = "rbxasset://sounds/electronicpingshort.wav",
	Whisper = "rbxasset://sounds/uuhhh.mp3",
	Scare = "rbxasset://sounds/impact_explosion_03.mp3",
	BigScare = "rbxasset://sounds/impact_explosion_03.mp3",
	MonsterGrowl = "rbxasset://sounds/uuhhh.mp3",
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	Win = "rbxasset://sounds/swoosh.mp3",
	Lose = "rbxasset://sounds/uuhhh.mp3",
	DoorCreak = "rbxasset://sounds/snap.mp3",
	Pickup = "rbxasset://sounds/electronicpingshort.wav",
	Portal = "rbxasset://sounds/swoosh.mp3",
}

-- Насколько ниже/выше играет запасной звук, чтобы эффекты отличались.
Config.SoundPitch = {
	MenuMusic = 0.55,
	DreamAmbient = 0.7,
	Heartbeat = 0.45,
	Whisper = 1.35,
	Scare = 1.0,
	BigScare = 0.8,
	MonsterGrowl = 0.6,
	Click = 1.0,
	Purchase = 1.5,
	Win = 1.25,
	Lose = 0.55,
	DoorCreak = 0.7,
	Pickup = 1.3,
	Portal = 0.9,
}

Config.Colors = {
	bg = Color3.fromRGB(10, 10, 18),
	panel = Color3.fromRGB(20, 18, 34),
	accent = Color3.fromRGB(150, 120, 255),
	accent2 = Color3.fromRGB(90, 200, 230),
	good = Color3.fromRGB(120, 230, 160),
	bad = Color3.fromRGB(255, 95, 115),
	warn = Color3.fromRGB(255, 195, 95),
	text = Color3.fromRGB(238, 236, 250),
	dim = Color3.fromRGB(150, 148, 172),
	gold = Color3.fromRGB(255, 205, 100),
}

function Config.getDifficulty(key)
	return Config.Difficulties[key] or Config.Difficulties.Normal
end

function Config.validDifficulty(key)
	return type(key) == "string" and Config.Difficulties[key] ~= nil
end

function Config.defaultSettings()
	local copy = {}
	for key, value in pairs(Config.Settings) do
		copy[key] = value
	end
	return copy
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="250">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Util: общие вспомогательные функции (работают и на сервере, и на клиенте).

local Util = {}

function Util.clamp(value, minValue, maxValue)
	if value ~= value then
		return minValue
	end
	if value < minValue then
		return minValue
	elseif value > maxValue then
		return maxValue
	end
	return value
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

function Util.round(value, decimals)
	local mult = 10 ^ (decimals or 0)
	return math.floor(value * mult + 0.5) / mult
end

function Util.deepCopy(source)
	if type(source) ~= "table" then
		return source
	end
	local copy = {}
	for key, value in pairs(source) do
		copy[key] = Util.deepCopy(value)
	end
	return copy
end

function Util.copy(source)
	local copy = {}
	for key, value in pairs(source) do
		copy[key] = value
	end
	return copy
end

function Util.shuffle(list, rng)
	local random = rng or Random.new()
	for i = #list, 2, -1 do
		local j = random:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Util.pick(list, rng)
	if #list == 0 then
		return nil
	end
	if rng then
		return list[rng:NextInteger(1, #list)]
	end
	return list[math.random(1, #list)]
end

function Util.pickMany(list, count, rng)
	local pool = Util.copy(list)
	Util.shuffle(pool, rng)
	local out = {}
	for i = 1, math.min(count, #pool) do
		out[i] = pool[i]
	end
	return out
end

function Util.weightedPick(entries, rng)
	local total = 0
	for _, entry in ipairs(entries) do
		total = total + (entry.weight or 1)
	end
	if total <= 0 then
		return nil
	end
	local roll = rng and rng:NextNumber() * total or math.random() * total
	local acc = 0
	for _, entry in ipairs(entries) do
		acc = acc + (entry.weight or 1)
		if roll <= acc then
			return entry
		end
	end
	return entries[#entries]
end

function Util.formatTime(seconds)
	local s = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(s / 60), s % 60)
end

function Util.formatLongTime(seconds)
	local s = math.max(0, math.floor(seconds))
	local hours = math.floor(s / 3600)
	local minutes = math.floor((s % 3600) / 60)
	if hours > 0 then
		return string.format("%d ч %02d мин", hours, minutes)
	end
	return string.format("%d мин", minutes)
end

function Util.count(tbl)
	local total = 0
	for _ in pairs(tbl or {}) do
		total = total + 1
	end
	return total
end

function Util.find(list, predicate)
	for index, value in ipairs(list) do
		if predicate(value, index) then
			return value, index
		end
	end
	return nil, nil
end

function Util.contains(list, value)
	for _, entry in ipairs(list) do
		if entry == value then
			return true
		end
	end
	return false
end

function Util.distance2D(a, b)
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

function Util.isFiniteNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Util.sanitizeNumber(value, fallback, minValue, maxValue)
	if not Util.isFiniteNumber(value) then
		value = fallback
	end
	if minValue and value < minValue then
		value = minValue
	end
	if maxValue and value > maxValue then
		value = maxValue
	end
	return value
end

function Util.newRigPart(name, size, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = false
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Massless = true
	return part
end

function Util.weld(parentPart, childPart, offset)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parentPart
	weld.Part1 = childPart
	weld.Parent = childPart
	if offset then
		childPart.CFrame = parentPart.CFrame * offset
	end
	return weld
end

function Util.tween(instance, info, goals)
	local TweenService = game:GetService("TweenService")
	local tween = TweenService:Create(instance, info, goals)
	tween:Play()
	return tween
end

function Util.fadeIn(guiObject, duration, targetTransparency)
	if not guiObject then
		return
	end
	guiObject.Visible = true
	local TweenService = game:GetService("TweenService")
	TweenService:Create(guiObject, TweenInfo.new(duration or 0.4), {
		BackgroundTransparency = targetTransparency or 0,
	}):Play()
end

function Util.getPlayerFromCharacter(character)
	local Players = game:GetService("Players")
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character == character then
			return player
		end
	end
	return nil
end

function Util.taggedParts(tagName)
	local CollectionService = game:GetService("CollectionService")
	return CollectionService:GetTagged(tagName)
end

function Util.shallowEqual(a, b)
	if type(a) ~= "table" or type(b) ~= "table" then
		return a == b
	end
	for key, value in pairs(a) do
		if b[key] ~= value then
			return false
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false
		end
	end
	return true
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="251">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Remotes: доступ к каналам связи. Инстансы лежат в ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
if not folder then
	error("[Remotes] папка ReplicatedStorage.Remotes не найдена")
end

Remotes.folder = folder

-- Полный список каналов (используется сборкой места).
Remotes.EVENTS = {
	-- клиент -> сервер
	"RequestDream",
	"ReturnToMenu",
	"BuyItem",
	"EquipItem",
	"UnequipItem",
	"UseItem",
	"UpdateSettings",
	"ResetSettings",
	"Interact",
	"DialogChoice",
	"CloseDialog",
	"PlayerReady",
	"SetSprinting",
	"SetFlashlight",
	"LookUpdate",
	"ReportDeath",
	-- сервер -> клиент
	"ProfileUpdated",
	"TimerUpdate",
	"VitalsUpdate",
	"QuestUpdate",
	"QuestCompleted",
	"DialogOpen",
	"DialogClosed",
	"Toast",
	"Scare",
	"DreamStarted",
	"DreamEnded",
	"SleepSequence",
	"DreamStateChanged",
	"PortalOpened",
	"MonsterAlert",
	"Hint",
	"AchievementUnlocked",
	"EventStarted",
	"PurchaseResult",
	"EquipResult",
	"PromptUpdate",
	"InteractionResult",
}

Remotes.FUNCTIONS = { "RequestProfile" }

local cache = {}

function Remotes.get(name)
	if cache[name] then
		return cache[name]
	end
	local instance = folder:WaitForChild(name, 20)
	if not instance then
		warn("[Remotes] канал не найден: " .. tostring(name))
		return nil
	end
	cache[name] = instance
	return instance
end

function Remotes.getFolder()
	return folder
end

-- Удобные обёртки.
function Remotes.fire(name, ...)
	local remote = Remotes.get(name)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireServer(...)
	end
end

function Remotes.toClient(player, name, ...)
	local remote = Remotes.get(name)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	end
end

function Remotes.toAll(name, ...)
	local remote = Remotes.get(name)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireAllClients(...)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="252">
