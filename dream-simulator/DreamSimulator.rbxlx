          <string name="Name">DreamDefinitions</string>
          <string name="Source"><![CDATA[--!nonstrict
-- DreamDefinitions: 10 снов — карта, освещение, монстры, NPC, квесты, подсказки.

local DreamDefinitions = {}

local function dream(data)
	return data
end

DreamDefinitions.List = {
	dream({
		id = "forest",
