}

-- Погода каждого сна (для клиентских эффектов).
local WEATHER = {
	forest = "Rain",
	school = "Storm",
	city = "Rain",
	hospital = "Rain",
	circus = "None",
	flood = "Rain",
	ice = "Snow",
	factory = "None",
	space = "None",
	castle = "None",
}

for _, entry in ipairs(DreamDefinitions.List) do
	entry.name = entry.title
	entry.weather = entry.weather or WEATHER[entry.id] or "None"
end

DreamDefinitions.ById = {}
for _, entry in ipairs(DreamDefinitions.List) do
	DreamDefinitions.ById[entry.id] = entry
end

DreamDefinitions.Order = {}
for _, entry in ipairs(DreamDefinitions.List) do
	table.insert(DreamDefinitions.Order, entry.id)
end

function DreamDefinitions.get(id)
	return DreamDefinitions.ById[id] or DreamDefinitions.List[1]
end

function DreamDefinitions.random(exclude, rng)
	local pool = {}
	for _, entry in ipairs(DreamDefinitions.List) do
		if not exclude or entry.id ~= exclude then
			table.insert(pool, entry.id)
		end
	end
	if #pool == 0 then
		return DreamDefinitions.List[1].id
	end
	if rng then
		return pool[rng:NextInteger(1, #pool)]
	end
	return pool[math.random(1, #pool)]
end

return DreamDefinitions
