<UserControl x:Class="DrBrowser.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,10">
            <TextBlock Text="История" Style="{StaticResource H1}" />
            <TextBlock Text="Записи хранятся в SQLite (%AppData%\DrBrowser\drbrowser.db)"
                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,4,32,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource InputBox}"
                     KeyDown="Search_KeyDown" ToolTip="Поиск по адресу и заголовку" />
            <ComboBox x:Name="RangeBox" Grid.Column="1" Width="150" Margin="8,0,0,0" SelectionChanged="Range_Changed" />
            <Button Grid.Column="2" Content="Найти" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Search_Click" />
            <Button Grid.Column="3" Content="Очистить историю" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                    Command="{Binding ClearHistoryCommand}" />
        </Grid>

        <Grid Grid.Row="2" Margin="32,0,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ЗАПИСИ" Style="{StaticResource SectionTitle}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding History.Entries}" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Display}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource Muted}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding VisitedText}" Style="{StaticResource Muted}"
                                               FontSize="10.5" VerticalAlignment="Center" Margin="8,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Открыть" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11"
                                                Command="{Binding DataContext.OpenHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="✕" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                                Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ЧАСТО ПОСЕЩАЕМЫЕ" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding History.MostVisited}" MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Host}" FontSize="12" />
                                        <TextBlock Text="{Binding VisitsText}" Style="{StaticResource Muted}" FontSize="10" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="→" Style="{StaticResource IconButton}" Width="24" Height="24"
                                            Command="{Binding DataContext.OpenHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
