<UserControl x:Class="DrBrowser.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- hero -->
        <Border Grid.Row="0" Padding="0,34,0,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#227C5CFF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.65" />
                    <GradientStop Color="#1538BDF8" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel MaxWidth="820" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="◎" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DrSearch" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Собственный SQLite FTS5 / BM25 индекс + явно отмеченный внешний поиск" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border Margin="0,20,0,0" Height="50" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕" FontSize="20" Margin="16,0,4,0"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="QueryBox" Style="{StaticResource AddressBox}" FontSize="14.5"
                                     Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="QueryBox_KeyDown" VerticalAlignment="Center" />
                            <TextBlock Text="Введите запрос — DrSearch ищет локально, без трекеров" FontSize="13.5"
                                       Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Search.HasQuery, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                        <Button Grid.Column="2" Content="Искать" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,7,0" VerticalAlignment="Center" Click="Search_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Search.PrivacyText}" Style="{StaticResource Muted}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />

                <ItemsControl ItemsSource="{Binding Search.Recents}" HorizontalAlignment="Center" Margin="0,12,0,0"
                              Visibility="{Binding Search.HasRecents, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" FontSize="10.5" Padding="9,4" Margin="0,0,6,6"
                                    Content="{Binding}" ToolTip="Повторить запрос"
                                    Command="{Binding DataContext.Search.UseRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Найти в интернете:" Style="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Google" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,6,0"
                            Command="{Binding Search.SearchWebCommand}" CommandParameter="Google" />
                    <Button Content="Яндекс" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,6,0"
                            Command="{Binding Search.SearchWebCommand}" CommandParameter="Яндекс" />
                    <Button Content="Bing" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,6,0"
                            Command="{Binding Search.SearchWebCommand}" CommandParameter="Bing" />
                    <Button Content="DuckDuckGo" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,6,0"
                            Command="{Binding Search.SearchWebCommand}" CommandParameter="DuckDuckGo" />
                    <CheckBox Content="Только локально" Style="{StaticResource Switch}" FontSize="11"
                              IsChecked="{Binding Search.LocalOnly, Mode=TwoWay}" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- results -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="30,0,20,24">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Search.Summary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Search.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,11" Cursor="Hand"
                                        MouseLeftButtonUp="Result_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                                Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- web results -->
                    <Grid Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ВЕБ-РЕЗУЛЬТАТЫ" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Content="{Binding Search.WebButtonText}" Style="{StaticResource GhostButton}"
                                FontSize="10.5" Padding="9,4" Command="{Binding Search.SearchWebNowCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding Search.WebNote}" Style="{StaticResource Muted}" FontSize="10.5"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Text="Веб-поиск выключен в настройках: DrSearch работает только с вашими данными."
                               Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding Search.WebSearchEnabled, Converter={StaticResource InverseBoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Search.WebResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,11" Cursor="Hand"
                                        MouseLeftButtonUp="WebResult_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Host}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Snippet}" Style="{StaticResource Muted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Как работает DrSearch" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="DrSearch сначала выполняет BM25-поиск в собственном локальном индексе SQLite FTS5, затем ищет в истории и закладках. Индекс наполняется ограниченным пользовательским краулером: только явно выбранные публичные сайты, robots.txt, noindex, canonical URL, задержка запросов и удаление дублей соблюдаются. Внешняя выдача всегда подписана отдельно и полностью отключается локальным режимом." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- side panel -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" Padding="18,18,18,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="ПОИСКОВЫЕ ДВИЖКИ" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"
                               Text="Движок по умолчанию выбирается в настройках. DrSearch стоит первым, пока вы не выберете другой." />

                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="СОБСТВЕННЫЙ ИНДЕКС" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Search.IndexStatsText}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Search.IndexUpdatedText}" Style="{StaticResource Muted}" FontSize="9.5" Margin="0,2,0,7" />
                            <TextBox Style="{StaticResource InputBox}" Height="28" FontSize="10.5"
                                     Text="{Binding Search.CrawlUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="{Binding Search.CrawlButtonText}" Style="{StaticResource PrimaryButton}"
                                    FontSize="10" Padding="8,5" Margin="0,6,0,0"
                                    Command="{Binding Search.StartCrawlCommand}" IsEnabled="{Binding Search.CanStartCrawl}" />
                            <Button Content="Остановить" Style="{StaticResource GhostButton}" FontSize="9.5" Padding="7,3"
                                    Margin="0,5,0,0" Command="{Binding Search.CancelCrawlCommand}"
                                    IsEnabled="{Binding Search.CanCancelCrawl}" />
                            <TextBlock Text="{Binding Search.CrawlerLimitsText}" Style="{StaticResource Muted}" FontSize="9" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Search.CrawlStatus}" Style="{StaticResource Muted}" FontSize="9"
                                       TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="58" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ПО УМОЛЧАНИЮ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Settings.SearchEngine}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <Button Content="Настройки поиска" Style="{StaticResource GhostButton}" FontSize="11"
                                    Margin="0,10,0,0" Command="{Binding OpenSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ВЕБ-ПОИСК" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Запросы уходят в открытый индекс, история запросов остаётся локально." />
                            <CheckBox Content="Искать в интернете" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Search.WebSearchEnabled, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ЗАЩИТА" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Security.BlockedText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,6" />
                            <Button Content="🛡 DrGuard" Style="{StaticResource GhostButton}" FontSize="11"
                                    Command="{Binding OpenGuardCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="МУЗЫКА" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Music.LibrarySummary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,8" />
                    <Button Content="🎵 Открыть плеер" Style="{StaticResource GhostButton}" FontSize="11.5"
                            Command="{Binding OpenMusicCommand}" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
