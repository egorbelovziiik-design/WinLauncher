<UserControl x:Class="DrBrowser.AiPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="34" Height="34">
                    <Border CornerRadius="11" ClipToBounds="True">
                        <Image Source="/Assets/dr-ai-avatar.png" Stretch="UniformToFill" />
                    </Border>
                    <Border CornerRadius="11" BorderThickness="1" BorderBrush="#55FFFFFF" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DrAI Assistant" FontSize="13" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AiEngineText}" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding AiKeyStatus}" Style="{StaticResource Muted}" FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="⌫" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                            ToolTip="Очистить чат" Command="{Binding ClearAiCommand}" />
                    <Button Content="✕" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11"
                            ToolTip="Закрыть панель" Command="{Binding CloseAiCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
                <TextBlock Text="Режим DrAI" Style="{StaticResource SectionTitle}" Margin="2,4,0,8" />
                <ItemsControl ItemsSource="{Binding Personas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" FontSize="9.5" Padding="4,6" Margin="0,0,4,0"
                                    ToolTip="{Binding Hint}" Click="Persona_Click" Tag="{Binding Id}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding AiPersonaHint}" Style="{StaticResource Muted}" FontSize="9.5"
                           TextWrapping="Wrap" Margin="2,6,0,8" />

                <CheckBox Content="Учитывать текст страницы" Style="{StaticResource Switch}" FontSize="11"
                          IsChecked="{Binding AiIncludePage, Mode=TwoWay}" Margin="2,0,0,4" />
                <TextBlock Text="{Binding AiContextLabel}" Style="{StaticResource Muted}" FontSize="9" Margin="2,0,0,8"
                           TextWrapping="Wrap" />

                <Border Style="{StaticResource Card}" Padding="10,8" Margin="2,0,2,10">
                    <StackPanel>
                        <TextBlock Text="DrAI Local · без ключа и без сети" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AiLocalHint}" Style="{StaticResource Muted}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                        <WrapPanel Margin="0,7,0,0">
                            <Button Content="Ключевые слова" Style="{StaticResource GhostButton}" FontSize="9.5"
                                    Padding="7,3" Margin="0,0,5,5" Command="{Binding RunLocalActionCommand}"
                                    CommandParameter="keywords" />
                            <Button Content="Статистика" Style="{StaticResource GhostButton}" FontSize="9.5"
                                    Padding="7,3" Margin="0,0,5,5" Command="{Binding RunLocalActionCommand}"
                                    CommandParameter="stats" />
                            <Button Content="Чистка текста" Style="{StaticResource GhostButton}" FontSize="9.5"
                                    Padding="7,3" Margin="0,0,5,5" Command="{Binding RunLocalActionCommand}"
                                    CommandParameter="polish" />
                            <Button Content="Разбор кода" Style="{StaticResource GhostButton}" FontSize="9.5"
                                    Padding="7,3" Margin="0,0,5,5" Command="{Binding RunLocalActionCommand}"
                                    CommandParameter="explain-code" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Быстрые действия" Style="{StaticResource SectionTitle}" Margin="2,4,0,8" />
                <WrapPanel>
                    <Button Content="📄 Содержание страницы" Style="{StaticResource GhostButton}" Margin="0,0,6,6" FontSize="11"
                            Command="{Binding AiActionCommand}" CommandParameter="summarize" />
                    <Button Content="🌐 Перевести выделенное" Style="{StaticResource GhostButton}" Margin="0,0,6,6" FontSize="11"
                            Command="{Binding AiActionCommand}" CommandParameter="translate" />
                    <Button Content="💡 Объяснить фрагмент" Style="{StaticResource GhostButton}" Margin="0,0,6,6" FontSize="11"
                            Command="{Binding AiActionCommand}" CommandParameter="explain-selection" />
                    <Button Content="🧩 Объяснить код" Style="{StaticResource GhostButton}" Margin="0,0,6,6" FontSize="11"
                            Command="{Binding AiActionCommand}" CommandParameter="explain-code" />
                    <Button Content="✍️ Помочь с текстом" Style="{StaticResource GhostButton}" Margin="0,0,6,6" FontSize="11"
                            Command="{Binding AiActionCommand}" CommandParameter="write" />
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding AiMessages}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="10" MaxWidth="330" HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceAltBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding AttachmentLabel}" Style="{StaticResource Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="9"
                                                   VerticalAlignment="Center" />
                                        <Button Content="⧉ копировать" Style="{StaticResource GhostButton}" FontSize="8.5"
                                                Padding="5,1" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.CopyAiMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding AiStatus}" Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="📷 Фото" Style="{StaticResource GhostButton}" Command="{Binding AttachAiImageCommand}" />
                    <Button Content="🎬 Видео по ссылке" Style="{StaticResource GhostButton}"
                            Command="{Binding ExplainVideoLinkCommand}"
                            ToolTip="Вставьте ссылку YouTube / RUTUBE / Vimeo / Dailymotion — DrAI прочитает название, канал и описание" />
                    <Button Content="Убрать" Style="{StaticResource GhostButton}" Command="{Binding RemoveAiImageCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding AiAttachmentText}" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,3" />
                <TextBlock Text="{Binding AiLinkContext}" Style="{StaticResource Muted}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,0,0,5" />
                <TextBox x:Name="InputBox" Style="{StaticResource InputBox}" Height="70" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="{Binding AiInput, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Input_KeyDown" />
                <Button Content="{Binding AiSendText}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                        Command="{Binding SendAiCommand}" IsEnabled="{Binding IsAiBusy, Converter={StaticResource InverseBool}}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="9.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Enter — отправить, Shift+Enter — новая строка. Ключ хранится локально через DPAPI." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
