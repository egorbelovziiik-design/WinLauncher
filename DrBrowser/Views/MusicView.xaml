<UserControl x:Class="DrBrowser.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Padding="24,20,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="86" Height="86" CornerRadius="18" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/music-cover.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="DrMusic" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding Music.LibrarySummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Music.FolderText}" Style="{StaticResource Muted}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Music.Service.Status}" FontSize="10.5"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁 Выбрать папку" Style="{StaticResource PrimaryButton}" FontSize="12"
                            Command="{Binding Music.ChooseFolderCommand}" />
                    <Button Content="↻" Style="{StaticResource IconButton}" FontSize="15" ToolTip="Обновить библиотеку"
                            Command="{Binding Music.RefreshCommand}" />
                    <Button Content="📂" Style="{StaticResource IconButton}" FontSize="14" ToolTip="Открыть папку"
                            Command="{Binding Music.OpenFolderCommand}" IsEnabled="{Binding Music.HasFolder}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- online catalog search -->
        <Border Grid.Row="1" Margin="24,0,24,12" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <Grid Margin="2,0,2,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="ONLINE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="Поиск музыки в каталогах" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Music.CatalogSourceText}" Style="{StaticResource Muted}" FontSize="10.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Music.CatalogSources}" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,3"
                                        Margin="6,0,0,0" Tag="{Binding}" Click="CatalogSource_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Height="32"
                             Text="{Binding Music.CatalogQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Название трека или исполнитель" KeyDown="CatalogQuery_KeyDown" />
                    <Button Grid.Column="1" Content="{Binding Music.CatalogSearchText}" Style="{StaticResource PrimaryButton}"
                            FontSize="11.5" Margin="8,0,0,0" Command="{Binding Music.SearchCatalogCommand}" />
                    <Button Grid.Column="2" Content="Яндекс Музыка ↗" Style="{StaticResource GhostButton}"
                            FontSize="11" Margin="8,0,0,0" Command="{Binding Music.OpenYandexMusicCommand}"
                            ToolTip="Открыть поиск в Яндекс Музыке в новой вкладке (её API закрыт)" />
                </Grid>

                <TextBlock Text="{Binding Music.CatalogStatus}" Style="{StaticResource Muted}" FontSize="10.5"
                           TextWrapping="Wrap" Margin="2,7,2,0" />
                <TextBlock Text="{Binding Music.CatalogHint}" Style="{StaticResource Muted}" FontSize="9.5"
                           TextWrapping="Wrap" Margin="2,3,2,0" Opacity="0.75" />

                <ItemsControl ItemsSource="{Binding Music.CatalogResults}" Margin="0,8,0,0" MaxHeight="200">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="266" Margin="0,0,8,8" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="9.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="4,1">
                                                <TextBlock Text="{Binding Badge}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Muted}"
                                                       FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="▶" Style="{StaticResource IconButton}" FontSize="12"
                                                ToolTip="{Binding Hint}"
                                                Command="{Binding DataContext.Music.PlayCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="↗" Style="{StaticResource IconButton}" FontSize="11"
                                                ToolTip="Открыть трек на сайте каталога"
                                                Command="{Binding DataContext.Music.OpenCatalogPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- live radio -->
        <Border Grid.Row="2" Margin="24,0,24,12" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <Grid Margin="2,0,2,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#33EF4444" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#FCA5A5" />
                        </Border>
                        <TextBlock Text="Прямой эфир DrMusic" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Music.RadioSummary}" Style="{StaticResource Muted}" FontSize="10.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="↻ Обновить" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                            FontSize="10" Padding="9,4" Command="{Binding Music.RefreshCommand}" ToolTip="Перечитать папку и станции" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Music.Stations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" Width="172" Height="52" Margin="0,0,8,8" Padding="10,7"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.Music.PlayStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="9.5" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#33EF4444" CornerRadius="4" Padding="4,1"
                                            VerticalAlignment="Top" Margin="6,0,0,0">
                                        <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="#FCA5A5" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- body -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- categories -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ПЛЕЙЛИСТЫ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Music.PlaylistsSummary}" FontSize="9.5" MaxWidth="86"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                   ToolTip="Плейлисты, их состав и порядок треков хранятся в SQLite"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBox Style="{StaticResource InputBox}" Height="28" FontSize="11.5" Margin="0,0,0,6"
                             Text="{Binding Music.NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Имя нового плейлиста" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="+ Создать" Style="{StaticResource PrimaryButton}" FontSize="10.5" Padding="9,4"
                                Margin="0,0,5,5" Command="{Binding Music.CreatePlaylistCommand}" />
                        <Button Content="✎" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="8,4"
                                Margin="0,0,5,5" ToolTip="Переименовать выбранный плейлист в имя из поля выше"
                                Command="{Binding Music.RenamePlaylistCommand}" />
                        <Button Content="🗑" Style="{StaticResource GhostButton}" FontSize="10.5" Padding="8,4"
                                Margin="0,0,5,5" ToolTip="Удалить выбранный плейлист"
                                Command="{Binding Music.DeletePlaylistCommand}" IsEnabled="{Binding Music.HasSelectedPlaylist}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Music.Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,5" FontSize="11.5" Padding="9,6" ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.Music.SelectPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding CountText}" FontSize="9.5" Opacity="0.65" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" FontSize="9.5" TextWrapping="Wrap" Margin="2,2,0,0"
                               Text="Плейлисты хранятся в SQLite: имя, состав и порядок треков сохраняются после перезапуска." />

                    <Border Height="1" Margin="0,12,0,10" Background="{DynamicResource BorderBrush}" />

                    <TextBlock Text="КАТЕГОРИИ" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Music.Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,6" FontSize="12" Padding="10,7"
                                        Content="{Binding Label}"
                                        Command="{Binding DataContext.Music.PlayCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="2,10,0,0"
                               Text="Категория — это подпапка внутри выбранной папки. Нажмите на неё, чтобы слушать всё подряд." />

                    <Border Height="1" Margin="0,12,0,10" Background="{DynamicResource BorderBrush}" />

                    <Grid Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ИЗБРАННОЕ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="★" Style="{StaticResource GhostButton}" Padding="7,2" FontSize="11"
                                ToolTip="Добавить или убрать текущий трек из избранного"
                                Command="{Binding Music.FavoriteCurrentCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Music.FavoritesSummary}" Style="{StaticResource Muted}" FontSize="10"
                               TextWrapping="Wrap" Margin="2,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Music.Favorites}" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,5" FontSize="11.5" Padding="9,6"
                                        ToolTip="{Binding FilePath}"
                                        Tag="{Binding DataContext.Music, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding DataContext.Music.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Убрать из избранного"
                                                      Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Добавить в выбранный плейлист"
                                                      Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="9.5" Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource BorderBrush}" />

                    <Grid Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="НЕДАВНО СЛУШАЛИ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="↺" Style="{StaticResource GhostButton}" Padding="7,2" FontSize="11"
                                ToolTip="Продолжить последний трек" Command="{Binding Music.ResumeLastCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Music.Recent}" MaxHeight="170">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,5" FontSize="11.5" Padding="9,6"
                                        Command="{Binding DataContext.Music.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="9.5" Opacity="0.65"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Очистить историю" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,4"
                            Margin="2,4,0,0" HorizontalAlignment="Left" Command="{Binding Music.ClearRecentCommand}" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- track list -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="ТРЕКИ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Music.VisibleCount, StringFormat=({0})}" Style="{StaticResource Muted}"
                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Music.SelectedCategory, StringFormat=· {0}}" Style="{StaticResource Muted}"
                                       FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <TextBox Style="{StaticResource Input}" FontSize="12"
                                     Text="{Binding Music.Filter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Поиск по названию, исполнителю или категории" />
                            <TextBlock Text="Поиск по названию или исполнителю" FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Music.HasFilter, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6"
                            Margin="0,0,0,6"
                            Visibility="{Binding Music.Service.HasLocalTracks, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"
                                   Text="Локальных файлов нет — в списке пока только радио. Нажмите «Выбрать папку», чтобы добавить свои треки: браузер читает только аудиофайлы и ничего не отправляет в сеть." />
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Music.Visible}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="9" Padding="9,7" Margin="0,0,0,2"
                                            Cursor="Hand" MouseLeftButtonUp="Track_Click"
                                            Tag="{Binding DataContext.Music, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Добавить в выбранный плейлист"
                                                          Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Добавить в / убрать из избранного"
                                                          Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Muted}"
                                                       FontSize="10.5" Margin="10,0" VerticalAlignment="Center" />
                                            <Border Grid.Column="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                                                    Padding="5,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- selected playlist -->
                    <Border Grid.Row="3" Margin="0,10,0,0" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="8" Padding="10" Visibility="{Binding Music.HasSelectedPlaylist, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Music.SelectedPlaylistTitle}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Music.SelectedPlaylistHint}" Style="{StaticResource Muted}"
                                               FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="＋ Текущий" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,4"
                                            ToolTip="Добавить играющий сейчас трек в этот плейлист"
                                            Command="{Binding Music.AddCurrentToPlaylistCommand}" />
                                    <Button Content="▶ Играть" Style="{StaticResource PrimaryButton}" FontSize="10" Padding="9,4"
                                            Margin="6,0,0,0" IsEnabled="{Binding Music.CanPlaySelectedPlaylist}"
                                            Command="{Binding Music.PlayPlaylistCommand}" />
                                    <Button Content="⇪ m3u" Style="{StaticResource GhostButton}" FontSize="9.5" Padding="7,4"
                                            Margin="6,0,0,0" ToolTip="Сохранить плейлист в файл .m3u8 (VLC, foobar2000, AIMP)"
                                            Command="{Binding Music.ExportPlaylistCommand}" />
                                    <Button Content="⇩ m3u" Style="{StaticResource GhostButton}" FontSize="9.5" Padding="7,4"
                                            Margin="6,0,0,0" ToolTip="Импортировать .m3u / .m3u8 в этот плейлист"
                                            Command="{Binding Music.ImportPlaylistCommand}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Music.SelectedPlaylist.Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Cursor="SizeNS" Background="Transparent"
                                                        ToolTip="Перетащите, чтобы изменить порядок"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="PlaylistDrag_MouseDown"
                                                        PreviewMouseMove="PlaylistDrag_MouseMove"
                                                        DragOver="PlaylistDrag_DragOver"
                                                        Drop="PlaylistDrag_Drop">
                                                    <TextBlock Text="≡" FontSize="13" Opacity="0.55"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                        FontSize="11.5" Padding="8,5" ToolTip="{Binding FilePath}"
                                                        Command="{Binding DataContext.Music.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Opacity="0.65"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="↑" Style="{StaticResource GhostButton}" FontSize="10" Padding="7,4"
                                                            ToolTip="Выше"
                                                            Command="{Binding DataContext.Music.MovePlaylistTrackUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="↓" Style="{StaticResource GhostButton}" FontSize="10" Padding="7,4" Margin="4,0,0,0"
                                                            ToolTip="Ниже"
                                                            Command="{Binding DataContext.Music.MovePlaylistTrackDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="✕" Style="{StaticResource GhostButton}" FontSize="10" Padding="7,4" Margin="4,0,0,0"
                                                            ToolTip="Убрать из плейлиста"
                                                            Command="{Binding DataContext.Music.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- now playing -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Music.Service.CurrentTitle}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Music.NowPlayingBadge}" FontSize="8" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Music.Service.CurrentSubtitle}" Style="{StaticResource Muted}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,14,0" VerticalAlignment="Center">
                    <Button Content="⏮" Style="{StaticResource IconButton}" FontSize="14" ToolTip="Предыдущий"
                            Command="{Binding Music.PreviousCommand}" />
                    <Button Content="{Binding Music.PlayPauseGlyph}" Style="{StaticResource IconButton}" FontSize="16"
                            ToolTip="{Binding Music.PlayPauseText}" Command="{Binding Music.TogglePlayCommand}" />
                    <Button Content="⏭" Style="{StaticResource IconButton}" FontSize="14" ToolTip="Следующий"
                            Command="{Binding Music.NextCommand}" />
                    <Button Content="⏹" Style="{StaticResource IconButton}" FontSize="12" ToolTip="Стоп"
                            Command="{Binding Music.StopCommand}" />
                    <Button Content="★" Style="{StaticResource IconButton}" FontSize="13"
                            ToolTip="Добавить / убрать из избранного"
                            Command="{Binding Music.FavoriteCurrentCommand}" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Music.Service.PositionText}" Style="{StaticResource Muted}"
                               FontSize="10.5" VerticalAlignment="Center" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1"
                            Value="{Binding Music.Service.Progress, Mode=OneWay}"
                            ValueChanged="Seek_ValueChanged"
                            IsEnabled="{Binding Music.IsStreaming, Converter={StaticResource InverseBool}}"
                            ToolTip="Прямой эфир нельзя перемотать" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Music.Service.DurationText}" Style="{StaticResource Muted}"
                               FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <CheckBox Content="⇄" Style="{StaticResource Switch}" IsChecked="{Binding Music.Shuffle, Mode=TwoWay}"
                              ToolTip="Перемешать" Margin="0,0,8,0" />
                    <CheckBox Content="↻" Style="{StaticResource Switch}" IsChecked="{Binding Music.Repeat, Mode=TwoWay}"
                              ToolTip="Повтор трека" Margin="0,0,12,0" />
                    <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider Width="110" Minimum="0" Maximum="1" Value="{Binding Music.Volume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Music.Service.VolumeText}" Style="{StaticResource Muted}" FontSize="10.5"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
