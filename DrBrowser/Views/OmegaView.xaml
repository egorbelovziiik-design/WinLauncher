<UserControl x:Class="DrBrowser.OmegaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="30,24,30,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OMEGA HUB" Style="{StaticResource H1}" />
                <TextBlock Text="Рабочие пространства, заметки, задачи, инструменты и реальные показатели системы"
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="ЛОКАЛЬНО · SQLITE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="24,0,24,12"
                    SelectedIndex="{Binding Omega.SelectedSection, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Width" Value="175" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>

            <!-- Workspaces -->
            <TabItem Header="▦  Workspaces">
                <Grid Margin="22,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Omega.Workspaces}" SelectedItem="{Binding Omega.SelectedWorkspace}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="12" Height="12" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="10.5" />
                                            <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" FontSize="9" />
                                            <Button Content="Открыть" Style="{StaticResource GhostButton}" FontSize="10" Padding="8,3" Margin="0,7,0,0"
                                                    HorizontalAlignment="Left" Command="{Binding DataContext.Omega.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" MaxWidth="620" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="СНИМОК ВКЛАДОК" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Имя" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Omega.WorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Цвет HEX" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Omega.WorkspaceColor, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Сохранение записывает реальные открытые URL, заголовки и закрепление вкладок в SQLite. Переключение всегда требует подтверждения."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Новое" Style="{StaticResource GhostButton}" Command="{Binding Omega.NewWorkspaceCommand}" />
                                    <Button Content="Сохранить текущие вкладки" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding Omega.SaveWorkspaceCommand}" />
                                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding Omega.DeleteWorkspaceCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Notes -->
            <TabItem Header="▤  Notes">
                <Grid Margin="22,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Omega.Notes}" SelectedItem="{Binding Omega.SelectedNote}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="11" Margin="0,0,8,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" FontSize="10" MaxHeight="34" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" FontSize="9" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBox Style="{StaticResource InputBox}" FontSize="16" FontWeight="SemiBold" Height="38"
                                 Text="{Binding Omega.NoteTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,10,0,0" MinHeight="300" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Omega.NoteBody, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Новая" Style="{StaticResource GhostButton}" Command="{Binding Omega.NewNoteCommand}" />
                            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding Omega.SaveNoteCommand}" />
                            <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding Omega.DeleteNoteCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tasks -->
            <TabItem Header="✓  Tasks">
                <StackPanel Margin="22,0,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Text="{Binding Omega.TaskTitle, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Добавить задачу" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding Omega.AddTaskCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Omega.Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center"
                                                  Command="{Binding DataContext.Omega.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding DueText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.Omega.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- Tools -->
            <TabItem Header="⌘  Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="22,0,0,0" ItemWidth="360">
                        <Border Style="{StaticResource Card}" Width="350" MinHeight="180" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="КАЛЬКУЛЯТОР" Style="{StaticResource SectionTitle}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Omega.CalculatorInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Вычислить" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Command="{Binding Omega.CalculateCommand}"/>
                                <TextBlock Text="{Binding Omega.CalculatorResult}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Без eval: + − × ÷ % ^, скобки, sqrt/sin/cos/log." Style="{StaticResource Muted}" FontSize="9.5" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="350" MinHeight="180" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="КОНВЕРТЕР ЕДИНИЦ" Style="{StaticResource SectionTitle}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Omega.UnitValue, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding Omega.Units}" SelectedItem="{Binding Omega.UnitFrom}"/>
                                    <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Omega.Units}" SelectedItem="{Binding Omega.UnitTo}"/>
                                </Grid>
                                <Button Content="Конвертировать" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Command="{Binding Omega.ConvertUnitCommand}"/>
                                <TextBlock Text="{Binding Omega.UnitResult}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="350" MinHeight="220" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="JSON FORMATTER" Style="{StaticResource SectionTitle}"/>
                                <TextBox Style="{StaticResource InputBox}" Height="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Omega.JsonInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel Margin="0,7,0,0"><Button Content="Форматировать" Style="{StaticResource GhostButton}" Command="{Binding Omega.FormatJsonCommand}"/>
                                    <Button Content="Минифицировать" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding Omega.FormatJsonCommand}" CommandParameter="minify"/></WrapPanel>
                                <TextBox Style="{StaticResource InputBox}" Height="72" Margin="0,7,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Omega.JsonOutput, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="350" MinHeight="220" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="ГЕНЕРАТОР ПАРОЛЕЙ" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Omega.PasswordLength, StringFormat=Длина: {0}}" Style="{StaticResource Muted}"/>
                                <Slider Minimum="8" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Omega.PasswordLength}"/>
                                <TextBox Style="{StaticResource InputBox}" Margin="0,7,0,0" IsReadOnly="True" Text="{Binding Omega.GeneratedPassword, Mode=OneWay}"/>
                                <WrapPanel Margin="0,7,0,0"><Button Content="Создать" Style="{StaticResource PrimaryButton}" Command="{Binding Omega.GeneratePasswordCommand}"/>
                                    <Button Content="Копировать" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding Omega.CopyGeneratedPasswordCommand}"/></WrapPanel>
                                <TextBlock Text="RandomNumberGenerator; неоднозначные 0/O/1/l исключены." Style="{StaticResource Muted}" FontSize="9.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="350" MinHeight="200" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="TEXT CONVERTER" Style="{StaticResource SectionTitle}"/>
                                <TextBox Style="{StaticResource InputBox}" Height="62" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Omega.TextInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <WrapPanel Margin="0,7,0,0"><Button Content="ABC" Style="{StaticResource GhostButton}" Command="{Binding Omega.ConvertTextCommand}" CommandParameter="upper"/>
                                    <Button Content="abc" Style="{StaticResource GhostButton}" Margin="5,0" Command="{Binding Omega.ConvertTextCommand}" CommandParameter="lower"/>
                                    <Button Content="Пробелы" Style="{StaticResource GhostButton}" Command="{Binding Omega.ConvertTextCommand}" CommandParameter="trim"/></WrapPanel>
                                <TextBox Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,7,0,0" Text="{Binding Omega.TextOutput, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="350" MinHeight="200" Margin="0,0,10,10">
                            <StackPanel><TextBlock Text="COLOR CONVERTER" Style="{StaticResource SectionTitle}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Omega.ColorInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Height="42" CornerRadius="8" Margin="0,7,0,0" Background="{Binding Omega.ColorInput, Converter={StaticResource HexToBrush}}"/>
                                <Button Content="HEX → RGB" Style="{StaticResource GhostButton}" Margin="0,7,0,0" Command="{Binding Omega.ConvertColorCommand}"/>
                                <TextBlock Text="{Binding Omega.ColorOutput}" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Performance -->
            <TabItem Header="◴  Performance">
                <StackPanel Margin="22,0,0,0" MaxWidth="820" HorizontalAlignment="Left">
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU DRBROWSER" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Omega.CpuText}" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKING SET" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Omega.RamText}" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MANAGED HEAP" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Omega.ManagedMemoryText}" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ВКЛАДКИ" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Omega.BrowserTabsText}" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WEBVIEW2 ПРОЦЕССЫ" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Omega.WebViewProcessText}" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ДВИЖОК" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Omega.RuntimeText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
                    </UniformGrid>
                    <Button Content="Обновить реальные показатели" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding Omega.RefreshPerformanceCommand}"/>
                    <TextBlock Text="Значения читаются из System.Diagnostics.Process и GC; они не моделируются. Первый замер CPU служит базовой точкой."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Gaming -->
            <TabItem Header="◇  Gaming">
                <StackPanel Margin="22,0,0,0" MaxWidth="820" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DRGAMING MODE" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Переключает интерфейс на Gaming и Tab Sleep на Aggressive. Закреплённые вкладки, звук и активные загрузки защищены от сна."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Включить Gaming Mode" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding Omega.EnableGamingModeCommand}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="БЫСТРЫЙ ДОСТУП" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                    <UniformGrid Columns="3">
                        <Button Content="Steam" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding Omega.OpenGamingLinkCommand}" CommandParameter="https://store.steampowered.com/"/>
                        <Button Content="Discord" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding Omega.OpenGamingLinkCommand}" CommandParameter="https://discord.com/app"/>
                        <Button Content="Twitch" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding Omega.OpenGamingLinkCommand}" CommandParameter="https://www.twitch.tv/"/>
                        <Button Content="YouTube Gaming" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding Omega.OpenGamingLinkCommand}" CommandParameter="https://www.youtube.com/gaming"/>
                        <Button Content="Epic Games" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding Omega.OpenGamingLinkCommand}" CommandParameter="https://store.epicgames.com/"/>
                        <Button Content="Roblox" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding Omega.OpenGamingLinkCommand}" CommandParameter="https://www.roblox.com/"/>
                    </UniformGrid>
                    <TextBlock Text="Ссылки открываются как обычные HTTPS-страницы. DrBrowser не запускает игры и не получает доступ к игровым процессам."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock Text="{Binding Omega.Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
