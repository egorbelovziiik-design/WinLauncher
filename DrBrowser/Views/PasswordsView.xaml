<UserControl x:Class="DrBrowser.PasswordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,12">
            <TextBlock Text="Менеджер паролей" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Пароли шифруются Windows DPAPI для текущей учётной записи и лежат в SQLite в зашифрованном виде. Автозаполнение сайтов намеренно не реализовано — данные попадают в поле только по вашему действию." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,0,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Style="{StaticResource InputBox}" Margin="0,0,0,10"
                             TextChanged="Search_Changed" ToolTip="Поиск по сайту или логину" />
                    <ListBox x:Name="List" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Site}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource Muted}" FontSize="11" />
                                        <TextBlock Text="{Binding PasswordMask}" Style="{StaticResource Muted}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Логин" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10.5"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.CopyLoginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Пароль" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10.5"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="✕" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                                                Command="{Binding DataContext.DeletePasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="НОВАЯ ЗАПИСЬ" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Сайт" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding NewPasswordSite, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Логин" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding NewPasswordLogin, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Пароль" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding NewPasswordValue, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding GeneratedPasswordStrength}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Сгенерировать пароль" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                Command="{Binding GeneratePasswordCommand}" />
                        <Button Content="Добавить запись" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                                Command="{Binding AddPasswordCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Пароли никогда не покидают этот компьютер и не отправляются в AI-сервис." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
