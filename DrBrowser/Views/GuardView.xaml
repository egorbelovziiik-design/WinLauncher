<UserControl x:Class="DrBrowser.GuardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="32,26,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="54" Height="54" Margin="0,0,16,0">
                <Ellipse Fill="{DynamicResource AccentGradientBrush}" Opacity="0.22" />
                <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" />
                <Path Data="M27 12 L38 17 V28 C38 35 32 40 27 43 C22 40 16 35 16 28 V17 Z"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                      Fill="{DynamicResource AccentSoftBrush}" Stretch="None" />
                <Path Data="M21 27 L25.5 32 L33 22" Stroke="#7CFFB2" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="DrGuard — защита браузера" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding GuardCounters}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Обновить статус" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshGuardCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding Security.ScanButtonText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanDownloadsCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,28">
            <StackPanel>

                <!-- status cards -->
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="АНТИВИРУС WINDOWS" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding GuardDefenderStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       FontSize="12.5" />
                            <TextBlock Text="{Binding GuardSignatureText}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="ЧТО ПРОВЕРЕНО" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Security.ScanText}" Margin="0,6,0,0" FontSize="12.5" />
                            <TextBlock Text="{Binding Security.ThreatText}" Margin="0,4,0,0" FontSize="11"
                                       Foreground="#7CFFB2" />
                            <TextBlock Text="{Binding GuardScanStatus}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="БЛОКИРОВКА" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Security.BlockedText}" Margin="0,6,0,0" FontSize="12.5" />
                            <TextBlock Text="{Binding GuardScanSummary}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5" />
                            <Button Content="Открыть папку загрузок" Style="{StaticResource GhostButton}"
                                    FontSize="10.5" Padding="9,4" Margin="0,8,0,0"
                                    Command="{Binding OpenDownloadFolderCommand}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- toggles -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="НАСТРОЙКИ ЗАЩИТЫ" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DrGuard включён" FontSize="12.5" />
                                <TextBlock Text="Проверка ссылок перед загрузкой и предупреждения об опасных адресах"
                                           Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Settings.DrGuardEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Сканировать загрузки" FontSize="12.5" />
                                <TextBlock Text="Каждый завершённый файл проверяется через Microsoft Defender (MpCmdRun.exe), результат показывается честно"
                                           Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Settings.DrGuardScanDownloads, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Предупреждать об HTTP" FontSize="12.5" />
                                <TextBlock Text="Соединение без шифрования — трафик может быть прочитан в сети"
                                           Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Settings.DrGuardWarnOnHttp, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- check link -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="ПРОВЕРИТЬ ССЫЛКУ" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                     Text="{Binding GuardCheckInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Вставьте адрес — проверка выполняется локально, без обращения к сети" />
                            <Button Grid.Column="1" Content="Проверить" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Command="{Binding CheckLinkCommand}" />
                            <Button Grid.Column="2" Content="В блок-лист" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Command="{Binding BlockHostCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding GuardVerdict}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5" />

                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Content="Проверить файл на диске" Style="{StaticResource GhostButton}"
                                    Margin="0,0,5,0" Command="{Binding ScanFileCommand}" />
                            <Button Content="Разрешить заблокированный сайт" Style="{StaticResource GhostButton}"
                                    Margin="5,0,0,0" Command="{Binding AllowHostCommand}"
                                    IsEnabled="{Binding HasBlockedLink}" />
                        </UniformGrid>

                        <TextBlock Text="{Binding GuardLastBlocked}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10" />
                    </StackPanel>
                </Border>

                <!-- lists -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="СВОЙ БЛОК-ЛИСТ" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding GuardBlockedHosts}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10.5" />
                            <TextBlock Text="{Binding GuardExemptions}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10.5" />
                            <Button Content="Очистить блок-лист" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    FontSize="10.5" Command="{Binding ClearBlockedHostsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ЖУРНАЛ СОБЫТИЙ" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Блокировки, сканирования и найденные угрозы"
                                       Style="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,6" />
                            <ListBox ItemsSource="{Binding Security.Threats}" MaxHeight="190" BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                        Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Level}" FontSize="8.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}"
                                                           FontSize="9.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Target}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}"
                                                       FontSize="9.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Очистить журнал" Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                    FontSize="10.5" Command="{Binding ClearGuardLogCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="DrGuard — это слой защиты браузера, а не отдельный антивирус: он блокирует известные схемы мошенничества и проверяет загрузки установленным Microsoft Defender. Полную защиту системы обеспечивает антивирус Windows." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
