          <Item class="ModuleScript" referent="RBX0000005D">
            <Properties>
              <string name="Name">ShopUI</string>
              <ProtectedString name="Source"><![CDATA[local ShopUI = {}
function ShopUI.open()
    local pg=game.Players.LocalPlayer:WaitForChild("PlayerGui")
    if pg:FindFirstChild("Shop") then pg.Shop:Destroy() end
    local gui=Instance.new("ScreenGui"); gui.Name="Shop"; gui.ResetOnSpawn=false; gui.Parent=pg
    local bg=Instance.new("Frame"); bg.Size=UDim2.fromOffset(760,520); bg.Position=UDim2.fromScale(0.5,0.5); bg.AnchorPoint=Vector2.new(0.5,0.5); bg.BackgroundColor3=Color3.fromHex("#0F172A"); bg.Parent=gui; Instance.new("UICorner",bg).CornerRadius=UDim.new(0,16); Instance.new("UIStroke",bg).Color=Color3.fromHex("#334155")
    local title=Instance.new("TextLabel"); title.Size=UDim2.new(1,0,0,44); title.BackgroundTransparency=1; title.Text="🛒 МАГАЗИН — только косметика, без Pay-to-Win"; title.TextColor3=Color3.new(1,1,1); title.Font=Enum.Font.GothamBold; title.TextSize=16; title.Parent=bg
    local grid=Instance.new("Frame"); grid.Size=UDim2.new(1,-24,1,-60); grid.Position=UDim2.fromOffset(12,48); grid.BackgroundTransparency=1; grid.Parent=bg
    local gl=Instance.new("UIGridLayout", grid); gl.CellSize=UDim2.fromOffset(170,120); gl.CellPadding=UDim2.fromOffset(12,12)
    local catalog={
        {id="gold_borders", name="Золотые границы", price=400},
        {id="neon_borders", name="Неоновые границы", price=600},
        {id="modern_city", name="Современный город", price=800},
        {id="gold_tank", name="Золотые танки", price=700},
        {id="music_war", name="Боевой саундтрек", price=500},
        {id="ui_neon", name="Неоновая тема", price=450},
        {id="flag_goldframe", name="Золотая рамка", price=350},
        {id="diamond_borders", name="Алмазные границы", price=1200},
    }
    for _,it in ipairs(catalog) do
        local c=Instance.new("TextButton"); c.BackgroundColor3=Color3.fromHex("#1E293B"); c.Text=""; c.Parent=grid; Instance.new("UICorner",c).CornerRadius=UDim.new(0,12)
        local n=Instance.new("TextLabel"); n.Size=UDim2.new(1,0,0,36); n.BackgroundTransparency=1; n.Text=it.name; n.TextColor3=Color3.new(1,1,1); n.Font=Enum.Font.GothamMedium; n.TextSize=11; n.TextWrapped=true; n.Parent=c
        local p=Instance.new("TextLabel"); p.Size=UDim2.new(1,0,0,22); p.Position=UDim2.fromScale(0,0.55); p.BackgroundTransparency=1; p.Text="🪙 "..it.price; p.TextColor3=Color3.fromHex("#FACC15"); p.Font=Enum.Font.GothamBold; p.TextSize=13; p.Parent=c
        local buy=Instance.new("TextButton"); buy.Size=UDim2.new(1,-12,0,28); buy.Position=UDim2.fromOffset(6,86); buy.Text="КУПИТЬ"; buy.Font=Enum.Font.GothamBold; buy.TextSize=11; buy.BackgroundColor3=Color3.fromHex("#22C55E"); buy.TextColor3=Color3.new(1,1,1); buy.Parent=c; Instance.new("UICorner",buy).CornerRadius=UDim.new(0,8)
        buy.MouseButton1Click:Connect(function()
            require(script.Parent.Parent.Controllers.ShopController).buy(it.id)
            buy.Text="✓ КУПЛЕНО"; buy.BackgroundColor3=Color3.fromHex("#64748B")
        end)
    end
    local close=Instance.new("TextButton"); close.Size=UDim2.fromOffset(32,32); close.Position=UDim2.fromScale(1,0); close.AnchorPoint=Vector2.new(1,0); close.Text="✕"; close.Font=Enum.Font.GothamBold; close.TextSize=16; close.BackgroundColor3=Color3.fromHex("#EF4444"); close.TextColor3=Color3.new(1,1,1); close.Parent=bg; Instance.new("UICorner",close).CornerRadius=UDim.new(1,0)
    close.MouseButton1Click:Connect(function() gui:Destroy() end)
end
return ShopUI
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX0000005E">
            <Properties>
              <string name="Name">TutorialUI</string>
              <ProtectedString name="Source"><![CDATA[local TutorialUI = {}
local steps = {
    "Перемести камеру WASD — проведи мышью к краю экрана",
    "Приблизь карту колесом — найди свою столицу",
    "Кликни по провинции — выбери государство",
    "Открой меню строительства слева — выбери House",
    "Поставь здание — зелёный призрак, клик",
    "Построй электростанцию — CoalPlant",
    "Построй завод — MilitaryFactory",
    "Создай армию — кнопка в HUD справа",
    "Перемести армию в соседнюю провинцию",
    "Захвати территорию — объяви войну",
    "Заключи альянс — кнопка 🤝",
    "Обменяй ресурсы — торговля",
    "Исследуй технологию — Army → ModernInfantry",
    "Проверь бюджет — верхняя панель",
    "Подпиши мир — заверши войну",
}
local idx=1
function TutorialUI.start()
    local pg=game.Players.LocalPlayer:WaitForChild("PlayerGui")
    local gui=Instance.new("ScreenGui"); gui.Name="Tutorial"; gui.ResetOnSpawn=false; gui.Parent=pg
    local frame=Instance.new("Frame"); frame.Size=UDim2.fromOffset(420,150); frame.Position=UDim2.fromScale(0.5,0.18); frame.AnchorPoint=Vector2.new(0.5,0); frame.BackgroundColor3=Color3.fromHex("#111827"); frame.Parent=gui; Instance.new("UICorner",frame).CornerRadius=UDim.new(0,14)
    local pad=Instance.new("UIPadding", frame); pad.PaddingLeft=UDim.new(0,16); pad.PaddingRight=UDim.new(0,16); pad.PaddingTop=UDim.new(0,14)
    local title=Instance.new("TextLabel"); title.Size=UDim2.new(1,0,0,22); title.BackgroundTransparency=1; title.Text="🎓 ОБУЧЕНИЕ — ШАГ "..idx.."/"..#steps; title.TextColor3=Color3.fromHex("#FACC15"); title.Font=Enum.Font.GothamBold; title.TextSize=12; title.Parent=frame
    local txt=Instance.new("TextLabel"); txt.Name="StepText"; txt.Size=UDim2.new(1,0,0,60); txt.Position=UDim2.fromOffset(0,28); txt.BackgroundTransparency=1; txt.Text=steps[1]; txt.TextColor3=Color3.new(1,1,1); txt.Font=Enum.Font.GothamMedium; txt.TextSize=13; txt.TextWrapped=true; txt.Parent=frame
    local btn=Instance.new("TextButton"); btn.Size=UDim2.new(1,0,0,38); btn.Position=UDim2.fromOffset(0,96); btn.Text="ДАЛЕЕ →"; btn.Font=Enum.Font.GothamBold; btn.TextSize=13; btn.BackgroundColor3=Color3.fromHex("#22C55E"); btn.TextColor3=Color3.new(1,1,1); btn.Parent=frame; Instance.new("UICorner",btn).CornerRadius=UDim.new(0,10)
    local skip=Instance.new("TextButton"); skip.Size=UDim2.fromOffset(100,28); skip.Position=UDim2.fromScale(1,0); skip.AnchorPoint=Vector2.new(1,0); skip.Text="Пропустить"; skip.Font=Enum.Font.Gotham; skip.TextSize=11; skip.BackgroundTransparency=1; skip.TextColor3=Color3.fromHex("#94A3B8"); skip.Parent=frame
    btn.MouseButton1Click:Connect(function()
        idx+=1
        if idx>#steps then
            title.Text="✅ ОБУЧЕНИЕ ЗАВЕРШЕНО! +500 COINS"
            txt.Text="Ты готов к мировому господству. Удачи, стратег!"
            btn.Text="ЗАВЕРШИТЬ"
            btn.MouseButton1Click:Once(function()
                gui:Destroy()
                local rem=game:GetService("ReplicatedStorage").Remotes:FindFirstChild("ToggleTutorial")
                if rem then rem:FireServer(true) end
                -- награда локально
                local s=Instance.new("Sound"); s.SoundId="rbxassetid://12222030"; s.Volume=0.8; s.Parent=workspace; s:Play(); game.Debris:AddItem(s,3)
            end)
            return
        end
        title.Text="🎓 ОБУЧЕНИЕ — ШАГ "..idx.."/"..#steps
        txt.Text=steps[idx]
    end)
    skip.MouseButton1Click:Connect(function() gui:Destroy() end)
    -- стрелка-подсветка (простая)
    local arrow=Instance.new("TextLabel"); arrow.Size=UDim2.fromOffset(40,40); arrow.Position=UDim2.fromScale(0.12,0.5); arrow.BackgroundTransparency=1; arrow.Text="👉"; arrow.TextSize=28; arrow.Parent=gui
    game:GetService("TweenService"):Create(arrow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Position=UDim2.fromScale(0.14,0.5)}):Play()
end
return TutorialUI
]]></ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="LocalScript" referent="RBX0000004E">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Main.client — точка входа клиента
print("🌍 Mini Nations 3D — Client starting...")

local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local pl = Players.LocalPlayer

-- дождаться ремоутов
local remotes = RS:WaitForChild("Remotes", 10)

-- Инициализация контроллеров
local CameraController = require(script.Controllers.CameraController)
local MapController = require(script.Controllers.MapController)
local AudioController = require(script.Controllers.AudioController)
local BuildingController = require(script.Controllers.BuildingController)

CameraController.init()
AudioController.init()
AudioController.play("menu", 0.45)

-- Построить карту (после загрузки)
MapController.init()

-- Построить UI
local MainMenu = require(script.UI.MainMenu)
local HUD = require(script.UI.HUD)

local pg = pl:WaitForChild("PlayerGui")
-- очистить старый
for _,g in ipairs(pg:GetChildren()) do if g.Name=="MainMenu" or g.Name=="HUD" then g:Destroy() end end

local menuGui = MainMenu.build()
menuGui.Parent = pg

local hudGui = HUD.build()
hudGui.Parent = pg -- внутри HUD.Enabled=false до начала игры

-- Профиль
local coins = 500
if remotes and remotes:FindFirstChild("GetProfile") then
    local ok, prof = pcall(function() return remotes.GetProfile:InvokeServer() end)
    if ok and prof then
        coins = prof.coins or 500
        print("[Client] Profile loaded — coins:", coins, " level:", prof.level)
        if prof.tutorialDone == false then
            -- показать приветствие
            task.delay(1, function()
                local gui=Instance.new("ScreenGui"); gui.Name="Welcome"; gui.ResetOnSpawn=false; gui.Parent=pg
                local f=Instance.new("Frame"); f.Size=UDim2.fromOffset(420,180); f.Position=UDim2.fromScale(0.5,0.5); f.AnchorPoint=Vector2.new(0.5,0.5); f.BackgroundColor3=Color3.fromHex("#0F172A"); f.Parent=gui; Instance.new("UICorner",f).CornerRadius=UDim.new(0,16)
                local t=Instance.new("TextLabel"); t.Size=UDim2.new(1,0,0,60); t.BackgroundTransparency=1; t.Text="Добро пожаловать в Mini Nations 3D!"; t.TextColor3=Color3.new(1,1,1); t.Font=Enum.Font.GothamBold; t.TextSize=16; t.Parent=f
                local b1=Instance.new("TextButton"); b1.Size=UDim2.new(1,-24,0,36); b1.Position=UDim2.fromOffset(12,70); b1.Text="🎓 ПРОЙТИ ОБУЧЕНИЕ"; b1.BackgroundColor3=Color3.fromHex("#22C55E"); b1.TextColor3=Color3.new(1,1,1); b1.Font=Enum.Font.GothamBold; b1.Parent=f; Instance.new("UICorner",b1).CornerRadius=UDim.new(0,10)
                local b2=Instance.new("TextButton"); b2.Size=UDim2.new(1,-24,0,36); b2.Position=UDim2.fromOffset(12,114); b2.Text="⏭️ ПРОПУСТИТЬ"; b2.BackgroundColor3=Color3.fromHex("#334155"); b2.TextColor3=Color3.new(1,1,1); b2.Font=Enum.Font.Gotham; b2.Parent=f; Instance.new("UICorner",b2).CornerRadius=UDim.new(0,10)
                b1.MouseButton1Click:Connect(function() gui:Destroy(); require(script.UI.TutorialUI).start() end)
                b2.MouseButton1Click:Connect(function() gui:Destroy() end)
            end)
        end
    end
end

-- Глобальные слушатели ремоутов для уведомлений
if remotes then
    local function notify(msg:string, color:Color3?)
        local gui=Instance.new("ScreenGui"); gui.Name="Notify"; gui.ResetOnSpawn=false; gui.Parent=pg
        local l=Instance.new("TextLabel"); l.Size=UDim2.fromOffset(360,36); l.Position=UDim2.fromScale(0.5,0.08); l.AnchorPoint=Vector2.new(0.5,0); l.BackgroundColor3=color or Color3.fromHex("#1E293B"); l.TextColor3=Color3.new(1,1,1); l.Text=msg; l.Font=Enum.Font.GothamMedium; l.TextSize=12; l.Parent=gui; Instance.new("UICorner",l).CornerRadius=UDim.new(0,10)
        task.delay(2.5, function() gui:Destroy() end)
    end
    remotes:FindFirstChild("WarDeclared").OnClientEvent:Connect(function(_,a,d) notify("⚔️ Война: "..a.." → "..d, Color3.fromHex("#EF4444")) ; AudioController.playSFX("war") end)
    remotes:FindFirstChild("BattleResult").OnClientEvent:Connect(function(_,prov, win) notify((win and "✓ Победа в " or "✗ Поражение в ")..prov, win and Color3.fromHex("#22C55E") or Color3.fromHex("#EF4444")) end)
    remotes:FindFirstChild("AchievementUnlocked").OnClientEvent:Connect(function(id, def) notify("🏆 Достижение: "..def.name.." +"..def.reward.." COINS", Color3.fromHex("#FACC15")) ; AudioController.playSFX("achieve") end)
    remotes:FindFirstChild("CoinsUpdated").OnClientEvent:Connect(function(new, delta) notify("🪙 +"..delta.." COINS", Color3.fromHex("#FACC15")) end)
end

-- Мобильная поддержка — показать джойстик подсказку
if game:GetService("UserInputService").TouchEnabled then
    print("[Client] Touch device detected — edge scroll & pinch enabled")
end

-- День/Ночь цикл (визуальный)
task.spawn(function()
    local lighting = game:GetService("Lighting")
    while true do
        task.wait(40)
        -- плавный переход
        local ts = game:GetService("TweenService")
        ts:Create(lighting, TweenInfo.new(8), {ClockTime = lighting.ClockTime > 12 and 2 or 14}):Play()
    end
end)

print("✅ Mini Nations 3D Client ready")
]]></ProtectedString>
        </Properties>
      </Item>
