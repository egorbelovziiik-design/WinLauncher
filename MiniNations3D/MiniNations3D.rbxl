            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00000050">
            <Properties>
              <string name="Name">AudioController</string>
              <ProtectedString name="Source"><![CDATA[local AudioController = {}
local assets = {
    menu = 1843523000, -- пример ID (замени на свои из Creator Marketplace)
    peace = 1837240040,
    war = 1837255766,
    economy = 1837761492,
    victory = 12222216,
    defeat = 12222124,
}
local current: Sound? = nil
function AudioController.init()
    local s = Instance.new("Folder"); s.Name="Audio"; s.Parent=workspace
end
function AudioController.play(track:string, volume:number?)
    if current then current:Stop(); current:Destroy() end
    local id = assets[track] or assets.menu
    local sound = Instance.new("Sound")
    sound.SoundId="rbxassetid://"..id
    sound.Volume=volume or 0.4
    sound.Looped = track~="victory" and track~="defeat"
    sound.Parent=workspace
    sound:Play()
    current=sound
end
function AudioController.playSFX(name:string)
    local id = ({click=12222025, build=12221967, war=12222058, coin=12221976, achieve=12222030})[name] or 12222025
    local s=Instance.new("Sound"); s.SoundId="rbxassetid://"..id; s.Volume=0.7; s.Parent=workspace; s:Play(); game.Debris:AddItem(s,3)
end
function AudioController.setVolumes(music:number, sfx:number, ui:number)
    if current then current.Volume=music end
end
return AudioController
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000051">
            <Properties>
              <string name="Name">BuildingController</string>
              <ProtectedString name="Source"><![CDATA[local BuildingController = {}
local ghost: Model? = nil
local selectedBuilding:string? = "House"
local RS = game:GetService("ReplicatedStorage")

local function makeGhost(name:string)
    if ghost then ghost:Destroy() end
    local m=Instance.new("Model"); m.Name="Ghost"
    local p=Instance.new("Part"); p.Size=Vector3.new(8,8,8); p.Anchored=true; p.CanCollide=false; p.Transparency=0.5; p.Color=Color3.fromHex("#22C55E"); p.Material=Enum.Material.ForceField; p.Parent=m
    m.PrimaryPart=p; m.Parent=workspace; ghost=m
    -- follow mouse via Raycast
    local UIS=game:GetService("UserInputService")
    game:GetService("RunService").RenderStepped:Connect(function()
        if not ghost or not ghost.Parent then return end
        local mouse = UIS:GetMouseLocation()
        local cam=workspace.CurrentCamera
        local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
        local params=RaycastParams.new(); params.FilterDescendantsInstances={ghost, workspace:FindFirstChild("Provinces")}; params.FilterType=Enum.RaycastFilterType.Exclude
        local res=workspace:Raycast(ray.Origin, ray.Direction*2000, params)
        if res then
            ghost:PivotTo(CFrame.new(res.Position + Vector3.new(0,4,0)))
            -- проверка можно ли строить (по провинции под курсором)
            local provFolder=workspace:FindFirstChild("Provinces")
            if provFolder then
                -- простейшая проверка расстояния до центра провинции
                local can=false
                for _,part in ipairs(provFolder:GetChildren()) do if (part.Position - res.Position).Magnitude < 28 then can=true break end end
                ghost.PrimaryPart.Color = can and Color3.fromHex("#22C55E") or Color3.fromHex("#EF4444")
            end
        end
    end)
end

function BuildingController.select(name:string) selectedBuilding=name; makeGhost(name) end
function BuildingController.get() return selectedBuilding end
function BuildingController.place()
    if not ghost or not selectedBuilding then return end
    -- найти ближайшую провинцию
    local pos = ghost:GetPivot().Position
    local best, dist=nil, 1e9
    local folder=workspace:FindFirstChild("Provinces"); if not folder then return end
    for _,part in ipairs(folder:GetChildren()) do
        local d=(part.Position - pos).Magnitude
        if d<dist then dist=d; best=part end
    end
    if best and dist < 40 then
        local rem = RS.Remotes:FindFirstChild("BuildRequest")
        if rem then rem:FireServer(best.Name, selectedBuilding) end
        game:GetService("ReplicatedStorage"):WaitForChild("Shared")
        -- локальный эффект
        require(script.Parent.AudioController).playSFX("build")
    end
end
function BuildingController.cancel() if ghost then ghost:Destroy(); ghost=nil end end
return BuildingController
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000052">
            <Properties>
              <string name="Name">CameraController</string>
              <ProtectedString name="Source"><![CDATA[local CameraController = {}
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local cam = workspace.CurrentCamera
cam.CameraType = Enum.CameraType.Scriptable

local targetPos = Vector3.new(0, 120, -80)
local targetYaw = 0
local targetPitch = 45
local zoom = 140
local minZoom, maxZoom = 40, 320
local moveSpeed = 60

local keys = {W=false, A=false, S=false, D=false}
local edgeMove = true

function CameraController.init()
    cam.FieldOfView = 70
    UIS.InputBegan:Connect(function(inp, proc)
        if proc then return end
        if inp.KeyCode==Enum.KeyCode.W then keys.W=true end
        if inp.KeyCode==Enum.KeyCode.A then keys.A=true end
        if inp.KeyCode==Enum.KeyCode.S then keys.S=true end
        if inp.KeyCode==Enum.KeyCode.D then keys.D=true end
        if inp.KeyCode==Enum.KeyCode.F then CameraController.focusCapital() end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.KeyCode==Enum.KeyCode.W then keys.W=false end
        if inp.KeyCode==Enum.KeyCode.A then keys.A=false end
        if inp.KeyCode==Enum.KeyCode.S then keys.S=false end
        if inp.KeyCode==Enum.KeyCode.D then keys.D=false end
    end)
    UIS.InputChanged:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseWheel then
            zoom = math.clamp(zoom - inp.Position.Z*12, minZoom, maxZoom)
        end
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and inp.UserInputType==Enum.UserInputType.MouseMovement then
            targetYaw -= inp.Delta.X*0.3
            targetPitch = math.clamp(targetPitch - inp.Delta.Y*0.3, 15, 85)
        end
        if inp.UserInputType==Enum.UserInputType.Touch then
            -- pinch handled via separate
        end
    end)

    -- Middle mouse pan
    local panning=false
    local lastPos=nil
    UIS.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton3 then panning=true; lastPos=inp.Position end
    end)
    UIS.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton3 then panning=false end end)
    UIS.InputChanged:Connect(function(inp)
        if panning and inp.UserInputType==Enum.UserInputType.MouseMovement then
            local delta = inp.Position - (lastPos or inp.Position)
            lastPos=inp.Position
            local rad = math.rad(targetYaw)
            targetPos += Vector3.new(-delta.X*0.25*math.cos(rad) - delta.Y*0.25*math.sin(rad),0, -delta.X*0.25*math.sin(rad) + delta.Y*0.25*math.cos(rad))
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        local mv = Vector3.zero
        if keys.W then mv+=Vector3.new(0,0,-1) end
        if keys.S then mv+=Vector3.new(0,0,1) end
        if keys.A then mv+=Vector3.new(-1,0,0) end
        if keys.D then mv+=Vector3.new(1,0,0) end
        -- edge scroll
        if edgeMove and not UIS:GetFocusedTextBox() then
            local m = UIS:GetMouseLocation()
            local vp = cam.ViewportSize
            if m.X < 18 then mv+=Vector3.new(-1,0,0) end
            if m.X > vp.X-18 then mv+=Vector3.new(1,0,0) end
            if m.Y < 18 then mv+=Vector3.new(0,0,-1) end
            if m.Y > vp.Y-18 then mv+=Vector3.new(0,0,1) end
        end
        if mv.Magnitude>0 then
            mv=mv.Unit * moveSpeed * dt * (zoom/120)
            local rad=math.rad(targetYaw)
            local fwd = Vector3.new(math.sin(rad),0, math.cos(rad))
            local right = Vector3.new(math.cos(rad),0, -math.sin(rad))
            targetPos += right*mv.X + fwd*mv.Z
        end
        targetPos = Vector3.new(math.clamp(targetPos.X,-1200,1200), targetPos.Y, math.clamp(targetPos.Z,-700,700))
        -- плавность
        local desired = targetPos + Vector3.new(0, math.sin(math.rad(targetPitch))*zoom, math.cos(math.rad(targetPitch))*zoom)
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(desired, targetPos), math.clamp(dt*7,0,1))
        cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos) * CFrame.Angles(0,0,0)
    end)
end

function CameraController.focusCapital()
    -- найти столицу выбранной страны (через MapController)
    local MapCtrl = require(script.Parent.MapController)
    local cap = MapCtrl.getSelectedCountryCapitalPos()
    if cap then targetPos = cap end
end
function CameraController.jumpTo(pos:Vector3) targetPos = pos end
return CameraController
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000053">
            <Properties>
              <string name="Name">DiplomacyController</string>
              <ProtectedString name="Source"><![CDATA[local DiplomacyController = {}
local RS = game:GetService("ReplicatedStorage")
function DiplomacyController.declareWar(from:string, to:string)
    local r=RS.Remotes:FindFirstChild("DeclareWar"); if r then r:FireServer(from,to) end
end
function DiplomacyController.makePeace(warId:string)
    local r=RS.Remotes:FindFirstChild("MakePeace"); if r then r:FireServer(warId) end
end
function DiplomacyController.createAlliance(name:string, color:Color3, leader:string)
    local r=RS.Remotes:FindFirstChild("CreateAlliance"); if r then r:FireServer(name,color,leader) end
end
return DiplomacyController
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000054">
            <Properties>
              <string name="Name">MapController</string>
              <ProtectedString name="Source"><![CDATA[local MapController = {}
local RS = game:GetService("ReplicatedStorage")
local ProvinceData = require(RS.Shared.ProvinceData)
local selectedCountry:string? = nil
local selectedProvince:string? = nil
local hoverProv:string? = nil

function MapController.init()
    -- генерировать 3D карту из провинций
    local folder = workspace:FindFirstChild("Provinces")
    if not folder then folder=Instance.new("Folder"); folder.Name="Provinces"; folder.Parent=workspace end
    folder:ClearAllChildren()
    for id,prov in pairs(ProvinceData.list) do
        local part = Instance.new("Part")
        part.Name=id
        part.Anchored=true; part.CanCollide=false; part.TopSurface=Enum.SurfaceType.Smooth
        part.Size=Vector3.new(38, math.random(2,9), 38)
        part.Position = prov.pos + Vector3.new(0, part.Size.Y/2, 0)
        -- цвет по владельцу
        local country = require(RS.Shared.CountryData).byId[prov.owner]
        part.Color = country and country.color or Color3.fromHex("#334155")
        part.Material=Enum.Material.Slate
        part.Parent=folder
        -- ClickDetector для выбора
        local cd = Instance.new("ClickDetector"); cd.MaxActivationDistance=800; cd.Parent=part
        cd.MouseClick:Connect(function(pl) MapController.selectProvince(id) end)
        cd.MouseHoverEnter:Connect(function() hoverProv=id; part.Material=Enum.Material.Neon end)
        cd.MouseHoverLeave:Connect(function() if hoverProv==id then hoverProv=nil end; part.Material=Enum.Material.Slate end)
        -- Биом: горные провинции выше
        if id:find("3$") then part.Size=Vector3.new(38,12,38); part.Color=Color3.fromHex("#78716C") end
        -- Леса — маленькие цилиндры
        if math.random()<0.3 then
            local tree=Instance.new("Part"); tree.Size=Vector3.new(2,6,2); tree.Position=part.Position+Vector3.new(math.random(-12,12),4, math.random(-12,12)); tree.Color=Color3.fromHex("#15803D"); tree.Anchored=true; tree.Parent=part
        end
    end
    -- границы: подсветка через SelectionBox
    -- Океан
    local ocean = Instance.new("Part")
    ocean.Name="Ocean"; ocean.Size=Vector3.new(2600, 2, 1600); ocean.Position=Vector3.new(0,-4,0); ocean.Anchored=true; ocean.Color=Color3.fromHex("#1E3A8A"); ocean.Material=Enum.Material.SmoothPlastic; ocean.Transparency=0.25; ocean.Parent=workspace

    -- ремоуты обновления
    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        remotes:FindFirstChild("ProvinceOwnerChanged").OnClientEvent:Connect(function(pid,newOwner)
            local p = folder:FindFirstChild(pid)
            if p then
                local c=require(RS.Shared.CountryData).byId[newOwner]
                if c then game:GetService("TweenService"):Create(p, TweenInfo.new(0.6), {Color=c.color}):Play() end
            end
        end)
        remotes:FindFirstChild("BuildingPlaced").OnClientEvent:Connect(function(pid, building, pos)
            local mdl=Instance.new("Part"); mdl.Size=Vector3.new(6,10,6); mdl.Position=pos+Vector3.new(math.random(-10,10),6, math.random(-10,10)); mdl.Anchored=true; mdl.Color=Color3.fromHex("#FBBF24"); mdl.Material=Enum.Material.Concrete; mdl.Parent=folder
        end)
    end
end

function MapController.selectProvince(id:string)
    selectedProvince=id
    local prov = ProvinceData.get(id)
    if prov then
        -- показать UI провинции
        local HUD = require(script.Parent.Parent.UI.HUD)
        HUD.showProvince(prov)
        -- обновить выбранную страну
        selectedCountry = prov.owner
    end
end
function MapController.getSelectedCountry() return selectedCountry end
function MapController.getSelectedCountryCapitalPos(): Vector3?
    if not selectedCountry then return nil end
    local list={}
    for _,p in pairs(ProvinceData.list) do if p.owner==selectedCountry then table.insert(list,p) end end
    if #list>0 then return list[1].pos end
    return nil
end
function MapController.setMapMode(mode:string)
    local folder=workspace:FindFirstChild("Provinces"); if not folder then return end
    for _,part in ipairs(folder:GetChildren()) do
        if part:IsA("BasePart") then
            local prov = ProvinceData.get(part.Name)
            if not prov then continue end
            if mode=="Political" then
                local c=require(RS.Shared.CountryData).byId[prov.owner]; part.Color=c and c.color or part.Color
            elseif mode=="Economic" then
                local t = prov.economy/2000; part.Color=Color3.fromHSV(0.33*t,0.8,0.9)
            elseif mode=="Population" then
                local t=prov.population/4000000; part.Color=Color3.fromHSV(0.05+t*0.15,0.85,0.9)
            end
        end
    end
end
return MapController
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00000055">
            <Properties>
              <string name="Name">MenuController</string>
              <ProtectedString name="Source"><![CDATA[local MenuController = {}
local UI = {}
function MenuController.init(mainGui: ScreenGui)
    -- управляет переключением панелей главного меню
    MenuController.gui = mainGui
end
function MenuController.show(panel:string)
    for _,ch in ipairs(MenuController.gui:GetDescendants()) do
        if ch:GetAttribute("Panel") then ch.Visible = ch:GetAttribute("Panel")==panel end
    end
end
return MenuController
]]></ProtectedString>
