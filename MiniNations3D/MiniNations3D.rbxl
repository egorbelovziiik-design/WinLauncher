        <Item class="ModuleScript" referent="RBX0000002F">
          <Properties>
            <string name="Name">Config</string>
            <ProtectedString name="Source"><![CDATA[-- MiniNations3D Config v1.0.1
-- Центральный конфиг игры
local Config = {}

Config.VERSION = "1.0.1 Ultimate"
Config.GAME_NAME = "MINI NATIONS 3D"
Config.SUBTITLE = "WORLD DOMINATION"

Config.YEARS = {1444,1700,1800,1914,1936,1945,1980,1991,2000,2010,2020,2026,2030,2050}
Config.MAPS = {"World","Europe","Asia","America","Africa","Custom"}
Config.DIFFICULTIES = {"Easy","Normal","Hard","Expert"}
Config.AI_BEHAVIORS = {"Peaceful","Economic","Aggressive","Diplomatic","Defensive","Expansionist"}

Config.RESOURCES = {"Oil","Gas","Coal","Iron","Copper","Gold","Uranium","Lithium","Wood","Stone","Food","Water"}
Config.BUILDINGS = {
    Residential = {"House","Apartment","Skyscraper","Complex"},
    Commercial = {"Shop","Mall","Office","Bank","Hotel"},
    Government = {"CityHall","Parliament","Ministry","Police","FireStation"},
    Social = {"School","University","Hospital","Park","Stadium"},
    Energy = {"CoalPlant","GasPlant","OilPlant","Hydro","Nuclear","Solar","Wind","Geothermal"},
    Industry = {"MilitaryFactory","AutoFactory","Metallurgy","Chemical","Electronics","OilRefinery","FoodFactory","Shipyard","AircraftFactory"},
    Infra = {"Road","Highway","Railway","Bridge","Tunnel","Port","Airport","Logistics"},
    Military = {"Barracks","Airbase","NavalBase","MissileBase","Radar","Depot","Fort","Academy"},
}
Config.UNITS = {"Infantry","Motorized","Tank","Artillery","AA","Aviation","Helicopter","Navy","Recon"}

Config.ECONOMY = {
    BaseIncome = 1000,
    TaxRate = 0.22,
    InflationTick = 0.001,
    CrisisChance = 0.02,
}

Config.MAP = {
    ProvinceSize = 48,
    WorldSize = Vector2.new(2400, 1400), -- условные единицы карты
    SeaLevel = 0,
}

Config.COINS_REWARDS = {
    Tutorial = 500,
    WinMatch = 250,
    DailyQuest = 50,
    WeeklyQuest = 300,
    LevelUp = 100,
}

Config.REMOTE_RATE_LIMIT = 8 -- событий в секунду
return Config
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000030">
          <Properties>
            <string name="Name">CountryData</string>
            <ProtectedString name="Source"><![CDATA[-- 20 стран для демонстрации (масштабируется до ~195)
local CountryData = {
    {id="USA", name="United States", color=Color3.fromHex("#3B82F6"), flag="🇺🇸", capital="P-DC"},
    {id="RUS", name="Russia", color=Color3.fromHex("#EF4444"), flag="🇷🇺", capital="P-MOW"},
    {id="CHN", name="China", color=Color3.fromHex("#F59E0B"), flag="🇨🇳", capital="P-BJ"},
    {id="DEU", name="Germany", color=Color3.fromHex("#10B981"), flag="🇩🇪", capital="P-BER"},
    {id="FRA", name="France", color=Color3.fromHex("#6366F1"), flag="🇫🇷", capital="P-PAR"},
    {id="GBR", name="United Kingdom", color=Color3.fromHex("#8B5CF6"), flag="🇬🇧", capital="P-LON"},
    {id="JPN", name="Japan", color=Color3.fromHex("#EC4899"), flag="🇯🇵", capital="P-TKY"},
    {id="IND", name="India", color=Color3.fromHex("#F97316"), flag="🇮🇳", capital="P-DEL"},
    {id="BRA", name="Brazil", color=Color3.fromHex("#22C55E"), flag="🇧🇷", capital="P-BSB"},
    {id="TUR", name="Turkey", color=Color3.fromHex("#DC2626"), flag="🇹🇷", capital="P-ANK"},
    {id="UKR", name="Ukraine", color=Color3.fromHex("#0EA5E9"), flag="🇺🇦", capital="P-KYV"},
    {id="POL", name="Poland", color=Color3.fromHex("#E11D48"), flag="🇵🇱", capital="P-WAW"},
    {id="ITA", name="Italy", color=Color3.fromHex("#059669"), flag="🇮🇹", capital="P-ROM"},
    {id="ESP", name="Spain", color=Color3.fromHex("#D97706"), flag="🇪🇸", capital="P-MAD"},
    {id="IRN", name="Iran", color=Color3.fromHex("#16A34A"), flag="🇮🇷", capital="P-THR"},
    {id="KOR", name="South Korea", color=Color3.fromHex("#0EA5E9"), flag="🇰🇷", capital="P-SEL"},
    {id="AUS", name="Australia", color=Color3.fromHex("#FACC15"), flag="🇦🇺", capital="P-CAN"},
    {id="CAN", name="Canada", color=Color3.fromHex("#EF4444"), flag="🇨🇦", capital="P-OTT"},
    {id="MEX", name="Mexico", color=Color3.fromHex("#22C55E"), flag="🇲🇽", capital="P-MEX"},
    {id="ZAF", name="South Africa", color=Color3.fromHex("#A3E635"), flag="🇿🇦", capital="P-PRE"},
}
-- быстрый индекс
local byId={} for _,c in ipairs(CountryData) do byId[c.id]=c end
CountryData.byId = byId
return CountryData
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000031">
          <Properties>
            <string name="Name">MapConfig</string>
            <ProtectedString name="Source"><![CDATA[local MapConfig = {
    Biomes = {
        {id="Plains", color=Color3.fromHex("#86EFAC"), height=1},
        {id="Forest", color=Color3.fromHex("#15803D"), height=2},
        {id="Mountain", color=Color3.fromHex("#78716C"), height=8},
