        <Item class="ModuleScript" referent="RBX00000032">
          <Properties>
            <string name="Name">ProvinceData</string>
            <ProtectedString name="Source"><![CDATA[-- Процедурная генерация ~120 провинций вокруг стран
local CountryData = require(script.Parent.CountryData)
local ProvinceData = {}
local provinces = {}
local idCounter=0
local function add(name:string, owner:string, pop:number, econ:number, pos:Vector3)
    idCounter+=1
    local id = string.format("P-%03d", idCounter)
    if owner=="CAP" then owner = CountryData[1].id end
    provinces[id] = {id=id, name=name, owner=owner, population=pop, economy=econ, infrastructure=math.random(40,90), stability=math.random(60,95), buildings={}, army={}, pos=pos}
    -- также сохраняем для простоты связь с визуальной позицией
end
-- Столицы
for i,c in ipairs(CountryData) do
    if type(c)=="table" and c.id and not c.id:find("byId") then
        add(c.name.." Capital", c.id, math.random(800000,5000000), math.random(800,2500), Vector3.new(math.random(-1100,1100), 0.5, math.random(-600,600)))
    end
end
-- Дополнительные провинции (по 5 на страну примерно)
for i=1,80 do
    local c = CountryData[math.random(1,20)]
    add(c.name.." Region "..i, c.id, math.random(200000,2000000), math.random(300,1500), Vector3.new(math.random(-1100,1100),0.2, math.random(-600,600)))
end
ProvinceData.list = provinces
function ProvinceData.get(id:string) return provinces[id] end
function ProvinceData.all():{{any}} local t={} for _,v in pairs(provinces) do table.insert(t,v) end return t end
return ProvinceData
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000033">
          <Properties>
            <string name="Name">Types</string>
            <ProtectedString name="Source"><![CDATA[export type CountryId = string
export type ProvinceId = string

export type Resources = {
    Oil:number, Gas:number, Coal:number, Iron:number, Copper:number, Gold:number,
    Uranium:number, Lithium:number, Wood:number, Stone:number, Food:number, Water:number
}

export type Economy = {
    gdp:number, budget:number, income:number, expenses:number,
    taxes:number, inflation:number, debt:number, unemployment:number,
    tradeBalance:number, livingStandard:number
}

export type Country = {
    id: CountryId,
    name:string,
    color: Color3,
    flag: string,
    capital: ProvinceId,
    provinces: {ProvinceId},
    economy: Economy,
    resources: Resources,
    tech: {[string]: number},
    relations: {[CountryId]: number}, -- -100..100
    isAI: boolean,
    behavior: string,
}

export type Province = {
    id: ProvinceId,
    name: string,
    owner: CountryId,
    population: number,
    economy: number,
    infrastructure: number,
    stability: number,
    buildings: {string},
    army: {string},
    pos: Vector3,
}

export type War = {
    id: string,
    attackers: {CountryId},
    defenders: {CountryId},
    startTime: number,
    battles: number,
}

export type Alliance = {
    id: string,
    name: string,
    color: Color3,
    leader: CountryId,
    members: {CountryId},
}

export type PlayerProfile = {
    coins: number,
    xp: number,
    level: number,
    wins: number,
    losses: number,
    playTime: number,
    ownedSkins: {string},
    achievements: {string},
    tutorialDone: boolean,
    settings: {[string]: any},
}

return {}
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000034">
          <Properties>
            <string name="Name">Util</string>
            <ProtectedString name="Source"><![CDATA[local Util = {}
function Util.clamp(v:number, a:number,b:number) return math.clamp(v,a,b) end
function Util.lerp(a:number,b:number,t:number) return a + (b-a)*t end
function Util.formatMoney(n:number):string
    if n>=1e9 then return string.format("%.1fB", n/1e9)
    elseif n>=1e6 then return string.format("%.1fM", n/1e6)
    elseif n>=1e3 then return string.format("%.1fK", n/1e3)
    else return tostring(math.floor(n)) end
end
function Util.deepCopy(t:any):any
    if type(t)~="table" then return t end
    local c={} for k,v in pairs(t) do c[k]=Util.deepCopy(v) end return c
end
function Util.uuid():string
    return string.format("%08x-%04x", math.random(0,0x7fffffff), math.random(0,0xffff))
end
function Util.colorToHex(c:Color3):string
    return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end
return Util
]]></ProtectedString>
          </Properties>
        </Item>
