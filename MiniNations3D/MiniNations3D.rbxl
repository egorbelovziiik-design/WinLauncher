        </Properties>
        <Item class="ModuleScript" referent="RBX00000036">
          <Properties>
            <string name="Name">AIService</string>
            <ProtectedString name="Source"><![CDATA[local AIService = {}
local CountryData = require(game.ReplicatedStorage.Shared.CountryData)
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local EconomyService = require(script.Parent.EconomyService)
local MilitaryService = require(script.Parent.MilitaryService)
local DiplomacyService = require(script.Parent.DiplomacyService)
local BuildingService = require(script.Parent.BuildingService)

local running=false
local difficulty="Normal"
local aggression=0.6

function AIService.configure(opts:{difficulty:string?, aggression:number?})
    if opts.difficulty then difficulty=opts.difficulty end
    if opts.aggression then aggression=opts.aggression end
end

function AIService.start()
    if running then return end; running=true
    task.spawn(function()
        while running do task.wait(8)
            for _,c in ipairs(CountryData) do if type(c)=="table" and c.id then
                local role = c.id==CountryData[2].id and "Aggressive" or (math.random()<0.5 and "Economic" or "Defensive")
                -- экономика: строить случайное здание
                if math.random() < 0.45 then
                    local provs={} for _,p in pairs(ProvinceData.list) do if p.owner==c.id then table.insert(provs,p) end end
                    if #provs>0 then
                        local p = provs[math.random(1,#provs)]
                        local picks={"House","Shop","CoalPlant","MilitaryFactory","Barracks","Road"}
                        local b = picks[math.random(1,#picks)]
                        local fakePl = {UserId=0} :: any
                        pcall(function() BuildingService.build(fakePl :: any, p.id, b) end)
                    end
                end
                -- военный найм
                if math.random() < 0.25 + aggression*0.2 then
                    local provs={} for _,p in pairs(ProvinceData.list) do if p.owner==c.id then table.insert(provs,p) end end
                    if #provs>0 then
                        local p = provs[math.random(1,#provs)]
                        local units={"Infantry","Tank","Artillery","Recon"}
                        pcall(function() MilitaryService.create({UserId=0}::any, p.id, units[math.random(1,#units)], c.id) end)
                    end
                end
                -- дипломатия
                if math.random() < 0.15 then
                    local other = CountryData[math.random(1,20)]
                    if type(other)=="table" and other.id~=c.id then
                        DiplomacyService.change(c.id, other.id, math.random(-6,10))
                    end
                end
            end end
        end
    end)
    -- войны AI vs AI иногда
    task.spawn(function()
        while running do task.wait(22)
            if math.random() < aggression*0.35 then
                local a = CountryData[math.random(1,20)]; local d=CountryData[math.random(1,20)]
                if type(a)=="table" and type(d)=="table" and a.id~=d.id then
                    local WarService = require(script.Parent.WarService)
                    local id = WarService.declare(a.id, d.id)
                    -- через 10 сек попытка битвы
                    task.delay(10, function()
                        local provs={} for _,p in pairs(ProvinceData.list) do if p.owner==d.id then table.insert(provs,p) end end
                        if #provs>0 and warsStillExist(id) then
                            WarService.battle(id, a.id, d.id, provs[math.random(1,#provs)].id)
                        end
                    end)
                end
            end
        end
    end)
end
function warsStillExist(id:string)
    local WarService = require(script.Parent.WarService)
    return WarService.list()[id] ~= nil
end
function AIService.stop() running=false end
return AIService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000037">
          <Properties>
            <string name="Name">AchievementService</string>
            <ProtectedString name="Source"><![CDATA[local AchievementService = {}
local CoinService = require(script.Parent.CoinService)
local defs = {
    first_win={name="Первая победа", desc="Выиграй свой первый матч", reward=200},
    first_war={name="Первая война", desc="Объяви войну", reward=100},
    first_alliance={name="Первый альянс", desc="Создай альянс", reward=150},
    first_power={name="Первая электростанция", desc="Построй электростанцию", reward=120},
    first_city={name="Первый город", desc="Оснуй поселение", reward=100},
    superpower={name="Экономическая сверхдержава", desc="Достигни ВВП 10k", reward=500},
    domination={name="Мировое господство", desc="Захвати 60 провинций", reward=1000},
    diplomat={name="Великий дипломат", desc="5 альянсов", reward=400},
    builder={name="Великий строитель", desc="100 зданий", reward=350},
    techleader={name="Технологический лидер", desc="Открой 10 технологий", reward=300},
}
function AchievementService.unlock(player:Player, id:string)
    local def = defs[id]; if not def then return end
    local p = CoinService.ensure(player)
    if table.find(p.achievements, id) then return end
    table.insert(p.achievements, id)
    CoinService.addCoins(player, def.reward, "Achievement:"..id)
    CoinService.addXP(player, 100)
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("AchievementUnlocked")
    if rem then rem:FireClient(player, id, def) end
end
function AchievementService.list() return defs end
return AchievementService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000038">
          <Properties>
            <string name="Name">AllianceService</string>
            <ProtectedString name="Source"><![CDATA[local AllianceService = {}
local alliances: {[string]: any} = {}
function AllianceService.create(name:string, color:Color3, leader:string)
    local id="AL_"..tostring(math.random(10000,99999))
    local al={id=id, name=name, color=color, leader=leader, members={leader}}
    alliances[id]=al
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("AllianceCreated")
    if rem then rem:FireAllClients(al) end
    return al
end
function AllianceService.invite(allianceId:string, countryId:string)
    local al=alliances[allianceId]; if not al then return false end
    if not table.find(al.members, countryId) then table.insert(al.members, countryId) end
    return true
end
function AllianceService.leave(allianceId:string, countryId:string)
    local al=alliances[allianceId]; if not al then return false end
    for i,v in ipairs(al.members) do if v==countryId then table.remove(al.members,i) break end end
    if #al.members==0 then alliances[allianceId]=nil end
    return true
end
function AllianceService.list() return alliances end
return AllianceService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000039">
          <Properties>
            <string name="Name">BuildingService</string>
            <ProtectedString name="Source"><![CDATA[local BuildingService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local EconomyService = require(script.Parent.EconomyService)
local Costs = {
    House=120, Apartment=400, Skyscraper=1500, Shop=300, Mall=900, Office=700,
    CityHall=1200, School=500, Hospital=800, Park=200, Stadium=1400,
    CoalPlant=2000, Solar=1800, Wind=1600, Nuclear=5000,
    MilitaryFactory=2500, Barracks=1800, Airbase=3200, Port=2800,
    Road=150, Railway=400, Bridge=900,
}
function BuildingService.canBuild(player:Player, provinceId:string, building:string): (boolean,string)
    local prov = ProvinceData.get(provinceId)
    if not prov then return false, "No province" end
    local eco = EconomyService.get(prov.owner)
    if eco and eco.budget < (Costs[building] or 500) then return false, "Not enough budget" end
    if #prov.buildings >= 12 then return false, "Province full" end
    return true, ""
end
function BuildingService.build(player:Player, provinceId:string, building:string)
    local ok,msg = BuildingService.canBuild(player, provinceId, building)
    if not ok then return false, msg end
    local prov = ProvinceData.get(provinceId)
    local eco = EconomyService.get(prov.owner)
    eco.budget -= (Costs[building] or 500)
    table.insert(prov.buildings, building)
    -- добавить экономику/энергию
    if building:find("Plant") or building=="Solar" or building=="Nuclear" then prov.economy += 60 else prov.economy += 20 end
    prov.stability = math.clamp(prov.stability+1, 0, 100)
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("BuildingPlaced")
    if rem then rem:FireAllClients(provinceId, building, prov.pos) end
    return true, "Built"
end
function BuildingService.listCosts() return Costs end
return BuildingService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003A">
          <Properties>
            <string name="Name">CityService</string>
            <ProtectedString name="Source"><![CDATA[local CityService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
function CityService.found(player:Player, provinceId:string, cityName:string)
    local p=ProvinceData.get(provinceId)
    if not p then return false end
    if p.buildings[1]=="CityCenter" then return false, "Already city" end
    table.insert(p.buildings, 1, "CityCenter")
    p.population += math.random(5000,20000)
    local rem=game.ReplicatedStorage.Remotes:FindFirstChild("CityFounded")
    if rem then rem:FireAllClients(provinceId, cityName) end
    return true
end
return CityService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003B">
          <Properties>
            <string name="Name">CoinService</string>
            <ProtectedString name="Source"><![CDATA[local CoinService = {}
local profiles: {[number]: any} = {}
local Config = require(game.ReplicatedStorage.Shared.Config)

function CoinService.getProfile(player:Player) return profiles[player.UserId] end
function CoinService.ensure(player:Player)
    if not profiles[player.UserId] then
        profiles[player.UserId] = {coins=500, xp=0, level=1, wins=0, losses=0, playTime=0, ownedSkins={}, achievements={}, tutorialDone=false, settings={music=0.7,sfx=0.8,graphics="Medium"}}
    end
    return profiles[player.UserId]
end
function CoinService.addCoins(player:Player, amount:number, reason:string?)
    local p = CoinService.ensure(player)
    p.coins += amount
    if game.ReplicatedStorage:FindFirstChild("Remotes") then
        local r = game.ReplicatedStorage.Remotes:FindFirstChild("CoinsUpdated")
        if r then r:FireClient(player, p.coins, amount, reason or "") end
    end
    return p.coins
end
function CoinService.spend(player:Player, amount:number):boolean
    local p = CoinService.ensure(player)
    if p.coins < amount then return false end
    p.coins -= amount
    return true
end
function CoinService.addXP(player:Player, xp:number)
    local p = CoinService.ensure(player)
    p.xp += xp
    local need = p.level*500
    if p.xp >= need then p.level+=1; p.xp-=need; CoinService.addCoins(player, Config.COINS_REWARDS.LevelUp, "LevelUp") end
end
return CoinService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003C">
          <Properties>
            <string name="Name">CountryService</string>
            <ProtectedString name="Source"><![CDATA[local CountryService = {}
local CountryData = require(game.ReplicatedStorage.Shared.CountryData)
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local EconomyService = require(script.Parent.EconomyService)

function CountryService.get(id:string)
    return CountryData.byId[id], EconomyService.get(id)
end
function CountryService.list()
    local t={} for _,c in ipairs(CountryData) do if type(c)=="table" and c.id then table.insert(t,c) end end return t
end
function CountryService.provincesOf(countryId:string)
    local t={} for _,p in pairs(ProvinceData.list) do if p.owner==countryId then table.insert(t,p) end end return t
end
function CountryService.transferProvince(provId:string, newOwner:string)
    local p = ProvinceData.get(provId)
    if not p then return false end
    p.owner = newOwner
    -- огонь Remote для обновления цвета границ
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("ProvinceOwnerChanged")
    if rem then rem:FireAllClients(provId, newOwner) end
    return true
end
return CountryService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003D">
          <Properties>
            <string name="Name">DiplomacyService</string>
            <ProtectedString name="Source"><![CDATA[local DiplomacyService = {}
local CountryData = require(game.ReplicatedStorage.Shared.CountryData)
local relations: {[string]: {[string]: number}} = {}
function DiplomacyService.init()
    for _,a in ipairs(CountryData) do if type(a)=="table" and a.id then
        relations[a.id]=relations[a.id] or {}
        for _,b in ipairs(CountryData) do if type(b)=="table" and b.id and a.id~=b.id then relations[a.id][b.id]=math.random(-20,40) end end
    end end
end
function DiplomacyService.get(a:string,b:string) return relations[a] and relations[a][b] or 0 end
function DiplomacyService.change(a:string,b:string, delta:number)
    if not relations[a] then return end
    relations[a][b]=math.clamp((relations[a][b] or 0)+delta, -100,100)
    relations[b][a]=math.clamp((relations[b][a] or 0)+delta*0.8, -100,100)
    local rem=game.ReplicatedStorage.Remotes:FindFirstChild("RelationChanged")
    if rem then rem:FireAllClients(a,b, relations[a][b]) end
end
function DiplomacyService.proposeAlliance(a:string,b:string):boolean
    if DiplomacyService.get(a,b) < 20 then return false end
    DiplomacyService.change(a,b, 10)
    return true
end
function DiplomacyService.sanction(a:string,b:string)
    DiplomacyService.change(a,b, -18)
    local eco = require(script.Parent.EconomyService)
    eco.applySanctions(a,b)
end
function DiplomacyService.all() return relations end
return DiplomacyService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003E">
          <Properties>
            <string name="Name">EconomyService</string>
            <ProtectedString name="Source"><![CDATA[local EconomyService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local CountryData = require(game.ReplicatedStorage.Shared.CountryData)
local Util = require(game.ReplicatedStorage.Shared.Util)

local state: {[string]: any} = {} -- countryId -> economy

function EconomyService.init()
    for _,c in ipairs(CountryData) do
        if type(c)=="table" and c.id then
            state[c.id] = {
                gdp=math.random(800,9000), budget=5000, income=0, expenses=0,
                taxes=0.22, inflation=math.random(10,40)/10, debt=math.random(0,3000),
                unemployment=math.random(40,120)/10, tradeBalance=0, livingStandard=math.random(50,85)
            }
        end
    end
    task.spawn(function()
        while true do task.wait(5)
            for id,eco in pairs(state) do
                -- доход от провинций + налоги
                local provIncome=0
                for _,p in pairs(ProvinceData.list) do if p.owner==id then provIncome+= p.economy*0.8 + p.population/10000 end end
                eco.income = provIncome + math.random(80,200)
                eco.expenses = 400 + #ecoDebtBuildings(id)*18 + eco.debt*0.02
                local net = eco.income - eco.expenses
                eco.budget += net
                eco.gdp = Util.lerp(eco.gdp, provIncome*1.4, 0.06)
                eco.inflation = Util.clamp(eco.inflation + (math.random()-0.5)*0.05, -1, 12)
                if math.random() < 0.02 then -- кризис
                    eco.budget -= math.random(500,1500)
                    eco.unemployment += math.random(5,15)/10
                end
            end
        end
    end)
end
function ecoDebtBuildings(cid:string)
    local t={} for _,p in pairs(ProvinceData.list) do if p.owner==cid then for _,b in ipairs(p.buildings) do table.insert(t,b) end end end return t
end
function EconomyService.get(id:string) return state[id] end
function EconomyService.all() return state end
function EconomyService.applySanctions(from:string, to:string)
    local e = state[to]; if e then e.income -= 200; e.tradeBalance-=150 end
end
return EconomyService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000003F">
          <Properties>
            <string name="Name">GameService</string>
            <ProtectedString name="Source"><![CDATA[local GameService = {}
local ScenarioService = require(script.Parent.ScenarioService)
local AIService = require(script.Parent.AIService)
local SaveService = require(script.Parent.SaveService)

local matches: {[string]: any} = {}

function GameService.createMatch(host:Player, cfg:any)
    local id = "M_"..tostring(math.random(100000,999999))
    matches[id]={id=id, host=host, config=cfg, players={[host.UserId]=host}, ready={}, started=false}
    return matches[id]
end
function GameService.joinMatch(player:Player, matchId:string)
    local m=matches[matchId]; if not m then return false, "No match" end
    if m.started then return false, "Started" end
    m.players[player.UserId]=player; return true, m
end
function GameService.setReady(matchId:string, player:Player, ready:boolean)
    local m=matches[matchId]; if m then m.ready[player.UserId]=ready end
end
function GameService.start(matchId:string)
    local m=matches[matchId]; if not m or m.started then return false end
    if next(m.ready)==nil then return false end
    m.started=true
    -- инициализация сценария года
    ScenarioService.applyYear(m.config.year or 2026)
    AIService.configure({difficulty=m.config.difficulty or "Normal", aggression=m.config.aggression or 0.6})
    AIService.start()
    for _,pl in pairs(m.players) do
        local rem=game.ReplicatedStorage.Remotes:FindFirstChild("MatchStarted")
        if rem then rem:FireClient(pl, m) end
    end
    return true
end
function GameService.list() return matches end
return GameService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000040">
          <Properties>
            <string name="Name">MapEditorService</string>
            <ProtectedString name="Source"><![CDATA[local MapEditorService = {}
local DSS = game:GetService("DataStoreService")
local store
pcall(function() store=DSS:GetDataStore("MiniNations_Maps_v1") end)
local cache: {[string]: any} = {}

function MapEditorService.save(player:Player, mapName:string, data:any): boolean
    -- защита: лимит размера ~4MB, проверяем JSON длину
    local ok, json = pcall(function() return game:GetService("HttpService"):JSONEncode(data) end)
    if not ok then return false end
    if #json > 3800000 then return false end -- резерв под ключ
    -- простая фильтрация контента: запрещаем слова
    local lower=json:lower()
    if lower:find("badword") then return false end
    cache[mapName]=data
    if store then pcall(function() store:SetAsync("map_"..player.UserId.."_"..mapName, data) end) end
    local rem=game.ReplicatedStorage.Remotes:FindFirstChild("MapSaved")
    if rem then rem:FireClient(player, mapName) end
    return true
end
function MapEditorService.load(player:Player, mapName:string)
    if cache[mapName] then return cache[mapName] end
    if store then
        local ok,res=pcall(function() return store:GetAsync("map_"..player.UserId.."_"..mapName) end)
        if ok and res then cache[mapName]=res; return res end
    end
    return nil
end
function MapEditorService.list(player:Player): {string}
    local keys={} for k,_ in pairs(cache) do table.insert(keys,k) end return keys
end
return MapEditorService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000041">
          <Properties>
            <string name="Name">MilitaryService</string>
            <ProtectedString name="Source"><![CDATA[local MilitaryService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local Config = require(game.ReplicatedStorage.Shared.Config)
local unitCost = {Infantry=120, Motorized=250, Tank=600, Artillery=500, AA=450, Aviation=900, Helicopter=850, Navy=1200, Recon=200}

local armies: {[string]: any} = {} -- id -> army
local byProvince: {[string]: {string}} = {}

function MilitaryService.create(player:Player, provinceId:string, unitType:string, countryId:string?)
    local prov = ProvinceData.get(provinceId)
    if not prov then return false, "Bad province" end
    if not table.find(Config.UNITS, unitType) then return false, "Bad unit" end
    local cost = unitCost[unitType] or 300
    -- budget check skipped for demo, but would call EconomyService
    local id = "ARMY_"..tostring(math.random(100000,999999))
    local army = {id=id, type=unitType, owner=countryId or prov.owner, province=provinceId, hp=100, morale=80, pos=prov.pos}
    armies[id]=army
    byProvince[provinceId]=byProvince[provinceId] or {}; table.insert(byProvince[provinceId], id)
    table.insert(prov.army, id)
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("ArmyCreated")
    if rem then rem:FireAllClients(army) end
    -- создать 3D модель в Workspace
    MilitaryService.spawnModel(army)
    return true, id
end

function MilitaryService.move(armyId:string, toProvinceId:string)
    local army = armies[armyId]; if not army then return false end
    local toProv = ProvinceData.get(toProvinceId); if not toProv then return false end
    local fromProv = ProvinceData.get(army.province)
    if fromProv then
        -- удалить из старой
        for i,v in ipairs(fromProv.army) do if v==armyId then table.remove(fromProv.army,i) break end end
    end
    army.province = toProvinceId; army.pos = toProv.pos
    table.insert(toProv.army, armyId)
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("ArmyMoved")
    if rem then rem:FireAllClients(armyId, toProvinceId, toProv.pos) end
    -- tween модели
    local mdl = workspace:FindFirstChild("Armies") and workspace.Armies:FindFirstChild(armyId)
    if mdl then
        game:GetService("TweenService"):Create(mdl.PrimaryPart, TweenInfo.new(1.2, Enum.EasingStyle.Quad), {Position = toProv.pos + Vector3.new(0,2,0)}):Play()
    end
    return true
end

function MilitaryService.spawnModel(army:any)
    local folder = workspace:FindFirstChild("Armies")
    if not folder then folder=Instance.new("Folder"); folder.Name="Armies"; folder.Parent=workspace end
    local part = Instance.new("Part")
    part.Name=army.id; part.Size=Vector3.new(4,2.5,6); part.Anchored=true; part.CanCollide=false
    part.Position = army.pos + Vector3.new(math.random(-6,6),2, math.random(-6,6))
    part.Color = Color3.fromHex("#FACC15"); part.Material=Enum.Material.SmoothPlastic
    part.Parent=folder
    local hum = Instance.new("BillboardGui"); hum.Size=UDim2.fromOffset(80,18); hum.StudsOffset=Vector3.new(0,3,0); hum.Parent=part
    local tl = Instance.new("TextLabel"); tl.Size=UDim2.fromScale(1,1); tl.BackgroundTransparency=0.3; tl.BackgroundColor3=Color3.fromHex("#0F172A"); tl.TextColor3=Color3.new(1,1,1); tl.TextScaled=true; tl.Text=army.type; tl.Parent=hum
end

function MilitaryService.get(armyId:string) return armies[armyId] end
function MilitaryService.all() return armies end
function MilitaryService.inProvince(pid:string) return byProvince[pid] or {} end
return MilitaryService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000042">
          <Properties>
            <string name="Name">PowerService</string>
            <ProtectedString name="Source"><![CDATA[local PowerService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local power: {[string]: {produced:number, consumed:number}} = {}

function PowerService.tick()
    task.spawn(function()
        while true do task.wait(6)
            for cid,_ in pairs(power) do power[cid]={produced=0, consumed=0} end
            for _,p in pairs(ProvinceData.list) do
                local pw = power[p.owner]; if not pw then pw={produced=0,consumed=0}; power[p.owner]=pw end
                for _,b in ipairs(p.buildings) do
                    if b=="CoalPlant" then pw.produced+=120 elseif b=="Nuclear" then pw.produced+=400 elseif b=="Solar" then pw.produced+=60 elseif b=="Wind" then pw.produced+=50
                    else pw.consumed+=8 end
                end
            end
        end
    end)
end
function PowerService.get(owner:string) return power[owner] or {produced=0,consumed=0} end
function PowerService.balance(owner:string) local g=PowerService.get(owner) return g.produced - g.consumed end
return PowerService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000043">
          <Properties>
            <string name="Name">ProvinceService</string>
            <ProtectedString name="Source"><![CDATA[local ProvinceService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
function ProvinceService.get(id:string) return ProvinceData.get(id) end
function ProvinceService.byOwner(owner:string)
    local t={} for _,p in pairs(ProvinceData.list) do if p.owner==owner then table.insert(t,p) end end return t
end
function ProvinceService.info(id:string)
    local p=ProvinceData.get(id)
    if not p then return nil end
    return {id=p.id, name=p.name, owner=p.owner, population=p.population, economy=p.economy, infrastructure=p.infrastructure, stability=p.stability, buildings=p.buildings, army=p.army, pos=p.pos}
end
return ProvinceService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000044">
          <Properties>
            <string name="Name">QuestService</string>
            <ProtectedString name="Source"><![CDATA[local QuestService = {}
local CoinService = require(script.Parent.CoinService)
local daily = {
    {id="build5", text="Построй 5 зданий", target=5, reward=50},
    {id="army1", text="Создай одну армию", target=1, reward=50},
    {id="trade1", text="Заключи торговый договор", target=1, reward=70},
    {id="tech1", text="Исследуй технологию", target=1, reward=60},
    {id="match1", text="Сыграй один матч", target=1, reward=80},
}
local weekly = {
    {id="w_build20", text="Построй 20 зданий", target=20, reward=300},
    {id="w_win3", text="Выиграй 3 матча", target=3, reward=400},
}
local progress: {[number]: {[string]: number}} = {}
function QuestService.getDaily(player:Player) return daily end
function QuestService.getProgress(player:Player, questId:string):number
    return progress[player.UserId] and progress[player.UserId][questId] or 0
end
function QuestService.add(player:Player, questId:string, amount:number)
    progress[player.UserId]=progress[player.UserId] or {}
    progress[player.UserId][questId]=(progress[player.UserId][questId] or 0)+amount
    -- check complete
    for _,q in ipairs(daily) do if q.id==questId and progress[player.UserId][questId]>=q.target then CoinService.addCoins(player, q.reward, "Daily") end end
    for _,q in ipairs(weekly) do if q.id==questId and progress[player.UserId][questId]>=q.target then CoinService.addCoins(player, q.reward, "Weekly") end end
end
return QuestService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000045">
          <Properties>
            <string name="Name">ResourceService</string>
            <ProtectedString name="Source"><![CDATA[local ResourceService = {}
local Config = require(game.ReplicatedStorage.Shared.Config)
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local stocks: {[string]: {[string]: number}} = {} -- country -> resource -> amount

function ResourceService.init()
    for _,p in pairs(ProvinceData.list) do
        if not stocks[p.owner] then stocks[p.owner]={} for _,r in ipairs(Config.RESOURCES) do stocks[p.owner][r]=math.random(200,1200) end end
    end
    task.spawn(function()
        while true do task.wait(7)
            for cid, store in pairs(stocks) do
                store.Oil  += math.random(0,2)
                store.Food += math.random(2,6)
                store.Coal += math.random(0,3)
                -- потребление
                for k,_ in pairs(store) do store[k] = math.max(0, store[k] - math.random(0,1)) end
            end
        end
    end)
end
function ResourceService.get(cid:string) return stocks[cid] end
function ResourceService.trade(from:string, to:string, res:string, amount:number)
    local a=stocks[from]; local b=stocks[to]
    if not a or not b then return false end
    if (a[res] or 0) < amount then return false end
    a[res]-=amount; b[res]=(b[res] or 0)+amount; return true
end
return ResourceService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000046">
          <Properties>
            <string name="Name">SaveService</string>
            <ProtectedString name="Source"><![CDATA[local SaveService = {}
local DSS = game:GetService("DataStoreService")
local CoinService = require(script.Parent.CoinService)
local profileStore
pcall(function() profileStore = DSS:GetDataStore("MiniNations_Profiles_v1") end)

local cache: {[number]: any} = {}
local autosaveInterval = 60

function SaveService.load(player:Player)
    local data
    if profileStore then
        local ok, res = pcall(function() return profileStore:GetAsync("p_"..player.UserId) end)
        if ok and res then data=res end
    end
    if data then
        cache[player.UserId]=data
        -- hydrate CoinService
        local c = CoinService.ensure(player)
        for k,v in pairs(data) do c[k]=v end
    else
        cache[player.UserId]=CoinService.ensure(player)
    end
    return cache[player.UserId]
end

function SaveService.save(player:Player)
    local p = CoinService.getProfile(player) or cache[player.UserId]
    if not p or not profileStore then return end
    pcall(function() profileStore:SetAsync("p_"..player.UserId, p) end)
    -- отдельный ключ для мультиплеерных сессий
    pcall(function()
        local ms = DSS:GetDataStore("MiniNations_Sessions_v1")
        if p.lastSession then ms:SetAsync("s_"..player.UserId.."_"..os.time(), p.lastSession) end
    end)
end

function SaveService.startAutosave()
    task.spawn(function()
        while true do task.wait(autosaveInterval)
            for _,pl in ipairs(game.Players:GetPlayers()) do SaveService.save(pl) end
        end
    end)
    game.Players.PlayerRemoving:Connect(function(pl) SaveService.save(pl); cache[pl.UserId]=nil end)
    game:BindToClose(function()
        for _,pl in ipairs(game.Players:GetPlayers()) do SaveService.save(pl) end
        task.wait(2)
    end)
end
return SaveService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000047">
          <Properties>
            <string name="Name">ScenarioService</string>
            <ProtectedString name="Source"><![CDATA[local ScenarioService = {}
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
-- исторические модификаторы по году
local yearMods: {[number]: any} = {
    [1444]={popMul=0.35, econMul=0.4, tech="Feudal"},
    [1914]={popMul=0.8, econMul=0.9, tech="Industrial"},
    [1945]={popMul=0.85, econMul=1.0, tech="WW2"},
    [2026]={popMul=1.0, econMul=1.0, tech="Modern"},
    [2050]={popMul=1.1, econMul=1.3, tech="Future"},
}
function ScenarioService.applyYear(year:number)
    local mod = yearMods[year] or yearMods[2026]
    -- масштабируем провинции
    for _,p in pairs(ProvinceData.list) do
        p.population = math.floor(p.population * mod.popMul)
        p.economy = math.floor(p.economy * mod.econMul)
    end
    print("[Scenario] Applied year "..year.." mod "..mod.tech)
end
return ScenarioService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000048">
          <Properties>
            <string name="Name">ShopService</string>
            <ProtectedString name="Source"><![CDATA[local ShopService = {}
local catalog = {
    {id="gold_borders", name="Золотые границы", price=400, cat="Country", preview="#FFD700"},
    {id="neon_borders", name="Неоновые границы", price=600, cat="Country", preview="#39FF14"},
    {id="diamond_borders", name="Алмазные границы", price=1200, cat="Country", preview="#00FFFF"},
    {id="modern_city", name="Современный город", price=800, cat="City", preview="#60A5FA"},
    {id="cyber_city", name="Киберпанк город", price=1500, cat="City", preview="#FF00FF"},
    {id="gold_tank", name="Золотые танки", price=700, cat="Army", preview="#FFD700"},
    {id="future_army", name="Футуристическая армия", price=1100, cat="Army", preview="#00FFFF"},
    {id="music_menu2", name="Саундтрек Меню 2", price=300, cat="Music", preview="#A78BFA"},
    {id="music_war", name="Боевой саундтрек", price=500, cat="Music", preview="#EF4444"},
    {id="ui_neon", name="Неоновая тема", price=450, cat="UI", preview="#39FF14"},
    {id="flag_goldframe", name="Золотая рамка флага", price=350, cat="Flag", preview="#FFD700"},
}
local CoinService = require(script.Parent.CoinService)
function ShopService.catalog() return catalog end
function ShopService.buy(player:Player, itemId:string): (boolean,string)
    local item
    for _,it in ipairs(catalog) do if it.id==itemId then item=it break end end
    if not item then return false, "No item" end
    local profile = CoinService.ensure(player)
    if table.find(profile.ownedSkins, itemId) then return false, "Already owned" end
    if not CoinService.spend(player, item.price) then return false, "Not enough coins" end
    table.insert(profile.ownedSkins, itemId)
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("ShopPurchased")
    if rem then rem:FireClient(player, itemId) end
    return true, "Purchased"
end
return ShopService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000049">
          <Properties>
            <string name="Name">TechnologyService</string>
            <ProtectedString name="Source"><![CDATA[local TechnologyService = {}
local trees = {
    Economy={"Market","TradeHub","DigitalTax"},
    Industry={"Automation","Robotics","AdvancedMetallurgy"},
    Army={"ModernInfantry","CompositeArmor","Stealth"},
    Energy={"SmartGrid","FusionProto","Hydrogen"},
    Transport={"HighSpeedRail","Maglev","DronesLogistics"},
    Aviation={"JetEngine","Supersonic","UAV"},
    Navy={"Carrier","NuclearSub","Aegis"},
    Medicine={"Vaccine","Biotech","Longevity"},
    Space={"Satellite","MoonBase","MarsMission"},
}
local progress: {[string]: {[string]: number}} = {} -- country -> tech -> level

function TechnologyService.research(countryId:string, branch:string, tech:string)
    progress[countryId]=progress[countryId] or {}
    local key = branch..":"..tech
    progress[countryId][key]=(progress[countryId][key] or 0)+1
    if progress[countryId][key]==1 then
        -- бонус
        local rem=game.ReplicatedStorage.Remotes:FindFirstChild("TechUnlocked")
        if rem then rem:FireAllClients(countryId, branch, tech) end
    end
    return progress[countryId][key]
end
function TechnologyService.get(countryId:string) return progress[countryId] or {} end
function TechnologyService.trees() return trees end
return TechnologyService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000004A">
          <Properties>
            <string name="Name">WarService</string>
            <ProtectedString name="Source"><![CDATA[local WarService = {}
local CountryService = require(script.Parent.CountryService)
local ProvinceData = require(game.ReplicatedStorage.Shared.ProvinceData)
local wars: {[string]: any} = {}

function WarService.declare(att:string, def:string)
    local id = att.."vs"..def.."_"..os.time()
    wars[id]={id=id, attackers={att}, defenders={def}, startTime=os.time(), battles=0}
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("WarDeclared")
    if rem then rem:FireAllClients(id, att, def) end
    return id
end
function WarService.battle(warId:string, attacker:string, defender:string, provinceId:string)
    local war = wars[warId]; if not war then return false end
    war.battles+=1
    -- очень упрощённый бросок
    local atkPower = math.random(60,140) + #CountryService.provincesOf(attacker)*2
    local defPower = math.random(60,140) + #CountryService.provincesOf(defender)*2
    local attackerWins = atkPower > defPower
    if attackerWins then
        local p = ProvinceData.get(provinceId)
        if p and p.owner==defender then
            CountryService.transferProvince(provinceId, attacker)
        end
    end
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("BattleResult")
    if rem then rem:FireAllClients(warId, provinceId, attackerWins, atkPower, defPower) end
    return attackerWins
end
function WarService.peace(warId:string)
    local w=wars[warId]; if not w then return false end
    wars[warId]=nil
    local rem = game.ReplicatedStorage.Remotes:FindFirstChild("PeaceSigned")
    if rem then rem:FireAllClients(warId) end
    return true
end
function WarService.list() return wars end
return WarService
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="RBX0000004B">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Main.server — инициализация всех сервисов и RemoteEvents
print("🌍 Mini Nations 3D — Server starting...")

-- Создать папку Remotes
local RS = game:GetService("ReplicatedStorage")
local remotesFolder = RS:FindFirstChild("Remotes") or Instance.new("Folder")
remotesFolder.Name="Remotes"; remotesFolder.Parent=RS

local function remote(name:string, isFunc:boolean?)
    if remotesFolder:FindFirstChild(name) then return remotesFolder:FindFirstChild(name) end
    local r = isFunc and Instance.new("RemoteFunction") or Instance.new("RemoteEvent")
    r.Name=name; r.Parent=remotesFolder; return r
end

-- Все ремоуты
local events = {
    "RequestProfile","CoinsUpdated","ProvinceOwnerChanged","BuildingPlaced","ArmyCreated","ArmyMoved",
    "WarDeclared","BattleResult","PeaceSigned","RelationChanged","AllianceCreated","TechUnlocked",
    "ShopPurchased","AchievementUnlocked","MapSaved","CityFounded","MatchStarted","CoinsUpdated",
    "BuyItem","BuildRequest","MoveArmy","DeclareWar","MakePeace","CreateAlliance","ResearchTech",
    "JoinMatch","CreateMatch","StartMatch","SaveMap","LoadMap","SetReady","ToggleTutorial",
    "GetEconomy","GetResources","GetProvinces"
}
for _,e in ipairs(events) do remote(e,false) end
remote("GetProfile", true)

-- Rate limit
local rl: {[number]: {number}} = {}
local LIMIT = 8
game:GetService("RunService").Heartbeat:Connect(function()
    -- очистка окна
end)

local function checkLimit(pl:Player):boolean
    local now = tick()
    rl[pl.UserId]=rl[pl.UserId] or {}
    table.insert(rl[pl.UserId], now)
    -- оставить только последнюю секунду
    local t={} for _,v in ipairs(rl[pl.UserId]) do if now - v < 1 then table.insert(t,v) end end
    rl[pl.UserId]=t
    return #t <= LIMIT
end

-- Загрузить сервисы
local CoinService = require(script.Services.CoinService)
local SaveService = require(script.Services.SaveService)
local EconomyService = require(script.Services.EconomyService)
local ResourceService = require(script.Services.ResourceService)
local DiplomacyService = require(script.Services.DiplomacyService)
local PowerService = require(script.Services.PowerService)
local BuildingService = require(script.Services.BuildingService)
local MilitaryService = require(script.Services.MilitaryService)
local WarService = require(script.Services.WarService)
local AllianceService = require(script.Services.AllianceService)
local TechnologyService = require(script.Services.TechnologyService)
local ShopService = require(script.Services.ShopService)
local QuestService = require(script.Services.QuestService)
local AchievementService = require(script.Services.AchievementService)
local MapEditorService = require(script.Services.MapEditorService)
local GameService = require(script.Services.GameService)

EconomyService.init()
ResourceService.init()
DiplomacyService.init()
PowerService.tick()
SaveService.startAutosave()

-- Подключения
game.Players.PlayerAdded:Connect(function(pl)
    SaveService.load(pl)
    CoinService.ensure(pl)
    -- отдать профиль
    task.wait(1)
    local prof = CoinService.getProfile(pl)
    local rem = remotesFolder:FindFirstChild("RequestProfile")
    if rem then rem:FireClient(pl, prof) end
end)

-- RemoteFunction GetProfile
remotesFolder.GetProfile.OnServerInvoke = function(pl:Player)
    return CoinService.ensure(pl)
end

-- Build
remotesFolder.BuildRequest.OnServerEvent:Connect(function(pl:Player, provinceId:string, building:string)
    if not checkLimit(pl) then return end
    local ok,msg = BuildingService.build(pl, provinceId, building)
    if ok then
        QuestService.add(pl, "build5", 1)
        AchievementService.unlock(pl, "first_city")
    end
end)

remotesFolder.BuyItem.OnServerEvent:Connect(function(pl:Player, itemId:string)
    if not checkLimit(pl) then return end
    ShopService.buy(pl, itemId)
end)

remotesFolder.MoveArmy.OnServerEvent:Connect(function(pl:Player, armyId:string, toProv:string)
    if not checkLimit(pl) then return end
    MilitaryService.move(armyId, toProv)
end)

remotesFolder.DeclareWar.OnServerEvent:Connect(function(pl:Player, from:string, to:string)
    if not checkLimit(pl) then return end
    -- валидация: from должен принадлежать игроку (упрощено)
    WarService.declare(from,to)
    AchievementService.unlock(pl, "first_war")
    QuestService.add(pl,"match1",1)
end)

remotesFolder.MakePeace.OnServerEvent:Connect(function(pl:Player, warId:string)
    WarService.peace(warId)
end)

remotesFolder.CreateAlliance.OnServerEvent:Connect(function(pl:Player, name:string, color:Color3, leader:string)
    AllianceService.create(name,color,leader)
    AchievementService.unlock(pl,"first_alliance")
end)

remotesFolder.ResearchTech.OnServerEvent:Connect(function(pl:Player, countryId:string, branch:string, tech:string)
    TechnologyService.research(countryId, branch, tech)
    QuestService.add(pl,"tech1",1)
end)

-- Economy polling
remotesFolder.GetEconomy.OnServerEvent:Connect(function(pl:Player, countryId:string)
    local eco = EconomyService.get(countryId)
    remotesFolder.GetEconomy:FireClient(pl, eco)
end)

remotesFolder.CreateMatch.OnServerEvent:Connect(function(pl:Player, cfg:any)
    local m = GameService.createMatch(pl, cfg)
    remotesFolder.CreateMatch:FireClient(pl, m)
end)
remotesFolder.JoinMatch.OnServerEvent:Connect(function(pl:Player, matchId:string)
    GameService.joinMatch(pl, matchId)
end)
remotesFolder.StartMatch.OnServerEvent:Connect(function(pl:Player, matchId:string)
    GameService.start(matchId)
end)
remotesFolder.SaveMap.OnServerEvent:Connect(function(pl:Player, name:string, data:any)
    MapEditorService.save(pl,name,data)
end)

print("✅ Mini Nations 3D Server ready — "..#events.." remotes")
]]></ProtectedString>
