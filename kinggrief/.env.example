# ── KINGGRIEF ────────────────────────────────────────────────────────────────
# Публичный адрес сайта (для возврата после оплаты и вебхуков)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секрет для подписи сессий администратора (сгенерируйте: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Первый администратор (создаётся при инициализации пустой базы)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=KingGrief-2026

# ── Платёжный провайдер ──────────────────────────────────────────────────────
# mock  — тестовый режим без реальных списаний (по умолчанию)
# yookassa | robokassa — реальные платежи (нужны ключи ниже)
PAYMENT_PROVIDER=mock
PAYMENTS_TEST_MODE=true

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3

ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=true

# ── Minecraft bridge (Paper / Purpur / Spigot) ───────────────────────────────
# Тот же секрет указывается в config.yml плагина KingGriefBridge
MINECRAFT_BRIDGE_SECRET=change-me-bridge-secret
MINECRAFT_SERVER_ID=main

# Secure-cookie флаг. true/false — принудительно; по умолчанию включён в production.
# Для локального docker-compose по http укажите false.
COOKIE_SECURE=false

# ── Прочее ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/kinggrief.db

# Порт, который docker-compose публикует на хосте (внутри контейнера всегда 3000)
APP_PORT=3000
