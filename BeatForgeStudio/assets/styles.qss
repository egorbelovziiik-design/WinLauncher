/* =====================================================================
   BeatForge Studio — QSS тема (тёмная, Ableton/FL-подобная)
   Плейсхолдеры вида @TOKEN@ подставляются из ui/theme.py (dark, light, amoled).
   ===================================================================== */

* {
    outline: none;
}

QWidget {
    background-color: transparent;
    color: @TEXT@;
    font-family: "@FONT@", "Segoe UI", "Inter", sans-serif;
    font-size: 11pt;
    selection-background-color: @ACCENT@;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog {
    background-color: @BG@;
}

QToolTip {
    background-color: @PANEL_HI@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------------------------------------------------------------- панели */
QFrame#Sidebar {
    background-color: @PANEL@;
    border-right: 1px solid @BORDER@;
}

QFrame#Card, QWidget#Card {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QFrame#Card:hover {
    border: 1px solid @ACCENT_DIM@;
}

QFrame#Panel {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QFrame#Toolbar {
    background-color: @PANEL@;
    border-bottom: 1px solid @BORDER@;
}

QFrame#HLine {
    background-color: @BORDER@;
    max-height: 1px;
    border: none;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

/* ---------------------------------------------------------------- текст */
QLabel {
    background: transparent;
}

QLabel#H1 { font-size: 22pt; font-weight: 700; color: @TEXT@; }
QLabel#H2 { font-size: 15pt; font-weight: 600; color: @TEXT@; }
QLabel#H3 { font-size: 12pt; font-weight: 600; color: @TEXT@; }
QLabel#Muted { color: @TEXT_MUTED@; }
QLabel#Tiny { color: @TEXT_MUTED@; font-size: 9pt; }
QLabel#Accent { color: @ACCENT@; font-weight: 600; }
QLabel#Accent2 { color: @ACCENT2@; font-weight: 600; }
QLabel#Badge {
    background-color: @PANEL_HI@;
    color: @TEXT_MUTED@;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 9pt;
}

/* ---------------------------------------------------------------- кнопки */
QPushButton {
    background-color: @PANEL_HI@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: @HOVER@;
    border-color: @ACCENT_DIM@;
}

QPushButton:pressed {
    background-color: @PRESSED@;
}

QPushButton:disabled {
    color: @TEXT_DISABLED@;
    background-color: @PANEL@;
    border-color: @BORDER@;
}

QPushButton#Primary {
    background-color: @ACCENT@;
    color: #14100C;
    border: none;
    font-weight: 700;
}

QPushButton#Primary:hover { background-color: @ACCENT_HOVER@; }
QPushButton#Primary:pressed { background-color: @ACCENT_PRESSED@; }

QPushButton#Secondary {
    background-color: @ACCENT2@;
    color: #06161F;
    border: none;
    font-weight: 600;
}

QPushButton#Secondary:hover { background-color: @ACCENT2_HOVER@; }

QPushButton#Ghost {
    background: transparent;
    border: 1px solid @BORDER@;
}

QPushButton#Ghost:hover {
    background-color: @HOVER@;
}

QPushButton#ToolButton {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 2px 6px;
    min-height: 18px;
    color: @TEXT_MUTED@;
    font-size: 12pt;
}

QPushButton#ToolButton:hover {
    border-color: @ACCENT_DIM@;
    color: @TEXT@;
    background-color: @HOVER@;
}

QPushButton#ToolButton:checked {
    border-color: @ACCENT@;
    color: @ACCENT@;
}

QPushButton#Danger {
    background-color: transparent;
    border: 1px solid #B03A3A;
    color: #FF8A8A;
}

QPushButton#Danger:hover {
    background-color: #3A1A1A;
}

QPushButton#Chip {
    background-color: @PANEL_HI@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
    padding: 5px 14px;
    font-size: 10pt;
    color: @TEXT_MUTED@;
}

QPushButton#Chip:hover { border-color: @ACCENT_DIM@; color: @TEXT@; }

QPushButton#Chip:checked {
    background-color: @ACCENT_SOFT@;
    border: 1px solid @ACCENT@;
    color: @ACCENT@;
    font-weight: 600;
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#IconButton:hover { background-color: @HOVER@; }

QPushButton#Transport {
    background-color: @PANEL_HI@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 8px;
}

QPushButton#Transport:hover { background-color: @HOVER@; border-color: @ACCENT_DIM@; }

QPushButton#TransportPlay {
    background-color: @ACCENT@;
    border: none;
    border-radius: 22px;
    padding: 10px;
}

QPushButton#TransportPlay:hover { background-color: @ACCENT_HOVER@; }

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px;
    color: @TEXT_MUTED@;
}

QToolButton:hover { background-color: @HOVER@; color: @TEXT@; }
QToolButton:checked { color: @ACCENT@; background-color: @ACCENT_SOFT@; }

/* ---------------------------------------------------------------- ввод */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @INPUT@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: @ACCENT@;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid @ACCENT@;
}

QLineEdit#Search {
    padding: 11px 14px;
    font-size: 12pt;
    border-radius: 10px;
}

QLineEdit:disabled, QComboBox:disabled {
    color: @TEXT_DISABLED@;
    background-color: @PANEL@;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: @PANEL_HI@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    selection-background-color: @ACCENT_SOFT@;
    selection-color: @TEXT@;
    padding: 4px;
    outline: none;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    width: 14px;
    border: none;
}

/* ---------------------------------------------------------------- слайдеры */
QSlider::groove:horizontal {
    height: 5px;
    background: @INPUT@;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: @ACCENT@;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: @TEXT@;
}

QSlider::handle:horizontal:hover { background: #FFFFFF; }

QSlider::groove:vertical {
    width: 5px;
    background: @INPUT@;
    border-radius: 3px;
}

QSlider::sub-page:vertical { background: @INPUT@; border-radius: 3px; }
QSlider::add-page:vertical { background: @ACCENT@; border-radius: 3px; }

QSlider::handle:vertical {
    height: 14px;
    width: 14px;
    margin: 0 -5px;
    border-radius: 7px;
    background: @TEXT@;
}

/* ---------------------------------------------------------------- прогресс */
QProgressBar {
    background-color: @INPUT@;
    border: none;
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: @ACCENT@;
    border-radius: 6px;
}

QProgressBar#Thin { height: 4px; border-radius: 2px; }

/* ---------------------------------------------------------------- чекбоксы/радио */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: @TEXT@;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid @BORDER@;
    background: @INPUT@;
}

QRadioButton::indicator { border-radius: 8px; }

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: @ACCENT@;
    border: 1px solid @ACCENT@;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: @ACCENT_DIM@;
}

/* ---------------------------------------------------------------- табы и списки */
QTabWidget::pane {
    border: 1px solid @BORDER@;
    border-radius: 10px;
    background-color: @PANEL@;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: @TEXT_MUTED@;
    padding: 9px 18px;
    margin-right: 4px;
    border-radius: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: @ACCENT_SOFT@;
    color: @ACCENT@;
    font-weight: 600;
}

QTabBar::tab:hover:!selected { background: @HOVER@; color: @TEXT@; }

/* узкая панель медиабраузера: компактные вкладки без обрезки */
QTabWidget#MediaTabs::pane { border: none; }
QTabWidget#MediaTabs QTabBar { font-size: 9pt; }
QTabWidget#MediaTabs QTabBar::tab {
    padding: 6px 5px;
    margin-right: 2px;
    min-width: 0px;
}

QListWidget, QTreeWidget, QTableWidget {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    alternate-background-color: @PANEL_ALT@;
}

QListWidget::item, QTreeWidget::item {
    padding: 6px 8px;
    border-radius: 6px;
}

QListWidget::item:selected, QTreeWidget::item:selected,
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: @ACCENT_SOFT@;
    color: @TEXT@;
}

QHeaderView::section {
    background-color: @PANEL_HI@;
    color: @TEXT_MUTED@;
    border: none;
    padding: 6px;
    font-size: 9pt;
}

/* ---------------------------------------------------------------- скроллбары */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @SCROLL@;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover { background: @SCROLL_HOVER@; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: @SCROLL@;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover { background: @SCROLL_HOVER@; }

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
}

/* ---------------------------------------------------------------- меню */
QMenu {
    background-color: @PANEL_HI@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: @ACCENT_SOFT@;
    color: @TEXT@;
}

QMenu::separator {
    height: 1px;
    background: @BORDER@;
    margin: 4px 8px;
}

QMenuBar {
    background-color: @PANEL@;
    color: @TEXT_MUTED@;
}

QMenuBar::item { padding: 6px 12px; border-radius: 6px; }
QMenuBar::item:selected { background: @HOVER@; color: @TEXT@; }

/* ---------------------------------------------------------------- диалоги */
QDialog QWidget { background-color: @BG@; }
QDialog QFrame#Card, QDialog QWidget#Card { background-color: @PANEL@; }

QStatusBar {
    background-color: @PANEL@;
    color: @TEXT_MUTED@;
    border-top: 1px solid @BORDER@;
}

QSplitter::handle {
    background-color: @BORDER@;
}

QSplitter::handle:hover { background-color: @ACCENT_DIM@; }

/* ---------------------------------------------------------------- спец. виджеты */
QWidget#DropZone {
    background-color: @PANEL@;
    border: 2px dashed @BORDER@;
    border-radius: 12px;
}

QWidget#DropZone[dragActive="true"] {
    border: 2px dashed @ACCENT@;
    background-color: @ACCENT_SOFT@;
}

QFrame#Toast {
    background-color: @PANEL_HI@;
    border: 1px solid @BORDER@;
    border-left: 3px solid @ACCENT@;
    border-radius: 10px;
}

QLabel#ToastTitle { font-weight: 600; }
QLabel#ToastText { color: @TEXT_MUTED@; font-size: 10pt; }

QFrame#Timeline {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

QFrame#TrackHeader {
    background-color: @PANEL_HI@;
    border-radius: 8px;
}

QWidget#VideoPreview {
    background-color: #0A0A0A;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}
