<Window x:Class="StealAnEggUltimate.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StealAnEggUltimate"
        Title="StealAnEggUltimate Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" Width="1280" Height="720"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <local:RarityToBrushConverter x:Key="RarityBrush" />
        <local:HexToBrushConverter x:Key="HexBrush" />
        <local:ColorToBrushConverter x:Key="ColorBrush" />
        <local:NoticeKindToBrushConverter x:Key="NoticeBrush" />
        <local:MultiplyConverter x:Key="Scale22" />

        <Style x:Key="MenuTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E7FA8" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="Underline" Height="2" CornerRadius="1" Margin="8,0"
                                    Background="Transparent" VerticalAlignment="Bottom" />
                            <ContentPresenter Margin="10,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#E9DFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuToggleRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4EEFF" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter Margin="10,7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="MenuOpenStory">
            <DoubleAnimation Storyboard.TargetName="MenuRoot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="MenuTranslate" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.26" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleX" From="0.97" To="1" Duration="0:0:0.24" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleY" From="0.97" To="1" Duration="0:0:0.24" FillBehavior="Stop">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="MenuCloseStory" Completed="MenuCloseStory_Completed">
            <DoubleAnimation Storyboard.TargetName="MenuRoot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="MenuTranslate" Storyboard.TargetProperty="Y" From="0" To="10" Duration="0:0:0.16" FillBehavior="Stop" />
            <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.16" FillBehavior="Stop" />
            <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.16" FillBehavior="Stop" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent">

        <!-- ======================= ESP LAYER ======================= -->
        <ItemsControl ItemsSource="{Binding Hub.EspEggs}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding ScreenX}" />
                    <Setter Property="Canvas.Top" Value="{Binding ScreenY}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform X="-75" Y="-30" />
                        </Grid.RenderTransform>
                        <Border x:Name="Glow" CornerRadius="10" BorderThickness="1.5"
                                BorderBrush="{Binding Rarity, Converter={StaticResource RarityBrush}}"
                                Opacity="0" Margin="-3">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.0" />
                            </Border.Effect>
                        </Border>
                        <Border Width="150" CornerRadius="8" Background="#C00A0614" BorderThickness="1.2"
                                BorderBrush="{Binding Rarity, Converter={StaticResource RarityBrush}}" Padding="8,5">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding RarityText, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" />
                                    <TextBlock Text=" · " FontSize="9" Foreground="#7E6E99" />
                                    <TextBlock Text="{Binding ValueText, Mode=OneWay}" FontSize="9" Foreground="#E9DFFF"
                                               Visibility="{Binding DataContext.Hub.ShowEggValue, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text=" · " FontSize="9" Foreground="#7E6E99"
                                               Visibility="{Binding DataContext.Hub.ShowEggValue, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding DistanceText, Mode=OneWay}" FontSize="9" Foreground="#B9A9D8"
                                               Visibility="{Binding DataContext.Hub.ShowEggDistance, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding OriginText, Mode=OneWay}" FontSize="8" Foreground="#6F6288" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRare, Mode=OneWay}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RarePulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="0.85" Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RarePulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tracked}" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ======================= HUD ======================= -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                Background="#A60A0614" CornerRadius="12" Padding="13,10" IsHitTestVisible="False"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="STEAL AN EGG · ULTIMATE" Margin="8,0,0,0" FontSize="10.5" FontWeight="Bold"
                               Foreground="#F4EEFF" />
                    <TextBlock Text="{Binding Hub.PlayerModeText, Mode=OneWay}" Margin="10,0,0,0" FontSize="9" FontWeight="SemiBold"
                               Foreground="{Binding Hub.AccentColor, Mode=OneWay, Converter={StaticResource ColorBrush}}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Hub.StatusLine, Mode=OneWay}" Margin="15,3,0,0" FontSize="9" Foreground="#9C8FB8" />
                <TextBlock Text="{Binding Hub.FpsText, Mode=OneWay}" Margin="15,1,0,0" FontSize="9" Foreground="#9C8FB8"
                           Visibility="{Binding Hub.ShowFps, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Best egg chip -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,84,0,0"
                Background="#990A0614" CornerRadius="10" Padding="11,7" BorderThickness="1"
                BorderBrush="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                Visibility="{Binding Hub.BestFinderEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="BEST EGG" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Hub.Eggs.BestEggText, Mode=OneWay}" FontSize="10" Foreground="#F4EEFF" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Tracker chip -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                Background="#B30A0614" CornerRadius="12" Padding="14,9" BorderThickness="1"
                BorderBrush="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                Visibility="{Binding Hub.TrackerEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="EGG TRACKER" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Hub.Eggs.TrackedSummary}" FontSize="10.5" Foreground="#F4EEFF" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- ======================= NOTIFICATIONS ======================= -->
        <ItemsControl ItemsSource="{Binding Hub.Notifications}" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,18,18,0" Width="300" IsHitTestVisible="False"
                      Visibility="{Binding Hub.ShowNotifications, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#D90A0614" CornerRadius="10" Padding="10,8" Margin="0,0,0,6"
                            BorderThickness="0" BorderBrush="#33FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,9,1"
                                    Background="{Binding Kind, Converter={StaticResource NoticeBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5" Foreground="#F4EEFF"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding TimeText, Mode=OneWay}" FontSize="8.5" Foreground="#7E6E99"
                                       Margin="8,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ======================= CROSSHAIR ======================= -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="22" Height="22"
              IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="{Binding Hub.CrosshairSize, Mode=OneWay, Converter={StaticResource Scale22}, ConverterParameter=0.0455}"
                                ScaleY="{Binding Hub.CrosshairSize, Mode=OneWay, Converter={StaticResource Scale22}, ConverterParameter=0.0455}" />
            </Grid.RenderTransform>
            <Path Data="M 11 3 V 8 M 11 14 V 19 M 3 11 H 8 M 14 11 H 19"
                  Stroke="{Binding Hub.AccentColor, Mode=OneWay, Converter={StaticResource ColorBrush}}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="{Binding Hub.CrosshairCrossVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <Ellipse Width="14" Height="14" StrokeThickness="1.5"
                     Stroke="{Binding Hub.AccentColor, Mode=OneWay, Converter={StaticResource ColorBrush}}"
                     Visibility="{Binding Hub.CrosshairCircleVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <Ellipse Width="4" Height="4" Fill="{Binding Hub.AccentColor, Mode=OneWay, Converter={StaticResource ColorBrush}}"
                     Visibility="{Binding Hub.CrosshairDotVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ======================= MENU ======================= -->
        <Canvas x:Name="MenuCanvas">
            <Grid x:Name="MenuRoot" Canvas.Left="{Binding Hub.MenuOffsetX, Mode=OneWay}" Canvas.Top="{Binding Hub.MenuOffsetY, Mode=OneWay}"
                  Width="{Binding Hub.MenuWidth, Mode=OneWay}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MenuScale" ScaleX="{Binding Hub.UiScale, Mode=OneWay}" ScaleY="{Binding Hub.UiScale, Mode=OneWay}" />
                        <TranslateTransform x:Name="MenuTranslate" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Border CornerRadius="18" Background="#F50B0716" BorderThickness="1"
                        BorderBrush="{DynamicResource AccentBrush}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="0" Opacity="0.75" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header (drag handle) -->
                        <Grid Grid.Row="0" x:Name="DragHeader" Background="Transparent" Margin="16,14,10,8"
                              MouseLeftButtonDown="Header_MouseLeftButtonDown"
                              MouseMove="Header_MouseMove"
                              MouseLeftButtonUp="Header_MouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentBrush}">
                                <TextBlock Text="🥚" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STEAL AN EGG" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock FontSize="9" Foreground="#9C8FB8">
                                    <Run Text="ULTIMATE HUB" />
                                    <Run Text="{Binding Hub.PlayerModeText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="—" Style="{StaticResource IconButton}" Height="26" Width="26"
                                        Click="MinimizeMenu_Click" ToolTip="Hide the menu (Right Shift)" />
                                <Button Content="✕" Style="{StaticResource IconButton}" Height="26" Width="26"
                                        Margin="2,0,0,0" Click="CloseMenu_Click" ToolTip="Close the menu" />
                            </StackPanel>
                        </Grid>

                        <!-- Tabs -->
                        <Grid Grid.Row="1" Margin="12,0,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="EGG" GroupName="MenuTabs" Style="{StaticResource MenuTab}"
                                         IsChecked="{Binding IsEggTab, Mode=TwoWay}" />
                            <RadioButton Grid.Column="1" Content="PLAYER" GroupName="MenuTabs" Style="{StaticResource MenuTab}"
                                         IsChecked="{Binding IsPlayerTab, Mode=TwoWay}" />
                            <RadioButton Grid.Column="2" Content="AUTO" GroupName="MenuTabs" Style="{StaticResource MenuTab}"
                                         IsChecked="{Binding IsAutoTab, Mode=TwoWay}" />
                            <RadioButton Grid.Column="3" Content="VISUAL" GroupName="MenuTabs" Style="{StaticResource MenuTab}"
                                         IsChecked="{Binding IsVisualTab, Mode=TwoWay}" />
                            <RadioButton Grid.Column="4" Content="CMD" GroupName="MenuTabs" Style="{StaticResource MenuTab}"
                                         IsChecked="{Binding IsCommandTab, Mode=TwoWay}" />
                        </Grid>

                        <!-- Content -->
                        <Border Grid.Row="2" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                            <ScrollViewer Style="{StaticResource ThinScrollViewer}" MaxHeight="470" Padding="12,10">
                                <Grid>

                                    <!-- EGG TAB -->
                                    <StackPanel Visibility="{Binding IsEggTab, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Hub.EggRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MenuToggleRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10.5" Foreground="#E9DFFF" />
                                                                <TextBlock Text="{Binding Badge, Mode=OneWay}" FontSize="7.5" Foreground="#6F6288"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1" Style="{DynamicResource NeonToggle}"
                                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          ToolTip="{Binding Tooltip, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <UniformGrid Columns="3" Margin="0,8,0,0">
                                            <Button Content="SCAN" Style="{StaticResource MenuButton}" Margin="0,0,3,0"
                                                    Command="{Binding Hub.ScanCommand, Mode=OneWay}" />
                                            <Button Content="BEST" Style="{StaticResource MenuButton}" Margin="3,0"
                                                    Command="{Binding Hub.TrackBestCommand, Mode=OneWay}" />
                                            <Button Content="SELL ALL" Style="{StaticResource MenuButton}" Margin="3,0,0,0"
                                                    Command="{Binding Hub.SellAllCommand, Mode=OneWay}" />
                                        </UniformGrid>

                                        <Border Background="#14FFFFFF" CornerRadius="9" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="TRACKED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Hub.Eggs.TrackedSummary}" FontSize="10" Foreground="#D9CCF2"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="DISCOVERED" FontSize="8" FontWeight="Bold" Foreground="#6F6288" Margin="2,10,0,4" />
                                        <ItemsControl ItemsSource="{Binding Hub.Eggs.Discovered}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10" Foreground="#D9CCF2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RarityText, Mode=OneWay}" FontSize="8.5" FontWeight="Bold"
                                                                   Foreground="{Binding Rarity, Converter={StaticResource RarityBrush}}" Margin="6,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DistanceText, Mode=OneWay}" FontSize="9" Foreground="#8E7FA8" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- PLAYER TAB -->
                                    <StackPanel Visibility="{Binding IsPlayerTab, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Hub.PlayerRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MenuToggleRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10.5" Foreground="#E9DFFF" />
                                                                <TextBlock Text="{Binding Badge, Mode=OneWay}" FontSize="7.5" Foreground="#6F6288"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1" Style="{DynamicResource NeonToggle}"
                                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          ToolTip="{Binding Tooltip, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Walk speed" FontSize="9.5" Foreground="#B9A9D8" />
                                                    <TextBlock Text="{Binding Hub.Settings.Player.WalkSpeed, StringFormat={}{0:0}}"
                                                               FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider Style="{DynamicResource NeonSlider}" Minimum="8" Maximum="200"
                                                        Value="{Binding Hub.Settings.Player.WalkSpeed, Mode=TwoWay}" Margin="0,2,0,6" />

                                                <Grid>
                                                    <TextBlock Text="Jump power" FontSize="9.5" Foreground="#B9A9D8" />
                                                    <TextBlock Text="{Binding Hub.Settings.Player.JumpPower, StringFormat={}{0:0}}"
                                                               FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider Style="{DynamicResource NeonSlider}" Minimum="0" Maximum="300"
                                                        Value="{Binding Hub.Settings.Player.JumpPower, Mode=TwoWay}" Margin="0,2,0,6" />

                                                <Grid>
                                                    <TextBlock Text="Fly speed" FontSize="9.5" Foreground="#B9A9D8" />
                                                    <TextBlock Text="{Binding Hub.Settings.Player.FlySpeed, StringFormat={}{0:0}}"
                                                               FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider Style="{DynamicResource NeonSlider}" Minimum="5" Maximum="200"
                                                        Value="{Binding Hub.Settings.Player.FlySpeed, Mode=TwoWay}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="TELEPORT" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <UniformGrid Columns="3" Margin="0,4,0,6">
                                                    <StackPanel Margin="0,0,3,0">
                                                        <TextBlock Text="X" FontSize="8.5" Foreground="#6F6288" />
                                                        <TextBox Style="{DynamicResource NeonTextBox}" FontSize="10"
                                                                 Text="{Binding Hub.Settings.Player.TeleportX, Mode=TwoWay, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="3,0">
                                                        <TextBlock Text="Y" FontSize="8.5" Foreground="#6F6288" />
                                                        <TextBox Style="{DynamicResource NeonTextBox}" FontSize="10"
                                                                 Text="{Binding Hub.Settings.Player.TeleportY, Mode=TwoWay, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="3,0,0,0">
                                                        <TextBlock Text="Z" FontSize="8.5" Foreground="#6F6288" />
                                                        <TextBox Style="{DynamicResource NeonTextBox}" FontSize="10"
                                                                 Text="{Binding Hub.Settings.Player.TeleportZ, Mode=TwoWay, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <Button Content="TELEPORT" Style="{StaticResource MenuButton}"
                                                        Command="{Binding Hub.TeleportCommand, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding Hub.PlayerModeDetail, Mode=OneWay}" FontSize="8.5" Foreground="#8E7FA8"
                                                   TextWrapping="Wrap" Margin="2,8,2,0" />
                                    </StackPanel>

                                    <!-- AUTOMATION TAB -->
                                    <StackPanel Visibility="{Binding IsAutoTab, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Hub.AutomationRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MenuToggleRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10.5" Foreground="#E9DFFF" />
                                                                <TextBlock Text="{Binding Badge, Mode=OneWay}" FontSize="7.5" Foreground="#6F6288"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ToggleButton Grid.Column="1" Style="{DynamicResource NeonToggle}"
                                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          ToolTip="{Binding Tooltip, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="Interval" FontSize="9.5" Foreground="#B9A9D8" />
                                            <TextBlock Text="{Binding Hub.Settings.Automation.IntervalMs, StringFormat={}{0} ms}"
                                                       HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Grid>
                                        <Slider Style="{DynamicResource NeonSlider}" Minimum="200" Maximum="5000"
                                                IsSnapToTickEnabled="True" TickFrequency="100"
                                                Value="{Binding Hub.Settings.Automation.IntervalMs, Mode=TwoWay}" Margin="0,2,0,8" />

                                        <UniformGrid Columns="2">
                                            <Button Content="START" Style="{StaticResource MenuButton}" Margin="0,0,3,0"
                                                    Command="{Binding Hub.StartAutomationCommand, Mode=OneWay}" />
                                            <Button Content="STOP" Style="{StaticResource MenuButton}" Margin="3,0,0,0"
                                                    Command="{Binding Hub.StopAutomationCommand, Mode=OneWay}" />
                                        </UniformGrid>

                                        <Border Background="#14FFFFFF" CornerRadius="10" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="LAST ACTION" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Hub.Automation.LastAction}" FontSize="9.5" Foreground="#D9CCF2"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Hub.Automation.StatsText}" FontSize="8.5" Foreground="#8E7FA8" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- VISUAL TAB -->
                                    <StackPanel Visibility="{Binding IsVisualTab, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="THEME" FontSize="8" FontWeight="Bold" Foreground="#6F6288" Margin="0,0,0,5" />
                                        <UniformGrid Columns="4">
                                            <Button Content="VIOLET" Style="{StaticResource MenuButton}" Margin="0,0,3,0"
                                                    Command="{Binding Hub.ApplyThemeCommand, Mode=OneWay}" CommandParameter="Violet" />
                                            <Button Content="CYBER" Style="{StaticResource MenuButton}" Margin="3,0"
                                                    Command="{Binding Hub.ApplyThemeCommand, Mode=OneWay}" CommandParameter="Cyber" />
                                            <Button Content="EMBER" Style="{StaticResource MenuButton}" Margin="3,0"
                                                    Command="{Binding Hub.ApplyThemeCommand, Mode=OneWay}" CommandParameter="Ember" />
                                            <Button Content="MONO" Style="{StaticResource MenuButton}" Margin="3,0,0,0"
                                                    Command="{Binding Hub.ApplyThemeCommand, Mode=OneWay}" CommandParameter="Mono" />
                                        </UniformGrid>

                                        <UniformGrid Columns="1" Margin="0,8,0,0">
                                            <Border Style="{StaticResource MenuToggleRow}">
                                                <Grid>
                                                    <TextBlock Text="Rainbow mode" FontSize="10.5" Foreground="#E9DFFF" />
                                                    <ToggleButton HorizontalAlignment="Right" Style="{DynamicResource NeonToggle}"
                                                                  IsChecked="{Binding Hub.Settings.Visual.RainbowMode, Mode=TwoWay}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource MenuToggleRow}">
                                                <Grid>
                                                    <TextBlock Text="FPS counter" FontSize="10.5" Foreground="#E9DFFF" />
                                                    <ToggleButton HorizontalAlignment="Right" Style="{DynamicResource NeonToggle}"
                                                                  IsChecked="{Binding Hub.Settings.Visual.ShowFps, Mode=TwoWay}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource MenuToggleRow}">
                                                <Grid>
                                                    <TextBlock Text="Notifications" FontSize="10.5" Foreground="#E9DFFF" />
                                                    <ToggleButton HorizontalAlignment="Right" Style="{DynamicResource NeonToggle}"
                                                                  IsChecked="{Binding Hub.Settings.Visual.ShowNotifications, Mode=TwoWay}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource MenuToggleRow}">
                                                <Grid>
                                                    <TextBlock Text="Custom crosshair" FontSize="10.5" Foreground="#E9DFFF" />
                                                    <ToggleButton HorizontalAlignment="Right" Style="{DynamicResource NeonToggle}"
                                                                  IsChecked="{Binding Hub.Settings.Visual.Crosshair, Mode=TwoWay}" />
                                                </Grid>
                                            </Border>
                                        </UniformGrid>

                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Overlay opacity" FontSize="9.5" Foreground="#B9A9D8" />
                                            <TextBlock Text="{Binding Hub.Settings.Overlay.Opacity, StringFormat={}{0:0.00}}"
                                                       HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Grid>
                                        <Slider Style="{DynamicResource NeonSlider}" Minimum="0.3" Maximum="1"
                                                Value="{Binding Hub.Settings.Overlay.Opacity, Mode=TwoWay}" Margin="0,2,0,6" />

                                        <Grid>
                                            <TextBlock Text="UI scale" FontSize="9.5" Foreground="#B9A9D8" />
                                            <TextBlock Text="{Binding Hub.Settings.Overlay.UiScale, Mode=OneWay, StringFormat={}{0:0.00}}"
                                                       HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Grid>
                                        <Slider Style="{DynamicResource NeonSlider}" Minimum="0.7" Maximum="1.4"
                                                Value="{Binding Hub.Settings.Overlay.UiScale, Mode=TwoWay}" Margin="0,2,0,6" />

                                        <TextBlock Text="ESP COLOURS" FontSize="8" FontWeight="Bold" Foreground="#6F6288" Margin="0,4,0,5" />
                                        <StackPanel Orientation="Horizontal">
                                            <ItemsControl ItemsSource="{Binding Hub.EspColorPresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand"
                                                                Command="{Binding DataContext.Hub.SelectEspColorCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Set normal ESP colour">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border CornerRadius="6" Background="{Binding Converter={StaticResource HexBrush}}"
                                                                            BorderBrush="#55FFFFFF" BorderThickness="1" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding Hub.EspColorPresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand"
                                                                Command="{Binding DataContext.Hub.SelectRareColorCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Set rare ESP colour">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border CornerRadius="6" Background="{Binding Converter={StaticResource HexBrush}}"
                                                                            BorderBrush="#55FFFFFF" BorderThickness="1" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- COMMAND TAB -->
                                    <StackPanel Visibility="{Binding IsCommandTab, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="COMMAND INTERPRETER" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBox Style="{DynamicResource ConsoleTextBox}" Margin="0,5,0,6" MinHeight="64"
                                                 Text="{Binding Hub.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <UniformGrid Columns="2">
                                            <Button Content="EXECUTE" Style="{StaticResource MenuButton}" Margin="0,0,3,0"
                                                    Command="{Binding Hub.ExecuteCommand, Mode=OneWay}" />
                                            <Button Content="CLEAR" Style="{StaticResource MenuButton}" Margin="3,0,0,0"
                                                    Command="{Binding Hub.ClearCommand, Mode=OneWay}" />
                                        </UniformGrid>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="egg.scan()" Style="{StaticResource MenuButton}" Margin="0,0,4,4"
                                                    FontSize="9" Command="{Binding Hub.InsertCommandSnippetCommand, Mode=OneWay}"
                                                    CommandParameter="egg.scan()" />
                                            <Button Content="automation.start()" Style="{StaticResource MenuButton}" Margin="0,0,4,4"
                                                    FontSize="9" Command="{Binding Hub.InsertCommandSnippetCommand, Mode=OneWay}"
                                                    CommandParameter="automation.start()" />
                                            <Button Content="settings.save()" Style="{StaticResource MenuButton}" Margin="0,0,4,4"
                                                    FontSize="9" Command="{Binding Hub.InsertCommandSnippetCommand, Mode=OneWay}"
                                                    CommandParameter="settings.save()" />
                                            <Button Content="overlay.hide()" Style="{StaticResource MenuButton}" Margin="0,0,4,4"
                                                    FontSize="9" Command="{Binding Hub.InsertCommandSnippetCommand, Mode=OneWay}"
                                                    CommandParameter="overlay.hide()" />
                                        </WrapPanel>

                                        <Border Background="#14FFFFFF" CornerRadius="9" Padding="8" Margin="0,6,0,0">
                                            <ItemsControl ItemsSource="{Binding Hub.ConsoleLines}" MaxHeight="180">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="9" Foreground="{Binding Kind, Converter={StaticResource NoticeBrush}}"
                                                                   TextWrapping="Wrap" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer -->
                        <Border Grid.Row="3" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="14,9">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1FFFFFFF" CornerRadius="6" Padding="7,3" BorderThickness="1"
                                            BorderBrush="#33FFFFFF">
                                        <TextBlock Text="{Binding MenuKeyLabel}" FontSize="9" FontWeight="Bold" Foreground="#E9DFFF" />
                                    </Border>
                                    <TextBlock Text="{Binding MenuKeyHint}" FontSize="9" Foreground="#8E7FA8" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="HUB" Style="{StaticResource MenuButton}" Margin="0,0,4,0" FontSize="9"
                                            Command="{Binding ActivateHubCommand, Mode=OneWay}" />
                                    <Button Content="SAVE" Style="{StaticResource MenuButton}" Margin="0,0,4,0" FontSize="9"
                                            Command="{Binding Hub.SaveConfigCommand, Mode=OneWay}" />
                                    <Button Content="DISCONNECT" Style="{StaticResource MenuButton}" FontSize="9"
                                            Command="{Binding Hub.DisconnectCommand, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Window>
