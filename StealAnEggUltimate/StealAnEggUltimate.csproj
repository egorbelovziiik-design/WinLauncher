<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>StealAnEggUltimate</AssemblyName>
    <RootNamespace>StealAnEggUltimate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>STEAL AN EGG ULTIMATE HUB</Product>
    <Company>StealAnEgg Ultimate</Company>
    <Description>Standalone overlay hub for the official STEAL AN EGG test place (no injection, no memory access).</Description>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ErrorReport>none</ErrorReport>

    <!-- Publish defaults (overridable from CLI) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Luau sources ship next to the app so users can copy them into Roblox Studio -->
    <None Include="RobloxStudio\TestPlaceModules\**\*.lua" CopyToOutputDirectory="PreserveNewest" LinkBase="RobloxStudio\TestPlaceModules" />
    <None Include="RobloxStudio\TestPlaceModules\**\*.lua" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Docs\**\*.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Config\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Config" />
    <None Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="build.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
