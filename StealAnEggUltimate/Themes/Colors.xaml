<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Runtime-swappable palette. MainViewModel replaces these brushes when the theme changes. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33A855F7" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#7C3AED" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#07050D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#120C1F" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#191029" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#221537" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3B2A5C" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#261A3D" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4EEFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C4B7DC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9C8FB8" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0B0713" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0716" Offset="0" />
        <GradientStop Color="#07050D" Offset="0.55" />
        <GradientStop Color="#0A0614" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowLeftBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4DA855F7" Offset="0" />
        <GradientStop Color="#00A855F7" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="GlowRightBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3D22D3EE" Offset="0" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
