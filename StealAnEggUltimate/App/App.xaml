<Application x:Class="StealAnEggUltimate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StealAnEggUltimate"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/StealAnEggUltimate;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/StealAnEggUltimate;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
            <local:StringToVisibilityConverter x:Key="StringToVis" />
            <local:HexToBrushConverter x:Key="HexBrush" />
            <local:ColorToBrushConverter x:Key="ColorBrush" />
            <local:RarityToBrushConverter x:Key="RarityBrush" />
            <local:NoticeKindToBrushConverter x:Key="NoticeBrush" />
            <local:DoubleIntConverter x:Key="DoubleInt" />
            <local:EqualityToBoolConverter x:Key="EqBool" />
            <local:NumberFormatConverter x:Key="NumberFormat" />
            <local:MultiplyConverter x:Key="Multiply" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
