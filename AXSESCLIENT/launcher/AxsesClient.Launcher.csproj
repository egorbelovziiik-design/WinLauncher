<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AXSESCLIENT</AssemblyName>
    <RootNamespace>AxsesClient.Launcher</RootNamespace>
    <Version>6.0.0</Version>
    <Product>AXSESCLIENT</Product>
    <Company>AXSESCLIENT Engineering</Company>
    <Description>AXSESCLIENT v6.0 (CELESTIAL ULTRA) — Next-Gen Glass HUD, 3D Volumetric Chams, BedWars Suite &amp; Launcher</Description>
    <ApplicationIcon>..\assets\branding\axsesclient.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\updater\AxsesClient.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\assets\branding\icon-128.png" Link="Assets\icon-128.png" />
    <AvaloniaResource Include="..\assets\branding\splash.png" Link="Assets\splash.png" />
  </ItemGroup>
</Project>
