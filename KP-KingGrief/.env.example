# ============================================================
#  КП-KingGrief — настройки окружения
#  Скопируйте этот файл в `.env` и заполните значения.
#  Файл `.env` НЕ должен попадать в Git и НЕ встраивается в EXE.
# ============================================================

# --- ОБЯЗАТЕЛЬНО -------------------------------------------------------
# Токен бота: https://discord.com/developers/applications → ваше приложение → Bot → Reset Token
DISCORD_TOKEN=

# --- РЕКОМЕНДУЕТСЯ -----------------------------------------------------
# Ваш Discord ID — владелец бота (полные права). Узнать: ПКМ по себе → «Копировать ID»
OWNER_ID=

# ID тестового сервера — slash-команды появятся мгновенно (иначе до 1 часа)
TEST_GUILD_ID=

# --- НЕОБЯЗАТЕЛЬНО -----------------------------------------------------
# Имя и активность бота
KP_BOT_NAME=КП-KingGrief
KP_BOT_ACTIVITY=🛡️ Контролирует персонал KingGrief

# Тайм-зона (по умолчанию Europe/Moscow)
KP_TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
KP_LOG_LEVEL=INFO

# Пути (по умолчанию — рядом с программой)
# KP_DATA_DIR=./data
# KP_DB_PATH=./data/kinggrief.db
# KP_BACKUP_DIR=./data/backups
# KP_LOG_DIR=./logs
# KP_LOCK_FILE=./data/bot.lock
